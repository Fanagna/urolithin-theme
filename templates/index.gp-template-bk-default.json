    "multicolumn_HA9E4L": {
      "type": "multicolumn",
      "blocks": {
        "column_3KNpiD": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/SHOE_RACK_REVIEWS_2.webp",
            "title": "<a href=\"https://www.amazon.com/gp/customer-reviews/R1W87PULMKTVQX/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8&ASIN=B0CYL8TMJ5\">Perfect! I need 1 more.</a>",
            "text": "<p>\"Very sturdy. No flimsy parts. There are a lot of parts, but it's very easy to put to together. Spins smoothly.<br/>Please be sure it will fit through your closet door prior to assembly if you plan to assemble outside of the closet and then slide it in. If not, either assemble in the closet or assemble 2-3 tiers at a time, turn sideways and carry into the closet to stack and attach. Just measure your doorway.<br/>Please get more in stock. I need another.\" </p><p>Cheryl C.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_bfTDd7": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/SHOE_RACK_REVIEWS_6.webp",
            "title": "<a href=\"https://www.amazon.com/gp/customer-reviews/R1J8X1SB2DVSBS/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8&ASIN=B0CYL8TMJ5\">Best purchase!</a>",
            "text": "<p>\"This is such a good product, it's just what we needed. Very heavy, made of partical board and covered in what appears to be formica. It spins well, tried to pull it over and couldn't so should be safe. Thanks to the person who came up with this design.\" </p><p>Justin A.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_TJFLQP": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/SHOE_RACK_REVIEWS_9.webp",
            "title": "Love it!",
            "text": "<p>\"This is great for displaying shoes or handbags. The quality is decent. It is decent and pretty good quality. I like that it spins. Assembly was simple and no tools were required. When adding parts A & B I used a rubber mallet. I do recommend the shelf.\" </p><p>Terrie Allen</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_nHFAfx": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/SHOE_RACK_REVIEWS.webp",
            "title": "Top Quality!",
            "text": "<p>\"This is my second purchase: the first was for me and this one is for my little girl, who really loves it. She's lucky to have this shoe kit. The quality is still excellent, with real wood, and it's heavy enough to be safe for children, as it's difficult to move around.\" </p><p>Chloe Anderson</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
