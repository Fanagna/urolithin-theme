        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Panstellar VIP Membership</title>\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --gold: #C9A84C;\n    --gold-light: #E8D48B;\n    --dark: #0A0A0A;\n    --dark-card: #111111;\n    --dark-border: #1E1E1E;\n    --text: #E8E8E8;\n    --text-muted: #8A8A8A;\n    --accent-green: #4ADE80;\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    font-family: 'DM Sans', sans-serif;\n    background: var(--dark);\n    color: var(--text);\n    line-height: 1.6;\n    overflow-x: hidden;\n  }\n\n  /* Hero */\n  .hero {\n    position: relative;\n    padding: 80px 24px 60px;\n    text-align: center;\n    background: radial-gradient(ellipse at 50% 0%, rgba(201,168,76,0.12) 0%, transparent 60%);\n  }\n\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: rgba(201,168,76,0.1);\n    border: 1px solid rgba(201,168,76,0.25);\n    padding: 6px 16px;\n    border-radius: 100px;\n    font-size: 12px;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: var(--gold);\n    margin-bottom: 28px;\n    font-weight: 500;\n  }\n\n  .hero h1 {\n    font-family: 'Playfair Display', serif;\n    font-size: clamp(32px, 6vw, 54px);\n    font-weight: 700;\n    line-height: 1.15;\n    margin-bottom: 20px;\n    background: linear-gradient(135deg, #FFFFFF 0%, var(--gold-light) 50%, var(--gold) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n\n  .hero p {\n    max-width: 560px;\n    margin: 0 auto 36px;\n    color: var(--text-muted);\n    font-size: 17px;\n    line-height: 1.7;\n  }\n\n  .price-tag {\n    display: inline-flex;\n    align-items: baseline;\n    gap: 4px;\n    margin-bottom: 8px;\n  }\n\n  .price-tag .amount {\n    font-family: 'Playfair Display', serif;\n    font-size: 48px;\n    font-weight: 700;\n    color: #fff;\n  }\n\n  .price-tag .period {\n    font-size: 16px;\n    color: var(--text-muted);\n  }\n\n  .price-note {\n    font-size: 13px;\n    color: var(--text-muted);\n    margin-bottom: 32px;\n  }\n\n  .cta-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: linear-gradient(135deg, var(--gold) 0%, #B8912E 100%);\n    color: var(--dark);\n    font-weight: 700;\n    font-size: 15px;\n    padding: 16px 40px;\n    border-radius: 8px;\n    text-decoration: none;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    transition: all 0.3s ease;\n    box-shadow: 0 4px 24px rgba(201,168,76,0.25);\n  }\n\n  .cta-btn:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 32px rgba(201,168,76,0.35);\n  }\n\n  /* Perks */\n  .perks {\n    max-width: 880px;\n    margin: 0 auto;\n    padding: 40px 24px 80px;\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 20px;\n  }\n\n  .perk-card {\n    background: var(--dark-card);\n    border: 1px solid var(--dark-border);\n    border-radius: 14px;\n    padding: 32px 28px;\n    transition: all 0.3s ease;\n  }\n\n  .perk-card:hover {\n    border-color: rgba(201,168,76,0.3);\n    transform: translateY(-3px);\n  }\n\n  .perk-icon {\n    width: 44px;\n    height: 44px;\n    border-radius: 10px;\n    background: rgba(201,168,76,0.08);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 18px;\n    font-size: 20px;\n  }\n\n  .perk-card h3 {\n    font-family: 'Playfair Display', serif;\n    font-size: 18px;\n    font-weight: 600;\n    margin-bottom: 10px;\n    color: #fff;\n  }\n\n  .perk-card p {\n    font-size: 14px;\n    color: var(--text-muted);\n    line-height: 1.65;\n  }\n\n  .perk-highlight {\n    display: inline-block;\n    color: var(--gold);\n    font-weight: 700;\n    font-size: 22px;\n    margin-bottom: 4px;\n  }\n\n  /* Savings Section */\n  .savings {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 24px 80px;\n    text-align: center;\n  }\n\n  .savings-card {\n    background: var(--dark-card);\n    border: 1px solid var(--dark-border);\n    border-radius: 16px;\n    padding: 40px 32px;\n  }\n\n  .savings-card h2 {\n    font-family: 'Playfair Display', serif;\n    font-size: 24px;\n    margin-bottom: 24px;\n    color: #fff;\n  }\n\n  .savings-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 24px;\n  }\n\n  .savings-table th {\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    color: var(--text-muted);\n    padding: 12px 8px;\n    border-bottom: 1px solid var(--dark-border);\n    text-align: left;\n  }\n\n  .savings-table th:last-child,\n  .savings-table td:last-child {\n    text-align: right;\n  }\n\n  .savings-table td {\n    padding: 14px 8px;\n    font-size: 15px;\n    border-bottom: 1px solid rgba(30,30,30,0.6);\n  }\n\n  .savings-table .old-price {\n    text-decoration: line-through;\n    color: var(--text-muted);\n    font-size: 13px;\n  }\n\n  .savings-table .new-price {\n    color: var(--accent-green);\n    font-weight: 700;\n  }\n\n  .savings-total {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-top: 16px;\n    border-top: 1px solid var(--gold);\n  }\n\n  .savings-total span:first-child {\n    font-size: 14px;\n    color: var(--text-muted);\n  }\n\n  .savings-total span:last-child {\n    font-size: 20px;\n    font-weight: 700;\n    color: var(--accent-green);\n  }\n\n  /* Terms */\n  .terms {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 24px 60px;\n    text-align: center;\n  }\n\n  .terms p {\n    font-size: 13px;\n    color: var(--text-muted);\n    line-height: 1.7;\n  }\n\n  .terms a {\n    color: var(--gold);\n    text-decoration: underline;\n  }\n\n  /* Responsive */\n  @media (max-width: 600px) {\n    .perks { grid-template-columns: 1fr; }\n    .savings-card { padding: 28px 20px; }\n  }\n</style>\n</head>\n<body>\n\n<!-- Hero -->\n<section class=\"hero\">\n  <div class=\"badge\">✦ Exclusive Program</div>\n  <h1>Panstellar VIP<br>Membership</h1>\n  <p>Unlock 30% off every order, free shipping, and priority access to new releases. One membership — savings on everything, every time.</p>\n\n  <div class=\"price-tag\">\n    <span class=\"amount\">$9.99</span>\n    <span class=\"period\">/month</span>\n  </div>\n  <div class=\"price-note\">3-month minimum commitment · Cancel anytime after</div>\n\n  <a href=\"#\" class=\"cta-btn\">Become a VIP Member →</a>\n</section>\n\n<!-- Perks -->\n<section class=\"perks\">\n  <div class=\"perk-card\">\n    <div class=\"perk-icon\">%</div>\n    <span class=\"perk-highlight\">30% OFF</span>\n    <h3>Every Order, Every Product</h3>\n    <p>Your VIP discount applies automatically at checkout on our entire catalog — peptides, probiotics, longevity compounds, and more. No codes needed, no exceptions.</p>\n  </div>\n\n  <div class=\"perk-card\">\n    <div class=\"perk-icon\">📦</div>\n    <span class=\"perk-highlight\">$0</span>\n    <h3>Free Shipping, Always</h3>\n    <p>Every order ships free to the US, UK, and Canada. No minimum spend required. Your supplements arrive at your door with zero added cost.</p>\n  </div>\n\n  <div class=\"perk-card\">\n    <div class=\"perk-icon\">⚡</div>\n    <span class=\"perk-highlight\">First Access</span>\n    <h3>New Product Priority</h3>\n    <p>Be the first to know when we launch new formulas. VIP members get early access before public release — plus exclusive member-only products.</p>\n  </div>\n\n  <div class=\"perk-card\">\n    <div class=\"perk-icon\">💬</div>\n    <span class=\"perk-highlight\">Priority</span>\n    <h3>Dedicated Support</h3>\n    <p>Skip the queue. VIP members get priority response from our support team for order inquiries, product questions, and personalized guidance.</p>\n  </div>\n</section>\n\n<!-- Savings Example -->\n<section class=\"savings\">\n  <div class=\"savings-card\">\n    <h2>See How Much You Save</h2>\n    <table class=\"savings-table\">\n      <thead>\n        <tr>\n          <th>Product</th>\n          <th>Regular</th>\n          <th>VIP Price</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>BPC-157 (500mcg)</td>\n          <td><span class=\"old-price\">$69.99</span></td>\n          <td><span class=\"new-price\">$49.00</span></td>\n        </tr>\n        <tr>\n          <td>NAD+ Liposomal</td>\n          <td><span class=\"old-price\">$89.99</span></td>\n          <td><span class=\"new-price\">$63.00</span></td>\n        </tr>\n        <tr>\n          <td>Akkermansia</td>\n          <td><span class=\"old-price\">$59.99</span></td>\n          <td><span class=\"new-price\">$42.00</span></td>\n        </tr>\n      </tbody>\n    </table>\n    <div class=\"savings-total\">\n      <span>Your annual savings (ordering monthly)</span>\n      <span>Up to $780+/yr</span>\n    </div>\n  </div>\n</section>\n\n<!-- Terms -->\n<section class=\"terms\">\n  <p>\n    Panstellar VIP Membership is billed at $9.99/month with a 3-month minimum commitment ($29.97 total minimum). After the initial 3 months, you may cancel at any time from your account portal. Your 30% discount and free shipping activate immediately upon membership purchase and apply to all future orders for as long as your membership is active. Membership is non-refundable for the current billing period. By subscribing, you agree to our <a href=\"#\">Terms of Service</a> and <a href=\"#\">Membership Agreement</a>.\n  </p>\n</section>\n\n</body>\n</html>",
