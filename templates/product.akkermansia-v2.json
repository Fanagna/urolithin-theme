        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What exactly is in the 8-in-1 formula?",
            "answer": "Akkermansia muciniphila (500 Billion AFU per serving), prebiotic inulin, green tea leaf, vitamin D, vitamin B2, chromium, zinc and alpha lipoic acid (ALA)."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "Each bottle contains 180 capsules. The daily serving is 2 capsules, so one bottle is a full 3-month (90-day) supply."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "What are AFUs and why do they matter?",
            "answer": "AFU (Active Fluorescent Units) counts viable probiotic cells using flow cytometry — a modern, more precise alternative to traditional CFU counting. It gives a clearer picture of the active cells in each serving."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "When should I expect to notice a difference?",
            "answer": "Everyone's microbiome is different, so individual experiences vary. Consistency matters most — many people give a new probiotic routine at least 4–6 weeks as part of their daily habits."
          }
        },
