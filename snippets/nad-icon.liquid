{% comment %}
  Renders one of PANSTELLAR's NAD+ line icons by name, or a merchant-uploaded
  image if custom_image is set. Kept as inline <svg> (not an asset file) so the
  stroke color keeps following the surrounding .icon{color:...} via
  currentColor — an <img src="*.svg"> can't inherit page CSS color that way.
  Usage: {% render 'nad-icon', name: 'shield-check', custom_image: block.settings.icon %}
{% endcomment %}
{% liquid
  assign nad_icon_alt = alt | default: ''
  assign nad_icon_class = class | default: ''
%}
{% if custom_image != blank %}
  {{ custom_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: nad_icon_alt, class: nad_icon_class }}
{% else %}
  <svg viewBox="0 0 24 24" class="{{ nad_icon_class }}" aria-hidden="true">
    {% case name %}
      {% when 'shield-check' %}<path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"/><path d="m9 12 2 2 4-5"/>
      {% when 'brain-web' %}<path d="M9 4a4 4 0 0 0-4 4v1a4 4 0 0 0-2 3.5A4.5 4.5 0 0 0 7.5 17H9"/><path d="M15 4a4 4 0 0 1 4 4v1a4 4 0 0 1 2 3.5 4.5 4.5 0 0 1-4.5 4.5H15"/><path d="M9 4v16M15 4v16"/>
      {% when 'root' %}<path d="M9 3h6l1 5 3 3-2 8H7l-2-8 3-3z"/><path d="M9 14h6"/>
      {% when 'leaf-glow' %}<path d="M6 20c6-1 10-5 12-12-6 1-10 5-12 12Z"/><path d="M8 16c3-1 5-3 7-6"/>
      {% when 'truck' %}<path d="M3 7h12v9H3z"/><path d="M15 10h3l3 3v3h-6"/><circle cx="7" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/>
      {% when 'bolt-arrow' %}<path d="m13 2-8 12h6l-1 8 9-13h-6z"/>
      {% when 'circle-plus' %}<circle cx="12" cy="12" r="9"/><path d="M7 12h10M12 7v10"/>
      {% when 'lock-box' %}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
      {% when 'battery' %}<path d="M4 8h15v9H4z"/><path d="M19 11h2v3h-2"/>
      {% when 'infinity' %}<path d="M4 4c8 0 8 16 16 16M20 4C12 4 12 20 4 20"/><path d="M7 7h4M13 17h4M13 7h4M7 17h4"/>
      {% when 'box' %}<path d="M3 5h18v14H3z"/><path d="M3 9h18M8 5v14"/>
      {% when 'cart' %}<path d="M3 4h2l2.1 10h10.8l2-7H7"/><circle cx="9" cy="19" r="1.2"/><circle cx="18" cy="19" r="1.2"/>
      {% when 'shield-plus' %}<path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"/><path d="M12 8v8M8 12h8"/>
      {% when 'molecule' %}<circle cx="8" cy="8" r="2"/><circle cx="16" cy="7" r="1.7"/><circle cx="14" cy="16" r="2"/><circle cx="6" cy="16" r="1.4"/>
      {% when 'runner' %}<circle cx="7" cy="5" r="2"/><path d="m9 8 3 3 3-1 3 4M11 11l-2 4-4 4M13 13l2 5"/>
      {% when 'target' %}<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
    {% endcase %}
  </svg>
{% endif %}
