{%- comment -%}
  Reusable add-to-cart form for the Urolithin A landing product page.
  Expected render params:
  - product
  - section
  - form_id_suffix
  - button_label
  - button_class
  - form_class
{%- endcomment -%}

{%- liquid
  assign ua_variant = product.selected_or_first_available_variant
  assign ua_form_id = 'ua-cta-form-' | append: section.id | append: '-' | append: form_id_suffix
  assign ua_button_class = button_class | default: 'ua-btn'
  assign ua_form_class = form_class | default: 'ua-product-form'
-%}

{%- form 'product', product, id: ua_form_id, class: ua_form_class -%}
  {%- if product.has_only_default_variant -%}
    <input type="hidden" name="id" value="{{ ua_variant.id }}">
  {%- else -%}
    <label class="ua-visually-hidden" for="UaVariant-{{ section.id }}-{{ form_id_suffix }}">Choose variant</label>
    <select class="ua-variant-select" id="UaVariant-{{ section.id }}-{{ form_id_suffix }}" name="id">
      {%- for variant in product.variants -%}
        <option
          value="{{ variant.id }}"
          {% if variant == ua_variant %}selected="selected"{% endif %}
          {% unless variant.available %}disabled="disabled"{% endunless %}
        >
          {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
        </option>
      {%- endfor -%}
    </select>
  {%- endif -%}

  <input type="hidden" name="quantity" value="1">
  <button type="submit" name="add" class="{{ ua_button_class }}" {% unless ua_variant.available %}disabled="disabled"{% endunless %}>
    {%- if ua_variant.available -%}
      {{ button_label }}
    {%- else -%}
      Sold out
    {%- endif -%}
  </button>
{%- endform -%}
