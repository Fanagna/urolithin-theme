<script>
(function() {
  // Exit if already initialized
  if (window.__GA4_ATC_LISTENER__) return;
  window.__GA4_ATC_LISTENER__ = true;

  // Safe gtag/dataLayer bootstrap (works even if GA loads later)
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function(){ dataLayer.push(arguments); };

  const CONFIG = {
    currency: (window.Shopify && Shopify.currency && Shopify.currency.active) ||
              document.documentElement.getAttribute('data-currency') ||
              '{{ shop.currency }}',
    dedupeWindow: 3000, // ms
    debug: false
  };

  const recent = new Set();
  const dedupe = (key) => (
    recent.has(key) ? true : (recent.add(key), setTimeout(() => recent.delete(key), CONFIG.dedupeWindow), false)
  );

  function centsToAmount(x) {
    if (typeof x !== 'number' && isNaN(Number(x))) return 0;
    return Math.round(Number(x)) / 100;
  }

  function toItem(obj) {
    const priceCents = obj.final_price ?? obj.price ?? obj.line_price ?? obj.original_price ?? 0;
    return {
      item_id: String(obj.variant_id ?? obj.id ?? obj.product_id ?? ''),
      item_name: (obj.title || obj.product_title || obj.item_title || '').trim() || 'Unknown Item',
      item_brand: obj.vendor || obj.brand || undefined,
      item_variant: obj.variant_title || obj.title || undefined,
      price: centsToAmount(priceCents),
      quantity: Math.max(1, Number(obj.quantity ?? obj.qty ?? 1)),
      item_category: obj.product_type || undefined,
      sku: obj.sku || undefined,
    };
  }

  function fireAddToCart(itemsArr) {
    if (!Array.isArray(itemsArr) || !itemsArr.length) return;
    const items = itemsArr.map(toItem).filter(i => i.item_id);
    if (!items.length) return;

    const value = items.reduce((sum, i) => sum + (Number(i.price) * (i.quantity || 1)), 0);
    const key = `${items[0].item_id}:${items[0].quantity}:${value.toFixed(2)}`;
    if (dedupe(key)) return;

    gtag('event', 'add_to_cart', {
      currency: CONFIG.currency,
      value: Number(value.toFixed(2)),
      items
    });
    if (CONFIG.debug) console.log('GA4 ATC Event Fired:', { currency: CONFIG.currency, value, items });
  }

  async function parseAddResponse(res) {
    try {
      if (!res?.headers?.get || !/json/i.test(res.headers.get('content-type'))) return null;
      const data = await res.clone().json();
      return Array.isArray(data?.items) ? data.items
           : (data?.item ? [data.item]
           : (data ? [data] : null));
    } catch (e) {
      if (CONFIG.debug) console.error('Parse Error:', e);
      return null;
    }
  }

  // Intercept fetch
  const originalFetch = window.fetch;
  window.fetch = async function(...args) {
    const [req] = args;
    const url = typeof req === 'string' ? req : (req?.url || '');
    const res = await originalFetch.apply(this, args);
    if (/\/cart\/add(\.js)?(\?|$)/.test(url)) {
      parseAddResponse(res).then(items => items && fireAddToCart(items));
    }
    return res;
  };

  // Intercept XHR
  const originalOpen = XMLHttpRequest.prototype.open;
  const originalSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function(method, url) {
    this.__isATC = /\/cart\/add(\.js)?(\?|$)/.test(String(url || ''));
    return originalOpen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function(...args) {
    if (this.__isATC) {
      this.addEventListener('load', () => {
        try {
          const ct = this.getResponseHeader && this.getResponseHeader('content-type');
          if (ct && /json/i.test(ct)) {
            const data = JSON.parse(this.responseText || '{}');
            const items = Array.isArray(data?.items) ? data.items : (data?.item ? [data.item] : [data]);
            fireAddToCart(items);
          }
        } catch (e) {
          if (CONFIG.debug) console.error('XHR Parse Error:', e);
        }
      });
    }
    return originalSend.apply(this, args);
  };

  // Fallback: non-AJAX form posts (no preventDefault!)
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement) || !/\/cart\/add(\.js)?/.test(form.action || '')) return;
    try {
      const variantId = form.querySelector('[name="id"]')?.value;
      const qty = Math.max(1, Number(form.querySelector('[name="quantity"]')?.value || 1));
      const title = (document.querySelector('[data-product-title]')?.textContent ||
                     document.querySelector('h1.product__title, h1.product-title')?.textContent || '').trim() || 'Unknown Item';
      // fire minimal payload immediately; final value will likely be 0 here, which is fine as a fallback
      fireAddToCart([{ id: variantId, variant_id: variantId, title, quantity: qty, price: 0 }]);
    } catch (e) {
      if (CONFIG.debug) console.error('Form Submit Error:', e);
    }
  });
})();
</script>
