{%- comment -%}
  Scientific Experts — shared markup snippet. Rendered by the standalone
  `sections/sciexp-experts.liquid` AND inline inside `akv-pdp` (after ingredients).
  Params: heading, show_shield, research_heading, bg_color, accent_color,
  accent_color2, experts (blocks array of type 'expert'), research (blocks array
  of type 'research_item'). Load `sciexp-experts.css` in the host before rendering.
{%- endcomment -%}
<section class="sciexp" style="--sciexp-bg:{{ bg_color | default: '#f6fbff' }};--sciexp-accent:{{ accent_color | default: '#082f56' }};--sciexp-accent2:{{ accent_color2 | default: '#0a3357' }}">
  <div class="sciexp-inner">
    <div class="sciexp-shell">

      {%- if heading != blank -%}
        <h2 class="sciexp-heading"><span>{{ heading }}</span></h2>
        {%- if show_shield -%}
          <div class="sciexp-ornament" aria-hidden="true">
            <svg class="sciexp-shield" viewBox="0 0 64 72" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M32 3 57 12v23c0 16-9.4 26.8-25 34C16.4 61.8 7 51 7 35V12L32 3Z" fill="#fff" stroke="var(--sciexp-accent)" stroke-width="2.2"/>
              <path d="m32 17 3.8 8 8.7 1.1-6.4 6 1.7 8.5-7.8-4.2-7.8 4.2 1.7-8.5-6.4-6 8.7-1.1 3.8-8Z" stroke="var(--sciexp-accent)" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if experts.size > 0 -%}
        <div class="sciexp-grid" style="--sciexp-cols:{{ experts.size | at_most: 4 }}">
          {%- for block in experts -%}
            {%- liquid
              assign photo = ''
              if block.settings.image_file != blank
                assign photo = block.settings.image_file | asset_url
              elsif block.settings.image != blank
                assign photo = block.settings.image | image_url: width: 700
              endif
            -%}
            <article class="sciexp-card" {{ block.shopify_attributes }}>
              <div class="sciexp-photo-wrap">
                {%- if photo != blank -%}
                  <img class="sciexp-photo" src="{{ photo }}" alt="{{ block.settings.name | escape }}" width="700" height="820" loading="lazy" style="object-position:50% {{ block.settings.focus_y | default: 35 }}%">
                {%- endif -%}
              </div>
              <div class="sciexp-banner">
                <h3 class="sciexp-name">{{ block.settings.name }}</h3>
                {%- if block.settings.role != blank -%}<p class="sciexp-role">{{ block.settings.role }}</p>{%- endif -%}
              </div>
              {%- if block.settings.institution != blank or block.settings.institution_sub != blank -%}
                <div class="sciexp-institution">
                  {%- if block.settings.institution != blank -%}<strong>{{ block.settings.institution }}</strong>{%- endif -%}
                  {%- if block.settings.institution_sub != blank -%}<span>{{ block.settings.institution_sub }}</span>{%- endif -%}
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if research.size > 0 -%}
        {%- if research_heading != blank -%}
          <div class="sciexp-research-heading">{{ research_heading }}</div>
        {%- endif -%}
        <div class="sciexp-research-panel">
          <div class="sciexp-research-grid" style="--sciexp-rcols:{{ research.size | at_most: 6 }}">
            {%- for block in research -%}
              {%- liquid
                assign rimg = ''
                if block.settings.image_file != blank
                  assign rimg = block.settings.image_file | asset_url
                elsif block.settings.image != blank
                  assign rimg = block.settings.image | image_url: width: 320
                endif
              -%}
              <div class="sciexp-research-item" {{ block.shopify_attributes }}>
                {%- if rimg != blank -%}
                  <img src="{{ rimg }}" alt="{{ block.settings.alt | default: block.settings.text | escape }}" loading="lazy" width="298" height="91">
                {%- elsif block.settings.text != blank -%}
                  <p class="sciexp-research-copy">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>
