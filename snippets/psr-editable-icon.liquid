{% liquid
  assign psr_icon_class = class | default: 'psr-svg-icon'
  assign psr_icon_alt = alt | default: ''
  assign psr_icon_width = width | default: 96
%}
{% if custom_image != blank %}
  {{ custom_image | image_url: width: psr_icon_width | image_tag: loading: 'lazy', alt: psr_icon_alt, class: psr_icon_class }}
{% elsif fallback_asset != blank %}
  <img src="{{ fallback_asset | asset_url }}" alt="{{ psr_icon_alt | escape }}" class="{{ psr_icon_class }}" loading="lazy">
{% endif %}
