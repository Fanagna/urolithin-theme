{{ 'crt-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign crt_variant = product.selected_or_first_available_variant
  assign crt_price   = crt_variant.price | money

  # Per-serving price, auto-calculated from the live product price so it never
  # goes stale when the price changes. servings_count is a merchant-editable
  # fact about the product (not a price), defaults to 90 (90 servings).
  assign crt_servings = section.settings.servings_count | default: 90
  assign crt_serving_price = crt_variant.price | times: 1.0 | divided_by: crt_servings | money | append: ' per serving'

  assign crt_hero_desktop = 'crt-hero-desktop.webp' | asset_url
  assign crt_hero_mobile  = 'crt-hero-mobile.webp'  | asset_url
  if section.settings.hero_bg != blank
    assign crt_hero_desktop = section.settings.hero_bg | image_url: width: 1920
  endif
  if section.settings.hero_bg_mobile != blank
    assign crt_hero_mobile = section.settings.hero_bg_mobile | image_url: width: 900
  endif

  assign crt_bottle = 'crt-jar.webp' | asset_url
  if section.settings.product_image != blank
    assign crt_bottle = section.settings.product_image | image_url: width: 600
  endif

  assign faq_blocks = section.blocks | where: 'type', 'faq_item'

  assign crt_hero_form_id   = 'crt-hero-form-'   | append: section.id
  assign crt_sticky_form_id = 'crt-sticky-form-' | append: section.id
-%}

{% render 'panstellar-product-schema', product: product %}
<link rel="preload" as="image" href="{{ crt_hero_desktop }}" media="(min-width: 761px)" fetchpriority="high">
<link rel="preload" as="image" href="{{ crt_hero_mobile }}" media="(max-width: 760px)" fetchpriority="high">
<style>
  #crt-pdp-{{ section.id }}{
    --crt-hero-img: url('{{ crt_hero_desktop }}');
    --crt-hero-img-m: url('{{ crt_hero_mobile }}');
  }
</style>

<div class="crt-pdp" id="crt-pdp-{{ section.id }}">

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="crt-hero">
    <div class="crt-wrap">
      <div class="crt-hero-grid">
        <div class="crt-hero-copy">
          <div class="crt-eyebrow">{{ section.settings.hero_eyebrow }}</div>
          <h1 class="crt-hero-title">{{ section.settings.hero_h1 }}</h1>
          <p>{{ section.settings.hero_subtitle }}</p>

          <div class="crt-hero-icons" aria-label="Product highlights">
            <div class="crt-hero-icon">
              <div class="crt-circle"><img class="crt-icon-img" src="{{ 'crt-icon-molecule.png' | asset_url }}" alt=""></div>
              {{ section.settings.hero_stat1 }}
            </div>
            <div class="crt-hero-icon">
              <div class="crt-circle"><img class="crt-icon-img" src="{{ 'crt-icon-capsule.png' | asset_url }}" alt=""></div>
              {{ section.settings.hero_stat2 }}
            </div>
            <div class="crt-hero-icon">
              <div class="crt-circle"><img class="crt-icon-img" src="{{ 'crt-icon-certificate.png' | asset_url }}" alt=""></div>
              {{ section.settings.hero_stat3 }}
            </div>
            <div class="crt-hero-icon">
              <div class="crt-circle"><img class="crt-icon-img" src="{{ 'crt-icon-shield-check.png' | asset_url }}" alt=""></div>
              {{ section.settings.hero_stat4 }}
            </div>
          </div>

          <div class="crt-trust-line">{{ section.settings.hero_foot }}</div>
        </div>

        <aside class="crt-buy-card" id="crt-buy-card-{{ section.id }}">
          <p class="crt-price">{{ crt_price }}</p>
          <p class="crt-sub">{{ section.settings.card_meta }}</p>
          <p class="crt-daily">{{ crt_serving_price }}</p>

          {%- form 'product', product, id: crt_hero_form_id, novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ crt_variant.id }}">
            <div class="crt-qty">
              <button type="button" class="crt-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
              <span data-qty-value>1</span>
              <input type="number" name="quantity" value="1" min="1" data-qty-input style="display:none">
              <button type="button" class="crt-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" name="add" class="crt-btn">{{ section.settings.cta_text }}</button>
          {%- endform -%}

          <div class="crt-benefits">
            <div class="crt-benefit"><img class="crt-icon-img" src="{{ 'crt-icon-molecule.png' | asset_url }}" alt="">{{ section.settings.benefit1 }}</div>
            <div class="crt-benefit"><img class="crt-icon-img" src="{{ 'crt-icon-beaker.png' | asset_url }}" alt="">{{ section.settings.benefit2 }}</div>
            <div class="crt-benefit"><img class="crt-icon-img" src="{{ 'crt-icon-shield-check.png' | asset_url }}" alt="">{{ section.settings.benefit3 }}</div>
          </div>

          <details class="crt-product-detail">
            <summary>{{ section.settings.acc1_label }}</summary>
            <div class="crt-detail-content"><ul>
              <li>{{ section.settings.acc1_text1 }}</li>
              <li>{{ section.settings.acc1_text2 }}</li>
              <li>{{ section.settings.acc1_text3 }}</li>
            </ul></div>
          </details>
          <details class="crt-product-detail">
            <summary>{{ section.settings.acc2_label }}</summary>
            <div class="crt-detail-content"><ul>
              <li>{{ section.settings.acc2_text1 }}</li>
              <li>{{ section.settings.acc2_text2 }}</li>
              <li>{{ section.settings.acc2_text3 }}</li>
            </ul></div>
          </details>
          <details class="crt-product-detail">
            <summary>{{ section.settings.acc3_label }}</summary>
            <div class="crt-detail-content"><ul>
              <li>{{ section.settings.acc3_text1 }}</li>
              <li>{{ section.settings.acc3_text2 }}</li>
              <li>{{ section.settings.acc3_text3 }}</li>
            </ul></div>
          </details>
        </aside>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ INGREDIENT FEATURE (1) ══════════════════════════════ -->
  <section class="crt-ingredient-feature">
    <div class="crt-wrap crt-feature-grid">
      <div class="crt-powder-photo">
        <img src="{{ 'crt-ing-powder.webp' | asset_url }}" alt="Creatine monohydrate powder" loading="lazy">
      </div>
      <div class="crt-feature-copy">
        <div class="crt-feature-kicker">{{ section.settings.feature_kicker }}</div>
        <h2>{{ section.settings.feature_h2 }}</h2>
        <div class="crt-blue-dose">{{ section.settings.feature_dose }}</div>
        <div class="crt-micro-box">
          <div class="crt-micro-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M19.1 4.9l-2.8 2.8M7.7 16.3l-2.8 2.8"/></svg>
          </div>
          <div><strong>{{ section.settings.feature_micro_title }}</strong><span>{{ section.settings.feature_micro_text }}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ COMPARE ══════════════════════════════ -->
  <section class="crt-compare-section">
    <div class="crt-wrap crt-compare-grid">
      <div class="crt-compare-card crt-clean-card">
        <img src="{{ crt_bottle }}" alt="{{ product.title }}" loading="lazy">
        <div>
          <h3>{{ section.settings.compare_ours_heading }}</h3>
          <ul class="crt-check-list">
            <li>{{ section.settings.compare_ours1 }}</li>
            <li>{{ section.settings.compare_ours2 }}</li>
            <li>{{ section.settings.compare_ours3 }}</li>
            <li>{{ section.settings.compare_ours4 }}</li>
            <li>{{ section.settings.compare_ours5 }}</li>
            <li>{{ section.settings.compare_ours6 }}</li>
            <li>{{ section.settings.compare_ours7 }}</li>
          </ul>
        </div>
      </div>

      <div class="crt-vs">VS</div>

      <div class="crt-compare-card crt-typical-card">
        <div>
          <h3>{{ section.settings.compare_typical_heading }}</h3>
          <ul class="crt-x-list">
            <li>{{ section.settings.compare_typical1 }}</li>
            <li>{{ section.settings.compare_typical2 }}</li>
            <li>{{ section.settings.compare_typical3 }}</li>
            <li>{{ section.settings.compare_typical4 }}</li>
            <li>{{ section.settings.compare_typical5 }}</li>
          </ul>
        </div>
        <img src="{{ 'crt-typical.webp' | asset_url }}" alt="Typical generic creatine bottle" loading="lazy">
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SCIENCE ══════════════════════════════ -->
  <section class="crt-science">
    <div class="crt-science-layout">
      <div class="crt-science-img"><img src="{{ 'crt-science.webp' | asset_url }}" alt="Blue scientific network" loading="lazy"></div>
      <div class="crt-science-copy">
        <h2>{{ section.settings.science_heading }}</h2>
        <p>{{ section.settings.science_sub }}</p>
        <ul class="crt-science-list">
          <li>{{ section.settings.science_point1 }}</li>
          <li>{{ section.settings.science_point2 }}</li>
          <li>{{ section.settings.science_point3 }}</li>
          <li>{{ section.settings.science_point4 }}</li>
        </ul>
      </div>
      <div class="crt-works">
        <h3>{{ section.settings.works_heading }}</h3>
        <div class="crt-works-item">
          <div class="crt-circle"><svg viewBox="0 0 24 24"><path d="M12 2v20M4 12h16"/><circle cx="12" cy="12" r="8"/></svg></div>
          {{ section.settings.works1 }}
        </div>
        <div class="crt-works-item">
          <div class="crt-circle"><img class="crt-icon-img" src="{{ 'crt-icon-molecule.png' | asset_url }}" alt="" loading="lazy"></div>
          {{ section.settings.works2 }}
        </div>
        <div class="crt-works-item">
          <div class="crt-circle"><svg viewBox="0 0 24 24"><path d="M8 18c5-2 8-7 7-14 3 2 5 6 4 10-1 5-6 8-11 4z"/></svg></div>
          {{ section.settings.works3 }}
        </div>
        <div class="crt-works-item">
          <div class="crt-circle"><svg viewBox="0 0 24 24"><path d="m3 21 6-6"/><path d="M15 3l6 6"/><path d="M9 15 15 9"/></svg></div>
          {{ section.settings.works4 }}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ QUALITY + FAQ ══════════════════════════════ -->
  <section class="crt-quality-faq">
    <div class="crt-wrap">
      <div class="crt-quality-row">
        <h2>{{ section.settings.quality_heading }}</h2>
        <div class="crt-quality-icons">
          <div class="crt-quality-item"><div class="crt-quality-icon"><img class="crt-icon-img" src="{{ 'crt-icon-beaker.png' | asset_url }}" alt="" loading="lazy"></div>{{ section.settings.quality1 }}</div>
          <div class="crt-quality-item"><div class="crt-quality-icon"><img class="crt-icon-img" src="{{ 'crt-icon-made-in-usa.webp' | asset_url }}" alt="" loading="lazy"></div>{{ section.settings.quality2 }}</div>
          <div class="crt-quality-item"><div class="crt-quality-icon"><img class="crt-icon-img" src="{{ 'crt-icon-certificate.png' | asset_url }}" alt="" loading="lazy"></div>{{ section.settings.quality3 }}</div>
          <div class="crt-quality-item"><div class="crt-quality-icon"><img class="crt-icon-img" src="{{ 'crt-icon-molecule0.png' | asset_url }}" alt="" loading="lazy"></div>{{ section.settings.quality4 }}</div>
          <div class="crt-quality-item"><div class="crt-quality-icon"><img class="crt-icon-img" src="{{ 'crt-icon-shield-check.png' | asset_url }}" alt="" loading="lazy"></div>{{ section.settings.quality5 }}</div>
        </div>
        <div class="crt-supply-badge"><div><strong>{{ section.settings.supply_count }}</strong>{{ section.settings.supply_unit }}<span>{{ section.settings.supply_duration }}</span></div></div>
        <div class="crt-quality-note">{{ section.settings.quality_note }}</div>
      </div>

      {%- if faq_blocks.size > 0 -%}
      <div class="crt-faq-grid">
        <h2>{{ section.settings.faq_heading }}</h2>
        <div class="crt-faq-list">
          {%- for block in faq_blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <p>{{ block.settings.answer }}</p>
            </details>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>

  <!-- ══════════════════════════════ STICKY ADD-TO-CART ══════════════════════════════ -->
  <div class="crt-sticky" id="crt-sticky-{{ section.id }}" aria-label="Quick add to cart">
    <div class="crt-wrap crt-sticky-inner">
      <img src="{{ crt_bottle }}" alt="{{ product.title }}" loading="lazy">
      <div class="crt-sticky-title">{{ section.settings.sticky_title }}</div>
      <div class="crt-sticky-price">{{ crt_price }}<small>{{ section.settings.card_meta }}</small></div>
      <div class="crt-sticky-benefits">
        <span>{{ section.settings.benefit1 }}</span>
        <span>{{ section.settings.benefit3 }}</span>
        <span>{{ section.settings.benefit2 }}</span>
        <span>{{ section.settings.trust_secure }}</span>
      </div>
      {%- form 'product', product, id: crt_sticky_form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ crt_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="crt-btn">{{ section.settings.cta_text }}</button>
      {%- endform -%}
    </div>
  </div>

</div><!-- /.crt-pdp -->

<script>
(function(){
  var wrap = document.getElementById('crt-pdp-{{ section.id }}');
  if (!wrap) return;

  /* ── Quantity selector ── */
  wrap.querySelectorAll('.crt-qty').forEach(function(qty){
    var input = qty.querySelector('[data-qty-input]');
    var value = qty.querySelector('[data-qty-value]');
    var minus = qty.querySelector('[data-qty-minus]');
    var plus  = qty.querySelector('[data-qty-plus]');
    function set(n){
      n = Math.max(1, n);
      input.value = n;
      value.textContent = n;
    }
    minus.addEventListener('click', function(){ set(parseInt(input.value, 10) - 1); });
    plus.addEventListener('click', function(){ set(parseInt(input.value, 10) + 1); });
  });

  /* ── Sticky reveal once the buy-card (CTA + accordions) scrolls out of
     view — observing the whole hero instead would keep the sticky hidden
     while the buy-card has scrolled away but the rest of the (taller) hero
     is still on screen, leaving no visible CTA in between. ── */
  var buyCard = document.getElementById('crt-buy-card-{{ section.id }}');
  var sticky = document.getElementById('crt-sticky-{{ section.id }}');
  if (buyCard && sticky && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(entries){
      sticky.classList.toggle('crt-sticky--visible', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(buyCard);
  } else if (sticky) {
    sticky.classList.add('crt-sticky--visible');
  }

  /* ── AJAX Add to Cart (Dawn cart drawer) ── */
  /* Uses the native <cart-drawer> custom element's own renderContents()
     method (same one Dawn's product-form.js calls) — it both swaps in the
     fresh sections AND opens the drawer. window.openCartDrawer() and
     [data-cart-toggle]/[aria-controls="CartDrawer"] don't exist anywhere
     in this theme, so relying on them silently did nothing. */
  function handleForm(form){
    if (!form) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      var origText = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
      var qtyInput = form.querySelector('[name="quantity"]');
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({
          id: form.querySelector('[name="id"]').value,
          quantity: qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1,
          sections: ['cart-drawer', 'cart-icon-bubble'],
          sections_url: window.location.pathname
        })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        /* Fire Dawn's own pubsub cart-update event (same one product-form.js
           fires) — apps that hook into cart updates (reviews widgets, bundle
           upsells, etc.) listen for this, not our custom DOM event alone. */
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'crt-pdp', productVariantId: form.querySelector('[name="id"]').value, cartData: data });
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (btn) { btn.dataset.added = '1'; }
        var drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.renderContents === 'function') {
          drawer.renderContents(data);
        } else {
          window.location = window.Shopify.routes.root + 'cart';
        }
      })
      .catch(function(){ window.location = window.Shopify.routes.root + 'cart'; })
      .finally(function(){ if (btn) { btn.disabled = false; if (btn.dataset.added) { delete btn.dataset.added; btn.textContent = '\u2713 Added'; setTimeout(function(){ btn.textContent = origText; }, 1600); } else { btn.textContent = origText; } } });
    });
  }
  handleForm(document.getElementById('crt-hero-form-{{ section.id }}'));
  handleForm(document.getElementById('crt-sticky-form-{{ section.id }}'));
})();
</script>

{% schema %}
{
  "name": "Creatine PDP",
  "tag": "section",
  "class": "crt-pdp-wrapper",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_bg",        "label": "Hero background (desktop)" },
    { "type": "image_picker", "id": "hero_bg_mobile", "label": "Hero background (mobile)" },
    { "type": "image_picker", "id": "product_image",  "label": "Product bottle (compare + sticky)" },
    { "type": "text",     "id": "hero_eyebrow",  "label": "Eyebrow", "default": "MICRONIZED • PREMIUM GRADE" },
    { "type": "html",     "id": "hero_h1",       "label": "Heading (HTML allowed)", "default": "Pure Creatine.<br>Daily Strength Support." },
    { "type": "textarea", "id": "hero_subtitle",  "label": "Subtitle", "default": "1500mg of pure creatine monohydrate micronized for better absorption and maximum performance." },
    { "type": "html",     "id": "hero_stat1",    "label": "Stat 1", "default": "Boosts<br>Strength" },
    { "type": "html",     "id": "hero_stat2",    "label": "Stat 2", "default": "Builds Lean<br>Muscle" },
    { "type": "html",     "id": "hero_stat3",    "label": "Stat 3", "default": "Enhances<br>Performance" },
    { "type": "html",     "id": "hero_stat4",    "label": "Stat 4", "default": "Supports Daily<br>Recovery" },
    { "type": "text",     "id": "hero_foot",     "label": "Footer line", "default": "Unflavored  •  Clean Formula  •  Easy to Use Capsules" },
    { "type": "header", "content": "Buy card" },
    { "type": "text",     "id": "card_meta",     "label": "Meta line", "default": "180 Capsules  •  90 Servings" },
    { "type": "number",   "id": "servings_count", "label": "Servings per bottle (used to auto-calculate the per-serving price)", "info": "The per-serving price shown on the page is calculated automatically from the live product price ÷ this number — it always stays correct, even when the price changes.", "default": 90 },
    { "type": "text",     "id": "cta_text",      "label": "CTA button", "default": "ADD TO CART" },
    { "type": "text",     "id": "benefit1",      "label": "Benefit 1", "default": "Maximizes Strength" },
    { "type": "text",     "id": "benefit2",      "label": "Benefit 2", "default": "Clean & Pure Formula" },
    { "type": "text",     "id": "benefit3",      "label": "Benefit 3", "default": "Unflavored" },
    { "type": "text",     "id": "trust_secure",  "label": "Sticky trust badge", "default": "Secure Checkout" },
    { "type": "text",     "id": "acc1_label",    "label": "Accordion 1 label", "default": "Supports" },
    { "type": "text",     "id": "acc1_text1",    "label": "Accordion 1 line 1",  "default": "Daily strength and performance support" },
    { "type": "text",     "id": "acc1_text2",    "label": "Accordion 1 line 2",  "default": "Lean muscle and workout output support" },
    { "type": "text",     "id": "acc1_text3",    "label": "Accordion 1 line 3",  "default": "Daily recovery and training consistency" },
    { "type": "text",     "id": "acc2_label",    "label": "Accordion 2 label", "default": "Ingredients" },
    { "type": "text",     "id": "acc2_text1",    "label": "Accordion 2 line 1",  "default": "100% micronized creatine monohydrate" },
    { "type": "text",     "id": "acc2_text2",    "label": "Accordion 2 line 2",  "default": "1500mg per serving" },
    { "type": "text",     "id": "acc2_text3",    "label": "Accordion 2 line 3",  "default": "Unflavored capsules with no unnecessary extras" },
    { "type": "text",     "id": "acc3_label",    "label": "Accordion 3 label", "default": "Certifications" },
    { "type": "text",     "id": "acc3_text1",    "label": "Accordion 3 line 1",  "default": "Third-party tested" },
    { "type": "text",     "id": "acc3_text2",    "label": "Accordion 3 line 2",  "default": "GMP quality standards" },
    { "type": "text",     "id": "acc3_text3",    "label": "Accordion 3 line 3",  "default": "Clean formula, non-GMO, made in USA" },
    { "type": "header", "content": "Ingredient feature" },
    { "type": "text",     "id": "feature_kicker", "label": "Kicker", "default": "1 Powerful Ingredient" },
    { "type": "html",     "id": "feature_h2",      "label": "Heading", "default": "Creatine<br>Monohydrate" },
    { "type": "text",     "id": "feature_dose",    "label": "Dose line", "default": "1500mg per serving" },
    { "type": "text",     "id": "feature_micro_title", "label": "Micro box title", "default": "Micronized" },
    { "type": "text",     "id": "feature_micro_text",  "label": "Micro box text", "default": "Ultra-fine for superior absorption" },
    { "type": "header", "content": "Compare" },
    { "type": "html",     "id": "compare_ours_heading", "label": "Ours — heading", "default": "Our Clean<br>Creatine Formula" },
    { "type": "text",     "id": "compare_ours1", "label": "Ours 1", "default": "100% Creatine Monohydrate" },
    { "type": "text",     "id": "compare_ours2", "label": "Ours 2", "default": "Micronized for Better Absorption" },
    { "type": "text",     "id": "compare_ours3", "label": "Ours 3", "default": "No Fillers or Additives" },
    { "type": "text",     "id": "compare_ours4", "label": "Ours 4", "default": "Unflavored" },
