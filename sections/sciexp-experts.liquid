{% comment %}
  Scientific Experts — reusable, fully editable section (experts grid + research
  logos). Prefix .sciexp- (scoped resets), safe on any product/page/template.
  Every image, text, logo and background is editable via settings/blocks.
  Images: fixed-height photo frames + object-fit:cover with per-expert focal
  point (no layout/format bugs); research logos object-fit:contain.
{% endcomment %}

{{ 'sciexp-experts.css' | asset_url | stylesheet_tag }}

{%- assign experts = section.blocks | where: 'type', 'expert' -%}
{%- assign research = section.blocks | where: 'type', 'research_item' -%}
{% render 'sciexp-experts',
   heading: section.settings.heading,
   show_shield: section.settings.show_shield,
   research_heading: section.settings.research_heading,
   bg_color: section.settings.bg_color,
   accent_color: section.settings.accent_color,
   accent_color2: section.settings.accent_color2,
   experts: experts,
   research: research %}

{% schema %}
{
  "name": "Scientific Experts",
  "tag": "section",
  "class": "sciexp-section-wrap",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Our Scientific Experts – Backed by Research. Driven by Results." },
    { "type": "checkbox", "id": "show_shield", "label": "Show shield ornament", "default": true },
    { "type": "text", "id": "research_heading", "label": "Research row heading", "default": "Research & Publications" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#f6fbff" },
    { "type": "color", "id": "accent_color", "label": "Accent (banners, heading)", "default": "#082f56" },
    { "type": "color", "id": "accent_color2", "label": "Accent 2 (banner gradient)", "default": "#0a3357" },
    { "type": "paragraph", "content": "⚠️ Use only experts who have given written consent to appear. Institution / journal logos imply endorsement — use only with a genuine, documented affiliation." }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_file", "label": "…or photo asset filename", "info": "e.g. sciexp-patrice-cani.webp" },
        { "type": "range", "id": "focus_y", "label": "Photo vertical focus", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 35 },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role / title" },
        { "type": "text", "id": "institution", "label": "Institution" },
        { "type": "text", "id": "institution_sub", "label": "Institution location / sub" }
      ]
    },
    {
      "type": "research_item",
      "name": "Research logo / text",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "image_file", "label": "…or logo asset filename", "info": "e.g. sciexp-nih.webp" },
        { "type": "text", "id": "alt", "label": "Logo alt text" },
        { "type": "textarea", "id": "text", "label": "Text (used if no logo)", "info": "e.g. Published in Top-Tier Peer-Reviewed Journals" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scientific Experts",
      "blocks": [
        { "type": "expert", "settings": { "image_file": "sciexp-patrice-cani.webp", "focus_y": 41, "name": "Dr. Patrice D. Cani, PhD", "role": "Microbiologist, Metabolism Expert", "institution": "UCLouvain", "institution_sub": "Belgium" } },
        { "type": "expert", "settings": { "image_file": "sciexp-willem-de-vos.webp", "focus_y": 33, "name": "Dr. Willem M. de Vos, PhD", "role": "Microbiology & Gut Microbiome Pioneer", "institution": "Wageningen University & Research", "institution_sub": "Netherlands" } },
        { "type": "expert", "settings": { "image_file": "sciexp-audrey-everard.webp", "focus_y": 28, "name": "Dr. Audrey Everard, PhD", "role": "Physiology & Metabolic Health", "institution": "UCLouvain", "institution_sub": "Belgium" } },
        { "type": "expert", "settings": { "image_file": "sciexp-didier-maiter.webp", "focus_y": 33, "name": "Dr. Didier Maiter, MD, PhD", "role": "Endocrinology & Clinical Research", "institution": "Cliniques Universitaires Saint-Luc", "institution_sub": "Brussels, Belgium" } },
        { "type": "research_item", "settings": { "image_file": "sciexp-nih.webp", "alt": "National Institutes of Health" } },
        { "type": "research_item", "settings": { "image_file": "sciexp-pubmed.webp", "alt": "PubMed" } },
        { "type": "research_item", "settings": { "text": "Published in Top-Tier Peer-Reviewed Journals" } },
        { "type": "research_item", "settings": { "image_file": "sciexp-harvard.webp", "alt": "Harvard University" } },
        { "type": "research_item", "settings": { "image_file": "sciexp-stanford.webp", "alt": "Stanford University" } }
      ]
    }
  ]
}
{% endschema %}
