{% render 'panstellar-product-schema', product: product %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet">
{{ 'ual-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ual_variant = product.selected_or_first_available_variant
  assign ual_price = ual_variant.price | money
  assign ual_compare_price = ual_variant.compare_at_price | money

  assign has_hero_desktop = false
  if section.settings.hero_image_desktop != blank
    assign has_hero_desktop = true
  endif
  assign has_hero_mobile = false
  if section.settings.hero_image_mobile != blank
    assign has_hero_mobile = true
  endif
  assign has_product_img = false
  if section.settings.product_image != blank
    assign has_product_img = true
  endif

  assign ual_plan_15 = nil
  assign ual_plan_23 = nil
  assign ual_plan_31 = nil
  for group in product.selling_plan_groups
    for plan in group.selling_plans
      if plan.name contains '15%'
        assign ual_plan_15 = plan
      endif
      if plan.name contains '23%'
        assign ual_plan_23 = plan
      endif
      if plan.name contains '31%'
        assign ual_plan_31 = plan
      endif
    endfor
  endfor
-%}

<div class="ual-pdp" id="ual-pdp-{{ section.id }}">

  <!-- ══ HERO ══ -->
  <section class="ual-hero" id="ual-buy-{{ section.id }}">

    <picture class="ual-hero__bg-picture">
      {%- if has_hero_mobile -%}
        <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 800 }}">
      {%- else -%}
        <source media="(max-width: 767px)" srcset="{{ 'ual-hero-mobile.webp' | asset_url }}">
      {%- endif -%}
      {%- if has_hero_desktop -%}
        {{ section.settings.hero_image_desktop | image_url: width: 1920 | image_tag: class: 'ual-hero__bg', loading: 'eager', alt: '' }}
      {%- else -%}
        <img class="ual-hero__bg" src="{{ 'ual-hero-lifestyle.webp' | asset_url }}" alt="" loading="eager" width="1920" height="820">
      {%- endif -%}
    </picture>

    <div class="ual-pill">{{ section.settings.pill_text }} <span aria-hidden="true">•</span> Liposomal</div>

    <div class="ual-wrap ual-hero__grid">

      <div class="ual-hero__copy">
        <h1>{{ section.settings.hero_title }}</h1>
        <p>{{ section.settings.hero_subtitle }}</p>
        <div class="ual-hero__icons" aria-label="Points clés produit">
          <div><img src="{{ 'ual-icon-flask.png' | asset_url }}" alt="Third-party tested" width="34" height="34"><span>Third-Party<br>Tested</span></div>
          <div><img src="{{ 'ual-icon-factory.png' | asset_url }}" alt="cGMP Manufactured" width="34" height="34"><span>cGMP<br>Manufactured</span></div>
          <div><img src="{{ 'ual-icon-coa-document.png' | asset_url }}" alt="COA By Batch" width="34" height="34"><span>COA<br>By Batch</span></div>
          <div><img src="{{ 'ual-icon-leaf.png' | asset_url }}" alt="Non-GMO" width="34" height="34"><span>Non-GMO</span></div>
        </div>
      </div>

      <!-- BUY CARD -->
      <aside class="ual-buy-card">
        <h2>{{ section.settings.card_title }}</h2>

        {%- if product.variants.size > 1 -%}
          <div class="ual-variant-select">
            <select id="ual-variant-{{ section.id }}" aria-label="Variante">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  data-available="{{ variant.available }}"
                  {%- if variant == ual_variant %} selected{%- endif -%}>
                  {{ variant.title }}{%- unless variant.available %} — Épuisé{%- endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <!-- One-time -->
        <div class="ual-choice" id="ual-choice-once-{{ section.id }}" role="button" tabindex="0" aria-label="Achat unique">
          <div class="ual-choice__head">
            <span class="ual-radio" aria-hidden="true"></span>
            <div>
              <div class="ual-choice__title">{{ section.settings.onetime_label }}</div>
              <div class="ual-choice__price"><span id="ual-price-{{ section.id }}">{{ ual_price }}</span></div>
            </div>
          </div>
        </div>

        <!-- Subscribe -->
        <div class="ual-choice ual-choice--active" id="ual-choice-sub-{{ section.id }}" role="button" tabindex="0" aria-label="Abonnement">
          <div class="ual-choice__head">
            <span class="ual-radio" aria-hidden="true"></span>
            <div>
              <div class="ual-choice__title">{{ section.settings.sub_label }}</div>
              <div class="ual-choice__ship">{{ section.settings.sub_period }}</div>
              <div class="ual-choice__price">{{ section.settings.sub_price }} <small>/ {{ section.settings.sub_unit }}</small></div>
            </div>
          </div>
        </div>

        <!-- Benefits -->
        <div class="ual-benefit-grid">
          <div class="ual-benefit"><img src="{{ 'ual-icon-medal.png' | asset_url }}" alt="45 servings" width="15" height="15"><span>{{ section.settings.benefit_1 }}</span></div>
          <div class="ual-benefit"><img src="{{ 'ual-icon-molecule.png' | asset_url }}" alt="Single active" width="15" height="15"><span>{{ section.settings.benefit_2 }}</span></div>
          <div class="ual-benefit"><img src="{{ 'ual-icon-liposomal.png' | asset_url }}" alt="Liposomal" width="15" height="15"><span>{{ section.settings.benefit_3 }}</span></div>
          <div class="ual-benefit"><img src="{{ 'ual-icon-no-blend.png' | asset_url }}" alt="No blend" width="15" height="15"><span>{{ section.settings.benefit_4 }}</span></div>
          <div class="ual-benefit"><img src="{{ 'ual-icon-shield.png' | asset_url }}" alt="Guarantee" width="15" height="15"><span>{{ section.settings.benefit_5 }}</span></div>
        </div>

        {%- assign ual_form_id = 'ual-form-' | append: section.id -%}{% form 'product', product, id: ual_form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ ual_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {%- if ual_plan_15 -%}
            <input type="hidden" name="selling_plan" id="ual-hero-sp-{{ section.id }}" value="{{ ual_plan_15.id }}">
          {%- endif -%}
          <button type="submit" name="add" class="ual-cta" id="ual-cta-{{ section.id }}"
            {%- unless ual_variant.available %} disabled{%- endunless -%}>
            {%- if ual_variant.available -%}SUBSCRIBE &amp; SAVE{%- else -%}Sold Out{%- endif -%}
          </button>
        {%- endform -%}

        <div class="ual-shipping">
          <img src="{{ 'ual-icon-truck.png' | asset_url }}" alt="Livraison" width="20" height="20">
          {{ section.settings.shipping_text }}
        </div>

        <!-- Visual accordions -->
        <div class="ual-accordion">

          <!-- Supports -->
          <div class="ual-acc-row">
            <button class="ual-acc-btn" type="button" aria-expanded="false">
              <span class="ual-acc-label">
                <img src="{{ 'ual-acc-support-leaf.webp' | asset_url }}" alt="" width="31" height="31">
                Supports
              </span>
              <span class="ual-acc-note">Designed to support.</span>
              <span class="ual-acc-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="ual-acc-panel">
              <div class="ual-support-grid">
                <div class="ual-support-card"><img src="{{ 'ual-acc-support-cellular.webp' | asset_url }}" alt="" width="34" height="34"><span>Cellular energy</span></div>
                <div class="ual-support-card"><img src="{{ 'ual-acc-support-mito.png' | asset_url }}" alt="" width="34" height="34"><span>Mitochondrial health</span></div>
                <div class="ual-support-card"><img src="{{ 'ual-acc-support-leaf.webp' | asset_url }}" alt="" width="34" height="34"><span>Healthy aging</span></div>
                <div class="ual-support-card"><img src="{{ 'ual-acc-support-coa.webp' | asset_url }}" alt="" width="34" height="34"><span>COA-verified</span></div>
              </div>
            </div>
          </div>

          <!-- Ingredients -->
          <div class="ual-acc-row">
            <button class="ual-acc-btn" type="button" aria-expanded="false">
              <span class="ual-acc-label">
                <img src="{{ 'ual-acc-title-flask.webp' | asset_url }}" alt="" width="31" height="31">
                Ingredients
              </span>
              <span class="ual-acc-note">Full list inside.</span>
              <span class="ual-acc-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="ual-acc-panel">
              <div class="ual-ing-acc-grid">
                <div class="ual-ing-acc-card"><img src="{{ 'ual-acc-ing-urolithin.webp' | asset_url }}" alt="" width="48" height="48"><span>Urolithin A</span></div>
                <div class="ual-ing-acc-card"><img src="{{ 'ual-acc-ing-liposomal.webp' | asset_url }}" alt="" width="48" height="48"><span>Liposomal</span></div>
                <div class="ual-ing-acc-card"><img src="{{ 'ual-acc-ing-pomegranate.webp' | asset_url }}" alt="" width="48" height="48"><span>Derived from<br>pomegranate</span></div>
                <div class="ual-ing-acc-card"><img src="{{ 'ual-acc-ing-2000.webp' | asset_url }}" alt="" width="48" height="48"><span>2000 mg</span></div>
                <div class="ual-ing-acc-card"><img src="{{ 'ual-acc-ing-capsule.webp' | asset_url }}" alt="" width="48" height="48"><span>90 capsules</span></div>
                <div class="ual-ing-acc-card"><img src="{{ 'ual-acc-ing-45.png' | asset_url }}" alt="" width="48" height="48"><span>45 servings</span></div>
              </div>
            </div>
          </div>

          <!-- Certificates -->
          <div class="ual-acc-row">
            <button class="ual-acc-btn" type="button" aria-expanded="false">
              <span class="ual-acc-label">
                <img src="{{ 'ual-acc-title-shield.webp' | asset_url }}" alt="" width="31" height="31">
                Certificates
              </span>
              <span class="ual-acc-note">Verified quality. Total transparency.</span>
              <span class="ual-acc-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="ual-acc-panel">
              <div class="ual-cert-layout">
                <div class="ual-cert-icons">
                  <div><img src="{{ 'ual-acc-cert-thirdparty.png' | asset_url }}" alt="" width="26" height="26"><span>Third-Party Tested</span></div>
                  <div><img src="{{ 'ual-acc-cert-coa.png' | asset_url }}" alt="" width="26" height="26"><span>COA available by batch</span></div>
                  <div><img src="{{ 'ual-acc-cert-cgmp.png' | asset_url }}" alt="" width="26" height="26"><span>cGMP</span></div>
                  <div><img src="{{ 'ual-acc-cert-usa.webp' | asset_url }}" alt="" width="26" height="26"><span>USA</span></div>
                </div>
                <img class="ual-coa-paper" src="{{ 'ual-acc-cert-paper.webp' | asset_url }}" alt="Certificate of Analysis" loading="lazy">
              </div>
            </div>
          </div>

        </div><!-- /.ual-accordion -->
      </aside><!-- /.ual-buy-card -->

    </div><!-- /.ual-hero__grid -->
  </section><!-- /.ual-hero -->

  <!-- ══ ICON STRIP ══ -->
  <section class="ual-strip">
    <div class="ual-wrap">
      <div class="ual-strip__grid">
        <div class="ual-strip__item"><img src="{{ 'ual-icon-molecule.png' | asset_url }}" alt="Cellular energy" width="42" height="42"><b>Cellular energy<br>support</b></div>
        <div class="ual-strip__item"><img src="{{ 'ual-icon-liposomal.png' | asset_url }}" alt="Mitochondrial support" width="42" height="42"><b>Mitochondrial<br>health support</b></div>
        <div class="ual-strip__item"><img src="{{ 'ual-icon-leaf.png' | asset_url }}" alt="Healthy aging" width="42" height="42"><b>Healthy aging<br>support</b></div>
        <div class="ual-strip__item"><img src="{{ 'ual-icon-coa-document.png' | asset_url }}" alt="COA verified" width="42" height="42"><b>COA-verified<br>&amp; tested</b></div>
      </div>
      <div class="ual-strip__cta">
        Keep it clean. Choose single-active.
        <a href="#ual-buy-{{ section.id }}">Add to Cart →</a>
      </div>
    </div>
  </section>

  <!-- ══ VS COMPARISON ══ -->
  <section class="ual-compare" aria-label="Comparaison produits">
    <div class="ual-compare__side ual-compare__side--left">
      {%- if has_product_img -%}
        {{ section.settings.product_image | image_url: width: 760 | image_tag: class: 'ual-compare__product', loading: 'lazy', alt: product.title }}
      {%- else -%}
        <img class="ual-compare__product" src="{{ 'ual-packshot.webp' | asset_url }}" alt="{{ product.title }}" loading="lazy" width="760" height="900">
      {%- endif -%}
      <h3>Panstellar Urolithin Liposomal</h3>
      <div class="ual-compare__list">
        <div><span class="ual-check" aria-hidden="true">✓</span>Single-Active (No Blend)</div>
        <div><span class="ual-check" aria-hidden="true">✓</span>Liposomal Delivery</div>
        <div><span class="ual-check" aria-hidden="true">✓</span>Clinically Dosed 2000mg</div>
        <div><span class="ual-check" aria-hidden="true">✓</span>COA Verified</div>
        <div><span class="ual-check" aria-hidden="true">✓</span>Third-Party Tested</div>
        <div><span class="ual-check" aria-hidden="true">✓</span>90-Day Guarantee</div>
      </div>
    </div>
    <div class="ual-vs-col" aria-hidden="true"><div class="ual-vs">VS</div></div>
    <div class="ual-compare__side">
      <img class="ual-compare__bottles" src="{{ 'ual-comparison-bottles.webp' | asset_url }}" alt="Typical supplement approach" loading="lazy" width="920" height="600">
      <h3>Typical Approach</h3>
      <div class="ual-compare__list">
        <div><span class="ual-cross" aria-hidden="true">×</span>Multi-Ingredient Blends</div>
        <div><span class="ual-cross" aria-hidden="true">×</span>No Liposomal Delivery</div>
        <div><span class="ual-cross" aria-hidden="true">×</span>Underdosed</div>
        <div><span class="ual-cross" aria-hidden="true">×</span>COA Varies</div>
        <div><span class="ual-cross" aria-hidden="true">×</span>Testing Often Missing</div>
        <div><span class="ual-cross" aria-hidden="true">×</span>No Guarantee</div>
      </div>
    </div>
  </section>

  <!-- ══ INGREDIENTS ══ -->
  <section class="ual-ingredients">
    <div class="ual-wrap ual-ing-grid">
      <div class="ual-ing-title"><h2>From Nature,<br>Backed by Science.</h2></div>
      <div class="ual-ing-scroll">
        <div class="ual-ing-card"><img src="{{ 'ual-ingredient-pomegranate.webp' | asset_url }}" alt="Pomegranate" loading="lazy" width="136" height="86"><b>Urolithin A<br>(2000mg)</b><small>Derived from<br>pomegranate</small></div>
        <div class="ual-ing-card"><img src="{{ 'ual-ingredient-phosphatidylcholine.webp' | asset_url }}" alt="Phosphatidylcholine" loading="lazy" width="136" height="86"><b>Phosphatidylcholine<br>(Liposomal Matrix)</b><small>Supports delivery</small></div>
        <div class="ual-ing-card"><img src="{{ 'ual-ingredient-sunflower.webp' | asset_url }}" alt="Sunflower lecithin" loading="lazy" width="136" height="86"><b>Sunflower Lecithin<br>(Helps encapsulation)</b><small>Plant-based carrier</small></div>
        <div class="ual-ing-card"><img src="{{ 'ual-ingredient-rice-flour.webp' | asset_url }}" alt="Rice flour" loading="lazy" width="136" height="86"><b>Rice Flour<br>(Filler)</b><small>Clean &amp; simple</small></div>
        <div class="ual-ing-card"><img src="{{ 'ual-ingredient-vegetable-capsule.webp' | asset_url }}" alt="Vegetable capsule" loading="lazy" width="136" height="86"><b>Vegetable Capsule<br>(Vegan)</b><small>Plant-based capsule</small></div>
      </div>
    </div>
  </section>

  <!-- ══ QUALITY ══ -->
  <section class="ual-quality">
    <div class="ual-wrap ual-quality-grid">
      <h2>Quality You<br>Can Trust.</h2>
      <div class="ual-quality-icons">
        <div class="ual-q-item"><img src="{{ 'ual-icon-coa-document.png' | asset_url }}" alt="COA" width="34" height="34"><div><b>COA by Batch</b><small>Transparency you can see</small></div></div>
        <div class="ual-q-item"><img src="{{ 'ual-icon-factory.png' | asset_url }}" alt="cGMP" width="34" height="34"><div><b>cGMP</b><small>Quality you can trust</small></div></div>
        <div class="ual-q-item"><img src="{{ 'ual-icon-flask.png' | asset_url }}" alt="Purity tested" width="34" height="34"><div><b>Purity Tested</b><small>Third-party verified</small></div></div>
        <div class="ual-q-item"><img src="{{ 'ual-icon-shield.png' | asset_url }}" alt="Made in USA" width="34" height="34"><div><b>Made in USA</b><small>With globally sourced ingredients</small></div></div>
      </div>
      <div class="ual-lab-card">
        <img src="{{ 'ual-lab-results.webp' | asset_url }}" alt="Lab results" loading="lazy" width="720" height="400">
        <div>
          <h3>Lab results.<br>Real data.</h3>
          {%- if section.settings.lab_url != blank -%}
            <a href="{{ section.settings.lab_url }}">View library →</a>
          {%- else -%}
            <span style="color:#e9c488;font-size:13px;font-weight:800;">View library →</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ SUBSCRIBE / PLANS ══ -->
  <section class="ual-subscribe" id="ual-plans-{{ section.id }}">
    <div class="ual-wrap ual-sub-grid">
      <div class="ual-sub-left">
        <h2>Commit. Save.<br>Skip Anytime.</h2>
        <ul class="ual-sub-list">
          <li>Subscribe &amp; save on every order</li>
          <li>Ships every 90 days</li>
          <li>Cancel or pause anytime</li>
          <li>COA access included</li>
        </ul>
      </div>

      <div class="ual-plans">
        <div class="ual-plan ual-plan--popular ual-plan--selected"
          data-plan-id="{{ ual_plan_15.id }}"
          role="button" tabindex="0" aria-pressed="true">
          <div class="ual-plan__tag">MOST POPULAR</div>
          <h3>3 Months</h3>
          <small>1 bottle • 2 refills</small>
          <div class="ual-plan__monthly">{{ section.settings.plan_3m_price }} / delivery</div>
          <div class="ual-plan__off">{{ section.settings.plan_3m_off }}</div>
        </div>
        <div class="ual-plan"
          data-plan-id="{{ ual_plan_23.id }}"
          role="button" tabindex="0" aria-pressed="false">
          <h3>6 Months</h3>
          <small>1 bottle • 5 refills</small>
          <div class="ual-plan__monthly">{{ section.settings.plan_6m_price }} / delivery</div>
          <div class="ual-plan__off">{{ section.settings.plan_6m_off }}</div>
        </div>
        <div class="ual-plan"
          data-plan-id="{{ ual_plan_31.id }}"
          role="button" tabindex="0" aria-pressed="false">
          <h3>12 Months</h3>
          <small>1 bottle • 11 refills</small>
          <div class="ual-plan__monthly">{{ section.settings.plan_12m_price }} / delivery</div>
          <div class="ual-plan__off">{{ section.settings.plan_12m_off }}</div>
        </div>
      </div>

      <div class="ual-lock">
        <h3>Lock your routine.</h3>
        {%- assign ual_sub_form_id = 'ual-sub-form-' | append: section.id -%}{% form 'product', product, id: ual_sub_form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ ual_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {%- if ual_plan_15 -%}
            <input type="hidden" name="selling_plan" id="ual-selling-plan-{{ section.id }}" value="{{ ual_plan_15.id }}">
          {%- endif -%}
          <button type="submit" name="add" class="ual-cta" id="ual-sub-btn-{{ section.id }}"
            {%- unless ual_variant.available %} disabled{%- endunless -%}>
            {%- if ual_variant.available -%}SUBSCRIBE — 3 MONTHS (SAVE 15%){%- else -%}Sold Out{%- endif -%}
          </button>
        {%- endform -%}
        <small>Cancel or skip anytime</small>
      </div>
    </div>

    <div class="ual-wrap ual-bottom-row">
      <div class="ual-guarantee">
        <div class="ual-seal">90</div>
        <div>
          <h3>90 Days. No Risk.</h3>
          <p>Not a fit? Full refund.</p>
          {%- if section.settings.guarantee_url != blank -%}
            <p><a href="{{ section.settings.guarantee_url }}" style="color:var(--gold);">View guarantee details →</a></p>
          {%- else -%}
            <p style="text-decoration:underline;cursor:default;">View guarantee details →</p>
          {%- endif -%}
        </div>
      </div>

      <div class="ual-reviews">
        <div class="ual-review"><div class="ual-stars">★★★★★</div><b>"Clean labels. No fillers. Exactly why I switched."</b><br><small>— Verified reviewer</small></div>
        <div class="ual-review"><div class="ual-stars">★★★★★</div><b>"COA transparency is a huge plus for me."</b><br><small>— Review from website</small></div>
        <div class="ual-review"><div class="ual-stars">★★★★★</div><b>"Finally a single-active I can trust."</b><br><small>— All our guarantees</small></div>
      </div>

      <div class="ual-faq-mini" aria-label="FAQ rapide">
        <div class="ual-faq-mini__item">
          <button class="ual-faq-mini__btn" type="button" aria-expanded="false">
            Why single-active? <span class="ual-faq-mini__chevron" aria-hidden="true">⌄</span>
          </button>
          <div class="ual-faq-mini__panel">
            Most Urolithin A products blend multiple compounds, which dilutes each individual dose and makes it harder to know what's actually working. Single-active means 100% of the dose is Urolithin A — nothing competing, nothing diluted.
          </div>
        </div>
        <div class="ual-faq-mini__item">
          <button class="ual-faq-mini__btn" type="button" aria-expanded="false">
            Is it pure? <span class="ual-faq-mini__chevron" aria-hidden="true">⌄</span>
          </button>
          <div class="ual-faq-mini__panel">
            Yes. Each batch is COA-verified by an independent third-party lab. Beyond Urolithin A, the only other ingredients are rice flour (filler), phosphatidylcholine (liposomal matrix), sunflower lecithin, and a vegetable capsule.
          </div>
        </div>
        <div class="ual-faq-mini__item">
          <button class="ual-faq-mini__btn" type="button" aria-expanded="false">
            Is it tested? <span class="ual-faq-mini__chevron" aria-hidden="true">⌄</span>
          </button>
          <div class="ual-faq-mini__panel">
            Every batch is sent to a third-party laboratory and tested for purity, potency, and contaminants. Certificates of Analysis are available by batch on request.
          </div>
        </div>
        <div class="ual-faq-mini__item">
          <button class="ual-faq-mini__btn" type="button" aria-expanded="false">
            What is the guarantee? <span class="ual-faq-mini__chevron" aria-hidden="true">⌄</span>
          </button>
          <div class="ual-faq-mini__panel">
            We offer a 90-day money-back guarantee. If you're not satisfied for any reason within 90 days of purchase, contact us for a full refund — no questions asked.
          </div>
        </div>
      </div>
    </div>
  </section>

</div><!-- /.ual-pdp -->

<!-- STICKY ATC -->
<div class="ual-sticky" id="ual-sticky-{{ section.id }}" aria-label="Achat rapide">
  <div class="ual-wrap ual-sticky__inner">
    <div class="ual-sticky__info">
      <span class="ual-sticky__name">{{ product.title }}</span>
      <span class="ual-sticky__price" id="ual-sticky-price-{{ section.id }}">{{ ual_price }}</span>
    </div>
    {%- assign ual_sticky_form_id = 'ual-sticky-form-' | append: section.id -%}{% form 'product', product, id: ual_sticky_form_id, novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ ual_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" name="add" class="ual-sticky__btn" id="ual-sticky-btn-{{ section.id }}"
        {%- unless ual_variant.available %} disabled{%- endunless -%}>
        {%- if ual_variant.available -%}{{ section.settings.cta_text }}{%- else -%}Sold Out{%- endif -%}
      </button>
    {%- endform -%}
  </div>
</div>

<script>
(function(){
  var pdp = document.getElementById('ual-pdp-{{ section.id }}');
  if(!pdp) return;

  /* ── AJAX Add to Cart ─────────────────────────────────────────────── */
  function ualAddToCart(formEl, btn) {
    if(!btn || btn.dataset.loading) return;
    btn.dataset.loading = '1';
    var origText = btn.textContent;
    btn.textContent = 'Adding…';

    var fd = new FormData(formEl);
    fd.append('sections', 'cart-drawer,cart-icon-bubble');
    fd.append('sections_url', window.location.pathname);

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: fd
    })
    .then(function(res) {
      if(!res.ok) return res.json().then(function(d){ throw d; });
      return res.json();
    })
    .then(function(response) {
      if (btn) { btn.dataset.added = '1'; }
        var drawer = document.querySelector('cart-drawer');
      if(drawer && typeof drawer.renderContents === 'function') {
        drawer.renderContents(response);
      } else {
        window.location.href = '/cart';
      }
    })
    .catch(function(err) {
      var msg = (err && err.description) ? err.description : 'Could not add to cart. Please try again.';
      alert(msg);
    })
    .finally(function() {
      delete btn.dataset.loading;
      if (btn.dataset.added) { delete btn.dataset.added; btn.textContent = '\u2713 Added'; setTimeout(function(){ btn.textContent = origText; }, 1600); } else { btn.textContent = origText; }
    });
  }

  ['ual-form-{{ section.id }}','ual-sub-form-{{ section.id }}','ual-sticky-form-{{ section.id }}'].forEach(function(fid){
    var f = document.getElementById(fid);
    if(!f) return;
    f.addEventListener('submit', function(e){
      e.preventDefault();
      ualAddToCart(f, f.querySelector('[name="add"]'));
    });
  });

  /* ── Buy card accordion ───────────────────────────────────────────── */
  pdp.querySelectorAll('.ual-acc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var row = this.closest('.ual-acc-row');
      var isOpen = row.classList.toggle('open');
      this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  /* ── One-time vs Subscribe toggle ────────────────────────────────── */
  var choiceOnce  = pdp.querySelector('#ual-choice-once-{{ section.id }}');
  var choiceSub   = pdp.querySelector('#ual-choice-sub-{{ section.id }}');
  var heroSpInput = document.getElementById('ual-hero-sp-{{ section.id }}');
  var ctaBtn      = document.getElementById('ual-cta-{{ section.id }}');
  var ctaText     = {{ section.settings.cta_text | json }};

  function selectChoice(selected, other) {
    selected.classList.add('ual-choice--active');
    other.classList.remove('ual-choice--active');
  }

  if(choiceOnce && choiceSub){
    choiceOnce.addEventListener('click', function(){
      selectChoice(choiceOnce, choiceSub);
      if(heroSpInput) heroSpInput.disabled = true;
      if(ctaBtn && !ctaBtn.disabled) ctaBtn.textContent = ctaText;
    });
    choiceSub.addEventListener('click', function(){
      selectChoice(choiceSub, choiceOnce);
      if(heroSpInput) heroSpInput.disabled = false;
      if(ctaBtn && !ctaBtn.disabled) ctaBtn.textContent = 'SUBSCRIBE & SAVE';
    });
  }

  /* ── Variant selector ────────────────────────────────────────────── */
  var variantSel = document.getElementById('ual-variant-{{ section.id }}');
  if(variantSel){
    variantSel.addEventListener('change', function(){
      var opt = this.options[this.selectedIndex];
      var vid = this.value;
      var price = opt.dataset.price;
      var available = opt.dataset.available === 'true';

      ['ual-form-{{ section.id }}','ual-sub-form-{{ section.id }}','ual-sticky-form-{{ section.id }}'].forEach(function(fid){
        var f = document.getElementById(fid);
        if(f){ var inp = f.querySelector('[name="id"]'); if(inp) inp.value = vid; }
      });

      var priceEl = document.getElementById('ual-price-{{ section.id }}');
      var stickyPriceEl = document.getElementById('ual-sticky-price-{{ section.id }}');
      if(priceEl) priceEl.textContent = price;
      if(stickyPriceEl) stickyPriceEl.textContent = price;

      if(ctaBtn) {
        ctaBtn.disabled = !available;
        if(!available) ctaBtn.textContent = 'Sold Out';
        else ctaBtn.textContent = (choiceSub && choiceSub.classList.contains('ual-choice--active')) ? 'SUBSCRIBE & SAVE' : ctaText;
      }
      var stickyBtn = document.getElementById('ual-sticky-btn-{{ section.id }}');
      if(stickyBtn){ stickyBtn.disabled = !available; stickyBtn.textContent = available ? ctaText : 'Sold Out'; }
      var subBtn = document.getElementById('ual-sub-btn-{{ section.id }}');
      if(subBtn){ subBtn.disabled = !available; }
    });
  }

  /* ── Subscription plan selector ──────────────────────────────────── */
  var planLabels = {
    '{{ ual_plan_15.id }}': '3 MONTHS (SAVE 15%)',
    '{{ ual_plan_23.id }}': '6 MONTHS (SAVE 23%)',
    '{{ ual_plan_31.id }}': '12 MONTHS (SAVE 31%)'
  };
  var planBtns = document.querySelectorAll('#ual-plans-{{ section.id }} .ual-plan[data-plan-id]');
  var sellingPlanInput = document.getElementById('ual-selling-plan-{{ section.id }}');
  var subBtn = document.getElementById('ual-sub-btn-{{ section.id }}');

  planBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      planBtns.forEach(function(b){ b.classList.remove('ual-plan--selected'); b.setAttribute('aria-pressed','false'); });
      this.classList.add('ual-plan--selected');
      this.setAttribute('aria-pressed','true');
      var pid = this.dataset.planId;
      if(sellingPlanInput) sellingPlanInput.value = pid;
      if(heroSpInput) heroSpInput.value = pid;
      var label = planLabels[pid] || '';
      if(subBtn && !subBtn.disabled) subBtn.textContent = 'SUBSCRIBE — ' + label;
    });
  });

  /* ── FAQ mini accordions ─────────────────────────────────────────── */
  document.querySelectorAll('.ual-faq-mini__btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = this.closest('.ual-faq-mini__item');
      var isOpen = item.classList.toggle('open');
      this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  /* ── Sticky ATC — show when hero buy card scrolls out of view ────── */
  var sentinel = document.getElementById('ual-buy-{{ section.id }}');
  var sticky   = document.getElementById('ual-sticky-{{ section.id }}');
  if(sentinel && sticky && 'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      sticky.classList.toggle('ual-sticky--visible', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(sentinel);
  }
})();
</script>

