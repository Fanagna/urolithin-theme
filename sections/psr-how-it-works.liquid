{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
<section class="psr psr-section psr-difference psr-difference--hybrid" id="how-it-works" style="background:{{ section.settings.background }}">
<div class="psr-shell">
  <div class="psr-difference-hybrid">
    <div class="psr-difference-copy">
      <p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span><span class="psr-kicker__rule"></span></p>
      <h2 class="psr-title">{{ section.settings.heading_before }} <em>{{ section.settings.heading_highlight }}</em></h2>
      <div class="rte psr-section-lead">{{ section.settings.body }}</div>
      <div class="psr-benefit-icons psr-benefit-icons--original">{% for block in section.blocks %}{% if block.type == 'benefit' %}<article {{ block.shopify_attributes }}><span>{% case forloop.index %}{% when 1 %}{% assign psr_benefit_fallback = 'psr-v10-icon-energy.svg' %}{% when 2 %}{% assign psr_benefit_fallback = 'psr-v10-icon-sparkle.svg' %}{% when 3 %}{% assign psr_benefit_fallback = 'psr-v10-icon-brain.svg' %}{% when 4 %}{% assign psr_benefit_fallback = 'psr-v10-icon-vitality.svg' %}{% else %}{% assign psr_benefit_fallback = 'psr-v10-icon-absorption.svg' %}{% endcase %}{% render 'psr-editable-icon', custom_image: block.settings.icon, fallback_asset: psr_benefit_fallback, class: 'psr-svg-icon', alt: '' %}</span><p>{{ block.settings.text }}</p></article>{% endif %}{% endfor %}</div>
    </div>
    <div class="psr-difference-visual">{% if section.settings.visual != blank %}{{ section.settings.visual | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.visual_alt }}{% else %}<img alt="{{ section.settings.visual_alt | escape }}" loading="lazy" src="{{ 'psr-v10-image-how-it-works-visual.webp' | asset_url }}">{% endif %}</div>
  </div>
  <div class="psr-quality-strip">{% for block in section.blocks %}{% if block.type == 'quality' %}<span {{ block.shopify_attributes }}>{% case forloop.index %}{% when 1 %}{% assign psr_quality_fallback = 'psr-v10-icon-atom.svg' %}{% when 2 %}{% assign psr_quality_fallback = 'psr-v10-icon-leaf.svg' %}{% when 3 %}{% assign psr_quality_fallback = 'psr-v10-icon-shield.svg' %}{% else %}{% assign psr_quality_fallback = 'psr-v10-icon-flag.svg' %}{% endcase %}{% render 'psr-editable-icon', custom_image: block.settings.icon, fallback_asset: psr_quality_fallback, class: 'psr-strip-icon', alt: '' %}<span>{{ block.settings.text }}</span></span>{% endif %}{% endfor %}</div>
</div>
</section>
{% schema %}
{
  "name": "PSR — How it works",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Advanced formula. Real results."
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading first part",
      "default": "Here’s What Makes"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted part",
      "default": "This Different"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Our 1600mg complex combines NMN and Trans-Resveratrol with liposomal technology for better absorption. NMN supports cellular energy, while Resveratrol supports natural healthy-aging processes.</p>"
    },
    {
      "type": "image_picker",
      "id": "visual",
      "label": "Right-side composite image"
    },
    {
      "type": "text",
      "id": "visual_alt",
      "label": "Visual alt text",
      "default": "Product bottle with ingredient callouts"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "radial-gradient(circle at 82% 40%,#ffe9dc 0,transparent 40%),#fffaf7"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sustained Energy"
        }
      ]
    },
    {
      "type": "quality",
      "name": "Quality item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Third-party tested"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PSR — How it works",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Sustained Energy" } },
        { "type": "benefit", "settings": { "text": "Glowing Skin" } },
        { "type": "benefit", "settings": { "text": "Mental Clarity" } },
        { "type": "benefit", "settings": { "text": "Daily Vitality" } },
        { "type": "benefit", "settings": { "text": "Better Absorption" } },
        { "type": "quality", "settings": { "text": "Science-backed ingredients" } },
        { "type": "quality", "settings": { "text": "Non-GMO & gluten free" } },
        { "type": "quality", "settings": { "text": "Third-party tested" } },
        { "type": "quality", "settings": { "text": "Made in USA · globally sourced" } }
      ]
    }
  ]
}
{% endschema %}
