{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
{% liquid assign psr_product = product %}{% if section.settings.product != blank %}{% assign psr_product = section.settings.product %}{% endif %}{% assign psr_variant = psr_product.selected_or_first_available_variant %}
<section class="psr psr-section psr-final" id="bundle-offer" data-psr-product data-product-handle="{{ psr_product.handle | escape }}" data-product-url="{{ psr_product.url }}" data-variant-id="{{ psr_variant.id }}" style="background:{{ section.settings.background }}"><div class="psr-shell psr-final__layout"><div class="psr-photo-frame psr-photo-frame--soft">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img alt="{{ section.settings.image_alt | escape }}" loading="lazy" src="{{ 'psr-v10-image-final-woman-product.webp' | asset_url }}">{% endif %}</div><div class="psr-final__content"><p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span><span class="psr-kicker__rule"></span></p><h2 class="psr-title">{{ section.settings.heading_before }} <em>{{ section.settings.heading_highlight }}</em> {{ section.settings.heading_after }}</h2><div class="psr-mini-benefits">{% for block in section.blocks %}{% if block.type == 'benefit' %}<span {{ block.shopify_attributes }}>{% case forloop.index %}{% when 1 %}{% assign psr_mini_fallback = 'psr-v10-icon-leaf.svg' %}{% when 2 %}{% assign psr_mini_fallback = 'psr-v10-icon-sun.svg' %}{% else %}{% assign psr_mini_fallback = 'psr-v10-icon-flower.svg' %}{% endcase %}{% render 'psr-editable-icon', custom_image: block.settings.icon, fallback_asset: psr_mini_fallback, class: 'psr-mini-icon', alt: '' %}<span>{{ block.settings.text }}</span></span>{% endif %}{% endfor %}</div><div aria-label="Choose a final bundle" class="psr-bundle-grid psr-bundle-grid--final" data-bundle-group="final" role="radiogroup">{% for block in section.blocks %}{% if block.type == 'bundle' %}<button aria-checked="{% if block.settings.selected %}true{% else %}false{% endif %}" class="psr-bundle{% if block.settings.selected %} is-selected{% endif %}" data-quantity="{{ block.settings.quantity }}" role="radio" type="button" {{ block.shopify_attributes }}>{% if block.settings.badge != blank %}<b>{{ block.settings.badge }}</b>{% endif %}<span class="psr-bundle__bottles">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'psr-bundle-photo' }}{% else %}{% capture psr_bundle_asset %}psr-v10-bundle-bundle-{{ block.settings.quantity }}.png{% endcapture %}<img class="psr-bundle-photo" src="{{ psr_bundle_asset | asset_url }}" alt="{{ block.settings.title | escape }}">{% endif %}</span><span class="psr-bundle__title">{{ block.settings.title }}</span><span>{{ block.settings.subtitle }}</span><strong>{{ block.settings.price }}</strong><small>{{ block.settings.price_note }}</small>{% if block.settings.save_text != blank %}<em>{{ block.settings.save_text }}</em>{% endif %}</button>{% endif %}{% endfor %}</div><button class="psr-btn psr-btn--primary psr-btn--wide" data-buy type="button">{% render 'psr-editable-icon', custom_image: section.settings.button_icon, fallback_asset: 'psr-v10-icon-cart.svg', class: 'psr-btn__icon', alt: '' %}<span class="psr-btn__label">{{ section.settings.button_label }}</span></button><div class="psr-guarantee"><span class="psr-guarantee__seal">{% render 'psr-editable-icon', custom_image: section.settings.guarantee_icon, fallback_asset: 'psr-v10-icon-shield.svg', class: 'psr-guarantee__shield', alt: '' %}<b>{{ section.settings.guarantee_days }}</b><small>{{ section.settings.guarantee_day_label }}</small></span><div><strong>{{ section.settings.guarantee_heading }}</strong><p>{{ section.settings.guarantee_text }}</p></div></div></div></div></section>
{% schema %}
{
  "name": "PSR — Final CTA",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Radiant woman beside product bottle"
    },
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Rooted in science. Made for you."
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading first part",
      "default": "Ready to feel more"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted part",
      "default": "energetic"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading last part",
      "info": "HTML allowed (e.g. <em>word</em> for a second highlighted word).",
      "default": "and look more <em>radiant</em> again?"
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "Button icon"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Bundle & Add to Cart"
    },
    {
      "type": "image_picker",
      "id": "guarantee_icon",
      "label": "Guarantee icon"
    },
    {
      "type": "text",
      "id": "guarantee_days",
      "label": "Guarantee days",
      "default": "90"
    },
    {
      "type": "text",
      "id": "guarantee_day_label",
      "label": "Day label",
      "default": "DAY"
    },
    {
      "type": "text",
      "id": "guarantee_heading",
      "label": "Guarantee heading",
      "default": "90-Day Money-Back Guarantee"
    },
    {
      "type": "textarea",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Try it with confidence. Your satisfaction is our promise."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fff8f4"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Mini benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sustained daily energy"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle option",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bundle photo"
        },
        {
          "id": "quantity",
          "label": "Quantity",
          "info": "Only 1, 3 and 6 have a matching bundle photo bundled with this package. Pick another value only if you also upload a custom bundle photo above.",
          "type": "select",
          "options": [
            { "value": "1", "label": "1 bottle" },
            { "value": "3", "label": "3 bottles" },
            { "value": "6", "label": "6 bottles" }
          ],
          "default": "3"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "3 Bottles"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "270-day supply"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$199"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Price note",
          "default": "bundle total"
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Savings text",
          "default": "Save $38"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Most Popular"
        },
        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "PSR — Final CTA",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Sustained daily energy" } },
        { "type": "benefit", "settings": { "text": "Brighter-looking skin" } },
        { "type": "benefit", "settings": { "text": "Healthy-aging support" } },
        { "type": "bundle", "settings": { "quantity": "1", "title": "1 Bottle", "subtitle": "90-day supply", "price": "$79", "price_note": "per bottle", "save_text": "", "badge": "", "selected": false } },
        { "type": "bundle", "settings": { "quantity": "3", "title": "3 Bottles", "subtitle": "270-day supply", "price": "$199", "price_note": "bundle total", "save_text": "Save $38", "badge": "Most Popular", "selected": true } },
        { "type": "bundle", "settings": { "quantity": "6", "title": "6 Bottles", "subtitle": "540-day supply", "price": "$349", "price_note": "bundle total", "save_text": "Save $125", "badge": "", "selected": false } }
      ]
    }
  ]
}
{% endschema %}
