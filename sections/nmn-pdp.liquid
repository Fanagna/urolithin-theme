<!-- ══════════════════════════════════
     REVIEWS
══════════════════════════════════ -->
{%- if review_blocks.size > 0 -%}
<section class="unm-reviews" id="unm-reviews-{{ section.id }}">
  <div class="unm-reviews__top">
    <div>
      <span class="unm-eyebrow">{{ section.settings.reviews_eyebrow }}</span>
      <h2>{{ section.settings.reviews_heading }}</h2>
      <div class="unm-rating">
        <span class="unm-stars">★★★★★</span>
        {{ section.settings.reviews_score }} &bull; {{ section.settings.reviews_count }}
      </div>
    </div>
    <div></div>
  </div>
  <div class="unm-review-row">
    <div></div><!-- spacer column desktop -->
    {%- for block in review_blocks -%}
      <div class="unm-review-card" {{ block.shopify_attributes }}>
        <span class="unm-stars">★★★★★</span>
        <blockquote>{{ block.settings.quote }}</blockquote>
        <cite>— {{ block.settings.author }}</cite>
      </div>
