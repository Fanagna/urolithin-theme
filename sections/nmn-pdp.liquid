    </div>
  </div>
</section>
{%- endif -%}


<!-- ══════════════════════════════════
     STICKY BAR
══════════════════════════════════ -->
<aside class="unm-sticky" id="unm-sticky-{{ section.id }}" aria-label="Quick add to cart">
  <div class="unm-sticky__img">
    {%- if has_packshot -%}
      {{ section.settings.hero_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}
    {%- else -%}
      <img src="{{ 'unm-packshot-2.png' | asset_url }}" alt="{{ product.title }}" loading="lazy" width="50" height="50">
    {%- endif -%}
  </div>
  <div class="unm-sticky__copy">
    <div class="unm-sticky__title">{{ section.settings.sticky_title }}</div>
    <div class="unm-sticky__sub">{{ section.settings.card_meta }}</div>
  </div>
  <div class="unm-sticky__sep"></div>
  <div>
    <div class="unm-sticky__price">{{ unm_price }}</div>
    <div class="unm-sticky__details">{{ section.settings.card_meta }}</div>
  </div>
  <div class="unm-sticky__trust">
    <span>🚚 Free shipping</span>
    <span>🛡 Secure checkout</span>
    <span>↩ 90-day guarantee</span>
  </div>
  {%- form 'product', product, id: 'unm-sticky-form-{{ section.id }}', novalidate: 'novalidate' -%}
    <input type="hidden" name="id" value="{{ unm_variant.id }}">
    <input type="hidden" name="quantity" value="1">
    <button type="submit" name="add" class="unm-sticky-cta">ADD TO CART</button>
  {%- endform -%}
</aside>

</div><!-- /.unm-pdp -->

<script>
(function(){
  var wrap = document.getElementById('unm-pdp-{{ section.id }}');
  if (!wrap) return;

  /* ── Accordions ── */
  wrap.querySelectorAll('.unm-acc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var open = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });

  /* ── FAQ ── */
  wrap.querySelectorAll('.unm-faq-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var open = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', open ? 'false' : 'true');
      var panel = this.nextElementSibling;
      if (panel) panel.style.display = open ? 'none' : 'block';
    });
  });

  /* ── Sticky visibility ── */
  var hero   = wrap.querySelector('.unm-hero');
  var sticky = document.getElementById('unm-sticky-{{ section.id }}');
  if (hero && sticky) {
    new IntersectionObserver(function(entries){
      sticky.classList.toggle('unm-sticky--visible', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(hero);
  }

  /* ── AJAX ATC (Dawn cart drawer) ── */
  function handleForm(form) {
    if (!form) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      btn.disabled = true;
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({
          id: form.querySelector('[name="id"]').value,
          quantity: 1,
          sections: ['cart-drawer', 'cart-icon-bubble'],
          sections_url: window.location.pathname
        })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.sections) {
          var drawer = document.getElementById('CartDrawer');
          if (drawer && data.sections['cart-drawer']) {
            var tmp = document.createElement('div');
            tmp.innerHTML = data.sections['cart-drawer'];
            var inner = tmp.querySelector('#CartDrawer');
            if (inner) drawer.innerHTML = inner.innerHTML;
          }
          var bubble = document.querySelector('.shopify-section-header-inline #cart-icon-bubble, #cart-icon-bubble');
          if (bubble && data.sections['cart-icon-bubble']) {
            var tmp2 = document.createElement('div');
            tmp2.innerHTML = data.sections['cart-icon-bubble'];
            var cnt = tmp2.querySelector('#cart-icon-bubble');
            if (cnt) bubble.innerHTML = cnt.innerHTML;
          }
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (typeof window.openCartDrawer === 'function') window.openCartDrawer();
        else {
          var toggle = document.querySelector('[data-cart-toggle], [aria-controls="CartDrawer"]');
          if (toggle) toggle.click();
        }
      })
      .catch(function(){ window.location = window.Shopify.routes.root + 'cart'; })
      .finally(function(){ btn.disabled = false; });
    });
  }

  handleForm(document.getElementById('unm-hero-form-{{ section.id }}'));
  handleForm(document.getElementById('unm-sticky-form-{{ section.id }}'));
})();
</script>

{% schema %}
{
  "name": "NMN + Resveratrol",
  "tag": "div",
  "class": "unm-pdp-wrapper",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_bg",       "label": "Background image (landscape)" },
    { "type": "image_picker", "id": "hero_image",    "label": "Product packshot" },
    { "type": "text",  "id": "hero_pill",     "label": "Pill label",    "default": "VERIFIED NMN · DAILY NAD+ SUPPORT" },
    { "type": "text",  "id": "hero_h1",       "label": "Heading (HTML allowed)", "default": "Real NMN.<br><em>Verified</em> Every Bottle." },
