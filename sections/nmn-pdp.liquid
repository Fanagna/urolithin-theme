{{ 'nmn-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign unm_variant = product.selected_or_first_available_variant
  assign unm_price   = unm_variant.price | money
  assign unm_compare = unm_variant.compare_at_price | money

  assign has_packshot = false
  if section.settings.hero_image != blank
    assign has_packshot = true
  endif

  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks    = section.blocks | where: 'type', 'faq_item'
-%}

<div class="unm-pdp" id="unm-pdp-{{ section.id }}">

<!-- ══════════════════════════════════
     HERO
══════════════════════════════════ -->
<section class="unm-hero" id="unm-hero-{{ section.id }}">

  {%- if has_packshot -%}
    {{ section.settings.hero_bg | image_url: width: 1920 | image_tag: class: 'unm-hero__bg', loading: 'eager', alt: '' }}
  {%- else -%}
    <img class="unm-hero__bg" src="{{ 'unm-hero-bg.png' | asset_url }}" alt="" loading="eager" width="1920" height="1080">
  {%- endif -%}

  <div class="unm-hero__grid">

    <!-- Left: copy -->
    <div class="unm-hero__copy">
      <div class="unm-pill">{{ section.settings.hero_pill }}</div>
      <h1>{{ section.settings.hero_h1 }}</h1>
      <p>{{ section.settings.hero_subtitle }}</p>

      <div class="unm-hero__icons">
        <div class="unm-icon-item">
          <img src="{{ 'unm-icon-molecule.png' | asset_url }}" alt="" width="48" height="48">
          <span>NAD+<br>Support</span>
        </div>
        <div class="unm-icon-item">
          <img src="{{ 'unm-icon-capsule.png' | asset_url }}" alt="" width="48" height="48">
          <span>Cell<br>Energy</span>
        </div>
        <div class="unm-icon-item">
          <img src="{{ 'unm-icon-bottle.png' | asset_url }}" alt="" width="48" height="48">
          <span>30<br>Capsules</span>
        </div>
        <div class="unm-icon-item">
          <img src="{{ 'unm-icon-shield.png' | asset_url }}" alt="" width="48" height="48">
          <span>3rd-Party<br>Tested</span>
        </div>
      </div>

      <div class="unm-hero__foot">{{ section.settings.hero_foot }}</div>
    </div>

    <!-- Centre: product bottle -->
    <div class="unm-hero__product">
      {%- if has_packshot -%}
        {{ section.settings.hero_image | image_url: width: 840 | image_tag: loading: 'eager', alt: product.title }}
      {%- else -%}
        <img src="{{ 'unm-packshot.png' | asset_url }}" alt="{{ product.title }}" loading="eager" width="420" height="560">
      {%- endif -%}
    </div>

    <!-- Right: buy card -->
    <div class="unm-buy-card">
      <div class="unm-card__name">{{ product.title }}</div>
      <div class="unm-card__price">
        {{ unm_price }}
        {%- if unm_variant.compare_at_price > unm_variant.price -%}
          <span class="unm-card__compare">{{ unm_compare }}</span>
        {%- endif -%}
      </div>
      <div class="unm-card__meta">{{ section.settings.card_meta }}</div>

      {%- form 'product', product, id: 'unm-hero-form-{{ section.id }}', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ unm_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="unm-cta" id="unm-cta-{{ section.id }}">{{ section.settings.cta_text }}</button>
      {%- endform -%}

      <div class="unm-trust">
        <div class="unm-trust-item">
          <img src="{{ 'unm-icon-truck.png' | asset_url }}" alt="" width="18" height="18">
          Free shipping
        </div>
        <div class="unm-trust-item">
          <img src="{{ 'unm-icon-medal.png' | asset_url }}" alt="" width="18" height="18">
          90-day guarantee
        </div>
        <div class="unm-trust-item">
          <img src="{{ 'unm-icon-lock.png' | asset_url }}" alt="" width="18" height="18">
          Secure checkout
        </div>
      </div>

      <div class="unm-accordion">
        <div class="unm-acc-row">
          <button class="unm-acc-btn" type="button" aria-expanded="false">
            <span class="unm-acc-label">
              <img src="{{ 'unm-icon-heart.png' | asset_url }}" alt="" width="26" height="26">
              Supports
            </span>
            <span class="unm-acc-chevron">⌄</span>
          </button>
          <div class="unm-acc-panel">
            <div class="unm-support-grid">
              <div class="unm-support-card">
                <img src="{{ 'unm-icon-molecule.png' | asset_url }}" alt="" width="30" height="30">
                <span>Cellular NAD+</span>
              </div>
              <div class="unm-support-card">
                <img src="{{ 'unm-icon-heart.png' | asset_url }}" alt="" width="30" height="30">
                <span>Healthy aging</span>
              </div>
              <div class="unm-support-card">
                <img src="{{ 'unm-icon-capsule.png' | asset_url }}" alt="" width="30" height="30">
                <span>Daily energy</span>
              </div>
            </div>
          </div>
        </div>

        <div class="unm-acc-row">
          <button class="unm-acc-btn" type="button" aria-expanded="false">
            <span class="unm-acc-label">
              <img src="{{ 'unm-icon-molecule.png' | asset_url }}" alt="" width="26" height="26">
              Ingredients
            </span>
            <span class="unm-acc-note">Full formula</span>
            <span class="unm-acc-chevron">⌄</span>
          </button>
          <div class="unm-acc-panel">
            <div class="unm-ing-panel">
              <div class="unm-ing-tile"><img src="{{ 'unm-ing-nmn.png' | asset_url }}" alt="NMN"><span>NMN 500mg</span></div>
              <div class="unm-ing-tile"><img src="{{ 'unm-ing-resveratrol.png' | asset_url }}" alt="Resveratrol"><span>Resveratrol 300mg</span></div>
              <div class="unm-ing-tile"><img src="{{ 'unm-ing-quercetin.png' | asset_url }}" alt="Quercetin"><span>Quercetin 200mg</span></div>
              <div class="unm-ing-tile"><img src="{{ 'unm-ing-bioperine.png' | asset_url }}" alt="BioPerine"><span>BioPerine® 10mg</span></div>
              <div class="unm-ing-tile"><img src="{{ 'unm-ing-lecithin.png' | asset_url }}" alt="Lecithin"><span>Lecithin 300mg</span></div>
              <div class="unm-ing-tile"><img src="{{ 'unm-ing-vitaminc.png' | asset_url }}" alt="Vitamin C"><span>Vitamin C 100mg</span></div>
            </div>
          </div>
        </div>

        <div class="unm-acc-row">
          <button class="unm-acc-btn" type="button" aria-expanded="false">
            <span class="unm-acc-label">
              <img src="{{ 'unm-icon-cert.png' | asset_url }}" alt="" width="26" height="26">
              Certifications
            </span>
            <span class="unm-acc-note">Full transparency</span>
            <span class="unm-acc-chevron">⌄</span>
          </button>
          <div class="unm-acc-panel">
            <div class="unm-cert-grid">
              <div class="unm-cert-card"><img src="{{ 'unm-icon-cert.png' | asset_url }}" alt="" width="38" height="38"><span>COA by Batch</span></div>
              <div class="unm-cert-card"><img src="{{ 'unm-icon-flask.png' | asset_url }}" alt="" width="38" height="38"><span>cGMP Facility</span></div>
              <div class="unm-cert-card"><img src="{{ 'unm-icon-medal.png' | asset_url }}" alt="" width="38" height="38"><span>3rd-Party Tested</span></div>
              <div class="unm-cert-card"><img src="{{ 'unm-icon-shield.png' | asset_url }}" alt="" width="38" height="38"><span>Made in USA</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>


<!-- ══════════════════════════════════
     INGREDIENT CARDS
══════════════════════════════════ -->
