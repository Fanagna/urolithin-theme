{{ 'section-pnf-nmn.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ugc_blocks = section.blocks | where: 'type', 'ugc_video'
  assign has_ugc_content = false
  for block in ugc_blocks
    if block.settings.video != blank or block.settings.external_video_url != blank
      assign has_ugc_content = true
    endif
  endfor
-%}

<section class="pnf" id="pnf-nmn-ugc-{{ section.id }}">
  {%- if has_ugc_content -%}
    <div class="pnf__section pnf__ugc">
      <div class="pnf__container">
        <p class="pnf__eyebrow">{{ section.settings.ugc_eyebrow }}</p>
        <h2 class="pnf__title">{{ section.settings.ugc_heading }}</h2>
        {%- if section.settings.ugc_subheading != blank -%}<p class="pnf__subcopy">{{ section.settings.ugc_subheading }}</p>{%- endif -%}
        <div class="pnf__ugc-grid">
          {%- for block in ugc_blocks -%}
            {%- if block.settings.video != blank or block.settings.external_video_url != blank -%}
              <article class="pnf__ugc-card" {{ block.shopify_attributes }}>
                <div class="pnf__ugc-media">
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '900x', class: 'pnf__ugc-video' }}
                  {%- else -%}
                    <a class="pnf__ugc-link" href="{{ block.settings.external_video_url }}" target="_blank" rel="noopener">
                      {%- if block.settings.cover_image != blank -%}
                        <img src="{{ block.settings.cover_image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="1200">
                      {%- endif -%}
                      <span class="pnf__play" aria-hidden="true">Play</span>
                    </a>
                  {%- endif -%}
                </div>
                {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
                {%- if block.settings.caption != blank -%}<p>{{ block.settings.caption }}</p>{%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "PNF NMN UGC videos",
  "tag": "section",
  "class": "shopify-section--pnf-nmn-ugc",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "ugc_eyebrow", "label": "UGC eyebrow", "default": "CUSTOMER VIDEOS" },
    { "type": "text", "id": "ugc_heading", "label": "UGC heading", "default": "See the Routine in Real Life." },
    { "type": "textarea", "id": "ugc_subheading", "label": "UGC subheading", "default": "Add customer video clips, unboxings or short usage moments directly from the theme editor." }
  ],
  "blocks": [
    { "type": "ugc_video", "name": "UGC video", "settings": [
      { "type": "video", "id": "video", "label": "Shopify-hosted video" },
      { "type": "video_url", "id": "external_video_url", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"] },
      { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Why I chose a" },
      { "type": "textarea", "id": "caption", "label": "Caption", "default": "complete NMN formula" }
    ] }
  ],
  "presets": [
    { "name": "PNF NMN UGC videos" }
  ]
}
{% endschema %}
