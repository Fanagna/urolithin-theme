    { "type": "text", "id": "plan_6m_off",    "label": "6 mois — remise",    "default": "23% OFF" },
    { "type": "text", "id": "plan_12m_price", "label": "12 mois — prix/mois","default": "$95.91" },
    { "type": "text", "id": "plan_12m_off",   "label": "12 mois — remise",   "default": "31% OFF" },
    { "type": "header", "content": "Liens" },
    { "type": "url", "id": "lab_url",       "label": "Lien résultats labo" },
