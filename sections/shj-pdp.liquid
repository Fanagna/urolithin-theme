{{ 'shj-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shj_variant = product.selected_or_first_available_variant
  assign shj_price   = shj_variant.price | money
  assign shj_compare = shj_variant.compare_at_price | money

  # Per-day price, auto-calculated from the live product price so it never goes
  # stale when the price changes. supply_days is a merchant-editable fact about
  # the product (not a price), defaults to 90 (3 months supply).
  assign shj_supply_days = section.settings.supply_days | default: 90
  assign shj_day_price = shj_variant.price | times: 1.0 | divided_by: shj_supply_days | money | append: '/day'

  assign shj_hero_desktop = 'shj-hero-desktop.webp' | asset_url
  assign shj_hero_mobile  = 'shj-hero-mobile.webp'  | asset_url
  if section.settings.hero_bg != blank
    assign shj_hero_desktop = section.settings.hero_bg | image_url: width: 1920
  endif
  if section.settings.hero_bg_mobile != blank
    assign shj_hero_mobile = section.settings.hero_bg_mobile | image_url: width: 900
  endif

  assign shj_bottle = 'shj-jar.webp' | asset_url
  if section.settings.product_image != blank
    assign shj_bottle = section.settings.product_image | image_url: width: 600
  endif

  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks    = section.blocks | where: 'type', 'faq_item'

  assign shj_hero_form_id   = 'shj-hero-form-'   | append: section.id
  assign shj_sticky_form_id = 'shj-sticky-form-' | append: section.id
-%}

{% render 'panstellar-product-schema', product: product %}
<style>
  #shj-pdp-{{ section.id }}{
    --shj-hero-img: url('{{ shj_hero_desktop }}');
    --shj-hero-img-m: url('{{ shj_hero_mobile }}');
  }
</style>

<div class="shj-pdp shj-page" id="shj-pdp-{{ section.id }}">

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="shj-section shj-hero">
    <div class="shj-hero-grid">
      <div class="shj-hero-copy">
        <div class="shj-eyebrow">{{ section.settings.hero_eyebrow }}</div>
        <h1 class="shj-hero-title">{{ section.settings.hero_h1 }}</h1>
        <p>{{ section.settings.hero_subtitle }}</p>
        <div class="shj-hero-icons">
          <div class="shj-hero-icon"><div class="shj-icon-circle"><img src="{{ 'shj-icon-molecule.png' | asset_url }}" alt="Serving strength" width="30" height="30"></div>{{ section.settings.hero_stat1 }}</div>
          <div class="shj-hero-icon"><div class="shj-icon-circle"><img src="{{ 'shj-icon-capsule.png' | asset_url }}" alt="Gummies" width="30" height="30"></div>{{ section.settings.hero_stat2 }}</div>
          <div class="shj-hero-icon"><div class="shj-icon-circle"><img src="{{ 'shj-icon-shield-check.png' | asset_url }}" alt="No added sugars" width="30" height="30"></div>{{ section.settings.hero_stat3 }}</div>
          <div class="shj-hero-icon"><div class="shj-icon-circle"><img src="{{ 'shj-icon-certificatev.png' | asset_url }}" alt="Supply" width="30" height="30"></div>{{ section.settings.hero_stat4 }}</div>
        </div>
        <div class="shj-hero-meta">{{ section.settings.hero_foot }}</div>
      </div>

      <aside class="shj-buy-card" id="shj-buy-card-{{ section.id }}">
        <div class="shj-price">
          {{ shj_price }}
          {%- if shj_variant.compare_at_price > shj_variant.price -%}
            <span style="font-size:24px;color:#b3a89c;text-decoration:line-through;font-weight:600;margin-left:8px">{{ shj_compare }}</span>
          {%- endif -%}
        </div>
        <div class="shj-meta">{{ section.settings.card_meta }}</div>
        <div class="shj-day">{{ shj_day_price }}</div>

        {%- form 'product', product, id: shj_hero_form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ shj_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" name="add" class="shj-cta">{{ section.settings.cta_text }}</button>
        {%- endform -%}

        <div class="shj-trust-list">
          <div><img src="{{ 'shj-icon-truck.png' | asset_url }}" alt="" width="20" height="20">{{ section.settings.trust1 }}</div>
          <div><img src="{{ 'shj-icon-shield-lock.png' | asset_url }}" alt="" width="20" height="20">{{ section.settings.trust2 }}</div>
          <div><img src="{{ 'shj-icon-shield-check.png' | asset_url }}" alt="" width="20" height="20">{{ section.settings.trust3 }}</div>
        </div>

        <div class="shj-accordion">
          <div class="shj-acc">
            <button class="shj-acc-btn" type="button">{{ section.settings.acc1_label }} <span>⌄</span></button>
            <div class="shj-acc-panel"><p>{{ section.settings.acc1_text }}</p></div>
          </div>
          <div class="shj-acc">
            <button class="shj-acc-btn" type="button">{{ section.settings.acc2_label }} <span>⌄</span></button>
            <div class="shj-acc-panel"><p>{{ section.settings.acc2_text }}</p></div>
          </div>
          <div class="shj-acc">
            <button class="shj-acc-btn" type="button">{{ section.settings.acc3_label }} <span>⌄</span></button>
            <div class="shj-acc-panel"><p>{{ section.settings.acc3_text }}</p></div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ══════════════════════════════ INGREDIENTS ══════════════════════════════ -->
  <section class="shj-section shj-ingredients">
    <div class="shj-ingredient-layout">
      <div class="shj-block-title">
        <h2 class="shj-ingredients-title">{{ section.settings.ing_heading }}</h2>
        <p>{{ section.settings.ing_sub }}</p>
      </div>
      <div class="shj-ingredient-grid">
        <article class="shj-ingredient-card"><div class="shj-thumb"><img src="{{ 'shj-ing-shilajit.webp' | asset_url }}" alt="Shilajit Extract" loading="lazy"></div><h3>Shilajit<br>Extract</h3><div class="shj-dose">core mineral</div><div class="shj-desc">daily vitality support</div></article>
        <article class="shj-ingredient-card"><div class="shj-thumb"><img src="{{ 'shj-ing-seamoss.webp' | asset_url }}" alt="Sea Moss" loading="lazy"></div><h3>Sea<br>Moss</h3><div class="shj-dose">botanical</div><div class="shj-desc">daily wellness support</div></article>
        <article class="shj-ingredient-card"><div class="shj-thumb"><img src="{{ 'shj-ing-burdock.webp' | asset_url }}" alt="Burdock Root" loading="lazy"></div><h3>Burdock<br>Root</h3><div class="shj-dose">root extract</div><div class="shj-desc">traditional plant support</div></article>
        <article class="shj-ingredient-card"><div class="shj-thumb"><img src="{{ 'shj-ing-lionsmane.webp' | asset_url }}" alt="Lion's Mane" loading="lazy"></div><h3>Lion&rsquo;s<br>Mane</h3><div class="shj-dose">mushroom</div><div class="shj-desc">focus-friendly support</div></article>
        <article class="shj-ingredient-card"><div class="shj-thumb"><img src="{{ 'shj-ing-raspberry.webp' | asset_url }}" alt="Raspberry Flavor" loading="lazy"></div><h3>Raspberry<br>Flavor</h3><div class="shj-dose">great taste</div><div class="shj-desc">bright berry profile</div></article>
        <article class="shj-ingredient-card"><div class="shj-thumb"><img src="{{ 'shj-ing-watermelon.webp' | asset_url }}" alt="Watermelon Flavor" loading="lazy"></div><h3>Watermelon<br>Flavor</h3><div class="shj-dose">great taste</div><div class="shj-desc">fresh daily gummy flavor</div></article>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ COMPARE ══════════════════════════════ -->
  <section class="shj-section shj-compare">
    <div class="shj-compare-layout">
      <div class="shj-compare-title">
        <h2>{{ section.settings.compare_heading }}</h2>
        <p>{{ section.settings.compare_sub }}</p>
      </div>
      <div class="shj-main-compare">
        <div class="shj-bottle"><img src="{{ shj_bottle }}" alt="{{ product.title }}" loading="lazy"></div>
        <div class="shj-copy">
          <div class="shj-brand">PANSTELLAR</div>
          <h3>SHILAJIT GUMMIES</h3>
          <ul class="shj-check-list">
            <li><span class="shj-tick">✓</span>1500mg per serving</li>
            <li><span class="shj-tick">✓</span>Plant-based gummies</li>
            <li><span class="shj-tick">✓</span>Simple 1-a-day format</li>
            <li><span class="shj-tick">✓</span>Great taste</li>
            <li><span class="shj-tick">✓</span>Convenient daily routine</li>
          </ul>
        </div>
        <div class="shj-vs">VS</div>
      </div>
      <div class="shj-side-compare">
        <h3>Many Products</h3>
        <div class="shj-bottles"><img src="{{ 'shj-typical.webp' | asset_url }}" alt="Buying supplements separately" loading="lazy"></div>
        <ul class="shj-x-list">
          <li><span class="shj-cross">×</span>Multiple bottles</li>
          <li><span class="shj-cross">×</span>Harder to track</li>
          <li><span class="shj-cross">×</span>More clutter</li>
          <li><span class="shj-cross">×</span>Less convenient</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SCIENCE ══════════════════════════════ -->
  <section class="shj-section shj-science">
    <div class="shj-science-layout">
      <div class="shj-science-img"><img src="{{ 'shj-science.webp' | asset_url }}" alt="Shilajit gummies" loading="lazy"></div>
      <div class="shj-science-copy">
        <h2>{{ section.settings.science_heading }}</h2>
        <p>{{ section.settings.science_sub }}</p>
      </div>
      <div class="shj-science-points">
        <div class="shj-science-point"><div class="shj-mini"><img src="{{ 'shj-icon-molecule.png' | asset_url }}" alt="" width="22" height="22"></div>Great taste — raspberry-watermelon flavor</div>
        <div class="shj-science-point"><div class="shj-mini"><img src="{{ 'shj-icon-capsule.png' | asset_url }}" alt="" width="22" height="22"></div>Easy daily use — just 1 gummy daily</div>
        <div class="shj-science-point"><div class="shj-mini"><img src="{{ 'shj-icon-shield-check.png' | asset_url }}" alt="" width="22" height="22"></div>Plant-based pectin — gelatin-free formula</div>
      </div>
      <div class="shj-research">
        <h3>{{ section.settings.research_big }}<span>{{ section.settings.research_sub }}</span></h3>
        <p>{{ section.settings.research_note }}</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ TRUST / QUALITY ══════════════════════════════ -->
  <section class="shj-section shj-trust">
    <div class="shj-trust-layout">
      <h2>{{ section.settings.quality_heading }}</h2>
      <div class="shj-quality-icons">
        <div class="shj-quality"><div class="shj-icon-circle"><img src="{{ 'shj-icon-certificate.png' | asset_url }}" alt="" width="28" height="28"></div>Third‑Party<br>Tested</div>
        <div class="shj-quality"><div class="shj-icon-circle"><img src="{{ 'shj-icon-molecule.png' | asset_url }}" alt="" width="28" height="28"></div>Non‑GMO</div>
        <div class="shj-quality"><div class="shj-icon-circle"><img src="{{ 'shj-icon-bottle.png' | asset_url }}" alt="" width="28" height="28"></div>Gelatin‑Free</div>
        <div class="shj-quality"><div class="shj-icon-circle"><img src="{{ 'shj-icon-capsule.png' | asset_url }}" alt="" width="28" height="28"></div>Plant‑Based</div>
        <div class="shj-quality"><div class="shj-icon-circle"><img src="{{ 'shj-icon-made-in-usa.webp' | asset_url }}" alt="" width="28" height="28"></div>Made in<br>USA</div>
        <div class="shj-quality"><div class="shj-icon-circle"><img src="{{ 'shj-icon-beaker.png' | asset_url }}" alt="" width="28" height="28"></div>No Added<br>Sugars</div>
      </div>
      <div class="shj-badge"><img src="{{ 'shj-guarantee.webp' | asset_url }}" alt="90 Day guarantee" loading="lazy"></div>
      <div class="shj-risk">
        <h3>Try it Risk‑Free</h3>
        <p>Love it or get a full refund within 90 days of purchase.</p>
        <a href="{{ section.settings.guarantee_url | default: '#' }}" class="shj-learn">LEARN MORE</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ REVIEWS ══════════════════════════════ -->
  {%- if review_blocks.size > 0 -%}
  <section class="shj-section shj-reviews">
    <div class="shj-reviews-layout">
      <div>
        <h2>{{ section.settings.reviews_heading }}</h2>
        <div class="shj-rating">{{ section.settings.reviews_score }} <span class="shj-stars">★★★★★</span> <span style="font-weight:500;color:#5d534a">{{ section.settings.reviews_count }}</span></div>
      </div>
      <div>
        <div class="shj-review-grid">
          {%- for block in review_blocks -%}
            <article class="shj-review-card" {{ block.shopify_attributes }}>
              <div class="shj-stars">★★★★★</div>
              <p>{{ block.settings.quote }}</p>
              <div class="shj-author">— {{ block.settings.author }}</div>
            </article>
          {%- endfor -%}
        </div>
        {%- if section.settings.reviews_note != blank -%}
          <div class="shj-note">{{ section.settings.reviews_note }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ══════════════════════════════ FAQ ══════════════════════════════ -->
  {%- if faq_blocks.size > 0 -%}
  <section class="shj-section shj-faq">
    <div class="shj-faq-layout">
      <h2 class="shj-faq-title">{{ section.settings.faq_heading }}</h2>
      <div class="shj-faq-box">
        {%- for block in faq_blocks -%}
          <div class="shj-faq-item" {{ block.shopify_attributes }}>
            <button class="shj-faq-q" type="button">{{ block.settings.question }} <span>⌄</span></button>
            <div class="shj-faq-a"><p>{{ block.settings.answer }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ══════════════════════════════ STICKY ADD-TO-CART ══════════════════════════════ -->
  <section class="shj-sticky" id="shj-sticky-{{ section.id }}" aria-label="Quick add to cart">
    <div class="shj-sticky-inner">
      <div class="shj-mini-bottle"><img src="{{ shj_bottle }}" alt="{{ product.title }}" loading="lazy"></div>
      <div class="shj-headline">{{ section.settings.sticky_title }}</div>
      <div class="shj-sticky-price">
        <div class="shj-num">{{ shj_price }}</div>
        <div class="shj-sub">{{ section.settings.card_meta }} · {{ shj_day_price }}</div>
        <div class="shj-sticky-icons">
          <span><img src="{{ 'shj-icon-truck.png' | asset_url }}" alt="" width="16" height="16">{{ section.settings.trust1 }}</span>
          <span><img src="{{ 'shj-icon-shield-lock.png' | asset_url }}" alt="" width="16" height="16">{{ section.settings.trust2 }}</span>
          <span><img src="{{ 'shj-icon-shield-check.png' | asset_url }}" alt="" width="16" height="16">{{ section.settings.trust3 }}</span>
        </div>
      </div>
      {%- form 'product', product, id: shj_sticky_form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ shj_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add">{{ section.settings.cta_text }}</button>
      {%- endform -%}
    </div>
  </section>

</div><!-- /.shj-pdp -->

<script>
(function(){
  var wrap = document.getElementById('shj-pdp-{{ section.id }}');
  if (!wrap) return;

  /* ── Accordions + FAQ ── */
  wrap.querySelectorAll('.shj-acc-btn, .shj-faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var p = btn.nextElementSibling;
      var open = p.style.maxHeight && p.style.maxHeight !== '0px';
      var group = p.parentElement.parentElement;
      group.querySelectorAll('.shj-acc-panel, .shj-faq-a').forEach(function(x){
        if (x !== p) x.style.maxHeight = null;
      });
      p.style.maxHeight = open ? null : p.scrollHeight + 'px';
    });
  });

  /* ── Sticky reveal once the buy-card (CTA + accordions) scrolls out of
     view — observing the whole hero instead would keep the sticky hidden
     while the buy-card has scrolled away but the rest of the (taller) hero
     is still on screen, leaving no visible CTA in between. ── */
  var buyCard = document.getElementById('shj-buy-card-{{ section.id }}');
  var sticky = document.getElementById('shj-sticky-{{ section.id }}');
  if (buyCard && sticky && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(entries){
      sticky.classList.toggle('shj-sticky--visible', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(buyCard);
  } else if (sticky) {
    sticky.classList.add('shj-sticky--visible');
  }

  /* ── AJAX Add to Cart (Dawn cart drawer) ── */
  /* ── AJAX Add to Cart (Dawn cart drawer) ──
     Uses the native <cart-drawer> custom element's own renderContents()
     method (same one Dawn's product-form.js calls) — it both swaps in the
     fresh sections AND opens the drawer. window.openCartDrawer() and
     [data-cart-toggle]/[aria-controls="CartDrawer"] don't exist anywhere
     in this theme, so relying on them silently did nothing. */
  function handleForm(form){
    if (!form) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      var origText = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({
          id: form.querySelector('[name="id"]').value,
          quantity: 1,
          sections: ['cart-drawer', 'cart-icon-bubble'],
          sections_url: window.location.pathname
        })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        /* Fire Dawn's own pubsub cart-update event (same one product-form.js
           fires) — apps that hook into cart updates (reviews widgets, bundle
           upsells, etc.) listen for this, not our custom DOM event alone. */
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'shj-pdp', productVariantId: form.querySelector('[name="id"]').value, cartData: data });
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (btn) { btn.dataset.added = '1'; }
        var drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.renderContents === 'function') {
          drawer.renderContents(data);
        } else {
          window.location = window.Shopify.routes.root + 'cart';
        }
      })
      .catch(function(){ window.location = window.Shopify.routes.root + 'cart'; })
      .finally(function(){ if (btn) { btn.disabled = false; if (btn.dataset.added) { delete btn.dataset.added; btn.textContent = '\u2713 Added'; setTimeout(function(){ btn.textContent = origText; }, 1600); } else { btn.textContent = origText; } } });
    });
  }
  handleForm(document.getElementById('shj-hero-form-{{ section.id }}'));
  handleForm(document.getElementById('shj-sticky-form-{{ section.id }}'));
})();
</script>

{% schema %}
{
  "name": "Shilajit PDP",
  "tag": "section",
  "class": "shj-pdp-wrapper",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_bg",        "label": "Hero background (desktop)" },
    { "type": "image_picker", "id": "hero_bg_mobile", "label": "Hero background (mobile)" },
    { "type": "image_picker", "id": "product_image",  "label": "Product jar (compare + sticky)" },
    { "type": "text",     "id": "hero_eyebrow",  "label": "Eyebrow",  "default": "Pure Himalayan · Plant-Based Gummies" },
    { "type": "html",     "id": "hero_h1",       "label": "Heading (HTML allowed)", "default": "<span class=\"shj-nowrap-line\">Daily Vitality,</span><br><span class=\"shj-nowrap-line\">Made Delicious.</span>" },
    { "type": "textarea", "id": "hero_subtitle",  "label": "Subtitle", "default": "Pure Himalayan shilajit in an easy, delicious gummy—made for your everyday routine." },
    { "type": "html",     "id": "hero_stat1",    "label": "Stat 1", "default": "1500mg<br>Per Serving" },
    { "type": "html",     "id": "hero_stat2",    "label": "Stat 2", "default": "90 Vegan<br>Gummies" },
    { "type": "html",     "id": "hero_stat3",    "label": "Stat 3", "default": "No Added<br>Sugars" },
    { "type": "html",     "id": "hero_stat4",    "label": "Stat 4", "default": "3 Months<br>Supply" },
    { "type": "text",     "id": "hero_foot",     "label": "Footer line", "default": "Gelatin-Free · Non-GMO · Plant-Based Pectin" },
    { "type": "header", "content": "Buy card" },
    { "type": "text",     "id": "card_meta",     "label": "Meta line", "default": "90 Vegan Gummies · 3 Months Supply" },
    { "type": "number",   "id": "supply_days",   "label": "Days of supply (used to auto-calculate the $/day price)", "info": "How many days one order lasts. The $/day price shown on the page is calculated automatically from the live product price ÷ this number — it always stays correct, even when the price changes.", "default": 90 },
    { "type": "text",     "id": "cta_text",      "label": "CTA button", "default": "ADD TO CART" },
    { "type": "text",     "id": "trust1",        "label": "Trust 1", "default": "Free U.S. shipping · 1-2 day delivery" },
    { "type": "text",     "id": "trust2",        "label": "Trust 2", "default": "Secure checkout" },
    { "type": "text",     "id": "trust3",        "label": "Trust 3", "default": "Quality you can trust" },
    { "type": "text",     "id": "acc1_label",    "label": "Accordion 1 label", "default": "Supports" },
    { "type": "textarea", "id": "acc1_text",     "label": "Accordion 1 text",  "default": "Daily vitality, easy wellness routines and convenient plant-based gummy support." },
    { "type": "text",     "id": "acc2_label",    "label": "Accordion 2 label", "default": "Ingredients" },
    { "type": "textarea", "id": "acc2_text",     "label": "Accordion 2 text",  "default": "Shilajit extract, sea moss, burdock root, lion’s mane, raspberry flavor, watermelon flavor and plant-based pectin." },
    { "type": "text",     "id": "acc3_label",    "label": "Accordion 3 label", "default": "Certificates" },
    { "type": "textarea", "id": "acc3_text",     "label": "Accordion 3 text",  "default": "Third-party tested, non-GMO, gelatin-free, made in USA and backed by a 90-day guarantee." },
