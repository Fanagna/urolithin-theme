{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
<section class="psr psr-section psr-solutions" id="previous-solutions" style="background:{{ section.settings.background }}">
<div class="psr-shell psr-split">
  <div class="psr-photo-frame psr-photo-frame--soft">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img alt="{{ section.settings.image_alt | escape }}" loading="lazy" src="{{ 'psr-v10-image-solutions-stilllife.webp' | asset_url }}">{% endif %}</div>
  <div class="psr-copy">
    <p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span><span class="psr-kicker__rule"></span></p>
    <h2 class="psr-title">{{ section.settings.heading_before }} <em>{{ section.settings.heading_highlight }}</em> {{ section.settings.heading_after }}</h2>
    <div class="rte psr-section-copy">{{ section.settings.body }}</div>
    <div class="psr-reason-list">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="psr-reason-icon">{% case forloop.index %}{% when 1 %}{% assign psr_reason_fallback = 'psr-v10-premium-molecule.webp' %}{% when 2 %}{% assign psr_reason_fallback = 'psr-v10-premium-absorption.webp' %}{% when 3 %}{% assign psr_reason_fallback = 'psr-v10-premium-atom.webp' %}{% else %}{% assign psr_reason_fallback = 'psr-v10-icon-sparkle.svg' %}{% endcase %}{% render 'psr-editable-icon', custom_image: block.settings.icon, fallback_asset: psr_reason_fallback, class: 'psr-svg-icon psr-premium-icon', alt: '' %}</span><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></article>{% endfor %}</div>
    {% if section.settings.note != blank %}<div class="psr-note"><span>{% render 'psr-editable-icon', custom_image: section.settings.note_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><div class="rte">{{ section.settings.note }}</div></div>{% endif %}
  </div>
</div>
</section>
{% schema %}
{
  "name": "PSR — Previous solutions",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Premium supplement still life"
    },
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Science-backed reasons"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading before highlight",
      "default": "Why what you’ve tried before"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted text",
      "default": "may not"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading after highlight",
      "default": "have worked fully"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>You may have tried NMN alone, Resveratrol, or other supplements. The issue is often not the ingredient itself, but the way the full formula is designed.</p>"
    },
    {
      "type": "image_picker",
      "id": "note_icon",
      "label": "Note icon"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p><strong>You didn’t fail.</strong> The solution may simply have been incomplete.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Poor absorption"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Useful ingredients still need an effective delivery system."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PSR — Previous solutions",
      "blocks": [
        { "type": "reason", "settings": { "title": "Low dosage", "text": "Some formulas provide too little of the core actives." } },
        { "type": "reason", "settings": { "title": "Poor absorption", "text": "Useful ingredients still need an effective delivery system." } },
        { "type": "reason", "settings": { "title": "Missing synergy", "text": "NMN and Trans-Resveratrol are designed to complement each other." } },
        { "type": "reason", "settings": { "title": "An incomplete approach", "text": "The right dose, absorption and combination all matter." } }
      ]
    }
  ]
}
{% endschema %}
