{{ 'ndl-liposomal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ndl-liposomal.js' | asset_url }}" defer></script>
{% liquid
  assign expert_blocks = section.blocks | where: 'type', 'expert'
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
%}
<div class="ndl">
  <section class="ndl-section">
    <div class="ndl-shell">
      {% if expert_blocks.size > 0 %}
      <div class="ndl-section-head"><h2 class="ndl-heading" style="font-size:clamp(2rem,4vw,3.4rem)">{{ section.settings.experts_heading }}</h2></div>
      <div class="ndl-hscroll-wrap">
        <div class="ndl-experts-grid">
          {% for block in expert_blocks %}
            <article class="ndl-expert-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {% else %}
                {% assign ndl_expert_n = forloop.index0 | modulo: 5 | plus: 1 %}
                {% capture ndl_expert_asset %}ndl-expert-{{ ndl_expert_n }}.webp{% endcapture %}
                <img src="{{ ndl_expert_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% endif %}
              <div class="body"><strong>{{ block.settings.name }}</strong><small>{{ block.settings.title }}</small><p>“{{ block.settings.quote }}”</p></div>
            </article>
          {% endfor %}
        </div>
        <button type="button" class="ndl-hscroll-arrow is-hidden" data-ndl-hscroll-prev aria-label="Previous">‹</button>
        <button type="button" class="ndl-hscroll-arrow" data-ndl-hscroll-next aria-label="Next">›</button>
      </div>
      {% endif %}

      {% if faq_blocks.size > 0 %}
      <div class="ndl-faq" id="ndl-faq-{{ section.id }}">
        <h2>{{ section.settings.faq_heading }}</h2>
        {% for block in faq_blocks %}
          <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if trust_blocks.size > 0 %}
    <div class="ndl-trust-strip">
      {% for block in trust_blocks %}
        <div class="ndl-trust-item" {{ block.shopify_attributes }}>
          <span class="icon">{% render 'nad-icon', name: block.settings.icon, custom_image: block.settings.custom_icon %}</span>
          <span><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></span>
        </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>
</div>
{% schema %}
{
  "name": "NDL — Experts & FAQ",
  "tag": "section",
  "class": "ndl-section-wrapper",
  "settings": [
    { "type": "text", "id": "experts_heading", "label": "Experts heading", "default": "Trusted by Experts & Active Adults" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    { "type": "expert", "name": "Expert card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Wellness Specialist" },
      { "type": "text", "id": "title", "label": "Title / tag", "default": "Healthy Aging" },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "A premium addition to a consistent cellular wellness routine." }
    ]},
    { "type": "faq_item", "name": "FAQ item", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What is NAD+ and why is it important?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>NAD+ is a naturally occurring coenzyme involved in cellular energy processes. This product is designed as a daily dietary supplement supporting general wellness.</p>" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ]},
    { "type": "trust", "name": "Trust strip item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "truck", "label": "Truck" }, { "value": "shield-check", "label": "Shield check" }, { "value": "root", "label": "Root" }, { "value": "lock-box", "label": "Lock" }
      ], "default": "truck" },
      { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image (optional)" },
      { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
      { "type": "text", "id": "text", "label": "Text", "default": "on orders over $75" }
    ]}
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "NDL — Experts & FAQ", "blocks": [
      { "type": "expert", "settings": { "name": "Wellness Specialist", "title": "Healthy Aging", "quote": "A premium addition to a consistent cellular wellness routine." } },
      { "type": "expert", "settings": { "name": "Performance Coach", "title": "Strength & Conditioning", "quote": "Supports a simple daily routine built around energy and recovery." } },
      { "type": "expert", "settings": { "name": "Ryan, 34", "title": "Endurance Athlete", "quote": "More energy, better focus, and a smoother recovery routine." } },
      { "type": "expert", "settings": { "name": "Sarah, 48", "title": "Morning Ritual", "quote": "My skin looks brighter and I feel more refreshed." } },
      { "type": "expert", "settings": { "name": "David, 57", "title": "Daily Wellness", "quote": "I feel more consistent in my everyday routine." } },
      { "type": "faq_item", "settings": { "question": "What is NAD+ and why is it important?", "answer": "<p>NAD+ is a naturally occurring coenzyme involved in cellular energy processes. This product is designed as a daily dietary supplement supporting general wellness.</p>" } },
      { "type": "faq_item", "settings": { "question": "How does liposomal NAD+ work?", "answer": "<p>Liposomal delivery surrounds ingredients with phospholipid structures designed to support stability and delivery through digestion.</p>" } },
      { "type": "faq_item", "settings": { "question": "What are the benefits of taking NAD+?", "answer": "<p>The formula is positioned to support cellular energy, daily performance, mental clarity, and healthy aging as part of a consistent wellness routine.</p>" } },
      { "type": "faq_item", "settings": { "question": "Who should take NAD+ Liposomal?", "answer": "<p>Adults seeking a convenient daily wellness supplement may consider it. Consult a qualified healthcare professional before use, especially when pregnant, nursing, taking medication, or managing a health condition.</p>" } },
      { "type": "faq_item", "settings": { "question": "How many capsules should I take?", "answer": "<p>Follow the directions printed on the final product label. Replace this placeholder with the confirmed suggested-use instruction before publishing.</p>" } },
      { "type": "faq_item", "settings": { "question": "Is PANSTELLAR NAD+ third-party tested?", "answer": "<p>The supplied mockup states third-party testing. Link the final page to the relevant current certificate of analysis or batch documentation.</p>" } },
      { "type": "faq_item", "settings": { "question": "What is your return policy?", "answer": "<p>The mockup displays a 180-day money-back guarantee. Replace this text with the final store policy and eligibility conditions.</p>" } },
      { "type": "trust", "settings": { "icon": "truck", "title": "Free Shipping", "text": "on orders over $75" } },
      { "type": "trust", "settings": { "icon": "shield-check", "title": "180-Day", "text": "Money Back Guarantee" } },
      { "type": "trust", "settings": { "icon": "root", "title": "Third-Party", "text": "Tested" } },
      { "type": "trust", "settings": { "icon": "lock-box", "title": "Secure", "text": "Checkout" } }
    ]}
  ]
}
{% endschema %}
