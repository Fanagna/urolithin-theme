{{ 'section-pnf-nmn.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
-%}

<section class="pnf" id="pnf-nmn-formula-{{ section.id }}">
  {%- if ingredient_blocks.size > 0 -%}
    <div class="pnf__section pnf__formula">
      <div class="pnf__container">
        <p class="pnf__eyebrow">{{ section.settings.formula_eyebrow }}</p>
        <h2 class="pnf__title">{{ section.settings.formula_heading }}</h2>
        <details class="pnf__formula-details" open>
          <summary>{{ section.settings.formula_mobile_summary }}</summary>
          <div class="pnf__formula-carousel" data-pnf-formula-carousel>
            <div class="pnf__formula-grid" data-pnf-formula-track>
              {%- for block in ingredient_blocks -%}
                <article class="pnf__formula-card" {{ block.shopify_attributes }}>
                  <span class="pnf__formula-index">{{ block.settings.index }}</span>
                  <div class="pnf__formula-media">
                    {%- if block.settings.image != blank -%}
                      <img src="{{ block.settings.image | image_url: width: 520 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="520" height="360">
                    {%- else -%}
                      <small>{{ block.settings.placeholder | default: 'ADD IMAGE' }}</small>
                    {%- endif -%}
                  </div>
                  <h3>{{ block.settings.name }}</h3>
                  <strong>{{ block.settings.dose }}</strong>
                </article>
              {%- endfor -%}
            </div>
            <div class="pnf__formula-controls" aria-label="Ingredient carousel controls">
              <button class="pnf__formula-arrow" type="button" aria-label="Previous ingredients" data-pnf-formula-prev>&lsaquo;</button>
              <button class="pnf__formula-arrow" type="button" aria-label="Next ingredients" data-pnf-formula-next>&rsaquo;</button>
            </div>
          </div>
        </details>
      </div>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'section-pnf-nmn.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PNF NMN formula",
  "tag": "section",
  "class": "shopify-section--pnf-nmn-formula",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "formula_eyebrow", "label": "Formula eyebrow", "default": "FULLY DISCLOSED FORMULA" },
    { "type": "html", "id": "formula_heading", "label": "Formula heading", "default": "10 Active Ingredients.<br><span class=\"pnf__accent\">Every Amount Shown.</span>" },
    { "type": "text", "id": "formula_mobile_summary", "label": "Formula mobile accordion label", "default": "View the 10 active ingredients" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingredient", "settings": [
      { "type": "text", "id": "index", "label": "Index", "default": "01" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "ADD IMAGE" },
      { "type": "text", "id": "name", "label": "Name", "default": "NMN" },
      { "type": "text", "id": "dose", "label": "Dose", "default": "450 mg" }
    ] }
  ],
  "presets": [
    { "name": "PNF NMN formula" }
  ]
}
{% endschema %}
