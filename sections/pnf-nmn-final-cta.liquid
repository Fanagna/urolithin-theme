{{ 'section-pnf-nmn.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'pnf-final-cta-form-' | append: section.id
-%}

<section class="pnf pnf__final-cta" id="pnf-nmn-final-cta-{{ section.id }}">
  <div class="pnf__container pnf__final-cta-inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pnf__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="pnf__final-cta-copy">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="pnf__final-cta-actions">
      {%- if section.settings.button_link != blank -%}
        <a class="pnf__final-cta-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- elsif product != blank -%}
        {%- form 'product', product, id: form_id, class: 'pnf__final-cta-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <button class="pnf__final-cta-button" type="submit" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}
              {{ section.settings.button_label }}
            {%- else -%}
              {{ section.settings.sold_out_label }}
            {%- endif -%}
          </button>
        {%- endform -%}
      {%- endif -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="pnf__final-cta-note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PNF NMN final CTA",
  "tag": "section",
  "class": "shopify-section--pnf-nmn-final-cta",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "READY TO START?" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Start Your Daily <span class=\"pnf__accent\">Cellular Wellness</span> Routine." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A complete 10-ingredient formula built for a simple daily routine." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SECURE MY SUPPLY" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "SOLD OUT" },
    { "type": "url", "id": "button_link", "label": "Optional button link" },
    { "type": "text", "id": "note", "label": "Note", "default": "90-day returns - Secure checkout - Delivery in 3 days" }
  ],
  "presets": [
    { "name": "PNF NMN final CTA" }
  ]
}
{% endschema %}
