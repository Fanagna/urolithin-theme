{{ 'section-pnf-nmn.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<section class="pnf" id="pnf-nmn-reviews-{{ section.id }}" data-pnf-nmn>
  {%- if review_blocks.size > 0 -%}
    <div class="pnf__section pnf__reviews">
      <div class="pnf__container">
        <p class="pnf__eyebrow">{{ section.settings.reviews_eyebrow }}</p>
        <h2 class="pnf__title">{{ section.settings.reviews_heading }}</h2>
        <div class="pnf__testimonial-slider" data-pnf-testimonials data-autoplay="{{ section.settings.testimonial_autoplay_ms }}">
          <div class="pnf__testimonial-viewport">
            <div class="pnf__testimonial-track" data-pnf-testimonial-track>
              {%- for block in review_blocks -%}
                <article class="pnf__review-card pnf__testimonial-slide" data-pnf-testimonial-slide {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <div class="pnf__review-media">
                      <img src="{{ block.settings.image | image_url: width: 760 }}" alt="{{ block.settings.author | escape }}" loading="lazy" width="760" height="920">
                    </div>
                  {%- endif -%}
                  <div class="pnf__review-copy">
                    <div class="pnf__stars">★★★★★</div>
                    <p>{{ block.settings.quote }}</p>
                    <span class="pnf__review-author">{{ block.settings.author }}</span>
                    {%- if block.settings.caption != blank -%}<span class="pnf__review-caption">{{ block.settings.caption }}</span>{%- endif -%}
                  </div>
                </article>
              {%- endfor -%}
            </div>
          </div>
          {%- if review_blocks.size > 1 -%}
            <div class="pnf__testimonial-controls" aria-label="Testimonials slider controls">
              <button type="button" data-pnf-testimonial-prev aria-label="Previous testimonial">Prev</button>
              <div class="pnf__testimonial-dots" data-pnf-testimonial-dots></div>
              <button type="button" data-pnf-testimonial-next aria-label="Next testimonial">Next</button>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'section-pnf-nmn.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PNF NMN reviews",
  "tag": "section",
  "class": "shopify-section--pnf-nmn-reviews",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "reviews_eyebrow", "label": "Reviews eyebrow", "default": "VERIFIED CUSTOMERS" },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading", "default": "Real People. Real Routines." },
    { "type": "range", "id": "testimonial_autoplay_ms", "label": "Testimonials autoplay speed", "min": 2500, "max": 9000, "step": 500, "unit": "ms", "default": 4500 }
  ],
  "blocks": [
    { "type": "review", "name": "Testimonial slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Customer photo" },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "I noticed more stable energy and fewer afternoon crashes after adding this to my routine." },
      { "type": "text", "id": "author", "label": "Author", "default": "Verified Buyer" },
      { "type": "text", "id": "caption", "label": "Photo caption", "default": "Customer photo with their PANSTELLAR bottle" }
    ] }
  ],
  "presets": [
    { "name": "PNF NMN reviews" }
  ]
}
{% endschema %}
