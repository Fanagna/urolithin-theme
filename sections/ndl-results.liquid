{{ 'ndl-liposomal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ndl-liposomal.js' | asset_url }}" defer></script>
{% liquid
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign gallery_blocks = section.blocks | where: 'type', 'gallery_image'
%}
<div class="ndl">
  <section class="ndl-section ndl-results-section">
    <div class="ndl-shell">
      <div class="ndl-section-head">
        <span class="ndl-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="ndl-heading">{{ section.settings.heading }}</h2>
        <p class="ndl-subheading">{{ section.settings.subheading }}</p>
      </div>

      {% if video_blocks.size > 0 %}
      <div class="ndl-hscroll-wrap">
        <div class="ndl-video-grid">
          {% for block in video_blocks %}
            <article class="ndl-video-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {% else %}
                {% assign ndl_video_n = forloop.index0 | modulo: 4 | plus: 1 %}
                {% capture ndl_video_asset %}ndl-video-{{ ndl_video_n }}.webp{% endcapture %}
                <img src="{{ ndl_video_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% endif %}
              {% if block.settings.video_url != blank %}<a class="ndl-play" href="{{ block.settings.video_url }}" target="_blank" rel="noopener" aria-label="Play video">▶</a>{% else %}<span class="ndl-play" aria-hidden="true">▶</span>{% endif %}
              <div class="ndl-video-quote">“{{ block.settings.quote }}”<strong>{{ block.settings.name }}</strong></div>
            </article>
          {% endfor %}
        </div>
        <button type="button" class="ndl-hscroll-arrow is-hidden" data-ndl-hscroll-prev aria-label="Previous">‹</button>
        <button type="button" class="ndl-hscroll-arrow" data-ndl-hscroll-next aria-label="Next">›</button>
      </div>
      {% endif %}

      {% if benefit_blocks.size > 0 %}
      <div class="ndl-benefits-six">
        {% for block in benefit_blocks %}
          <div class="ndl-big-benefit" {{ block.shopify_attributes }}>
            {% liquid
              assign ndl_benefit_photo_src = ''
              if block.settings.photo != blank
                assign ndl_benefit_photo_src = block.settings.photo | image_url: width: 240
              else
                assign ndl_benefit_n = forloop.index0 | modulo: 6 | plus: 1
                capture ndl_benefit_asset
                  echo 'ndl-lifestyle-'
                  echo ndl_benefit_n
                  echo '.webp'
                endcapture
                assign ndl_benefit_photo_src = ndl_benefit_asset | asset_url
              endif
            %}
            <img class="photo" src="{{ ndl_benefit_photo_src }}" alt="" loading="lazy">
            <strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if gallery_blocks.size > 0 %}
      <div class="ndl-gallery-grid">
        {% for block in gallery_blocks %}
          {% liquid
            assign ndl_gallery_src = ''
            if block.settings.image != blank
              assign ndl_gallery_src = block.settings.image | image_url: width: 700
            else
              assign ndl_gallery_n = forloop.index0 | modulo: 6 | plus: 1
              capture ndl_gallery_asset
                echo 'ndl-lifestyle-'
                echo ndl_gallery_n
                echo '.webp'
              endcapture
              assign ndl_gallery_src = ndl_gallery_asset | asset_url
            endif
          %}
          <img src="{{ ndl_gallery_src }}" alt="{{ block.settings.alt | escape }}" loading="lazy" {{ block.shopify_attributes }}>
        {% endfor %}
      </div>
      {% endif %}

      {% if section.settings.show_charts %}
      <div class="ndl-chart-grid">
        <div class="ndl-chart">
          <h3>{{ section.settings.chart1_title }}</h3>
          <p>{{ section.settings.chart1_subtitle }}</p>
          <div class="ndl-line-chart" aria-label="Illustrative line chart">
            <svg viewBox="0 0 500 180" preserveAspectRatio="none">
              <polyline points="0,10 80,28 160,50 240,78 320,112 400,144 500,170" fill="none" stroke="#baff3e" stroke-width="5"/>
              <g fill="#baff3e">
                <circle cx="0" cy="10" r="6"/><circle cx="80" cy="28" r="6"/><circle cx="160" cy="50" r="6"/>
                <circle cx="240" cy="78" r="6"/><circle cx="320" cy="112" r="6"/><circle cx="400" cy="144" r="6"/><circle cx="500" cy="170" r="6"/>
              </g>
            </svg>
          </div>
          <div class="ndl-chart-labels">
            {% assign chart1_labels = section.settings.chart1_labels | split: ',' %}
            {% for label in chart1_labels %}<span>{{ label | strip }}</span>{% endfor %}
          </div>
        </div>
        <div class="ndl-chart">
          <h3>{{ section.settings.chart2_title }}</h3>
          <p>{{ section.settings.chart2_subtitle }}</p>
          <div class="ndl-bar-wrap">
            <div class="ndl-bar"><span>{{ section.settings.chart2_value_a }}%</span><i style="height:{{ section.settings.chart2_value_a | times: 1.6 }}px"></i></div>
            <div class="ndl-bar lime"><span>{{ section.settings.chart2_value_b }}%</span><i style="height:{{ section.settings.chart2_value_b | times: 1.6 }}px"></i></div>
          </div>
          <div class="ndl-chart-labels"><span>{{ section.settings.chart2_label_a }}</span><span>{{ section.settings.chart2_label_b }}</span></div>
        </div>
      </div>
      {% endif %}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "NDL — Real world results",
  "tag": "section",
  "class": "ndl-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 Trusted by real people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "REAL WORLD RESULTS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Daily support for energy, focus, recovery, and healthy aging." },
    { "type": "checkbox", "id": "show_charts", "label": "Show comparison charts", "default": true },
    { "type": "text", "id": "chart1_title", "label": "Chart 1 — title", "default": "NAD+ LEVELS DECLINE WITH AGE" },
    { "type": "text", "id": "chart1_subtitle", "label": "Chart 1 — subtitle", "default": "NAD+ naturally decreases as we age." },
    { "type": "text", "id": "chart1_labels", "label": "Chart 1 — axis labels (comma-separated)", "default": "20, 30, 40, 50, 60, 70, 80+" },
    { "type": "text", "id": "chart2_title", "label": "Chart 2 — title", "default": "LIPOSOMAL ABSORPTION MAKES THE DIFFERENCE" },
    { "type": "text", "id": "chart2_subtitle", "label": "Chart 2 — subtitle", "default": "Superior delivery. Better results." },
    { "type": "range", "id": "chart2_value_a", "label": "Chart 2 — value A (%)", "min": 0, "max": 100, "step": 1, "default": 20 },
    { "type": "text", "id": "chart2_label_a", "label": "Chart 2 — label A", "default": "Traditional NAD+" },
    { "type": "range", "id": "chart2_value_b", "label": "Chart 2 — value B (%)", "min": 0, "max": 100, "step": 1, "default": 90 },
    { "type": "text", "id": "chart2_label_b", "label": "Chart 2 — label B", "default": "PANSTELLAR Liposomal" }
  ],
  "blocks": [
    { "type": "video", "name": "Video card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Cover image" },
      { "type": "url", "id": "video_url", "label": "Video link (optional)" },
      { "type": "text", "id": "quote", "label": "Quote", "default": "More energy in the morning and way less midday fatigue." },
      { "type": "text", "id": "name", "label": "Name", "default": "Mark, 52" }
    ]},
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "image_picker", "id": "photo", "label": "Photo", "info": "If left blank, falls back to the matching lifestyle photo from the gallery below (1st benefit → 1st gallery image, and so on)." },
      { "type": "text", "id": "title", "label": "Title", "default": "More Energy" },
      { "type": "text", "id": "text", "label": "Text", "default": "Feel more energized all day long." }
    ]},
    { "type": "gallery_image", "name": "Gallery image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Alt text" }
    ]}
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "NDL — Real world results", "blocks": [
      { "type": "video", "settings": { "quote": "More energy in the morning and way less midday fatigue.", "name": "Mark, 52" } },
      { "type": "video", "settings": { "quote": "My skin looks healthier and I feel years younger.", "name": "Sarah, 48" } },
      { "type": "video", "settings": { "quote": "Supports my recovery and helps me stay active every day.", "name": "James, 55" } },
      { "type": "video", "settings": { "quote": "Clearer mind, better focus, and deeper sleep.", "name": "Lisa, 50" } },
      { "type": "benefit", "settings": { "title": "More Energy", "text": "Feel more energized all day long." } },
      { "type": "benefit", "settings": { "title": "Healthier Skin", "text": "Support youthful, radiant-looking skin." } },
      { "type": "benefit", "settings": { "title": "Faster Recovery", "text": "Aid muscle recovery and reduce fatigue." } },
      { "type": "benefit", "settings": { "title": "Sharper Focus", "text": "Support memory, focus, and clarity." } },
      { "type": "benefit", "settings": { "title": "Stronger Daily Performance", "text": "Perform at your best mentally and physically." } },
      { "type": "benefit", "settings": { "title": "Healthy Aging", "text": "Support cellular health and longevity." } },
      { "type": "gallery_image", "settings": {} },
      { "type": "gallery_image", "settings": {} },
      { "type": "gallery_image", "settings": {} },
      { "type": "gallery_image", "settings": {} },
      { "type": "gallery_image", "settings": {} },
      { "type": "gallery_image", "settings": {} }
    ]}
  ]
}
{% endschema %}
