{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
<section class="psr psr-section psr-comparison" id="comparison" style="background:{{ section.settings.background }}">
<div class="psr-shell"><div class="psr-center-heading"><p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span></p><h2 class="psr-title">{{ section.settings.heading_before }} <em>{{ section.settings.heading_highlight }}</em></h2><div class="rte">{{ section.settings.body }}</div></div>
<div class="psr-comparison-desktop" role="table"><div class="psr-compare-row psr-compare-head" role="row"><div role="columnheader">{{ section.settings.label_column }}</div><div role="columnheader">{{ section.settings.our_column }}</div><div role="columnheader">{{ section.settings.regular_column }}</div><div role="columnheader">{{ section.settings.other_column }}</div></div>{% for block in section.blocks %}<div class="psr-compare-row" role="row" {{ block.shopify_attributes }}><div role="cell"><strong>{{ block.settings.label }}</strong></div><div role="cell"><span class="psr-compare-mark is-good">{% render 'psr-editable-icon', custom_image: block.settings.our_icon, fallback_asset: 'psr-v10-icon-check.svg', class: 'psr-svg-icon', alt: '' %}</span><span>{{ block.settings.our_text }}</span></div><div role="cell"><span class="psr-compare-mark">{% render 'psr-editable-icon', custom_image: block.settings.regular_icon, fallback_asset: 'psr-v10-icon-sparkle.svg', class: 'psr-svg-icon', alt: '' %}</span><span>{{ block.settings.regular_text }}</span></div><div role="cell"><span class="psr-compare-mark">{% render 'psr-editable-icon', custom_image: block.settings.other_icon, fallback_asset: 'psr-v10-icon-sparkle.svg', class: 'psr-svg-icon', alt: '' %}</span><span>{{ block.settings.other_text }}</span></div></div>{% endfor %}</div>
{% assign psr_compare_keys = 'ours,regular,other' | split: ',' %}<div class="psr-comparison-mobile" data-comparison-tabs><div class="psr-tablist" role="tablist"><button class="is-active" data-compare-tab="ours" role="tab" aria-selected="true">{{ section.settings.our_column }}</button><button data-compare-tab="regular" role="tab" aria-selected="false">{{ section.settings.regular_column }}</button><button data-compare-tab="other" role="tab" aria-selected="false">{{ section.settings.other_column }}</button></div>{% for key in psr_compare_keys %}<div class="psr-tabpanel{% if key == 'ours' %} is-active{% endif %}" data-compare-panel="{{ key }}"><h3>{% if key == 'ours' %}{{ section.settings.our_column }}{% elsif key == 'regular' %}{{ section.settings.regular_column }}{% else %}{{ section.settings.other_column }}{% endif %}</h3><ul>{% for block in section.blocks %}<li>{% if key == 'ours' %}{{ block.settings.our_text }}{% elsif key == 'regular' %}{{ block.settings.regular_text }}{% else %}{{ block.settings.other_text }}{% endif %}</li>{% endfor %}</ul></div>{% endfor %}</div>
</div></section>
{% schema %}
{
  "name": "PSR — Comparison",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Science. Purity. Simplicity."
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading first part",
      "default": "Why This Complex Works Better for"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted part",
      "default": "Women Over 40"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro text",
      "default": "<p>A complete formula designed around dose, absorption, synergy and daily consistency.</p>"
    },
    {
      "type": "text",
      "id": "label_column",
      "label": "First column label",
      "default": "What matters"
    },
    {
      "type": "text",
      "id": "our_column",
      "label": "Our column label",
      "default": "Our Complex"
    },
    {
      "type": "text",
      "id": "regular_column",
      "label": "Regular column label",
      "default": "Regular NMN"
    },
    {
      "type": "text",
      "id": "other_column",
      "label": "Other column label",
      "default": "Other Supplements"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "linear-gradient(135deg,#fff7f1,#fdebe4)"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Active blend"
        },
        {
          "type": "image_picker",
          "id": "our_icon",
          "label": "Our icon"
        },
        {
          "type": "text",
          "id": "our_text",
          "label": "Our text",
          "default": "1600mg daily blend"
        },
        {
          "type": "image_picker",
          "id": "regular_icon",
          "label": "Regular icon"
        },
        {
          "type": "text",
          "id": "regular_text",
          "label": "Regular text",
          "default": "Often a single ingredient"
        },
        {
          "type": "image_picker",
          "id": "other_icon",
          "label": "Other icon"
        },
        {
          "type": "text",
          "id": "other_text",
          "label": "Other text",
          "default": "Varies widely"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PSR — Comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Active blend", "our_text": "1600mg daily blend", "regular_text": "Often a single ingredient", "other_text": "Varies widely" } },
        { "type": "row", "settings": { "label": "Absorption", "our_text": "Liposomal delivery", "regular_text": "Standard delivery", "other_text": "Often unspecified" } },
        { "type": "row", "settings": { "label": "Synergy", "our_text": "NMN + Resveratrol", "regular_text": "NMN only", "other_text": "Random blends" } },
        { "type": "row", "settings": { "label": "Clean formula", "our_text": "Non-GMO, third-party tested", "regular_text": "Depends on brand", "other_text": "May contain unnecessary fillers" } },
        { "type": "row", "settings": { "label": "Women 40+", "our_text": "Built for this life stage", "regular_text": "Generic formula", "other_text": "One-size-fits-all" } }
      ]
    }
  ]
}
{% endschema %}
