{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
<section class="psr psr-section psr-testimonials" id="reviews" style="background:{{ section.settings.background }}">
<div class="psr-shell">
  <div class="psr-center-heading"><p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-woman.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span></p><h2 class="psr-title">{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.body }}</div></div>
  <div class="psr-carousel" data-carousel><button class="psr-carousel__arrow" data-carousel-prev aria-label="Previous testimonial" type="button">‹</button><div class="psr-carousel__viewport" data-carousel-viewport><div class="psr-carousel__track">
  {% for block in section.blocks %}<article class="psr-review-card" {{ block.shopify_attributes }}>
    <div class="psr-review-card__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image_alt }}{% else %}{% capture psr_testimonial_asset %}psr-v10-image-testimonial-{{ forloop.index }}.webp{% endcapture %}<img alt="{{ block.settings.image_alt | escape }}" loading="lazy" src="{{ psr_testimonial_asset | asset_url }}">{% endif %}{% if block.settings.video_url != blank %}<a class="psr-review-card__play" href="{{ block.settings.video_url }}" target="_blank" rel="noopener" aria-label="Play testimonial video">▶</a>{% endif %}</div>
    <p>“{{ block.settings.quote }}”</p><strong>{{ block.settings.name }}{% if block.settings.age != blank %}, {{ block.settings.age }}{% endif %}</strong><span class="psr-stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
  </article>{% endfor %}
  </div></div><button class="psr-carousel__arrow" data-carousel-next aria-label="Next testimonial" type="button">›</button></div><div class="psr-carousel__dots" data-carousel-dots></div>
</div>
</section>
{% schema %}
{
  "name": "PSR — Testimonials",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Real experiences"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Women, Real Experiences"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro text",
      "default": "<p>Warm, relatable stories from women who made Panstellar part of their daily routine.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fffaf7"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Only the first 6 testimonials without a custom photo fall back to a bundled image. Upload a photo here for the 7th block and beyond."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photo alt text",
          "default": "Customer testimonial"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Optional video link"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I finally have steady energy all day."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Michelle R."
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age",
          "default": "52"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PSR — Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "I finally have steadier energy throughout the day and feel more like myself again.", "name": "Michelle R.", "age": "52", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "My skin looks brighter, and my routine feels easier to stay consistent with.", "name": "Karen D.", "age": "55", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "I feel more focused, more vibrant, and more confident in my daily life.", "name": "Tina M.", "age": "50", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "I wake up feeling refreshed and ready to get more out of my day.", "name": "Sophie K.", "age": "51", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "The afternoon slump is less disruptive, and I feel calmer and clearer.", "name": "Laura G.", "age": "49", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "It has become one of the simplest parts of my wellness routine.", "name": "Denise L.", "age": "48", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
