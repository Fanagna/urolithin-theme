{{ 'nad-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nad_variant = product.selected_or_first_available_variant
  assign nad_price   = nad_variant.price | money
  assign nad_compare = nad_variant.compare_at_price | money

  # Per-day price, auto-calculated from the live product price so it never goes
  # stale when the price changes. supply_days is a merchant-editable fact about
  # the product (not a price), defaults to 90 (3 months supply / 180 capsules).
  assign nad_supply_days = section.settings.supply_days | default: 90
  assign nad_day_price = nad_variant.price | times: 1.0 | divided_by: nad_supply_days | money | append: '/day'

  assign nad_hero_desktop = 'nad-hero-desktop.webp' | asset_url
  assign nad_hero_mobile  = 'nad-hero-mobile.webp'  | asset_url
  if section.settings.hero_bg != blank
    assign nad_hero_desktop = section.settings.hero_bg | image_url: width: 1920
  endif
  if section.settings.hero_bg_mobile != blank
    assign nad_hero_mobile = section.settings.hero_bg_mobile | image_url: width: 900
  endif

  assign nad_bottle = 'nad-jar.webp' | asset_url
  if section.settings.product_image != blank
    assign nad_bottle = section.settings.product_image | image_url: width: 600
  endif

  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks    = section.blocks | where: 'type', 'faq_item'

  assign nad_hero_form_id   = 'nad-hero-form-'   | append: section.id
  assign nad_sticky_form_id = 'nad-sticky-form-' | append: section.id
-%}

{% render 'panstellar-product-schema', product: product %}
<style>
  #nad-pdp-{{ section.id }}{
    --nad-hero-img: url('{{ nad_hero_desktop }}');
    --nad-hero-img-m: url('{{ nad_hero_mobile }}');
  }
</style>

<div class="nad-pdp nad-page" id="nad-pdp-{{ section.id }}">

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="nad-section nad-hero">
    <div class="nad-hero-grid">
      <div class="nad-hero-copy">
        <div class="nad-eyebrow">{{ section.settings.hero_eyebrow }}</div>
        <h1 class="nad-hero-title">{{ section.settings.hero_h1 }}</h1>
        <p>{{ section.settings.hero_subtitle }}</p>
        <div class="nad-hero-icons">
          <div class="nad-hero-icon"><div class="nad-icon-circle"><img src="{{ 'nad-icon-molecule.png' | asset_url }}" alt="Serving strength" width="30" height="30"></div>{{ section.settings.hero_stat1 }}</div>
          <div class="nad-hero-icon"><div class="nad-icon-circle"><img src="{{ 'nad-icon-molecule0.png' | asset_url }}" alt="Formula" width="30" height="30"></div>{{ section.settings.hero_stat2 }}</div>
          <div class="nad-hero-icon"><div class="nad-icon-circle"><img src="{{ 'nad-icon-bottle.png' | asset_url }}" alt="Capsules" width="30" height="30"></div>{{ section.settings.hero_stat3 }}</div>
          <div class="nad-hero-icon"><div class="nad-icon-circle"><img src="{{ 'nad-icon-certificatev.png' | asset_url }}" alt="Supply" width="30" height="30"></div>{{ section.settings.hero_stat4 }}</div>
        </div>
        <div class="nad-hero-meta">{{ section.settings.hero_foot }}</div>
      </div>

      <aside class="nad-buy-card" id="nad-buy-card-{{ section.id }}">
        <div class="nad-price">
          {{ nad_price }}
          {%- if nad_variant.compare_at_price > nad_variant.price -%}
            <span style="font-size:24px;color:#b3a89c;text-decoration:line-through;font-weight:600;margin-left:8px">{{ nad_compare }}</span>
          {%- endif -%}
        </div>
        <div class="nad-meta">{{ section.settings.card_meta }}</div>
        <div class="nad-day">{{ nad_day_price }}</div>

        {%- form 'product', product, id: nad_hero_form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ nad_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" name="add" class="nad-cta">{{ section.settings.cta_text }}</button>
        {%- endform -%}

        <div class="nad-trust-list">
          <div><img src="{{ 'nad-icon-truck.png' | asset_url }}" alt="" width="20" height="20">{{ section.settings.trust1 }}</div>
          <div><img src="{{ 'nad-icon-shield-lock.png' | asset_url }}" alt="" width="20" height="20">{{ section.settings.trust2 }}</div>
          <div><img src="{{ 'nad-icon-shield-check.png' | asset_url }}" alt="" width="20" height="20">{{ section.settings.trust3 }}</div>
        </div>

        <div class="nad-accordion">
          <div class="nad-acc">
            <button class="nad-acc-btn" type="button">{{ section.settings.acc1_label }} <span>⌄</span></button>
            <div class="nad-acc-panel"><p>{{ section.settings.acc1_text }}</p></div>
          </div>
          <div class="nad-acc">
            <button class="nad-acc-btn" type="button">{{ section.settings.acc2_label }} <span>⌄</span></button>
            <div class="nad-acc-panel"><p>{{ section.settings.acc2_text }}</p></div>
          </div>
          <div class="nad-acc">
            <button class="nad-acc-btn" type="button">{{ section.settings.acc3_label }} <span>⌄</span></button>
            <div class="nad-acc-panel"><p>{{ section.settings.acc3_text }}</p></div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ══════════════════════════════ INGREDIENTS (10) ══════════════════════════════ -->
  <section class="nad-section nad-ingredients">
    <div class="nad-ingredient-layout">
      <div class="nad-block-title">
        <h2 class="nad-ingredients-title">{{ section.settings.ing_heading }}</h2>
        <p>{{ section.settings.ing_sub }}</p>
      </div>
      <div class="nad-ingredient-grid">
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-nad.jpg' | asset_url }}" alt="NAD+" loading="lazy"></div><h3>NAD+</h3><div class="nad-dose">core active</div><div class="nad-desc">cellular energy support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-nr.jpg' | asset_url }}" alt="NR" loading="lazy"></div><h3>NR</h3><div class="nad-dose">nicotinamide riboside</div><div class="nad-desc">NAD+ pathway support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-nmn.jpg' | asset_url }}" alt="NMN" loading="lazy"></div><h3>NMN</h3><div class="nad-dose">nicotinamide mononucleotide</div><div class="nad-desc">advanced cellular support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-resveratrol.jpg' | asset_url }}" alt="Resveratrol" loading="lazy"></div><h3>Resveratrol</h3><div class="nad-dose">polyphenol support</div><div class="nad-desc">healthy aging routine</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-quercetin.jpg' | asset_url }}" alt="Quercetin" loading="lazy"></div><h3>Quercetin</h3><div class="nad-dose">flavonoid support</div><div class="nad-desc">antioxidant support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-pqq.jpg' | asset_url }}" alt="PQQ" loading="lazy"></div><h3>PQQ</h3><div class="nad-dose">mitochondrial support</div><div class="nad-desc">daily energy support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-coq10.jpg' | asset_url }}" alt="CoQ10" loading="lazy"></div><h3>CoQ10</h3><div class="nad-dose">coenzyme support</div><div class="nad-desc">cellular energy support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-ala.jpg' | asset_url }}" alt="Alpha Lipoic Acid" loading="lazy"></div><h3>Alpha Lipoic<br>Acid</h3><div class="nad-dose">antioxidant support</div><div class="nad-desc">metabolic support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-taurine.jpg' | asset_url }}" alt="L-Taurine" loading="lazy"></div><h3>L&#8209;Taurine</h3><div class="nad-dose">amino acid support</div><div class="nad-desc">daily wellness support</div></article>
        <article class="nad-ingredient-card"><div class="nad-thumb"><img src="{{ 'nad-ing-vitaminc.jpg' | asset_url }}" alt="Vitamin C" loading="lazy"></div><h3>Vitamin C</h3><div class="nad-dose">vitamin support</div><div class="nad-desc">formula support</div></article>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ COMPARE ══════════════════════════════ -->
  <section class="nad-section nad-compare">
    <div class="nad-compare-layout">
      <div class="nad-compare-title">
        <h2>{{ section.settings.compare_heading }}</h2>
        <p>{{ section.settings.compare_sub }}</p>
      </div>
      <div class="nad-main-compare">
        <div class="nad-bottle"><img src="{{ nad_bottle }}" alt="{{ product.title }}" loading="lazy"></div>
        <div class="nad-copy">
          <div class="nad-brand">PANSTELLAR</div>
          <h3>NAD+ COMPLEX</h3>
          <ul class="nad-check-list">
            <li><span class="nad-tick">✓</span>2000mg per serving</li>
            <li><span class="nad-tick">✓</span>10 active ingredients</li>
            <li><span class="nad-tick">✓</span>180 capsules</li>
            <li><span class="nad-tick">✓</span>3 months supply</li>
            <li><span class="nad-tick">✓</span>Ultra liposomal technology</li>
            <li><span class="nad-tick">✓</span>Made in USA</li>
          </ul>
        </div>
        <div class="nad-vs">VS</div>
      </div>
      <div class="nad-side-compare">
        <h3>Buying Separately</h3>
        <div class="nad-bottles"><img src="{{ 'nad-typical.webp' | asset_url }}" alt="Buying supplements separately" loading="lazy"></div>
        <ul class="nad-x-list">
          <li><span class="nad-cross">×</span>Lower doses</li>
          <li><span class="nad-cross">×</span>10+ separate products</li>
          <li><span class="nad-cross">×</span>More pills to take</li>
          <li><span class="nad-cross">×</span>Shorter supply</li>
          <li><span class="nad-cross">×</span>Quality varies</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SCIENCE ══════════════════════════════ -->
  <section class="nad-section nad-science">
    <div class="nad-science-layout">
      <div class="nad-science-img"><img src="{{ 'nad-science.webp' | asset_url }}" alt="Ultra liposomal absorption" loading="lazy"></div>
      <div class="nad-science-copy">
        <h2>{{ section.settings.science_heading }}</h2>
        <p>{{ section.settings.science_sub }}</p>
      </div>
      <div class="nad-science-points">
        <div class="nad-science-point"><div class="nad-mini"><img src="{{ 'nad-icon-molecule.png' | asset_url }}" alt="" width="22" height="22"></div>Liposomal Protection — encapsulation support</div>
        <div class="nad-science-point"><div class="nad-mini"><img src="{{ 'nad-icon-molecule0.png' | asset_url }}" alt="" width="22" height="22"></div>Nutrient Payload — 10-in-1 formula support</div>
        <div class="nad-science-point"><div class="nad-mini"><img src="{{ 'nad-icon-beaker.png' | asset_url }}" alt="" width="22" height="22"></div>Enhanced Absorption — daily delivery support</div>
      </div>
      <div class="nad-research">
        <h3>{{ section.settings.research_big }}<span>{{ section.settings.research_sub }}</span></h3>
        <p>{{ section.settings.research_note }}</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ TRUST / QUALITY ══════════════════════════════ -->
  <section class="nad-section nad-trust">
    <div class="nad-trust-layout">
      <h2>{{ section.settings.quality_heading }}</h2>
      <div class="nad-quality-icons">
        <div class="nad-quality"><div class="nad-icon-circle"><img src="{{ 'nad-icon-certificate.png' | asset_url }}" alt="" width="28" height="28"></div>Third‑Party<br>Tested</div>
        <div class="nad-quality"><div class="nad-icon-circle"><img src="{{ 'nad-icon-beaker.png' | asset_url }}" alt="" width="28" height="28"></div>cGMP<br>Facility</div>
        <div class="nad-quality"><div class="nad-icon-circle"><img src="{{ 'nad-icon-made-in-usa.webp' | asset_url }}" alt="" width="28" height="28"></div>Made in<br>USA</div>
        <div class="nad-quality"><div class="nad-icon-circle"><img src="{{ 'nad-icon-molecule.png' | asset_url }}" alt="" width="28" height="28"></div>Non‑GMO</div>
        <div class="nad-quality"><div class="nad-icon-circle"><img src="{{ 'nad-icon-shield-check.png' | asset_url }}" alt="" width="28" height="28"></div>Clean &amp; Pure<br>Ingredients</div>
        <div class="nad-quality"><div class="nad-icon-circle"><img src="{{ 'nad-icon-capsule.png' | asset_url }}" alt="" width="28" height="28"></div>Clean &amp; Pure<br>Formula</div>
      </div>
      <div class="nad-badge"><img src="{{ 'nad-guarantee.webp' | asset_url }}" alt="90 Day guarantee" loading="lazy"></div>
      <div class="nad-risk">
        <h3>Try it Risk‑Free</h3>
        <p>Love it or get a full refund within 90 days of purchase.</p>
        <a href="{{ section.settings.guarantee_url | default: '#' }}" class="nad-learn">LEARN MORE</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ REVIEWS ══════════════════════════════ -->
  {%- if review_blocks.size > 0 -%}
  <section class="nad-section nad-reviews">
    <div class="nad-reviews-layout">
      <div>
        <h2>{{ section.settings.reviews_heading }}</h2>
        <div class="nad-rating">{{ section.settings.reviews_score }} <span class="nad-stars">★★★★★</span> <span style="font-weight:500;color:#5d534a">{{ section.settings.reviews_count }}</span></div>
      </div>
      <div>
        <div class="nad-review-grid">
          {%- for block in review_blocks -%}
            <article class="nad-review-card" {{ block.shopify_attributes }}>
              <div class="nad-stars">★★★★★</div>
              <p>{{ block.settings.quote }}</p>
              <div class="nad-author">— {{ block.settings.author }}</div>
            </article>
          {%- endfor -%}
        </div>
        {%- if section.settings.reviews_note != blank -%}
          <div class="nad-note">{{ section.settings.reviews_note }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ══════════════════════════════ FAQ ══════════════════════════════ -->
  {%- if faq_blocks.size > 0 -%}
  <section class="nad-section nad-faq">
    <div class="nad-faq-layout">
      <h2 class="nad-faq-title">{{ section.settings.faq_heading }}</h2>
      <div class="nad-faq-box">
        {%- for block in faq_blocks -%}
          <div class="nad-faq-item" {{ block.shopify_attributes }}>
            <button class="nad-faq-q" type="button">{{ block.settings.question }} <span>⌄</span></button>
            <div class="nad-faq-a"><p>{{ block.settings.answer }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ══════════════════════════════ STICKY ADD-TO-CART ══════════════════════════════ -->
  <section class="nad-sticky" id="nad-sticky-{{ section.id }}" aria-label="Quick add to cart">
    <div class="nad-sticky-inner">
      <div class="nad-mini-bottle"><img src="{{ nad_bottle }}" alt="{{ product.title }}" loading="lazy"></div>
      <div class="nad-headline">{{ section.settings.sticky_title }}</div>
      <div class="nad-sticky-price">
        <div class="nad-num">{{ nad_price }}</div>
        <div class="nad-sub">{{ section.settings.card_meta }} · {{ nad_day_price }}</div>
        <div class="nad-sticky-icons">
          <span><img src="{{ 'nad-icon-truck.png' | asset_url }}" alt="" width="16" height="16">{{ section.settings.trust1 }}</span>
          <span><img src="{{ 'nad-icon-shield-lock.png' | asset_url }}" alt="" width="16" height="16">{{ section.settings.trust2 }}</span>
          <span><img src="{{ 'nad-icon-shield-check.png' | asset_url }}" alt="" width="16" height="16">{{ section.settings.trust3 }}</span>
        </div>
      </div>
      {%- form 'product', product, id: nad_sticky_form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ nad_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add">{{ section.settings.cta_text }}</button>
      {%- endform -%}
    </div>
  </section>

</div><!-- /.nad-pdp -->

<script>
(function(){
  var wrap = document.getElementById('nad-pdp-{{ section.id }}');
  if (!wrap) return;

  /* ── Accordions + FAQ ── */
  wrap.querySelectorAll('.nad-acc-btn, .nad-faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var p = btn.nextElementSibling;
      var open = p.style.maxHeight && p.style.maxHeight !== '0px';
      var group = p.parentElement.parentElement;
      group.querySelectorAll('.nad-acc-panel, .nad-faq-a').forEach(function(x){
        if (x !== p) x.style.maxHeight = null;
      });
      p.style.maxHeight = open ? null : p.scrollHeight + 'px';
    });
  });

  /* ── Sticky reveal once the buy-card (CTA + accordions) scrolls out of
     view — observing the whole hero instead would keep the sticky hidden
     while the buy-card has scrolled away but the rest of the (taller) hero
     is still on screen, leaving no visible CTA in between. ── */
  var buyCard = document.getElementById('nad-buy-card-{{ section.id }}');
  var sticky = document.getElementById('nad-sticky-{{ section.id }}');
  if (buyCard && sticky && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(entries){
      sticky.classList.toggle('nad-sticky--visible', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(buyCard);
  } else if (sticky) {
    sticky.classList.add('nad-sticky--visible');
  }

  /* ── AJAX Add to Cart (Dawn cart drawer) ──
     Uses the native <cart-drawer> custom element's own renderContents()
     method (same one Dawn's product-form.js calls) — it both swaps in the
     fresh sections AND opens the drawer. window.openCartDrawer() and
     [data-cart-toggle]/[aria-controls="CartDrawer"] don't exist anywhere
     in this theme, so relying on them silently did nothing. */
  function handleForm(form){
    if (!form) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      var origText = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = '···'; }
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({
          id: form.querySelector('[name="id"]').value,
          quantity: 1,
          sections: ['cart-drawer', 'cart-icon-bubble'],
          sections_url: window.location.pathname
        })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        /* Fire Dawn's own pubsub cart-update event (same one product-form.js
           fires) — apps that hook into cart updates (reviews widgets, bundle
           upsells, etc.) listen for this, not our custom DOM event alone. */
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'nad-pdp', productVariantId: form.querySelector('[name="id"]').value, cartData: data });
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        var drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.renderContents === 'function') {
          drawer.renderContents(data);
        } else {
          window.location = window.Shopify.routes.root + 'cart';
        }
      })
      .catch(function(){ window.location = window.Shopify.routes.root + 'cart'; })
      .finally(function(){ if (btn) { btn.disabled = false; btn.textContent = origText; } });
    });
  }
  handleForm(document.getElementById('nad-hero-form-{{ section.id }}'));
  handleForm(document.getElementById('nad-sticky-form-{{ section.id }}'));
})();
</script>

{% schema %}
{
  "name": "NAD+ PDP",
  "tag": "section",
  "class": "nad-pdp-wrapper",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_bg",        "label": "Hero background (desktop)" },
    { "type": "image_picker", "id": "hero_bg_mobile", "label": "Hero background (mobile)" },
    { "type": "image_picker", "id": "product_image",  "label": "Product jar (compare + sticky)" },
    { "type": "text",     "id": "hero_eyebrow",  "label": "Eyebrow",  "default": "NAD+ SUPPORT · CELLULAR ENERGY" },
    { "type": "html",     "id": "hero_h1",       "label": "Heading (HTML allowed)", "default": "<span class=\"nad-nowrap-line\">Fuel Your</span><br><span class=\"nad-nowrap-line\">Cellular Energy</span>" },
    { "type": "textarea", "id": "hero_subtitle",  "label": "Subtitle", "default": "Advanced NAD+ Complex. Ultra Liposomal Technology." },
    { "type": "html",     "id": "hero_stat1",    "label": "Stat 1", "default": "2000mg<br>Per Serving" },
    { "type": "html",     "id": "hero_stat2",    "label": "Stat 2", "default": "10 in 1<br>Formula" },
    { "type": "html",     "id": "hero_stat3",    "label": "Stat 3", "default": "180<br>Capsules" },
    { "type": "html",     "id": "hero_stat4",    "label": "Stat 4", "default": "3 Months<br>Supply" },
    { "type": "text",     "id": "hero_foot",     "label": "Footer line", "default": "Third-party tested · cGMP facility · Made in USA" },
    { "type": "header", "content": "Buy card" },
    { "type": "text",     "id": "card_meta",     "label": "Meta line", "default": "3 Months Supply · 180 Capsules" },
    { "type": "number",   "id": "supply_days",   "label": "Days of supply (used to auto-calculate the $/day price)", "info": "How many days one order lasts. The $/day price shown on the page is calculated automatically from the live product price ÷ this number — it always stays correct, even when the price changes.", "default": 90 },
    { "type": "text",     "id": "cta_text",      "label": "CTA button", "default": "ADD TO CART" },
    { "type": "text",     "id": "trust1",        "label": "Trust 1", "default": "Free U.S. shipping · 1-2 day delivery" },
    { "type": "text",     "id": "trust2",        "label": "Trust 2", "default": "Secure checkout" },
    { "type": "text",     "id": "trust3",        "label": "Trust 3", "default": "Quality you can trust" },
    { "type": "text",     "id": "acc1_label",    "label": "Accordion 1 label", "default": "Supports" },
    { "type": "textarea", "id": "acc1_text",     "label": "Accordion 1 text",  "default": "Daily cellular energy, healthy aging routines and convenient everyday wellness support." },
    { "type": "text",     "id": "acc2_label",    "label": "Accordion 2 label", "default": "Ingredients" },
    { "type": "textarea", "id": "acc2_text",     "label": "Accordion 2 text",  "default": "NAD+, NR, NMN, Resveratrol, Quercetin, PQQ, CoQ10, Alpha Lipoic Acid, L-Taurine and Vitamin C." },
    { "type": "text",     "id": "acc3_label",    "label": "Accordion 3 label", "default": "Certificates" },
