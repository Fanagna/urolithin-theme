{{ 'ndl-liposomal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ndl-liposomal.js' | asset_url }}" defer></script>
{% liquid
  assign row_blocks = section.blocks | where: 'type', 'compare_row'
  assign fact_blocks = section.blocks | where: 'type', 'fact_row'
  assign quality_blocks = section.blocks | where: 'type', 'quality'
%}
<div class="ndl">
  <section class="ndl-section ndl-data-section">
    <div class="ndl-shell">
      <h2 class="ndl-heading">{{ section.settings.heading }}</h2>
      <p class="ndl-subheading">{{ section.settings.subheading }}</p>

      {% if row_blocks.size > 0 %}
      <div class="ndl-comparison-table-wrap">
        <table>
          <thead>
            <tr><th></th><th class="featured-col">{{ section.settings.our_column | newline_to_br }}</th><th>{{ section.settings.other_column }}</th></tr>
          </thead>
          <tbody>
            {% for block in row_blocks %}
              <tr>
                <td>{{ block.settings.label }}</td>
                <td class="featured-col{% if block.settings.our_value == '✓' %} checkmark{% elsif block.settings.our_value == '✕' %} cross{% endif %}">{{ block.settings.our_value }}</td>
                <td{% if block.settings.other_value == '✓' %} class="checkmark"{% elsif block.settings.other_value == '✕' %} class="cross"{% endif %}>{{ block.settings.other_value }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Mobile: the 3-column table can't fit a narrow screen without
           horizontal scroll, so each row becomes its own stacked card
           instead — no scrolling, nothing hidden. -->
      <div class="ndl-compare-cards">
        {% for block in row_blocks %}
          <div class="ndl-compare-card">
            <strong class="ndl-compare-card__label">{{ block.settings.label }}</strong>
            <div class="ndl-compare-card__row is-ours">
              <span class="ndl-compare-card__tag">{{ section.settings.our_column | newline_to_br }}</span>
              <span class="ndl-compare-card__value{% if block.settings.our_value == '✓' %} checkmark{% elsif block.settings.our_value == '✕' %} cross{% endif %}">{{ block.settings.our_value }}</span>
            </div>
            <div class="ndl-compare-card__row">
              <span class="ndl-compare-card__tag">{{ section.settings.other_column }}</span>
              <span class="ndl-compare-card__value{% if block.settings.other_value == '✓' %} checkmark{% elsif block.settings.other_value == '✕' %} cross{% endif %}">{{ block.settings.other_value }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
      {% endif %}

      <div class="ndl-facts-expert">
        <div class="ndl-white-card ndl-facts">
          <h3>{{ section.settings.facts_title }}</h3>
          <strong>{{ section.settings.serving_size }}</strong><br>
          <strong>{{ section.settings.servings_per_container }}</strong>
          <hr>
          {% for block in fact_blocks %}
            <div class="facts-row" {{ block.shopify_attributes }}><strong>{{ block.settings.label }}</strong><span>{{ block.settings.value }}</span></div>
          {% endfor %}
          {% if section.settings.blend_note != blank %}<p style="font-size:.78rem">{{ section.settings.blend_note }}</p>{% endif %}
          <hr>
          {% if section.settings.other_ingredients != blank %}<p style="font-size:.78rem"><strong>Other Ingredients:</strong> {{ section.settings.other_ingredients }}</p>{% endif %}
        </div>
        <div class="ndl-expert-panel">
          {% if section.settings.expert_image != blank %}
            {{ section.settings.expert_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.expert_alt }}
          {% else %}
            <img src="{{ 'ndl-formulation-expert.webp' | asset_url }}" alt="{{ section.settings.expert_alt | escape }}" loading="lazy">
          {% endif %}
        </div>
      </div>

      {% if quality_blocks.size > 0 %}
      <div class="ndl-quality-band">
        {% for block in quality_blocks %}
          <div {{ block.shopify_attributes }}>
            <span class="icon">{% render 'nad-icon', name: block.settings.icon, custom_image: block.settings.custom_icon %}</span>
            <span><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></span>
          </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "NDL — Comparison & facts",
  "tag": "section",
  "class": "ndl-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results. Real Data." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "See how PANSTELLAR NAD+ Liposomal compares with simpler formulas." },
    { "type": "textarea", "id": "our_column", "label": "Table — our column title", "default": "PANSTELLAR\nNAD+ LIPOSOMAL" },
    { "type": "text", "id": "other_column", "label": "Table — other column title", "default": "Ordinary NAD+" },
    { "type": "text", "id": "facts_title", "label": "Supplement facts title", "default": "Supplement Facts" },
    { "type": "text", "id": "serving_size", "label": "Serving size", "default": "Serving Size: 1 Capsule" },
    { "type": "text", "id": "servings_per_container", "label": "Servings per container", "default": "Servings Per Container: 180" },
    { "type": "text", "id": "blend_note", "label": "Blend note", "default": "Phosphatidylcholine, cholesterol, and medium chain triglycerides." },
    { "type": "text", "id": "other_ingredients", "label": "Other ingredients", "default": "Hypromellose capsule, rice flour, silicon dioxide, magnesium stearate." },
    { "type": "image_picker", "id": "expert_image", "label": "Formulation specialist image" },
    { "type": "text", "id": "expert_alt", "label": "Expert image alt text", "default": "Formulation specialist holding PANSTELLAR" }
  ],
  "blocks": [
    { "type": "compare_row", "name": "Comparison row", "settings": [
      { "type": "text", "id": "label", "label": "Row label", "default": "NAD+ Per Serving" },
      { "type": "text", "id": "our_value", "label": "Our value", "info": "Type ✓ or ✕ to show a check/cross mark instead of text.", "default": "2000mg" },
      { "type": "text", "id": "other_value", "label": "Other value", "default": "250–500mg" }
    ]},
    { "type": "fact_row", "name": "Supplement facts row", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "NAD+ (as Nicotinamide Adenine Dinucleotide)" },
      { "type": "text", "id": "value", "label": "Value", "default": "2000 mg" }
    ]},
    { "type": "quality", "name": "Quality badge", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "shield-check", "label": "Shield check" }, { "value": "circle-plus", "label": "Circle plus" }, { "value": "box", "label": "Box" }, { "value": "leaf-glow", "label": "Leaf glow" }
      ], "default": "shield-check" },
      { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image (optional)" },
      { "type": "text", "id": "title", "label": "Title", "default": "THIRD-PARTY TESTED" },
      { "type": "text", "id": "text", "label": "Text", "default": "For purity and potency." }
    ]}
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "NDL — Comparison & facts", "blocks": [
      { "type": "compare_row", "settings": { "label": "NAD+ Per Serving", "our_value": "2000mg", "other_value": "250–500mg" } },
      { "type": "compare_row", "settings": { "label": "Absorption Technology", "our_value": "Liposomal", "other_value": "Standard" } },
      { "type": "compare_row", "settings": { "label": "Bioavailability", "our_value": "Advanced Delivery", "other_value": "Standard" } },
      { "type": "compare_row", "settings": { "label": "Daily Dosage", "our_value": "1 Capsule", "other_value": "2–3 Capsules" } },
      { "type": "compare_row", "settings": { "label": "Third-Party Tested", "our_value": "✓", "other_value": "✓" } },
      { "type": "compare_row", "settings": { "label": "Made in USA", "our_value": "✓", "other_value": "✓" } },
      { "type": "compare_row", "settings": { "label": "GMP Certified", "our_value": "✓", "other_value": "✕" } },
      { "type": "compare_row", "settings": { "label": "Transparent Formula", "our_value": "✓", "other_value": "✕" } },
      { "type": "compare_row", "settings": { "label": "Money Back Guarantee", "our_value": "180-Day", "other_value": "60-Day" } },
      { "type": "fact_row", "settings": { "label": "NAD+ (as Nicotinamide Adenine Dinucleotide)", "value": "2000 mg" } },
      { "type": "fact_row", "settings": { "label": "Proprietary Liposomal Blend", "value": "150 mg" } },
      { "type": "quality", "settings": { "icon": "shield-check", "title": "THIRD-PARTY TESTED", "text": "For purity and potency." } },
      { "type": "quality", "settings": { "icon": "circle-plus", "title": "GMP CERTIFIED", "text": "Manufactured to quality standards." } },
      { "type": "quality", "settings": { "icon": "box", "title": "MADE IN USA", "text": "Proudly made in the United States." } },
      { "type": "quality", "settings": { "icon": "leaf-glow", "title": "TRANSPARENT FORMULA", "text": "No hidden blends. No compromises." } }
    ]}
  ]
}
{% endschema %}
