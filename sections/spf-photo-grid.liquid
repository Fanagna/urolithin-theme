{{ 'spf.css' | asset_url | stylesheet_tag }}
<div class="spf spf-photos-wrap" style="--spf-bg:{{ section.settings.bg }};--spf-line:{{ section.settings.line }}">
  {%- if section.settings.heading != blank -%}<h2 class="spf-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="spf-photos" style="--spf-cols:{{ section.settings.columns }};--spf-mcols:{{ section.settings.mobile_width }}px;--spf-gap:{{ section.settings.gap }}px;--spf-photo-ar:{{ section.settings.ratio }};--spf-photo-radius:{{ section.settings.radius }}px">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}{%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} class="spf-photo"{% if block.settings.link != blank %} href="{{ block.settings.link }}" target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
        {%- render 'spf-img', img: block.settings.image, file: block.settings.image_file, w: 440, alt: block.settings.alt -%}
        {%- if section.settings.show_play -%}<span class="spf-photo-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>{%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SPF · Photo grid",
  "tag": "section",
  "class": "spf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (blank = hidden)" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "mobile_width", "label": "Card width (mobile scroll)", "min": 120, "max": 260, "step": 5, "unit": "px", "default": 175 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "text", "id": "ratio", "label": "Image ratio (w/h)", "default": "1.06", "info": "e.g. 1.06 (creators) or 1.28 (community)" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "checkbox", "id": "show_play", "label": "Show play icon (video thumbnails)", "default": false },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "line", "label": "Border", "default": "#e7e2da" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_file", "label": "…or asset filename", "info": "e.g. spf-creator-1.webp / spf-community-1.webp" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Community photo" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SPF · Creator gallery",
      "settings": { "columns": 6, "mobile_width": 155, "gap": 11, "ratio": "1.06", "show_play": true },
      "blocks": [
        { "type": "photo", "settings": { "image_file": "spf-creator-1.webp", "alt": "Creator video 1" } },
        { "type": "photo", "settings": { "image_file": "spf-creator-2.webp", "alt": "Creator video 2" } },
        { "type": "photo", "settings": { "image_file": "spf-creator-3.webp", "alt": "Creator video 3" } },
        { "type": "photo", "settings": { "image_file": "spf-creator-4.webp", "alt": "Creator video 4" } },
        { "type": "photo", "settings": { "image_file": "spf-creator-5.webp", "alt": "Creator video 5" } },
        { "type": "photo", "settings": { "image_file": "spf-creator-6.webp", "alt": "Creator video 6" } }
      ]
    },
    {
      "name": "SPF · Community gallery",
      "settings": { "columns": 6, "mobile_width": 170, "gap": 2, "ratio": "1.28", "radius": 0, "show_play": false },
      "blocks": [
        { "type": "photo", "settings": { "image_file": "spf-community-1.webp", "alt": "Community 1" } },
        { "type": "photo", "settings": { "image_file": "spf-community-2.webp", "alt": "Community 2" } },
        { "type": "photo", "settings": { "image_file": "spf-community-3.webp", "alt": "Community 3" } },
        { "type": "photo", "settings": { "image_file": "spf-community-4.webp", "alt": "Community 4" } },
        { "type": "photo", "settings": { "image_file": "spf-community-5.webp", "alt": "Community 5" } },
        { "type": "photo", "settings": { "image_file": "spf-community-6.webp", "alt": "Community 6" } }
      ]
    }
  ]
}
{% endschema %}
