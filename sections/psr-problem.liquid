{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
<section class="psr psr-section psr-problem" id="problem" style="background:{{ section.settings.background }}">
  <div class="psr-shell psr-split psr-split--copy-first">
    <div class="psr-copy">
      <p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span><span class="psr-kicker__rule"></span></p>
      <h2 class="psr-title">{{ section.settings.heading_before }} <em>{{ section.settings.heading_highlight }}</em> {{ section.settings.heading_after }}</h2>
      <div class="rte psr-section-copy">{{ section.settings.body }}</div>
      <div class="psr-stat-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="psr-icon">{% case forloop.index %}{% when 1 %}{% assign psr_stat_fallback = 'psr-v10-premium-leaf.webp' %}{% when 2 %}{% assign psr_stat_fallback = 'psr-v10-icon-sun.svg' %}{% else %}{% assign psr_stat_fallback = 'psr-v10-premium-brain.webp' %}{% endcase %}{% render 'psr-editable-icon', custom_image: block.settings.icon, fallback_asset: psr_stat_fallback, class: 'psr-svg-icon psr-premium-icon', alt: '' %}</span><strong>{{ block.settings.value }}</strong><p>{{ block.settings.text }}</p></article>{% endfor %}</div>
      {% if section.settings.note_text != blank %}<div class="psr-note"><span>{% render 'psr-editable-icon', custom_image: section.settings.note_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><div class="rte">{{ section.settings.note_text }}</div>{% if section.settings.note_button_label != blank %}<button class="psr-note__cta" data-scroll="{{ section.settings.note_button_link }}" type="button"><span>{{ section.settings.note_button_label }}</span></button>{% endif %}</div>{% endif %}
    </div>
    <div class="psr-photo-frame psr-photo-frame--soft">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img alt="{{ section.settings.image_alt | escape }}" loading="lazy" src="{{ 'psr-v10-image-problem-woman.webp' | asset_url }}">{% endif %}</div>
  </div>
</section>
{% schema %}
{
  "name": "PSR — Problem",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The problem — and the real reason"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading before highlight",
      "default": "Why do you still feel"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted text",
      "default": "tired"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading after highlight",
      "default": "even when you do everything right?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>You eat clean, exercise, and sleep well… but energy drops in the afternoon, skin looks duller, and your mind feels foggy.</p><p>It’s not your fault. After 40, your cells naturally produce less energy.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Woman experiencing an afternoon energy dip"
    },
    {
      "type": "image_picker",
      "id": "note_icon",
      "label": "Note icon"
    },
    {
      "type": "richtext",
      "id": "note_text",
      "label": "Note text",
      "default": "<p><strong>The good news?</strong> You can support your cells naturally and feel more like yourself again.</p>"
    },
    {
      "type": "text",
      "id": "note_button_label",
      "label": "Note button label",
      "default": "Explore the formula"
    },
    {
      "type": "text",
      "id": "note_button_link",
      "label": "Note button anchor",
      "default": "#how-it-works"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "linear-gradient(90deg,#fffaf7 0 52%,#f1dfd5 52% 100%)"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "40+"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Cellular energy changes may feel more noticeable."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PSR — Problem",
      "blocks": [
        { "type": "stat", "settings": { "value": "40+", "text": "Cellular energy changes may feel more noticeable." } },
        { "type": "stat", "settings": { "value": "3 PM", "text": "A common time for the afternoon energy dip." } },
        { "type": "stat", "settings": { "value": "Daily", "text": "Foggy focus and dull-looking skin can feel persistent." } }
      ]
    }
  ]
}
{% endschema %}
