{{ 'psr-panstellar-v11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'psr-panstellar-v11.js' | asset_url }}" defer></script>
<section class="psr psr-section psr-ingredients" id="ingredients" style="background:{{ section.settings.background }}"><div class="psr-shell psr-split"><div class="psr-product-stage psr-product-stage--large">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img alt="{{ section.settings.image_alt | escape }}" loading="lazy" src="{{ 'psr-v10-image-product-bottle.webp' | asset_url }}">{% endif %}</div><div class="psr-copy"><p class="psr-kicker"><span class="psr-kicker__badge">{% render 'psr-editable-icon', custom_image: section.settings.kicker_icon, fallback_asset: 'psr-v10-icon-leaf.svg', class: 'psr-svg-icon', alt: '' %}</span><span class="psr-kicker__label">{{ section.settings.kicker }}</span><span class="psr-kicker__rule"></span></p><h2 class="psr-title">{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.body }}</div><div class="psr-ingredient-list">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="psr-icon">{% case forloop.index %}{% when 1 %}{% assign psr_ing_fallback = 'psr-v10-premium-molecule.webp' %}{% when 2 %}{% assign psr_ing_fallback = 'psr-v10-premium-leaf.webp' %}{% when 3 %}{% assign psr_ing_fallback = 'psr-v10-premium-absorption.webp' %}{% else %}{% assign psr_ing_fallback = 'psr-v10-premium-calendar.png' %}{% endcase %}{% render 'psr-editable-icon', custom_image: block.settings.icon, fallback_asset: psr_ing_fallback, class: 'psr-svg-icon psr-premium-icon', alt: '' %}</span><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></article>{% endfor %}</div></div></div></section>
{% schema %}
{
  "name": "PSR — Ingredients",
  "tag": "section",
  "class": "psr-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Panstellar product bottle"
    },
    {
      "type": "image_picker",
      "id": "kicker_icon",
      "label": "Kicker icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Advanced. Science-backed. Made for you."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What’s Inside"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro text",
      "default": "<p>Each daily serving delivers a premium blend designed to support energy, vitality and healthy aging.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "500mg NMN"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Supports cellular energy production and healthy aging."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PSR — Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "500mg NMN", "text": "Supports cellular energy production and healthy aging." } },
        { "type": "ingredient", "settings": { "title": "600mg Trans-Resveratrol", "text": "Supports cellular resilience and natural healthy-aging pathways." } },
        { "type": "ingredient", "settings": { "title": "Liposomal Technology", "text": "Designed for enhanced absorption and bioavailability." } },
        { "type": "ingredient", "settings": { "title": "One bottle lasts 90 days", "text": "One daily serving and three months of support." } }
      ]
    }
  ]
}
{% endschema %}
