{{ 'spf.css' | asset_url | stylesheet_tag }}
<div class="spf spf-experts-wrap" style="--spf-bg:{{ section.settings.bg }};--spf-ink:{{ section.settings.ink }};--spf-line:{{ section.settings.line }}">
  <div class="spf-experts">
    <div class="spf-expert-grid">
      {%- for block in section.blocks -%}
        <article class="spf-expert" {{ block.shopify_attributes }}>
          {%- render 'spf-img', img: block.settings.image, file: block.settings.image_file, w: 480, alt: block.settings.name -%}
          <strong>{{ block.settings.name }}</strong>
          <span>{{ block.settings.title }}</span>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.quote != blank -%}
      <aside class="spf-expert-quote" style="background:{{ section.settings.quote_bg }}">{{ section.settings.quote }}{%- if section.settings.quote_author != blank -%}<strong>{{ section.settings.quote_author }}</strong>{%- endif -%}</aside>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SPF · Experts",
  "tag": "section",
  "class": "spf-section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "line", "label": "Border", "default": "#e7e2da" },
    { "type": "header", "content": "Quote" },
    { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>The strains are rigorously selected for their effectiveness and scientific reliability.</p>" },
    { "type": "text", "id": "quote_author", "label": "Quote author", "default": "– Dr. Michael Dupont" },
    { "type": "color_background", "id": "quote_bg", "label": "Quote background", "default": "linear-gradient(135deg,#f5f2ee,#fff)" }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_file", "label": "…or asset filename", "info": "e.g. spf-expert-1.webp" },
        { "type": "text", "id": "name", "label": "Name", "default": "Dr. Name" },
        { "type": "text", "id": "title", "label": "Title", "default": "Specialist" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SPF · Experts",
      "blocks": [
        { "type": "expert", "settings": { "image_file": "spf-expert-1.webp", "name": "Dr. Michael Dupont", "title": "Gastroenterologist" } },
        { "type": "expert", "settings": { "image_file": "spf-expert-2.webp", "name": "Dr. Anne Lefevre", "title": "Clinical Nutritionist" } },
        { "type": "expert", "settings": { "image_file": "spf-expert-3.webp", "name": "Dr. David Martin", "title": "Microbiome Researcher" } },
        { "type": "expert", "settings": { "image_file": "spf-expert-4.webp", "name": "Dr. Sophie Bernard", "title": "Pharmacist" } },
        { "type": "expert", "settings": { "image_file": "spf-expert-5.webp", "name": "Dr. Julien Moreau", "title": "Nutrition Specialist" } }
      ]
    }
  ]
}
{% endschema %}
