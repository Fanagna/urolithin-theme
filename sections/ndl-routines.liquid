{{ 'ndl-liposomal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ndl-liposomal.js' | asset_url }}" defer></script>
<div class="ndl">
  <section class="ndl-section ndl-ugc-section">
    <div class="ndl-shell">
      <h2 class="ndl-ugc-title">{{ section.settings.heading }}</h2>
      <div class="ndl-hscroll-wrap">
        <div class="ndl-routine-grid">
          {% for block in section.blocks %}
            <article class="ndl-routine-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {% else %}
                {% assign ndl_routine_n = forloop.index0 | modulo: 6 | plus: 1 %}
                {% capture ndl_routine_asset %}ndl-review-{{ ndl_routine_n }}.webp{% endcapture %}
                <img src="{{ ndl_routine_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% endif %}
              <div class="ndl-routine-body">
                <strong>{{ block.settings.name }}</strong>
                <p>“{{ block.settings.quote }}”</p>
                <small>{{ block.settings.tag }}</small>
              </div>
            </article>
          {% endfor %}
        </div>
        <button type="button" class="ndl-hscroll-arrow is-hidden" data-ndl-hscroll-prev aria-label="Previous">‹</button>
        <button type="button" class="ndl-hscroll-arrow" data-ndl-hscroll-next aria-label="Next">›</button>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "NDL — Daily routines",
  "tag": "section",
  "class": "ndl-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Fits Into Their Daily Routine" }
  ],
  "blocks": [
    { "type": "routine", "name": "Routine card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Mark, 52" },
      { "type": "text", "id": "quote", "label": "Quote", "default": "More energy in the morning, better focus all day." },
      { "type": "text", "id": "tag", "label": "Tag", "default": "☀ Daily Routine" }
    ]}
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "NDL — Daily routines", "blocks": [
      { "type": "routine", "settings": { "name": "Mark, 52", "quote": "More energy in the morning, better focus all day.", "tag": "☀ Daily Routine" } },
      { "type": "routine", "settings": { "name": "Sarah, 48", "quote": "My skin looks brighter and I feel years younger.", "tag": "☀ Morning Ritual" } },
      { "type": "routine", "settings": { "name": "James, 55", "quote": "Supports my recovery and keeps me performing.", "tag": "🏋 Post-Workout" } },
      { "type": "routine", "settings": { "name": "Lisa, 50", "quote": "Clearer mind, better sleep, better me.", "tag": "☾ Night Routine" } },
      { "type": "routine", "settings": { "name": "David, 57", "quote": "I feel more like myself than I have in years.", "tag": "☀ Daily Routine" } },
      { "type": "routine", "settings": { "name": "Nicole, 46", "quote": "Easy to take, easy to love. My new daily essential.", "tag": "☀ Morning Ritual" } }
    ]}
  ]
}
{% endschema %}
