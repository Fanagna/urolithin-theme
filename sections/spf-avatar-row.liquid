{{ 'spf.css' | asset_url | stylesheet_tag }}
<div class="spf spf-avatars-wrap" style="--spf-bg:{{ section.settings.bg }};--spf-ink:{{ section.settings.ink }};--spf-line:{{ section.settings.line }};--spf-muted:{{ section.settings.muted }}">
  {%- if section.settings.heading != blank -%}<h2 class="spf-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="spf-avatars" style="--spf-cols:{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}{%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} class="spf-avatar"{% if block.settings.link != blank %} href="{{ block.settings.link }}" target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
        {%- render 'spf-img', img: block.settings.image, file: block.settings.image_file, w: 224, wid: 112, hei: 112, alt: block.settings.handle -%}
        <div class="spf-avatar-handle">{{ block.settings.handle }}</div>
        {%- if block.settings.sub != blank -%}<div class="spf-avatar-sub">{{ block.settings.sub }}</div>{%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SPF · Avatar row",
  "tag": "section",
  "class": "spf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (blank = hidden)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Sub-text", "default": "#5d5a57" },
    { "type": "color", "id": "line", "label": "Border", "default": "#e7e2da" }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Avatar",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_file", "label": "…or asset filename", "info": "e.g. spf-influencer-1.webp" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@handle" },
        { "type": "text", "id": "sub", "label": "Sub-text", "default": "100K followers" },
        { "type": "url", "id": "link", "label": "Profile link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SPF · Avatar row",
      "blocks": [
        { "type": "avatar", "settings": { "image_file": "spf-influencer-1.webp", "handle": "@madeleine_mode", "sub": "128K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-2.webp", "handle": "@chloeglow", "sub": "214K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-3.webp", "handle": "@laury_fit", "sub": "98K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-4.webp", "handle": "@healthbycam", "sub": "156K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-5.webp", "handle": "@marine_diet", "sub": "87K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-6.webp", "handle": "@justine.lifestyle", "sub": "132K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-7.webp", "handle": "@sarahealthmy", "sub": "203K followers" } },
        { "type": "avatar", "settings": { "image_file": "spf-influencer-8.webp", "handle": "@manonwellness", "sub": "77K followers" } }
      ]
    }
  ]
}
{% endschema %}
