{% comment %}
  AKV — Akkermansia PDP (v2 landing, converted from standalone mockup).
  All prices are computed in Liquid from the live variant / selling plan —
  never hardcoded (bug #32 lesson). Offers add to cart via real
  {% form 'product' %} with AJAX enhancement + native fallback.
  Reviews render only when real content is filled in (no fake counts/bars).
{% endcomment %}

{{ 'akv-pdp.css' | asset_url | stylesheet_tag }}
<link rel="preload" as="image" href="{{ 'akv-hero.webp' | asset_url }}" fetchpriority="high">

{% render 'panstellar-product-schema', product: product %}

{%- if product != blank -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign supply_days = section.settings.supply_days | default: 90
  assign price_1 = variant.price
  assign price_2 = variant.price | times: 2
  assign price_3 = variant.price | times: 3
  assign per_day_1 = price_1 | divided_by: supply_days

  assign sub_alloc = variant.selling_plan_allocations | first
  if sub_alloc
    assign sub_price = sub_alloc.price
    assign sub_per_day = sub_price | divided_by: supply_days
    assign sub_plan_id = sub_alloc.selling_plan.id
    assign saved = price_1 | minus: sub_price | times: 100
    assign sub_save = saved | divided_by: price_1
  endif

  assign review_blocks = section.blocks | where: 'type', 'review'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign has_reviews = false
  if review_blocks.size > 0 or section.settings.rating != blank or section.settings.judgeme or app_blocks.size > 0
    assign has_reviews = true
  endif

  assign hero_form_id = 'akv-hero-form-' | append: section.id
  assign sticky_form_id = 'akv-sticky-form-' | append: section.id
-%}

<div class="akv" id="akv-{{ section.id }}">

  <!-- ═══════════ HERO ═══════════ -->
  <section class="akv-hero">
    <div class="akv-shell akv-hero-grid">
      <div class="akv-hero-copy">
        <h1>{{ section.settings.hero_heading }}</h1>
        <p class="akv-hero-sub">{{ section.settings.hero_sub }}</p>
        <div class="akv-benefits-inline">
          <span>{{ section.settings.hero_b1 }}</span><i></i>
          <span>{{ section.settings.hero_b2 }}</span><i></i>
          <span>{{ section.settings.hero_b3 }}</span>
        </div>
        <div class="akv-price">
          {{ price_1 | money }}
          {%- if variant.compare_at_price > variant.price -%}
            <s style="font-size:.42em;color:#8a8378;text-decoration-thickness:2px;margin-left:10px">{{ variant.compare_at_price | money }}</s>
          {%- endif -%}
        </div>
        <p class="akv-price-note">&asymp; {{ per_day_1 | money }} per day</p>
        <div id="akv-hero-cta-{{ section.id }}" style="display:flex;gap:12px;flex-wrap:wrap">
          {%- form 'product', product, id: hero_form_id, class: 'akv-buy-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="add" class="akv-btn akv-btn--gold" style="max-width:320px">
              {{ section.settings.hero_cta }} &mdash; {{ price_1 | money }}
            </button>
          {%- endform -%}
          <a class="akv-btn akv-btn--outline" href="#akv-buy">{{ section.settings.hero_cta2 }}</a>
        </div>
        <div class="akv-guarantee">
          <svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
          <span>{{ section.settings.guarantee_text }}</span>
        </div>
      </div>
      <div class="akv-hero-visual">
        {%- assign hero_slides = section.blocks | where: 'type', 'hero_slide' -%}
        {%- if hero_slides.size > 0 -%}
          <div class="akv-hero-gallery" data-akv-gallery>
            <div class="akv-hero-stage">
              {%- for block in hero_slides -%}
                {%- assign hsrc = '' -%}{%- assign hfull = '' -%}
                {%- if block.settings.img_file != blank -%}{%- assign hsrc = block.settings.img_file | asset_url -%}{%- assign hfull = hsrc -%}
                {%- elsif block.settings.img != blank -%}{%- assign hsrc = block.settings.img | image_url: width: 1000 -%}{%- assign hfull = block.settings.img | image_url: width: 1600 -%}{%- endif -%}
                <a class="akv-hero-slide{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" href="{{ hfull }}" target="_blank" rel="noopener"{% if block.settings.fit == 'contain' %} data-fit="contain"{% endif %} {{ block.shopify_attributes }}>
                  <img src="{{ hsrc }}" alt="{{ block.settings.caption | default: product.title | escape }}"{% if forloop.first %} fetchpriority="high" width="788" height="545"{% else %} loading="lazy"{% endif %}>
                  {%- if block.settings.caption != blank -%}<span class="akv-hero-cap">{{ block.settings.caption }} <span aria-hidden="true">&#10530;</span></span>{%- endif -%}
                </a>
              {%- endfor -%}
            </div>
            {%- if hero_slides.size > 1 -%}
              <div class="akv-hero-thumbs">
                {%- for block in hero_slides -%}
                  {%- comment -%} Prefer a small thumb asset (thumb_file) so the tiny
                      58px thumbnail doesn't download the full-res slide image. {%- endcomment -%}
                  {%- assign tsrc = '' -%}
                  {%- if block.settings.thumb_file != blank -%}{%- assign tsrc = block.settings.thumb_file | asset_url -%}
                  {%- elsif block.settings.img != blank -%}{%- assign tsrc = block.settings.img | image_url: width: 160 -%}
                  {%- elsif block.settings.img_file != blank -%}{%- assign tsrc = block.settings.img_file | asset_url -%}{%- endif -%}
                  <button class="akv-hero-thumb{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" type="button" aria-label="{{ block.settings.caption | default: 'View image' | escape }}"><img src="{{ tsrc }}" alt="" loading="lazy"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <img src="{{ 'akv-hero.webp' | asset_url }}" alt="{{ product.title | escape }} bottle" width="788" height="545" fetchpriority="high">
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- ═══════════ PROOF STRIP (mobile: auto-scrolling marquee, CSS only) ═══════════ -->
  {%- capture proof_items -%}
    {%- if section.settings.rating != blank -%}
      <span class="akv-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span><strong>{{ section.settings.rating }}</strong>{% if section.settings.rating_count != blank %} &middot; {{ section.settings.rating_count }}{% endif %}</span>
      <span class="akv-dot">&bull;</span>
    {%- elsif section.settings.judgeme -%}
      <span class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">{{ product.metafields.judgeme.badge }}</span>
      <span class="akv-dot">&bull;</span>
    {%- endif -%}
    <span>{{ section.settings.proof_1 }}</span>
    <span class="akv-dot">&bull;</span>
    <span>{{ section.settings.proof_2 }}</span>
    <span class="akv-dot">&bull;</span>
    <span>{{ section.settings.proof_3 }}</span>
    <span class="akv-dot akv-dot--loop" aria-hidden="true">&bull;</span>
  {%- endcapture -%}
  <div class="akv-proof">
    <div class="akv-proof-inner">
      <div class="akv-proof-track">
        <div class="akv-proof-group">{{ proof_items }}</div>
        <div class="akv-proof-group" aria-hidden="true">{{ proof_items }}</div>
      </div>
    </div>
  </div>

  <!-- ═══════════ SCIENCE ═══════════ -->
  <section class="akv-science" id="akv-science">
    <div class="akv-science-grid">
      <div class="akv-science-photo">
        <img src="{{ 'akv-science-man.webp' | asset_url }}" alt="Researcher reviewing probiotic quality data" width="488" height="359" loading="lazy">
      </div>
      <div class="akv-science-main">
        <h2>{{ section.settings.sci_heading }}</h2>
        <div class="akv-question-grid">
          <div class="akv-question akv-card">
            <div class="akv-num">01</div>
            <h3>{{ section.settings.q1_title }}</h3>
            <p>{{ section.settings.q1_text }}</p>
          </div>
          <div class="akv-question akv-card">
            <div class="akv-num">02</div>
            <h3>{{ section.settings.q2_title }}</h3>
            <p>{{ section.settings.q2_text }}</p>
          </div>
        </div>
      </div>
      <div class="akv-afu">
        <h3>{{ section.settings.afu_heading }}</h3>
        <p class="akv-copy">{{ section.settings.afu_text }}</p>
        <div class="akv-afu-image">
          <img src="{{ 'akv-afu-diagram.webp' | asset_url }}" alt="How AFU counting measures active probiotic cells" width="1000" height="500" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Social-proof bar (below Science) — editable rating + testimonials
      + bottle + sales stat. All numbers/quotes are settings (never hard-coded). {%- endcomment -%}
  {%- assign sp_quotes = section.blocks | where: 'type', 'sp_quote' -%}
  {%- if section.settings.sp_enabled -%}
  <section class="akv-sp" aria-label="Customer rating and testimonials">
    <div class="akv-shell">
      <div class="akv-sp-bar">
        <div class="akv-sp-rating">
          <div class="akv-sp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <div class="akv-sp-number">{{ section.settings.sp_rating }}<small>{{ section.settings.sp_rating_suffix }}</small></div>
          {%- if section.settings.sp_caption != blank -%}<div class="akv-sp-caption">{{ section.settings.sp_caption }}</div>{%- endif -%}
        </div>

        {%- if sp_quotes.size > 0 -%}
          <div class="akv-sp-quotes">
            {%- for block in sp_quotes -%}
              {%- assign av = '' -%}
              {%- if block.settings.avatar_file != blank -%}{%- assign av = block.settings.avatar_file | asset_url -%}
              {%- elsif block.settings.avatar != blank -%}{%- assign av = block.settings.avatar | image_url: width: 96 -%}{%- endif -%}
              <article class="akv-sp-quote" {{ block.shopify_attributes }}>
                <blockquote>{{ block.settings.quote | newline_to_br }}{%- if block.settings.author != blank -%}<span class="akv-sp-author">{{ block.settings.author }}</span>{%- endif -%}</blockquote>
                <div class="akv-sp-foot">
                  {%- if av != blank -%}<img src="{{ av }}" alt="{{ block.settings.author | escape }}" width="34" height="34" loading="lazy">{%- endif -%}
                  <span class="akv-sp-qstars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign sp_bottle = '' -%}
        {%- if section.settings.sp_bottle_file != blank -%}{%- assign sp_bottle = section.settings.sp_bottle_file | asset_url -%}
        {%- elsif section.settings.sp_bottle != blank -%}{%- assign sp_bottle = section.settings.sp_bottle | image_url: width: 320 -%}{%- endif -%}
        {%- if sp_bottle != blank -%}
          <div class="akv-sp-bottle"><img src="{{ sp_bottle }}" alt="{{ product.title | escape }}" width="112" height="195" loading="lazy"></div>
        {%- endif -%}

        {%- if section.settings.sp_sales_number != blank -%}
          <div class="akv-sp-sales">
            <strong>{{ section.settings.sp_sales_number }}</strong>
            <span>{{ section.settings.sp_sales_text }}</span>
            <div class="akv-sp-arrow" aria-hidden="true">&#8599;</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} Doctor / scientific-proof video. Shows when enabled; a neutral
      video placeholder stands in until a real clip is added. Expert name/credential
      stay blank until a genuine expert is provided (no fabricated endorsement). {%- endcomment -%}
  {%- if section.settings.doctor_enabled -%}
  <!-- ═══════════ DOCTOR / SCIENTIFIC PROOF ═══════════ -->
  <section class="akv-doctor" id="akv-doctor">
    <div class="akv-shell akv-doctor-grid">
      <div class="akv-doctor-copy">
        <div class="akv-kicker">{{ section.settings.doctor_kicker }}</div>
        <h2>{{ section.settings.doctor_heading }}</h2>
        <p class="akv-copy">{{ section.settings.doctor_body }}</p>
        {%- if section.settings.doctor_name != blank -%}
          <div class="akv-doctor-person">
            {%- if section.settings.doctor_photo != blank -%}<img class="akv-doctor-avatar" src="{{ section.settings.doctor_photo | image_url: width: 120 }}" alt="{{ section.settings.doctor_name | escape }}" width="58" height="58" loading="lazy">{%- endif -%}
            <div><strong>{{ section.settings.doctor_name }}</strong>{% if section.settings.doctor_credential != blank %}<span>{{ section.settings.doctor_credential }}</span>{% endif %}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.doctor_disclaimer != blank -%}<p class="akv-doctor-disc">{{ section.settings.doctor_disclaimer }}</p>{%- endif -%}
      </div>
      <div class="akv-doctor-video">
        {%- assign dposter = '' -%}
        {%- if section.settings.doctor_poster_file != blank -%}{%- assign dposter = section.settings.doctor_poster_file | asset_url -%}
        {%- elsif section.settings.doctor_poster != blank -%}{%- assign dposter = section.settings.doctor_poster | image_url: width: 1000 -%}{%- endif -%}
        {%- if section.settings.doctor_video_file != blank -%}
          <div class="akv-video-placeholder akv-has-video akv-doctor-ph">
            <video class="akv-video-el" preload="none" playsinline{% if dposter != blank %} poster="{{ dposter }}"{% endif %}>
              <source src="{{ section.settings.doctor_video_file | asset_url }}" type="video/mp4">
            </video>
            <button class="akv-play akv-video-playbtn" type="button" aria-label="Play video">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5Z"/></svg>
            </button>
          </div>
        {%- elsif section.settings.doctor_video_url != blank -%}
          <a class="akv-video-placeholder akv-doctor-ph" href="{{ section.settings.doctor_video_url }}" target="_blank" rel="noopener"{% if dposter != blank %} style="background-image:linear-gradient(0deg,rgba(0,0,0,.3),transparent 55%),url('{{ dposter }}');background-size:cover;background-position:center"{% endif %}>
            <span class="akv-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z"/></svg></span>
          </a>
        {%- else -%}
          {%- comment -%} Placeholder until the real video is added {%- endcomment -%}
          <div class="akv-video-placeholder akv-doctor-ph"{% if dposter != blank %} style="background-image:linear-gradient(0deg,rgba(0,0,0,.3),transparent 55%),url('{{ dposter }}');background-size:cover;background-position:center"{% endif %}>
            <span class="akv-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z"/></svg></span>
            <span class="akv-video-label">VIDEO PLACEHOLDER</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ═══════════ VALUE ═══════════ -->
  <section class="akv-value" id="akv-value">
    <div class="akv-shell">
      <div class="akv-value-grid">
        <div class="akv-price-box akv-card">
          <div>
            <h3>{{ section.settings.val_brand_label }}</h3>
            <div class="akv-old-price">{{ section.settings.val_brand_price }}</div>
          </div>
        </div>
        <div class="akv-value-card">
          <div class="akv-badge">{{ section.settings.val_badge }}</div>
          <div>
            <div class="akv-value-brand">PANSTELLAR</div>
            <div class="akv-value-price">{{ price_1 | money }}</div>
          </div>
          <p class="akv-value-note">{{ section.settings.val_note }}</p>
        </div>
      </div>
      <p class="akv-value-caption">{{ section.settings.val_caption }}</p>

      <!-- Daily comfort -->
      <div class="akv-daily-grid akv-card">
        <div class="akv-daily-photo">
          <img src="{{ 'akv-daily-comfort.webp' | asset_url }}" alt="Enjoying a comfortable daily routine" width="698" height="411" loading="lazy">
        </div>
        <div class="akv-daily-content">
          <div class="akv-daily-copy">
            <h2>{{ section.settings.daily_heading }}</h2>
            <p class="akv-copy">{{ section.settings.daily_copy }}</p>
          </div>
          {%- capture icon_benefits -%}
            <div class="akv-icon-benefit">
              <div class="akv-icon-circle"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M9 12.5l2 2 4-5"/></svg></div>
              <span>{{ section.settings.daily_b1 }}</span>
            </div>
            <div class="akv-icon-benefit">
              <div class="akv-icon-circle"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/></svg></div>
              <span>{{ section.settings.daily_b2 }}</span>
            </div>
            <div class="akv-icon-benefit">
              <div class="akv-icon-circle"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 13h5l-1 8 8-10h-5l1-8z"/></svg></div>
              <span>{{ section.settings.daily_b3 }}</span>
            </div>
          {%- endcapture -%}
          <div class="akv-icon-benefits">
            <div class="akv-icon-track">
              <div class="akv-icon-group">{{ icon_benefits }}</div>
              <div class="akv-icon-group" aria-hidden="true">{{ icon_benefits }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ INGREDIENTS ═══════════ -->
  <section class="akv-ingredients" id="akv-ingredients">
    <div class="akv-shell">
      <div class="akv-ingredients-grid">
        <div class="akv-ingredients-intro">
          <p class="akv-kicker">Full formula, no proprietary vagueness</p>
          <h2>{{ section.settings.ing_heading }}</h2>
          <p>{{ section.settings.ing_intro }}</p>
        </div>
        <div class="akv-table-wrap">
          <div class="akv-ingredient-table">
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                <div class="akv-ingredient-row" {{ block.shopify_attributes }}>
                  <div class="akv-ingredient-name">{{ block.settings.name }}</div>
                  {%- if block.settings.img != blank -%}
                    <img class="akv-ingredient-image" src="{{ block.settings.img | asset_url }}" alt="{{ block.settings.name | escape }}" width="440" height="173" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
            <div class="akv-ingredient-row akv-ingredient-total">
              <div class="akv-ingredient-name">{{ section.settings.ing_total }}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quality band -->
      <div class="akv-quality">
        <div class="akv-quality-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6v5l4 9a2 2 0 0 1-2 3H7a2 2 0 0 1-2-3l4-9V3z"/><path d="M8 14h8"/></svg>{{ section.settings.qual_1 }}</div>
        <div class="akv-quality-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M9 12.5l2 2 4-5"/></svg>{{ section.settings.qual_2 }}</div>
        <div class="akv-quality-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>{{ section.settings.qual_3 }}</div>
        <div class="akv-quality-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/></svg>{{ section.settings.qual_4 }}</div>
        {%- if section.settings.coa_url != blank -%}
          <div class="akv-quality-item"><a class="akv-btn" href="{{ section.settings.coa_url }}" target="_blank" rel="noopener">{{ section.settings.coa_label }}</a></div>
        {%- endif -%}
      </div>

    </div>
  </section>

  {%- comment -%} Scientific Experts (below ingredients) — shared snippet, renders
      only when enabled AND real expert blocks exist. {%- endcomment -%}
  {%- assign expert_blocks = section.blocks | where: 'type', 'expert' -%}
  {%- assign research_blocks = section.blocks | where: 'type', 'research_item' -%}
  {%- if section.settings.experts_enabled and expert_blocks.size > 0 -%}
    {{ 'sciexp-experts.css' | asset_url | stylesheet_tag }}
    {% render 'sciexp-experts',
       heading: section.settings.experts_heading,
       show_shield: section.settings.experts_shield,
       research_heading: section.settings.experts_research_heading,
       bg_color: section.settings.experts_bg,
       accent_color: section.settings.experts_accent,
       accent_color2: section.settings.experts_accent2,
       experts: expert_blocks,
       research: research_blocks %}
  {%- endif -%}

  {%- assign media_blocks = section.blocks | where: 'type', 'media_logo' -%}
  {%- assign video_blocks = section.blocks | where: 'type', 'creator_video' -%}
  {%- if section.settings.media_enabled and media_blocks.size > 0 -%}
  <!-- ═══════════ PANSTELLAR IN THE MEDIA ═══════════ -->
  <section class="akv-media-creators" id="akv-media">
    <div class="akv-shell">
      <div class="akv-media-head">
        <div>
          <div class="akv-kicker">{{ section.settings.media_kicker }}</div>
          <h2>{{ section.settings.media_heading }}</h2>
          <p>{{ section.settings.media_sub }}</p>
        </div>
      </div>

      {%- comment -%} Auto-scrolling logo marquee: two identical groups so the
        CSS translateX(-50%) loop is seamless. shopify_attributes omitted (would
        duplicate the block anchor across both groups); blocks stay editable from
        the theme-editor sidebar. Alt text prefers the image's own alt. {%- endcomment -%}
      {%- capture media_logos_html -%}
        {%- for block in media_blocks -%}
          {%- capture logo_inner -%}{%- if block.settings.logo != blank -%}<img src="{{ block.settings.logo | image_url: width: 320 }}" alt="{{ block.settings.logo.alt | default: block.settings.name | escape }}" loading="lazy" width="160" height="60">{%- else -%}{{ block.settings.name }}{%- endif -%}{%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a class="akv-media-logo" href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ logo_inner }}</a>
          {%- else -%}
            <div class="akv-media-logo">{{ logo_inner }}</div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      <div class="akv-media-logos" aria-label="Media coverage">
        <div class="akv-media-track">
          <div class="akv-media-group">{{ media_logos_html }}</div>
          <div class="akv-media-group" aria-hidden="true">{{ media_logos_html }}</div>
        </div>
      </div>

      {%- if section.settings.media_link_url != blank -%}
        <div class="akv-media-footer">
          <a href="{{ section.settings.media_link_url }}" class="akv-media-link" target="_blank" rel="noopener">{{ section.settings.media_link_label }} <span aria-hidden="true">&rarr;</span></a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.creators_enabled and video_blocks.size > 0 -%}
    <!-- ─────────── Creator routines carousel ─────────── -->
    <div class="akv-creator-wrap">
      <div class="akv-shell akv-creator-grid">
        <div class="akv-creator-copy">
          <div class="akv-kicker">{{ section.settings.creators_kicker }}</div>
          <h2>{{ section.settings.creators_heading }}</h2>
          <p>{{ section.settings.creators_sub }}</p>
          {%- if section.settings.creators_link_url != blank -%}
            <a href="{{ section.settings.creators_link_url }}" class="akv-media-link" target="_blank" rel="noopener">{{ section.settings.creators_link_label }} <span aria-hidden="true">&rarr;</span></a>
          {%- endif -%}
        </div>

        <div class="akv-carousel" data-akv-carousel>
          <div class="akv-carousel-controls">
            <button class="akv-carousel-arrow akv-carousel-prev" type="button" aria-label="Previous videos">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
            </button>
            <button class="akv-carousel-arrow akv-carousel-next" type="button" aria-label="Next videos">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
            </button>
          </div>

          <div class="akv-video-track" tabindex="0">
            {%- for block in video_blocks -%}
              {%- assign vnum = forloop.index | prepend: '0' | slice: -2, 2 -%}
              {%- assign poster = '' -%}
              {%- if block.settings.poster_file != blank -%}{%- assign poster = block.settings.poster_file | asset_url -%}
              {%- elsif block.settings.thumb != blank -%}{%- assign poster = block.settings.thumb | image_url: width: 620 -%}{%- endif -%}
              {%- assign vsrc = block.settings.video_file | asset_url -%}
              {%- assign vlabel = block.settings.label -%}

              {%- if block.settings.video_file != blank -%}
                {%- comment -%} Real UGC video — inline click-to-play (preload:none, no autoplay for perf) {%- endcomment -%}
                <div class="akv-video-card" role="group" aria-label="{{ vlabel | default: 'Creator video' | escape }}" {{ block.shopify_attributes }}>
                  <div class="akv-video-placeholder akv-has-video">
                    <video class="akv-video-el" preload="none" playsinline{% if poster != blank %} poster="{{ poster }}"{% endif %}>
                      <source src="{{ vsrc }}" type="video/mp4">
                    </video>
                    <button class="akv-play akv-video-playbtn" type="button" aria-label="Play video">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5Z"/></svg>
                    </button>
                    {%- if vlabel != blank -%}<span class="akv-video-label">{{ vlabel }}</span>{%- endif -%}
                  </div>
                </div>
              {%- elsif block.settings.video_url != blank -%}
                <a class="akv-video-card" href="{{ block.settings.video_url }}" target="_blank" rel="noopener" role="group" aria-label="{{ vlabel | default: 'Creator video' | escape }}" {{ block.shopify_attributes }}>
                  <div class="akv-video-placeholder"{% if poster != blank %} style="background-image:linear-gradient(0deg,rgba(0,0,0,.35),transparent 55%),url('{{ poster }}');background-size:cover;background-position:center"{% endif %}>
                    <span class="akv-video-number">{{ vnum }}</span>
                    <span class="akv-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z"/></svg></span>
                    {%- if vlabel != blank -%}<span class="akv-video-label">{{ vlabel }}</span>{%- endif -%}
                  </div>
                </a>
              {%- else -%}
                <article class="akv-video-card" role="group" aria-label="Creator video placeholder" {{ block.shopify_attributes }}>
                  <div class="akv-video-placeholder">
                    <span class="akv-video-number">{{ vnum }}</span>
                    <span class="akv-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z"/></svg></span>
                    {%- if vlabel != blank -%}<span class="akv-video-label">{{ vlabel }}</span>{%- endif -%}
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- assign dot_count = video_blocks.size | plus: 2 | divided_by: 3 -%}
          {%- if dot_count > 1 -%}
          <div class="akv-carousel-dots" aria-label="Carousel position">
            {%- for i in (1..dot_count) -%}
              <button type="button" class="{% if forloop.first %}is-active{% endif %}" aria-label="Go to slide group {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- endif -%}
  </section>
  {%- endif -%}

  {%- if has_reviews -%}
  <!-- ═══════════ REVIEWS (renders only when real content is filled) ═══════════ -->
  <section class="akv-reviews" id="akv-reviews">
    <div class="akv-shell">
      <h2>{{ section.settings.rev_heading }}</h2>
      <div class="akv-reviews-grid">
        {%- if section.settings.rating != blank -%}
        <div class="akv-rating-summary akv-card">
          <div class="akv-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="akv-rating-meta"><strong>{{ section.settings.rating }} / 5</strong>{% if section.settings.rating_count != blank %}<br>{{ section.settings.rating_count }}{% endif %}</p>
          <div class="akv-summary-benefits">
            <div class="akv-summary-benefit"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M9 12.5l2 2 4-5"/></svg>{{ section.settings.rev_b1 }}</div>
            <div class="akv-summary-benefit"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/></svg>{{ section.settings.rev_b2 }}</div>
            <div class="akv-summary-benefit"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 13h5l-1 8 8-10h-5l1-8z"/></svg>{{ section.settings.rev_b3 }}</div>
          </div>
        </div>
        {%- endif -%}
        {%- if review_blocks.size > 0 -%}
        <div class="akv-review-list" {% if section.settings.rating == blank %}style="grid-column:1/-1"{% endif %}>
          {%- for block in review_blocks -%}
            <article class="akv-review akv-card{% if forloop.first %} akv-review--feature{% endif %}" {{ block.shopify_attributes }}>
              <div>
                <div class="akv-review-avatar{% unless block.settings.avatar %} akv-review-avatar--placeholder{% endunless %}">
                  {%- if block.settings.avatar -%}
                    <img src="{{ block.settings.avatar | image_url: width: 144 }}" alt="{{ block.settings.author | escape }}" width="72" height="72" loading="lazy">
                  {%- endif -%}
                </div>
              </div>
              <div>
                <div class="akv-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
                <p class="akv-review-meta">{{ block.settings.author }}{% if block.settings.verified %} &middot; <span class="akv-verified">&#10003; Verified Buyer</span>{% endif %}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
      {%- comment -%} Judge.me review widget as OS 2.0 app block — reviews fill
          in and update automatically from the app (this install has no
          judgeme.widget metafield, so the plain-div method stays empty) {%- endcomment -%}
      {%- for block in app_blocks -%}
        <div class="akv-jdgm" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endfor -%}
      {%- if section.settings.all_reviews_url != blank -%}
        <div class="akv-review-links"><a href="{{ section.settings.all_reviews_url }}">Read all verified reviews &rarr;</a></div>
      {%- endif -%}
      <div class="akv-review-image">
        <img src="{{ 'akv-review-lifestyle.webp' | asset_url }}" alt="Customers living their daily routine" width="1094" height="268" loading="lazy">
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ═══════════ PURCHASE ═══════════ -->
  <section class="akv-purchase" id="akv-buy">
    <div class="akv-shell">
      <h2>{{ section.settings.buy_heading }}</h2>
      <div class="akv-offers">

        <!-- 1 · One-time -->
        <article class="akv-offer akv-card" data-akv-offer data-qty="1" data-title="{{ section.settings.offer1_title | escape }}" data-price="{{ price_1 | money }}">
          <h3>{{ section.settings.offer1_title }}</h3>
          <div class="akv-offer-rule"></div>
          <p class="akv-offer-sub">{{ section.settings.offer1_sub }}</p>
          <div class="akv-offer-img"><img src="{{ 'akv-bottle-1.webp' | asset_url }}" alt="1 bottle" width="460" height="370" loading="lazy"></div>
          <div class="akv-offer-price">{{ price_1 | money }}</div>
          <p class="akv-offer-per">&asymp; {{ per_day_1 | money }}/day &middot; 3-month supply</p>
          {%- assign f1 = 'akv-offer1-' | append: section.id -%}
          {%- form 'product', product, id: f1, class: 'akv-buy-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="add" class="akv-btn akv-btn--outline">Add to Cart</button>
          {%- endform -%}
        </article>

        {%- if sub_alloc -%}
        <!-- 2 · Subscribe & Save (recommended) -->
        <article class="akv-offer akv-offer--recommended akv-card is-active" data-akv-offer data-qty="1" data-plan="{{ sub_plan_id }}" data-title="{{ section.settings.offer2_title | escape }}" data-price="{{ sub_price | money }}">
          <div class="akv-recommended">RECOMMENDED &middot; SAVE {{ sub_save }}%</div>
          <h3>{{ section.settings.offer2_title }}</h3>
          <div class="akv-offer-rule"></div>
          <p class="akv-offer-sub">{{ section.settings.offer2_sub }}</p>
          <div class="akv-offer-img"><img src="{{ 'akv-bottle-1.webp' | asset_url }}" alt="1 bottle, delivered on your schedule" width="460" height="370" loading="lazy"></div>
          <div class="akv-offer-price">{{ sub_price | money }}</div>
          <p class="akv-offer-per">&asymp; {{ sub_per_day | money }}/day &middot; cancel anytime</p>
          {%- assign f2 = 'akv-offer2-' | append: section.id -%}
          {%- form 'product', product, id: f2, class: 'akv-buy-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="selling_plan" value="{{ sub_plan_id }}">
            <button type="submit" name="add" class="akv-btn akv-btn--gold">Subscribe &amp; Save {{ sub_save }}%</button>
          {%- endform -%}
        </article>
        {%- endif -%}

        <!-- 3 · Two bottles -->
        <article class="akv-offer akv-card" data-akv-offer data-qty="2" data-title="{{ section.settings.offer3_title | escape }}" data-price="{{ price_2 | money }}">
          <h3>{{ section.settings.offer3_title }}</h3>
          <div class="akv-offer-rule"></div>
          <p class="akv-offer-sub">{{ section.settings.offer3_sub }}</p>
          <div class="akv-offer-img"><img src="{{ 'akv-bottles-2.webp' | asset_url }}" alt="2 bottles" width="460" height="370" loading="lazy"></div>
          <div class="akv-offer-price">{{ price_2 | money }}</div>
          <p class="akv-offer-per">&asymp; {{ per_day_1 | money }}/day &middot; 6-month supply</p>
          {%- assign f3 = 'akv-offer3-' | append: section.id -%}
          {%- form 'product', product, id: f3, class: 'akv-buy-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="2">
            <button type="submit" name="add" class="akv-btn akv-btn--outline">Add 2 to Cart</button>
          {%- endform -%}
        </article>

        <!-- 4 · Three bottles -->
        <article class="akv-offer akv-card" data-akv-offer data-qty="3" data-title="{{ section.settings.offer4_title | escape }}" data-price="{{ price_3 | money }}">
          <h3>{{ section.settings.offer4_title }}</h3>
          <div class="akv-offer-rule"></div>
          <p class="akv-offer-sub">{{ section.settings.offer4_sub }}</p>
          <div class="akv-offer-img"><img src="{{ 'akv-bottles-3.webp' | asset_url }}" alt="3 bottles" width="460" height="370" loading="lazy"></div>
          <div class="akv-offer-price">{{ price_3 | money }}</div>
          <p class="akv-offer-per">&asymp; {{ per_day_1 | money }}/day &middot; 9-month supply</p>
          {%- assign f4 = 'akv-offer4-' | append: section.id -%}
          {%- form 'product', product, id: f4, class: 'akv-buy-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="3">
            <button type="submit" name="add" class="akv-btn akv-btn--outline">Add 3 to Cart</button>
          {%- endform -%}
        </article>
      </div>

      <div class="akv-security">
        <div class="akv-security-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Secure SSL checkout</div>
        <div class="akv-security-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>{{ section.settings.guarantee_text }}</div>
        {%- if sub_alloc -%}
          <div class="akv-security-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5M20 12a8 8 0 0 1-14 5"/><path d="M18 3v4h-4M6 21v-4h4"/></svg>Pause, skip or cancel anytime</div>
        {%- else -%}
          <div class="akv-security-item"><svg class="akv-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M9 12.5l2 2 4-5"/></svg>Third-party tested</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- ═══════════ FAQ ═══════════ -->
  <section class="akv-faq" id="akv-faq">
    <div class="akv-shell">
      <div class="akv-faq-card akv-card">
        <h2>{{ section.settings.faq_heading }}</h2>
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="akv-faq-answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        <p class="akv-disclaimer">{{ section.settings.disclaimer }}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════ FINAL CTA ═══════════ -->
  <section class="akv-final">
    <div class="akv-shell">
      <div class="akv-final-card">
        <div class="akv-final-copy">
          <h2>{{ section.settings.final_heading }}</h2>
          <div class="akv-final-meta">
            <span>{{ section.settings.final_m1 }}</span><i></i>
            <span>{{ section.settings.final_m2 }}</span><i></i>
            <span>{{ section.settings.final_m3 }}</span>
          </div>
          <a class="akv-btn akv-btn--gold" href="#akv-buy" style="max-width:300px">{{ section.settings.final_cta }} &mdash; {{ price_1 | money }}</a>
        </div>
        <div class="akv-final-visual">
          <img src="{{ 'akv-final-visual.webp' | asset_url }}" alt="{{ product.title | escape }} bottle" width="832" height="624" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ STICKY BAR (revealed once the hero CTA scrolls away) ═══════════ -->
  <div class="akv-sticky" id="akv-sticky-{{ section.id }}">
    <div class="akv-shell akv-sticky-inner">
      <div class="akv-sticky-copy">
        <img class="akv-sticky-thumb" src="{{ 'akv-bottle-1.webp' | asset_url }}" alt="" width="46" height="37" loading="lazy">
        <div>
          <strong id="akv-sticky-title-{{ section.id }}">{{ section.settings.offer1_title }}</strong>
          <span class="akv-sticky-price" id="akv-sticky-price-{{ section.id }}">{{ price_1 | money }}</span>
        </div>
        <div class="akv-sticky-meta">
          <span>{{ section.settings.hero_b1 }}</span><i></i>
          <span>{{ section.settings.hero_b3 }}</span>
        </div>
      </div>
      {%- form 'product', product, id: sticky_form_id, class: 'akv-buy-form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="akv-btn akv-btn--gold">Add to Cart</button>
      {%- endform -%}
    </div>
  </div>
  <div class="akv-sticky-spacer" aria-hidden="true"></div>

  <div class="akv-cart-toast" id="akv-toast-{{ section.id }}" role="status" aria-live="polite"></div>

  <!-- Image lightbox (hero gallery zoom — click/tap image to zoom in, scroll to pan) -->
  <div class="akv-lightbox" id="akv-lightbox-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="akv-lightbox-close" type="button" aria-label="Close image">&times;</button>
    <div class="akv-lb-inner">
      <img src="" alt="" class="akv-lightbox-img">
    </div>
  </div>
</div>

<script>
(function(){
  var wrap = document.getElementById('akv-{{ section.id }}');
  if (!wrap) return;

  var toast = document.getElementById('akv-toast-{{ section.id }}');
  var toastTimer;
  function showToast(msg){
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toast.classList.remove('is-visible'); }, 3500);
  }

  /* ── Offer selection → highlight card + sync sticky bar (title, price,
     quantity, selling plan) so the sticky button adds the chosen offer ── */
  var stickyTitle = document.getElementById('akv-sticky-title-{{ section.id }}');
  var stickyPrice = document.getElementById('akv-sticky-price-{{ section.id }}');
  var stickyForm = document.getElementById('akv-sticky-form-{{ section.id }}');
  function selectOffer(card){
    wrap.querySelectorAll('.akv-offer').forEach(function(c){ c.classList.toggle('is-active', c === card); });
    if (stickyTitle) stickyTitle.textContent = card.dataset.title;
    if (stickyPrice) stickyPrice.textContent = card.dataset.price;
    if (stickyForm) {
      stickyForm.querySelector('[name="quantity"]').value = card.dataset.qty || '1';
      var planInput = stickyForm.querySelector('[name="selling_plan"]');
      if (card.dataset.plan) {
        if (!planInput) {
          planInput = document.createElement('input');
          planInput.type = 'hidden';
          planInput.name = 'selling_plan';
          stickyForm.appendChild(planInput);
        }
        planInput.value = card.dataset.plan;
      } else if (planInput) {
        planInput.remove();
      }
    }
  }
  wrap.querySelectorAll('.akv-offer').forEach(function(card){
    card.addEventListener('click', function(e){
      if (e.target.closest('form')) return; /* button click = add, not select */
      selectOffer(card);
    });
  });
  var initial = wrap.querySelector('.akv-offer.is-active') || wrap.querySelector('.akv-offer');
  if (initial) selectOffer(initial);

  /* Proof strip + icon-benefits auto-scroll are pure CSS marquees now
     (see .akv-proof-track / .akv-icon-track) — they run at every breakpoint
     and pause on hover, so no JS drives them. */

  /* ── Creator-routines video carousel (arrows, dots, keyboard track) ── */
  var carousel = wrap.querySelector('[data-akv-carousel]');
  if (carousel) {
    var track = carousel.querySelector('.akv-video-track');
    var cards = [].slice.call(carousel.querySelectorAll('.akv-video-card'));
    var prev = carousel.querySelector('.akv-carousel-prev');
    var next = carousel.querySelector('.akv-carousel-next');
    var dots = [].slice.call(carousel.querySelectorAll('.akv-carousel-dots button'));

    var cardStep = function(){
      var first = cards[0];
      if (!first) return 280;
      var gap = parseFloat(getComputedStyle(track).gap || 0);
      return first.getBoundingClientRect().width + gap;
    };
    var scrollByCards = function(dir){
      var visible = Math.max(1, Math.floor(track.clientWidth / cardStep()));
      track.scrollBy({ left: dir * cardStep() * visible, behavior: 'smooth' });
    };
    if (prev) prev.addEventListener('click', function(){ scrollByCards(-1); });
    if (next) next.addEventListener('click', function(){ scrollByCards(1); });
    dots.forEach(function(dot, index){
      dot.addEventListener('click', function(){
        var target = cards[index * 3];
        if (target) track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: 'smooth' });
      });
    });
    var updateDots = function(){
      if (!dots.length) return;
      var maxScroll = Math.max(1, track.scrollWidth - track.clientWidth);
      var group = Math.min(dots.length - 1, Math.round((track.scrollLeft / maxScroll) * (dots.length - 1)));
      dots.forEach(function(dot, index){ dot.classList.toggle('is-active', index === group); });
    };
    track.addEventListener('scroll', updateDots, { passive: true });
    window.addEventListener('resize', updateDots);
    updateDots();

    /* Hide arrows when everything fits (e.g. only 2 videos on desktop) */
    var controls = carousel.querySelector('.akv-carousel-controls');
    var updateControls = function(){
      if (controls) controls.style.visibility = (track.scrollWidth > track.clientWidth + 4) ? 'visible' : 'hidden';
    };
    window.addEventListener('resize', updateControls);
    updateControls();

  }

  /* Hero gallery: thumbnails switch the active slide */
  wrap.querySelectorAll('[data-akv-gallery]').forEach(function(g){
    var slides = g.querySelectorAll('.akv-hero-slide');
    var thumbs = g.querySelectorAll('.akv-hero-thumb');
    thumbs.forEach(function(t){
      t.addEventListener('click', function(){
        var i = +t.dataset.i;
        slides.forEach(function(s, n){ s.classList.toggle('is-active', n === i); });
        thumbs.forEach(function(th, n){ th.classList.toggle('is-active', n === i); });
      });
    });
  });

  /* Lightbox: click a hero slide → open an in-page overlay (closable) instead of
     opening the raw image in a new tab. Falls back to the link if JS is off. */
  /* Judge.me: default the review sort to "Highest rating" (best reviews first)
     on this page only. Runs once when the widget's sort dropdown first renders;
     the visitor can still re-sort manually afterwards. */
  (function(){
    var applied = false;
    function applySort(){
      if (applied) return true;
      var sel = wrap.querySelector('.akv-jdgm .jdgm-sort-dropdown');
      if (!sel) return false;
      applied = true;
      if (sel.value !== 'highest_rating') {
        var setter = Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, 'value').set;
        setter.call(sel, 'highest_rating');
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      }
      return true;
    }
    if (!applySort()) {
      var host = wrap.querySelector('.akv-jdgm');
      if (host && 'MutationObserver' in window) {
        var mo = new MutationObserver(function(){ if (applySort()) mo.disconnect(); });
        mo.observe(host, { childList: true, subtree: true });
        setTimeout(function(){ mo.disconnect(); }, 15000);
      }
    }
  })();

  var lb = document.getElementById('akv-lightbox-{{ section.id }}');
  if (lb) {
    var lbImg = lb.querySelector('.akv-lightbox-img');
    var lbInner = lb.querySelector('.akv-lb-inner');
    function closeLb(){ lb.classList.remove('is-open'); lbImg.classList.remove('is-zoomed'); lbImg.src = ''; document.body.style.overflow = ''; }
    function openLb(src){ lbImg.classList.remove('is-zoomed'); lbImg.src = src; lb.classList.add('is-open'); lb.scrollTop = 0; document.body.style.overflow = 'hidden'; }
    wrap.querySelectorAll('.akv-hero-slide').forEach(function(a){
      a.addEventListener('click', function(e){
        var href = a.getAttribute('href');
        if (!href) return;
        e.preventDefault();
        openLb(href);
      });
    });
    /* click/tap the image → toggle zoom-in (scroll to pan when zoomed) */
    lbImg.addEventListener('click', function(e){
      e.stopPropagation();
      lbImg.classList.toggle('is-zoomed');
      lb.scrollTop = 0; lb.scrollLeft = 0;
    });
    lb.querySelector('.akv-lightbox-close').addEventListener('click', closeLb);
    lb.addEventListener('click', function(e){ if (e.target === lb || e.target === lbInner) closeLb(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && lb.classList.contains('is-open')) closeLb(); });
  }

  /* Inline video (creator carousel + doctor section): click play → native
     controls + play, and pause any other playing video in the section */
  wrap.querySelectorAll('.akv-video-playbtn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var holder = btn.closest('.akv-video-placeholder');
      var video = holder && holder.querySelector('.akv-video-el');
      if (!video) return;
      video.setAttribute('controls', '');
      holder.classList.add('is-playing');
      var pr = video.play();
      if (pr && pr.catch) pr.catch(function(){});
    });
  });
  wrap.querySelectorAll('.akv-video-el').forEach(function(v){
    v.addEventListener('play', function(){
      wrap.querySelectorAll('.akv-video-el').forEach(function(o){ if (o !== v) o.pause(); });
    });
  });

  /* ── Sticky reveal once the hero CTA scrolls out of view ── */
  var heroCta = document.getElementById('akv-hero-cta-{{ section.id }}');
  var sticky = document.getElementById('akv-sticky-{{ section.id }}');
  if (heroCta && sticky && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(entries){
      /* use the freshest entry — entries[0] can be stale when several
         intersection changes are delivered in one batch */
      var last = entries[entries.length - 1];
      sticky.classList.toggle('is-visible', !last.isIntersecting);
    }, { threshold: 0 }).observe(heroCta);
  } else if (sticky) {
    sticky.classList.add('is-visible');
  }

  /* ── AJAX Add to Cart (Dawn cart drawer, same pattern as akk-pdp):
     uses <cart-drawer>.renderContents() + Dawn's pubsub cartUpdate.
     Native form submit is the no-JS fallback. ── */
  function handleForm(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      if (btn && btn.disabled) return;
      var origText = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
      var payload = {
        id: form.querySelector('[name="id"]').value,
        quantity: parseInt((form.querySelector('[name="quantity"]') || {}).value, 10) || 1,
        sections: ['cart-drawer', 'cart-icon-bubble'],
        sections_url: window.location.pathname
      };
      var plan = form.querySelector('[name="selling_plan"]');
      if (plan && plan.value) payload.selling_plan = plan.value;
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(payload)
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.status && data.status !== 200) {
          showToast(data.description || data.message || 'Could not add to cart — please try again.');
          return;
        }
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'akv-pdp', productVariantId: payload.id, cartData: data });
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (btn) btn.dataset.added = '1';
        var drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.renderContents === 'function') {
          drawer.renderContents(data);
        } else {
          window.location = window.Shopify.routes.root + 'cart';
        }
      })
      .catch(function(){ showToast('Network error — please try again.'); })
      .finally(function(){
        if (btn) {
          btn.disabled = false;
          if (btn.dataset.added) {
            delete btn.dataset.added;
            btn.textContent = '✓ Added';
            setTimeout(function(){ btn.textContent = origText; }, 1600);
          } else {
            btn.textContent = origText;
          }
        }
      });
    });
  }
  wrap.querySelectorAll('form.akv-buy-form').forEach(handleForm);
})();
</script>
