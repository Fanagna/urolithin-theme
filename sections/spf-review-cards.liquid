{{ 'spf.css' | asset_url | stylesheet_tag }}
<script src="{{ 'spf.js' | asset_url }}" defer></script>
<div class="spf spf-reviews spf-carousel" data-spf-carousel style="--spf-bg:{{ section.settings.bg }};--spf-ink:{{ section.settings.ink }};--spf-gold:{{ section.settings.gold }};--spf-line:{{ section.settings.line }}">
  {%- if section.settings.heading != blank -%}<h2 class="spf-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <button class="spf-btn prev" type="button" aria-label="Previous" data-spf-scroll="-1">‹</button>
  <div class="spf-scroller" data-spf-track>
    {%- for block in section.blocks -%}
      <article class="spf-review" {{ block.shopify_attributes }}>
        {%- render 'spf-img', img: block.settings.image, file: block.settings.image_file, w: 440, wid: 205, hei: 118, alt: block.settings.name -%}
        <div class="spf-review-body">
          <div class="spf-review-head">
            <span class="spf-review-name">{{ block.settings.name }}</span>
            <span class="spf-stars" aria-hidden="true">{{ block.settings.stars | default: section.settings.stars }}</span>
          </div>
          <div class="spf-review-text">{{ block.settings.text }}</div>
        </div>
      </article>
    {%- endfor -%}
  </div>
  <button class="spf-btn next" type="button" aria-label="Next" data-spf-scroll="1">›</button>
</div>

{% schema %}
{
  "name": "SPF · Review cards",
  "tag": "section",
  "class": "spf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (blank = hidden)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "gold", "label": "Stars", "default": "#f5a000" },
    { "type": "color", "id": "line", "label": "Border", "default": "#e7e2da" },
    { "type": "text", "id": "stars", "label": "Default stars", "default": "★★★★★" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_file", "label": "…or asset filename", "info": "e.g. spf-review-1.webp" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sophie L." },
        { "type": "text", "id": "stars", "label": "Stars (blank = default)" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Great product! I take it every morning.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SPF · Review cards",
      "blocks": [
        { "type": "review", "settings": { "image_file": "spf-review-1.webp", "name": "Sophie L.", "text": "<p>Great product! I take it every morning.</p>" } },
        { "type": "review", "settings": { "image_file": "spf-review-2.webp", "name": "Mark P.", "text": "<p>I really notice the difference in my digestion.</p>" } },
        { "type": "review", "settings": { "image_file": "spf-review-3.webp", "name": "Camille T.", "text": "<p>An essential part of my daily routine!</p>" } },
        { "type": "review", "settings": { "image_file": "spf-review-4.webp", "name": "Laura B.", "text": "<p>Neutral taste, easy to take and very effective.</p>" } },
        { "type": "review", "settings": { "image_file": "spf-review-5.webp", "name": "Chloe R.", "text": "<p>My skin is clearer and my stomach feels less bloated.</p>" } }
      ]
    }
  ]
}
{% endschema %}
