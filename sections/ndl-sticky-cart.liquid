{{ 'ndl-liposomal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ndl-liposomal.js' | asset_url }}" defer></script>
{% liquid
  assign ndl_product = product
  if section.settings.product != blank
    assign ndl_product = section.settings.product
  endif
  assign ndl_variant = ndl_product.selected_or_first_available_variant
  # Native-form fallback — see ndl-hero.liquid: the CTA must work even
  # before the deferred JS attaches its listeners.
  assign ndl_sticky_form_id = 'ndl-sticky-form-' | append: section.id
%}
<div class="ndl">
  <aside class="ndl-sticky-bar" aria-label="Quick add to cart" data-ndl-product data-product-handle="{{ ndl_product.handle | escape }}" data-product-url="{{ ndl_product.url }}" data-variant-id="{{ ndl_variant.id }}" data-available="{{ ndl_variant.available }}">
    <div class="ndl-sticky-bar-inner">
      {% if section.settings.mini_bottle != blank %}
        {{ section.settings.mini_bottle | image_url: width: 100 | image_tag: loading: 'lazy', alt: '', class: 'mini-bottle' }}
      {% else %}
        <img class="mini-bottle" src="{{ 'ndl-nad-bottle.webp' | asset_url }}" alt="" loading="lazy">
      {% endif %}
      <div class="label-col">
        <strong data-ndl-sticky-bundle>{{ section.settings.default_label }}</strong>
        <span class="price" data-ndl-sticky-price>{{ section.settings.default_price }}</span>
      </div>
      {% form 'product', ndl_product, id: ndl_sticky_form_id, class: 'ndl-buy-form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ ndl_variant.id }}">
        <input type="hidden" name="quantity" value="1" data-ndl-qty-input>
        <button class="ndl-btn{% unless ndl_variant.available %} is-sold-out{% endunless %}" type="submit" name="add" data-ndl-buy {% unless ndl_variant.available %}disabled aria-disabled="true"{% endunless %}>
          <span data-ndl-cta-label>{% if ndl_variant.available %}{{ section.settings.cta_text }}{% else %}{{ section.settings.sold_out_text }}{% endif %}</span>
        </button>
      {% endform %}
    </div>
  </aside>
  <div class="ndl-sticky-spacer" aria-hidden="true"></div>
</div>
{% schema %}
{
  "name": "NDL — Sticky cart bar",
  "tag": "section",
  "class": "ndl-section-wrapper",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave blank to use the page's own product — recommended. Only set this if this section renders on a page with no product context (e.g. a plain page template) and it must match the Hero section's Product setting exactly, or the wrong item could be added to cart." },
    { "type": "image_picker", "id": "mini_bottle", "label": "Mini bottle image" },
    { "type": "text", "id": "default_label", "label": "Default bundle label", "info": "Automatically updates to match the bundle the shopper picks in the hero section.", "default": "2 bottles — 60 days" },
    { "type": "text", "id": "default_price", "label": "Default price", "default": "$119" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "ADD TO CART" },
    { "type": "text", "id": "sold_out_text", "label": "Sold out button label", "default": "SOLD OUT" }
  ],
  "presets": [
    { "name": "NDL — Sticky cart bar" }
  ]
}
{% endschema %}
