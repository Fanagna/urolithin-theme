{% doc %}
  @prompt
    genere moi une section contenant un titre et juste en dessous des star rating avec une bonne note, 3 card cote à cote identique contenant (une image, 5étoiles en desous de l image, paragraphe,une ligne de sépartion,un avatar et juste à coté le psudo avec un verified Buyer
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-reviews-rating-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  .ai-reviews-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-reviews-star-{{ ai_gen_id }} {
    width: {{ block.settings.header_star_size }}px;
    height: {{ block.settings.header_star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-rating-text-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-reviews-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
  }

  .ai-review-image-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: {{ block.settings.image_radius }}px;
    margin-bottom: 16px;
  }

  .ai-review-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_radius }}px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-review-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-card-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-review-card-star-{{ ai_gen_id }} {
    width: {{ block.settings.card_star_size }}px;
    height: {{ block.settings.card_star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .ai-review-separator-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.separator_color }};
    margin-bottom: 16px;
  }

  .ai-review-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
  }

  .ai-review-avatar-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.star_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 600;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
  }

  .ai-review-author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-review-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-review-verified-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: {{ block.settings.verified_color }};
  }

  .ai-review-verified-icon-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.verified_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-reviews-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    <div class="ai-reviews-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-reviews-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      
      <div class="ai-reviews-rating-{{ ai_gen_id }}">
        <div class="ai-reviews-stars-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            <svg class="ai-reviews-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="ai-reviews-rating-text-{{ ai_gen_id }}">{{ block.settings.rating_text }}</span>
      </div>
    </div>

    <div class="ai-reviews-cards-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'review_' | append: i | append: '_image'
          assign text_key = 'review_' | append: i | append: '_text'
          assign author_key = 'review_' | append: i | append: '_author'
          assign avatar_key = 'review_' | append: i | append: '_avatar'
          
          assign review_image = block.settings[image_key]
          assign review_text = block.settings[text_key]
          assign review_author = block.settings[author_key]
          assign review_avatar = block.settings[avatar_key]
        %}

        <div class="ai-review-card-{{ ai_gen_id }}">
          {% if review_image %}
            <img
              src="{{ review_image | image_url: width: 600 }}"
              alt="{{ review_author | escape }}"
              class="ai-review-image-{{ ai_gen_id }}"
              loading="lazy"
              width="600"
              height="400"
            >
          {% else %}
            <div class="ai-review-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-review-card-stars-{{ ai_gen_id }}">
            {% for j in (1..5) %}
              <svg class="ai-review-card-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>

          <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>

          <div class="ai-review-separator-{{ ai_gen_id }}"></div>

          <div class="ai-review-author-{{ ai_gen_id }}">
            {% if review_avatar %}
              <img
                src="{{ review_avatar | image_url: width: 100 }}"
                alt="{{ review_author | escape }}"
                class="ai-review-avatar-{{ ai_gen_id }}"
                loading="lazy"
                width="100"
                height="100"
              >
            {% else %}
              <div class="ai-review-avatar-placeholder-{{ ai_gen_id }}">
                {{ review_author | slice: 0 | upcase }}
              </div>
            {% endif %}

            <div class="ai-review-author-info-{{ ai_gen_id }}">
              <p class="ai-review-author-name-{{ ai_gen_id }}">{{ review_author }}</p>
              <div class="ai-review-verified-{{ ai_gen_id }}">
                <svg class="ai-review-verified-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                <span>Verified Buyer</span>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9/5"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "range",
      "id": "header_star_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Header star size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Review 1"
    },
    {
      "type": "image_picker",
      "id": "review_1_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "review_1_text",
      "label": "Review text",
      "default": "This product exceeded my expectations! The quality is outstanding and I've noticed real results. Highly recommend to anyone looking for premium supplements."
    },
    {
      "type": "text",
      "id": "review_1_author",
      "label": "Author name",
      "default": "Sarah M."
    },
    {
      "type": "image_picker",
      "id": "review_1_avatar",
      "label": "Avatar"
    },
    {
      "type": "header",
      "content": "Review 2"
    },
    {
      "type": "image_picker",
      "id": "review_2_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "review_2_text",
      "label": "Review text",
      "default": "Amazing customer service and fast shipping. The product quality is top-notch and I can feel the difference in my daily routine. Will definitely order again!"
    },
    {
      "type": "text",
      "id": "review_2_author",
      "label": "Author name",
      "default": "Michael R."
    },
    {
      "type": "image_picker",
      "id": "review_2_avatar",
      "label": "Avatar"
    },
    {
      "type": "header",
      "content": "Review 3"
    },
    {
      "type": "image_picker",
      "id": "review_3_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "review_3_text",
      "label": "Review text",
      "default": "Best purchase I've made this year! The results speak for themselves. Professional packaging and excellent quality. Five stars all the way!"
    },
    {
      "type": "text",
      "id": "review_3_author",
      "label": "Author name",
      "default": "Emma L."
    },
    {
      "type": "image_picker",
      "id": "review_3_avatar",
      "label": "Avatar"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFD700"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Verified badge color",
      "default": "#00A651"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_star_size",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card star size",
      "default": 18
    },
    {
      "type": "range",
      "id": "review_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
