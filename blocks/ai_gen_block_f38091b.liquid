{% doc %}
  @prompt
    Create a full-width feature bar section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, labels, colors, background, font sizes, or spacing values.
    ⚠️ The ONLY change allowed is icon placement.
    
    CONTENT (must remain EXACTLY the same)
    
    🧪 Lab Tested
    
    ⚡ 500B CFU
    
    🛡️ 90 Days Supply
    
    DESIGN (DESKTOP / TABLET / MOBILE)
    
    Full-width horizontal bar
    
    Dark green background (same exact shade as reference)
    
    White text
    
    Same icons as reference
    
    Clean, minimal, premium supplement-brand style
    
    ICON PLACEMENT (ONLY CHANGE ALLOWED)
    
    Place each icon ABOVE its text
    
    Icon and text must be vertically stacked
    
    Entire icon + text block must be perfectly centered
    
    Icon centered horizontally above the text
    
    ⚠️ No other visual changes are allowed.
    
    LAYOUT
    
    Desktop: three items in a single horizontal row
    
    Tablet: same horizontal row with reduced spacing
    
    Mobile:
    
    Items stack vertically in a linear column
    
    Each icon remains above its text
    
    All content centered
    
    No horizontal scrolling
    
    RESPONSIVENESS (MANDATORY)
    
    Mobile-first responsive layout
    
    Text remains readable on all screen sizes
    
    Icons scale proportionally
    
    Maintain equal spacing between items
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox
    
    Use Flexbox column direction for each item
    
    Use media queries for mobile stacking
    
    Shopify Dawn compatible
    
    No JavaScript
    
    The final result must look identical to the reference, with the only difference being icons positioned above the text and centered, while remaining fully responsive.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #1a4d2e;
    padding: 16px 20px;
  }

  .ai-feature-bar-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-feature-bar-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .ai-feature-bar-icon-{{ ai_gen_id }} {
    font-size: 24px;
    line-height: 1;
  }

  .ai-feature-bar-text-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    white-space: nowrap;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-bar-container-{{ ai_gen_id }} {
      gap: 40px;
    }

    .ai-feature-bar-text-{{ ai_gen_id }} {
      font-size: 13px;
    }

    .ai-feature-bar-icon-{{ ai_gen_id }} {
      font-size: 22px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-bar-{{ ai_gen_id }} {
      padding: 20px 16px;
    }

    .ai-feature-bar-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-feature-bar-text-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-feature-bar-icon-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }
{% endstyle %}

<div class="ai-feature-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-bar-container-{{ ai_gen_id }}">
    <div class="ai-feature-bar-item-{{ ai_gen_id }}">
      <div class="ai-feature-bar-icon-{{ ai_gen_id }}">🧪</div>
      <p class="ai-feature-bar-text-{{ ai_gen_id }}">Lab Tested</p>
    </div>

    <div class="ai-feature-bar-item-{{ ai_gen_id }}">
      <div class="ai-feature-bar-icon-{{ ai_gen_id }}">⚡</div>
      <p class="ai-feature-bar-text-{{ ai_gen_id }}">500B CFU</p>
    </div>

    <div class="ai-feature-bar-item-{{ ai_gen_id }}">
      <div class="ai-feature-bar-icon-{{ ai_gen_id }}">🛡️</div>
      <p class="ai-feature-bar-text-{{ ai_gen_id }}">90 Days Supply</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature bar",
  "settings": [],
  "presets": [
    {
      "name": "Feature bar"
    }
  ]
}
{% endschema %}
