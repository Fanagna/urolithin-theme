{% doc %}
  @prompt
    Create a premium pricing comparison section exactly matching the provided visual, structure, colors, and content. Do not rewrite, paraphrase, or add any text.
    
    Design & visual requirements:
    
    Clean, modern, premium layout
    
    Light / white background
    
    Centered section with strong visual hierarchy
    
    Two-card pricing layout side by side (desktop)
    
    Rounded cards with subtle shadows
    
    Desktop-first, fully responsive on mobile
    
    High-trust, science-driven aesthetic suitable for a longevity supplement brand
    
    Top section title (centered, exact text):
    READY TO OPTIMIZE YOUR CELLULAR PERFORMANCE?
    
    Trust indicators under the title (inline, exact text):
    
    ✓ CLINICALLY-BACKED DOSES
    
    ✓ 90-DAY GUARANTEE
    
    ✓ FREE SHIPPING
    
    LEFT CARD — Primary offer (highlighted):
    
    Badge at top: BEST VALUE
    
    Card title: LONGEVITY BUNDLE
    
    Subtitle: Full Mitochondrial Support Protocol
    
    Pricing (exact display):
    
    Strikethrough price: $159.99
    
    Main price: $119.99
    
    Highlight text: SAVE $40 TODAY
    
    Included items (exact wording):
    
    1x NAD+ Complex (90 day)
    
    1x Urolithin A (90 day)
    
    Primary button:
    
    Button text: Start Protocol — $119.99
    
    Solid blue button, rounded, visually dominant
    
    Secondary note (small text):
    Or subscribe & save 15% — $102/month
    
    RIGHT CARD — Secondary offer:
    
    Card title: NEW TO NAD+?
    
    Subtitle: Start with the foundation
    
    Pricing (exact text):
    $59.99
    
    Included items (exact wording):
    
    1x NAD+ Complex (30 day)
    
    Clinical 500mg daily dose
    
    Upgrade to bundle anytime
    
    Secondary button:
    
    Button text: Try NAD+ First
    
    Outline button style, less dominant than left card
    
    Additional constraints:
    
    Do NOT change wording
    
    Do NOT add testimonials, FAQs, or extra guarantees
    
    Do NOT add medical claims
    
    Do NOT hardcode checkout URLs
    
    Maintain exact visual hierarchy (left card = emphasized)
    
    Goal:
    Clearly present the primary longevity bundle as the best value while offering a lower-commitment entry option, using a clean, premium, and trust-driven pricing layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-comparison-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-pricing-comparison__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-pricing-comparison__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-pricing-comparison__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    letter-spacing: 0.5px;
  }

  .ai-pricing-comparison__trust-indicators-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.trust_indicator_gap }}px;
    flex-wrap: wrap;
    margin: 0;
  }

  .ai-pricing-comparison__trust-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.trust_indicator_size }}px;
    color: {{ block.settings.trust_indicator_color }};
    font-weight: {{ block.settings.trust_indicator_weight }};
    letter-spacing: 0.3px;
  }

  .ai-pricing-comparison__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.cards_margin_top }}px;
  }

  .ai-pricing-comparison__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .ai-pricing-comparison__card--primary-{{ ai_gen_id }} {
    border: {{ block.settings.primary_card_border_width }}px solid {{ block.settings.primary_card_border_color }};
    box-shadow: {{ block.settings.primary_card_shadow }};
  }

  .ai-pricing-comparison__badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_top }}px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: {{ block.settings.badge_font_weight }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    letter-spacing: 0.5px;
  }

  .ai-pricing-comparison__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: {{ block.settings.card_title_weight }};
    color: {{ block.settings.card_title_color }};
    margin: {{ block.settings.card_title_margin_top }}px 0 {{ block.settings.card_title_margin_bottom }}px;
    text-align: center;
    letter-spacing: 0.3px;
  }

  .ai-pricing-comparison__card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.card_subtitle_color }};
    margin: 0 0 {{ block.settings.card_subtitle_margin_bottom }}px;
    text-align: center;
  }

  .ai-pricing-comparison__pricing-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.pricing_margin_bottom }}px;
  }

  .ai-pricing-comparison__price-strikethrough-{{ ai_gen_id }} {
    font-size: {{ block.settings.strikethrough_size }}px;
    color: {{ block.settings.strikethrough_color }};
    text-decoration: line-through;
    margin-bottom: {{ block.settings.strikethrough_margin_bottom }}px;
  }

  .ai-pricing-comparison__price-main-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_price_size }}px;
    font-weight: {{ block.settings.main_price_weight }};
    color: {{ block.settings.main_price_color }};
    margin-bottom: {{ block.settings.main_price_margin_bottom }}px;
  }

  .ai-pricing-comparison__price-highlight-{{ ai_gen_id }} {
    font-size: {{ block.settings.highlight_size }}px;
    color: {{ block.settings.highlight_color }};
    font-weight: {{ block.settings.highlight_weight }};
    margin-top: {{ block.settings.highlight_margin_top }}px;
  }

  .ai-pricing-comparison__includes-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.includes_margin_bottom }}px;
  }

  .ai-pricing-comparison__includes-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.includes_item_size }}px;
    color: {{ block.settings.includes_item_color }};
    margin-bottom: {{ block.settings.includes_item_spacing }}px;
    padding-left: {{ block.settings.includes_item_padding_left }}px;
    position: relative;
  }

  .ai-pricing-comparison__includes-item-{{ ai_gen_id }}:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: {{ block.settings.checkmark_color }};
    font-weight: bold;
  }

  .ai-pricing-comparison__button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    transition: all 0.3s ease;
    border: none;
  }

  .ai-pricing-comparison__button--primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_text_color }};
    border: {{ block.settings.primary_button_border_width }}px solid {{ block.settings.primary_button_bg }};
  }

  .ai-pricing-comparison__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
    border-color: {{ block.settings.primary_button_hover_bg }};
  }

  .ai-pricing-comparison__button--secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_text_color }};
    border: {{ block.settings.secondary_button_border_width }}px solid {{ block.settings.secondary_button_border_color }};
  }

  .ai-pricing-comparison__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
    color: {{ block.settings.secondary_button_hover_text }};
  }

  .ai-pricing-comparison__note-{{ ai_gen_id }} {
    font-size: {{ block.settings.note_font_size }}px;
    color: {{ block.settings.note_color }};
    text-align: center;
    margin-top: {{ block.settings.note_margin_top }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-pricing-comparison__cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-pricing-comparison__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-pricing-comparison__trust-indicators-{{ ai_gen_id }} {
      gap: {{ block.settings.trust_indicator_gap_mobile }}px;
    }

    .ai-pricing-comparison__trust-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.trust_indicator_size_mobile }}px;
    }

    .ai-pricing-comparison__card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size_mobile }}px;
    }

    .ai-pricing-comparison__price-main-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_price_size_mobile }}px;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-pricing-comparison-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin: 0 auto;
    }
  }
{% endstyle %}

<pricing-comparison-{{ ai_gen_id }} class="ai-pricing-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pricing-comparison__container-{{ ai_gen_id }}">
    <div class="ai-pricing-comparison__header-{{ ai_gen_id }}">
      <h2 class="ai-pricing-comparison__title-{{ ai_gen_id }}">
        {{ block.settings.section_title }}
      </h2>
      <div class="ai-pricing-comparison__trust-indicators-{{ ai_gen_id }}">
        <span class="ai-pricing-comparison__trust-item-{{ ai_gen_id }}">{{ block.settings.trust_indicator_1 }}</span>
        <span class="ai-pricing-comparison__trust-item-{{ ai_gen_id }}">{{ block.settings.trust_indicator_2 }}</span>
        <span class="ai-pricing-comparison__trust-item-{{ ai_gen_id }}">{{ block.settings.trust_indicator_3 }}</span>
      </div>
    </div>

    <div class="ai-pricing-comparison__cards-{{ ai_gen_id }}">
      <div class="ai-pricing-comparison__card-{{ ai_gen_id }} ai-pricing-comparison__card--primary-{{ ai_gen_id }}">
        {% if block.settings.show_badge %}
          <div class="ai-pricing-comparison__badge-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        {% endif %}

        <h3 class="ai-pricing-comparison__card-title-{{ ai_gen_id }}">
          {{ block.settings.primary_card_title }}
        </h3>
        <p class="ai-pricing-comparison__card-subtitle-{{ ai_gen_id }}">
          {{ block.settings.primary_card_subtitle }}
        </p>

        <div class="ai-pricing-comparison__pricing-{{ ai_gen_id }}">
          {% if block.settings.primary_show_strikethrough %}
            <div class="ai-pricing-comparison__price-strikethrough-{{ ai_gen_id }}">
              {{ block.settings.primary_strikethrough_price }}
            </div>
          {% endif %}
          <div class="ai-pricing-comparison__price-main-{{ ai_gen_id }}">
            {{ block.settings.primary_main_price }}
          </div>
          {% if block.settings.primary_show_highlight %}
            <div class="ai-pricing-comparison__price-highlight-{{ ai_gen_id }}">
              {{ block.settings.primary_highlight_text }}
            </div>
          {% endif %}
        </div>

        <ul class="ai-pricing-comparison__includes-{{ ai_gen_id }}">
          {% if block.settings.primary_include_1 != blank %}
            <li class="ai-pricing-comparison__includes-item-{{ ai_gen_id }}">
              {{ block.settings.primary_include_1 }}
            </li>
          {% endif %}
          {% if block.settings.primary_include_2 != blank %}
            <li class="ai-pricing-comparison__includes-item-{{ ai_gen_id }}">
              {{ block.settings.primary_include_2 }}
            </li>
          {% endif %}
          {% if block.settings.primary_include_3 != blank %}
            <li class="ai-pricing-comparison__includes-item-{{ ai_gen_id }}">
              {{ block.settings.primary_include_3 }}
            </li>
          {% endif %}
        </ul>

        <a
          href="{{ block.settings.primary_button_link }}"
          class="ai-pricing-comparison__button-{{ ai_gen_id }} ai-pricing-comparison__button--primary-{{ ai_gen_id }}"
        >
          {{ block.settings.primary_button_label }}
        </a>

        {% if block.settings.primary_show_note %}
          <p class="ai-pricing-comparison__note-{{ ai_gen_id }}">
            {{ block.settings.primary_note_text }}
          </p>
        {% endif %}
      </div>

      <div class="ai-pricing-comparison__card-{{ ai_gen_id }}">
        <h3 class="ai-pricing-comparison__card-title-{{ ai_gen_id }}">
          {{ block.settings.secondary_card_title }}
        </h3>
        <p class="ai-pricing-comparison__card-subtitle-{{ ai_gen_id }}">
          {{ block.settings.secondary_card_subtitle }}
        </p>

        <div class="ai-pricing-comparison__pricing-{{ ai_gen_id }}">
          <div class="ai-pricing-comparison__price-main-{{ ai_gen_id }}">
            {{ block.settings.secondary_main_price }}
          </div>
        </div>

        <ul class="ai-pricing-comparison__includes-{{ ai_gen_id }}">
          {% if block.settings.secondary_include_1 != blank %}
            <li class="ai-pricing-comparison__includes-item-{{ ai_gen_id }}">
              {{ block.settings.secondary_include_1 }}
            </li>
          {% endif %}
          {% if block.settings.secondary_include_2 != blank %}
            <li class="ai-pricing-comparison__includes-item-{{ ai_gen_id }}">
              {{ block.settings.secondary_include_2 }}
            </li>
          {% endif %}
          {% if block.settings.secondary_include_3 != blank %}
            <li class="ai-pricing-comparison__includes-item-{{ ai_gen_id }}">
              {{ block.settings.secondary_include_3 }}
            </li>
          {% endif %}
        </ul>

        <a
          href="{{ block.settings.secondary_button_link }}"
          class="ai-pricing-comparison__button-{{ ai_gen_id }} ai-pricing-comparison__button--secondary-{{ ai_gen_id }}"
        >
          {{ block.settings.secondary_button_label }}
        </a>
      </div>
    </div>
  </div>
</pricing-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class PricingComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('pricing-comparison-{{ ai_gen_id }}', PricingComparison{{ ai_gen_id }});
  })();
</script>

