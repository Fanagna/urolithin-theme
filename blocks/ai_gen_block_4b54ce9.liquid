{% doc %}
  @prompt
    Create a centered, premium dark-mode success / confirmation page section with the exact same container width, padding, and alignment as all previous sections on the page.
    
    Do NOT change any wording, layout, order, spacing, icons, or visual hierarchy. The design must remain identical to the reference.
    
    Functional requirements (important):
    
    The main CTA button must be a fully functional Shopify button
    
    Button must link to the Panstellar BPC-157 capsules product page
    
    Button must be clickable, accessible, and work on desktop and mobile
    
    Discount code is displayed visually but applied at checkout via Omnisend or Shopify
    
    Visual & layout rules:
    
    Dark gradient background
    
    Rounded outer container
    
    Soft shadow and subtle border
    
    Section centered on the page
    
    Same max-width as previous sections
    
    Content to display (do not edit anything):
    
    Success! Check Your Inbox
    
    Your free recovery guide + 30% discount code are on their way to your email.
    
    What to Do Next
    
    Check your inbox
    Look for “Your Recovery Guide + 30% Discount” from Jerome @ Panstellar (2–5 minutes)
    
    Download your free guide
    Click the download link in the email to get your 15-page PDF
    
    Start reading page 1
    That’s where the concepts click (protocols explained)
    
    Use your discount code
    Your 30% off code is valid for 30 days
    
    YOUR DISCOUNT CODE
    
    RECOVERY30
    
    Save 30% on all Panstellar products · Expires in 30 days
    
    Primary CTA button (functional):
    SHOP BPC-157 CAPSULES NOW
    
    Secondary text link:
    BROWSE ALL PRODUCTS
    
    Trust metrics row (do not edit):
    
    10,000+ Active users
    4.8★ Average rating
    Third-party Lab tested
    
    Divider line
    
    Didn’t get the email?
    
    Check your spam folder
    
    Search for “Panstellar” or “Jerome”
    
    Add contact@panstellar.shop
     to your contacts
    
    Wait 5 minutes (delivery can take a bit longer)
    
    Footer note (small text, do not edit):
    © 2025 Panstellar. All rights reserved.
    
    Do not add animations, popups, or extra content.
    Keep everything visually and structurally identical to the reference.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-success-confirmation-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-success-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    background: {{ block.settings.background_gradient }};
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-success-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-success-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-success-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.9;
    color: {{ block.settings.text_color }};
  }

  .ai-success-steps-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-success-steps-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    margin: 0 0 24px 0;
    text-align: center;
    color: {{ block.settings.text_color }};
  }

  .ai-success-step-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-success-step-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_number_size }}px;
    font-weight: 700;
    margin-bottom: 8px;
    color: {{ block.settings.accent_color }};
  }

  .ai-success-step-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-success-discount-{{ ai_gen_id }} {
    background: {{ block.settings.discount_bg_color }};
    border-radius: {{ block.settings.discount_border_radius }}px;
    padding: 24px;
    margin-bottom: 40px;
    text-align: center;
    border: {{ block.settings.discount_border_thickness }}px solid {{ block.settings.discount_border_color }};
  }

  .ai-success-discount-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_label_size }}px;
    font-weight: 600;
    margin: 0 0 16px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-success-discount-code-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_code_size }}px;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0 0 12px 0;
    color: {{ block.settings.accent_color }};
  }

  .ai-success-discount-details-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_details_size }}px;
    margin: 0;
    opacity: 0.9;
    color: {{ block.settings.text_color }};
  }

  .ai-success-cta-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-success-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-success-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-success-secondary-link-{{ ai_gen_id }} {
    display: block;
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-success-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_text_size }}px;
    font-weight: 600;
    text-decoration: underline;
  }

  .ai-success-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-success-trust-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-around;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-success-trust-item-{{ ai_gen_id }} {
    text-align: center;
    flex: 1;
    min-width: 120px;
  }

  .ai-success-trust-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.trust_value_size }}px;
    font-weight: 700;
    margin: 0 0 4px 0;
    color: {{ block.settings.accent_color }};
  }

  .ai-success-trust-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.trust_label_size }}px;
    margin: 0;
    opacity: 0.9;
    color: {{ block.settings.text_color }};
  }

  .ai-success-divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: 40px 0;
    opacity: 0.3;
  }

  .ai-success-help-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-success-help-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    margin: 0 0 20px 0;
    text-align: center;
    color: {{ block.settings.text_color }};
  }

  .ai-success-help-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-success-footer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.footer_text_size }}px;
    opacity: 0.7;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-success-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.6 }}px;
    }

    .ai-success-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-success-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-success-steps-title-{{ ai_gen_id }},
    .ai-success-help-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.9 }}px;
    }

    .ai-success-discount-code-{{ ai_gen_id }} {
      font-size: {{ block.settings.discount_code_size | times: 0.8 }}px;
    }

    .ai-success-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }

    .ai-success-trust-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 16px;
    }
  }
{% endstyle %}

<div class="ai-success-confirmation-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-success-container-{{ ai_gen_id }}">
    <div class="ai-success-header-{{ ai_gen_id }}">
