      <div class="ai-success-step-{{ ai_gen_id }}">
        <div class="ai-success-step-number-{{ ai_gen_id }}">{{ block.settings.step_1_number }}</div>
        <p class="ai-success-step-text-{{ ai_gen_id }}">{{ block.settings.step_1_text }}</p>
      </div>

      <div class="ai-success-step-{{ ai_gen_id }}">
        <div class="ai-success-step-number-{{ ai_gen_id }}">{{ block.settings.step_2_number }}</div>
        <p class="ai-success-step-text-{{ ai_gen_id }}">{{ block.settings.step_2_text }}</p>
      </div>

      <div class="ai-success-step-{{ ai_gen_id }}">
        <div class="ai-success-step-number-{{ ai_gen_id }}">{{ block.settings.step_3_number }}</div>
        <p class="ai-success-step-text-{{ ai_gen_id }}">{{ block.settings.step_3_text }}</p>
      </div>

      <div class="ai-success-step-{{ ai_gen_id }}">
        <div class="ai-success-step-number-{{ ai_gen_id }}">{{ block.settings.step_4_number }}</div>
        <p class="ai-success-step-text-{{ ai_gen_id }}">{{ block.settings.step_4_text }}</p>
      </div>
    </div>

    <div class="ai-success-discount-{{ ai_gen_id }}">
      <h3 class="ai-success-discount-label-{{ ai_gen_id }}">{{ block.settings.discount_label }}</h3>
      <div class="ai-success-discount-code-{{ ai_gen_id }}">{{ block.settings.discount_code }}</div>
      <p class="ai-success-discount-details-{{ ai_gen_id }}">{{ block.settings.discount_details }}</p>
    </div>

    <div class="ai-success-cta-{{ ai_gen_id }}">
      <a href="{{ block.settings.primary_button_url }}" class="ai-success-button-{{ ai_gen_id }}">
        {{ block.settings.primary_button_text }}
      </a>
    </div>

    <div class="ai-success-secondary-link-{{ ai_gen_id }}">
      <a href="{{ block.settings.secondary_link_url }}" class="ai-success-link-{{ ai_gen_id }}">
        {{ block.settings.secondary_link_text }}
      </a>
    </div>

    <div class="ai-success-trust-{{ ai_gen_id }}">
      <div class="ai-success-trust-item-{{ ai_gen_id }}">
        <div class="ai-success-trust-value-{{ ai_gen_id }}">{{ block.settings.trust_1_value }}</div>
        <div class="ai-success-trust-label-{{ ai_gen_id }}">{{ block.settings.trust_1_label }}</div>
      </div>
      <div class="ai-success-trust-item-{{ ai_gen_id }}">
        <div class="ai-success-trust-value-{{ ai_gen_id }}">{{ block.settings.trust_2_value }}</div>
        <div class="ai-success-trust-label-{{ ai_gen_id }}">{{ block.settings.trust_2_label }}</div>
      </div>
      <div class="ai-success-trust-item-{{ ai_gen_id }}">
        <div class="ai-success-trust-value-{{ ai_gen_id }}">{{ block.settings.trust_3_value }}</div>
        <div class="ai-success-trust-label-{{ ai_gen_id }}">{{ block.settings.trust_3_label }}</div>
      </div>
    </div>

    <div class="ai-success-divider-{{ ai_gen_id }}"></div>

    <div class="ai-success-help-{{ ai_gen_id }}">
      <h3 class="ai-success-help-title-{{ ai_gen_id }}">{{ block.settings.help_title }}</h3>
      <p class="ai-success-help-item-{{ ai_gen_id }}">{{ block.settings.help_item_1 }}</p>
      <p class="ai-success-help-item-{{ ai_gen_id }}">{{ block.settings.help_item_2 }}</p>
      <p class="ai-success-help-item-{{ ai_gen_id }}">{{ block.settings.help_item_3 }}</p>
      <p class="ai-success-help-item-{{ ai_gen_id }}">{{ block.settings.help_item_4 }}</p>
    </div>

    <p class="ai-success-footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
  </div>
</div>

