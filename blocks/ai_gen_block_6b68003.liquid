{% doc %}
  @prompt
    genere moi une sdcetion contenant deux bloc , le 1 bloc contient un titre et des liste puis le 2eme bloc est un rectangle contenant un titre(en rouge) et des liste avec des croix comme signe de liste
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    max-width: 100%;
  }

  .ai-column-{{ ai_gen_id }} {
    padding: {{ block.settings.column_padding }}px;
  }

  .ai-column-left-{{ ai_gen_id }} {
    background-color: {{ block.settings.left_bg_color }};
    border-radius: {{ block.settings.left_border_radius }}px;
  }

  .ai-column-right-{{ ai_gen_id }} {
    background-color: {{ block.settings.right_bg_color }};
    border: {{ block.settings.right_border_width }}px solid {{ block.settings.right_border_color }};
    border-radius: {{ block.settings.right_border_radius }}px;
  }

  .ai-column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.2;
  }

  .ai-column-left-{{ ai_gen_id }} .ai-column-title-{{ ai_gen_id }} {
    color: {{ block.settings.left_title_color }};
  }

  .ai-column-right-{{ ai_gen_id }} .ai-column-title-{{ ai_gen_id }} {
    color: {{ block.settings.right_title_color }};
  }

  .ai-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    font-size: {{ block.settings.list_text_size }}px;
    line-height: 1.5;
  }

  .ai-list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-list-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-list-left-{{ ai_gen_id }} .ai-list-item-{{ ai_gen_id }} {
    color: {{ block.settings.left_text_color }};
  }

  .ai-list-left-{{ ai_gen_id }} .ai-list-icon-{{ ai_gen_id }} {
    color: {{ block.settings.left_icon_color }};
  }

  .ai-list-right-{{ ai_gen_id }} .ai-list-item-{{ ai_gen_id }} {
    color: {{ block.settings.right_text_color }};
  }

  .ai-list-right-{{ ai_gen_id }} .ai-list-icon-{{ ai_gen_id }} {
    color: {{ block.settings.right_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-list-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-two-column-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-column-{{ ai_gen_id }} ai-column-left-{{ ai_gen_id }}">
    {% if block.settings.left_title != blank %}
      <h3 class="ai-column-title-{{ ai_gen_id }}">{{ block.settings.left_title }}</h3>
    {% endif %}
    
    <ul class="ai-list-{{ ai_gen_id }} ai-list-left-{{ ai_gen_id }}">
      {% if block.settings.left_item_1 != blank %}
        <li class="ai-list-item-{{ ai_gen_id }}">
          <span class="ai-list-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
          </span>
          <span>{{ block.settings.left_item_1 }}</span>
        </li>
      {% endif %}
      
