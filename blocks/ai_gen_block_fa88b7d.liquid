{% doc %}
  @prompt
    genere moi une section contenant un titre centrer au centre et deux blocs de Card identique placé de haut en bas contenant  un titre, prix barré, prix et pourcentage sauvé (sur la meme  ligne à des liste de texte , un bloc d image à Droite bien visible dasn chaque card  ( avec tous les parametres du section) et avec la deuxieme bloc ajoute juste sur la le haut la bordure best value ; avec des boutton ADD TO CARD
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-cards-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pricing-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-pricing-cards-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 700;
  }

  .ai-pricing-cards-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.cards_gap }}px;
    max-width: {{ block.settings.card_max_width }}px;
    margin: 0 auto;
  }

  .ai-pricing-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    gap: {{ block.settings.card_content_gap }}px;
    position: relative;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-pricing-card-best-value-{{ ai_gen_id }} {
    border-top: {{ block.settings.best_value_border_width }}px solid {{ block.settings.best_value_border_color }};
  }

  .ai-pricing-card-best-value-badge-{{ ai_gen_id }} {
    position: absolute;
    top: -{{ block.settings.best_value_badge_size | divided_by: 2 }}px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.best_value_badge_bg }};
    color: {{ block.settings.best_value_badge_text_color }};
    padding: {{ block.settings.best_value_badge_padding_vertical }}px {{ block.settings.best_value_badge_padding_horizontal }}px;
    border-radius: {{ block.settings.best_value_badge_radius }}px;
    font-size: {{ block.settings.best_value_badge_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-pricing-card-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-pricing-card-header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-pricing-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-pricing-card-prices-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-pricing-card-original-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.original_price_size }}px;
    color: {{ block.settings.original_price_color }};
    text-decoration: line-through;
  }

  .ai-pricing-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-pricing-card-savings-{{ ai_gen_id }} {
    font-size: {{ block.settings.savings_size }}px;
    color: {{ block.settings.savings_color }};
    background-color: {{ block.settings.savings_bg }};
    padding: 4px 8px;
    border-radius: {{ block.settings.savings_radius }}px;
    font-weight: 600;
  }

  .ai-pricing-card-features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.features_spacing }}px;
  }

  .ai-pricing-card-feature-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_size }}px;
    color: {{ block.settings.feature_color }};
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .ai-pricing-card-feature-{{ ai_gen_id }}::before {
    content: "{{ block.settings.feature_icon }}";
    flex-shrink: 0;
    color: {{ block.settings.feature_icon_color }};
    font-size: {{ block.settings.feature_size }}px;
  }

  .ai-pricing-card-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    flex-shrink: 0;
  }

  .ai-pricing-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-pricing-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-pricing-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-pricing-card-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text }};
    border: none;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .ai-pricing-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  @media screen and (max-width: 749px) {
    .ai-pricing-card-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-pricing-card-image-{{ ai_gen_id }} {
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
    }

    .ai-pricing-cards-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-pricing-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pricing-cards-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-pricing-cards-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    {% endif %}

    <div class="ai-pricing-cards-wrapper-{{ ai_gen_id }}">
      <div class="ai-pricing-card-{{ ai_gen_id }}">
        <div class="ai-pricing-card-content-{{ ai_gen_id }}">
          <div class="ai-pricing-card-header-{{ ai_gen_id }}">
            {% if block.settings.card_1_title != blank %}
              <h3 class="ai-pricing-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
            {% endif %}

            <div class="ai-pricing-card-prices-{{ ai_gen_id }}">
              {% if block.settings.card_1_original_price != blank %}
                <span class="ai-pricing-card-original-price-{{ ai_gen_id }}">{{ block.settings.card_1_original_price }}</span>
              {% endif %}
              {% if block.settings.card_1_price != blank %}
                <span class="ai-pricing-card-price-{{ ai_gen_id }}">{{ block.settings.card_1_price }}</span>
              {% endif %}
              {% if block.settings.card_1_savings != blank %}
                <span class="ai-pricing-card-savings-{{ ai_gen_id }}">{{ block.settings.card_1_savings }}</span>
              {% endif %}
            </div>
          </div>

          {% if block.settings.card_1_features != blank %}
            <ul class="ai-pricing-card-features-{{ ai_gen_id }}">
              {% assign features = block.settings.card_1_features | newline_to_br | split: '<br />' %}
              {% for feature in features %}
                {% assign trimmed_feature = feature | strip %}
                {% if trimmed_feature != blank %}
                  <li class="ai-pricing-card-feature-{{ ai_gen_id }}">{{ trimmed_feature }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          {% if block.settings.card_1_button_text != blank %}
            <a href="{{ block.settings.card_1_button_link }}" class="ai-pricing-card-button-{{ ai_gen_id }}">
              {{ block.settings.card_1_button_text }}
            </a>
          {% endif %}
        </div>

        <div class="ai-pricing-card-image-{{ ai_gen_id }}">
          {% if block.settings.card_1_image %}
            <img
              src="{{ block.settings.card_1_image | image_url: width: 600 }}"
              alt="{{ block.settings.card_1_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.card_1_image.width }}"
              height="{{ block.settings.card_1_image.height }}"
            >
          {% else %}
            <div class="ai-pricing-card-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-pricing-card-{{ ai_gen_id }} ai-pricing-card-best-value-{{ ai_gen_id }}">
        {% if block.settings.show_best_value_badge %}
          <span class="ai-pricing-card-best-value-badge-{{ ai_gen_id }}">{{ block.settings.best_value_label }}</span>
        {% endif %}

        <div class="ai-pricing-card-content-{{ ai_gen_id }}">
          <div class="ai-pricing-card-header-{{ ai_gen_id }}">
            {% if block.settings.card_2_title != blank %}
              <h3 class="ai-pricing-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
            {% endif %}

            <div class="ai-pricing-card-prices-{{ ai_gen_id }}">
              {% if block.settings.card_2_original_price != blank %}
                <span class="ai-pricing-card-original-price-{{ ai_gen_id }}">{{ block.settings.card_2_original_price }}</span>
              {% endif %}
              {% if block.settings.card_2_price != blank %}
                <span class="ai-pricing-card-price-{{ ai_gen_id }}">{{ block.settings.card_2_price }}</span>
              {% endif %}
              {% if block.settings.card_2_savings != blank %}
                <span class="ai-pricing-card-savings-{{ ai_gen_id }}">{{ block.settings.card_2_savings }}</span>
              {% endif %}
            </div>
          </div>

          {% if block.settings.card_2_features != blank %}
            <ul class="ai-pricing-card-features-{{ ai_gen_id }}">
              {% assign features = block.settings.card_2_features | newline_to_br | split: '<br />' %}
              {% for feature in features %}
                {% assign trimmed_feature = feature | strip %}
                {% if trimmed_feature != blank %}
                  <li class="ai-pricing-card-feature-{{ ai_gen_id }}">{{ trimmed_feature }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          {% if block.settings.card_2_button_text != blank %}
            <a href="{{ block.settings.card_2_button_link }}" class="ai-pricing-card-button-{{ ai_gen_id }}">
              {{ block.settings.card_2_button_text }}
            </a>
          {% endif %}
        </div>

        <div class="ai-pricing-card-image-{{ ai_gen_id }}">
          {% if block.settings.card_2_image %}
            <img
              src="{{ block.settings.card_2_image | image_url: width: 600 }}"
              alt="{{ block.settings.card_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.card_2_image.width }}"
              height="{{ block.settings.card_2_image.height }}"
            >
          {% else %}
            <div class="ai-pricing-card-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

