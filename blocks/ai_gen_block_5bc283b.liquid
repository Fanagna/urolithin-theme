{% doc %}
  @prompt
    Role:
    Act as a senior Shopify theme developer and conversion-focused UX designer specialized in premium supplement and biotech brands.
    
    Goal:
    Generate a high-credibility comparison section that clearly explains what differentiates our brand from others, using a clean, premium comparison table.
    
    Section Header
    
    Centered headline (uppercase):
    “WHAT MAKES US DIFFERENT”
    
    Layout & Background
    
    Full-width section
    
    Dark navy / charcoal gradient background
    
    Soft vignette effect (subtle)
    
    High contrast but elegant
    
    Content centered with max-width container
    
    Comparison Table Structure
    
    3 columns:
    
    FEATURES
    
    OTHERS
    
    PANSTELLAR
    
    Horizontal separators between rows
    
    Clean alignment and generous spacing
    
    Table Rows (DEFAULT CONTENT — EDITABLE)
    
    Row 1 — Mechanism
    
    Others: ❌ Single Pathway
    
    Panstellar: ✅ Complementary
    
    Row 2 — Dosing
    
    Others: ❌ Underdosed (<300mg)
    
    Panstellar: ✅ Clinical (2000mg each)
    
    Row 3 — Transparency
    
    Others: ❌ Proprietary Blends
    
    Panstellar: ✅ Fully Disclosed
    
    Row 4 — Quality
    
    Others: ❌ Made Overseas
    
    Panstellar: ✅ USA cGMP Cert.
    
    Iconography
    
    Red ❌ icons for “Others”
    
    Green ✅ icons for “Panstellar”
    
    Icons must be SVG or native (no images required)
    
    CTA (Below Table)
    
    Centered button
    
    Button text (editable):
    “View Lab Reports”
    
    Button style:
    
    Rounded pill shape
    
    Light border
    
    Transparent background
    
    Hover glow or subtle highlight
    
    Button must be linkable from Shopify settings (PDF, page, or external URL)
    
    Typography
    
    Headline: bold, uppercase, white
    
    Column headers: small caps or uppercase
    
    Feature labels: light gray
    
    Panstellar column text slightly brighter or accented
    
    Design Principles
    
    Premium
    
    Trust-focused
    
    No hype
    
    Clear differentiation
    
    Suitable for biohackers and educated buyers
    
    Customization (IMPORTANT)
    
    All text editable from Shopify section settings
    
    CTA link editable
    
    Colors adjustable
    
    Ability to add/remove rows
    
    Technical Requirements
    
    Shopify Online Store 2.0 compatible
    
    Implement as a reusable section
    
    Mobile-friendly (table stacks or scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    background-image: {{ block.settings.background_gradient }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    position: relative;
  }

  .ai-comparison-section-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, {{ block.settings.vignette_opacity }}) 100%);
    pointer-events: none;
  }

  .ai-comparison-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-comparison-headline-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.headline_letter_spacing }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_margin_bottom }}px;
  }

  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin-bottom: {{ block.settings.table_margin_bottom }}px;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th {
    padding: {{ block.settings.header_padding }}px;
    text-align: center;
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.header_text_color }};
    border-bottom: {{ block.settings.header_border_thickness }}px solid {{ block.settings.header_border_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th:first-child {
    text-align: left;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr {
    border-bottom: {{ block.settings.row_border_thickness }}px solid {{ block.settings.row_border_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td {
    padding: {{ block.settings.cell_padding }}px;
    vertical-align: middle;
  }

  .ai-comparison-feature-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_font_size }}px;
    color: {{ block.settings.feature_text_color }};
    font-weight: 500;
  }

  .ai-comparison-cell-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.cell_font_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai-comparison-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-comparison-others-{{ ai_gen_id }} {
    color: {{ block.settings.others_text_color }};
  }

  .ai-comparison-panstellar-{{ ai_gen_id }} {
    color: {{ block.settings.panstellar_text_color }};
    font-weight: 600;
  }

  .ai-comparison-cta-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-comparison-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-comparison-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    box-shadow: 0 0 {{ block.settings.button_hover_glow }}px {{ block.settings.button_hover_glow_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.7);
    }

    .ai-comparison-table-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-comparison-table-{{ ai_gen_id }} thead th {
      padding: 12px 8px;
      font-size: 11px;
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody td {
      padding: 12px 8px;
    }

    .ai-comparison-feature-{{ ai_gen_id }} {
      font-size: 13px;
    }

    .ai-comparison-cell-{{ ai_gen_id }} {
      font-size: 12px;
      flex-direction: column;
      gap: 4px;
    }

    .ai-comparison-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.8);
      height: calc({{ block.settings.icon_size }}px * 0.8);
    }

    .ai-comparison-button-{{ ai_gen_id }} {
      font-size: 13px;
      padding: 12px 24px;
    }
  }
{% endstyle %}

