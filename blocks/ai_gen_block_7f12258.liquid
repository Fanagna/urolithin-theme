{% doc %}
  @prompt
    Create a comparison table section identical to the reference.
    
    ⚠️ Do not change any text, wording, icons, or layout.
    ⚠️ Only modify the color of the second column.
    
    CONTENT (must remain exactly the same)
    
    Title:
    🔴 WHY CHOOSE PANSTELLAR?
    
    TABLE STRUCTURE
    
    Columns:
    
    Left Column:
    Title: Most Brands
    Items:
    
    ❌ Weak doses
    
    ❌ 1 or 2 ingredients
    
    ❌ Made in China
    
    ❌ No testing
    
    ❌ Hidden formulas
    
    Right Column:
    Title: Panstellar
    Items:
    
    ✅ High potency (3610mg)
    
    ✅ Triple combo
    
    ✅ USA Made
    
    ✅ Every batch tested
    
    ✅ Full transparency
    
    DESIGN & STYLE RULES
    
    Left Column (Most Brands): Standard background color (light grey or white)
    
    Right Column (Panstellar):
    
    Change the background color to dark blue or another contrasting color, different from the left column. Keep the text white for contrast.
    
    The second column should stand out visually, while maintaining the same general layout.
    
    Keep the items aligned and consistent in size, with the check and cross icons placed next to the text as shown in the reference.
    
    Equal row height and spacing for both columns to maintain a clean, balanced look.
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: Two columns side by side, with the second column in a different background color.
    
    Tablet: Same two-column layout, with reduced gap between columns.
    
    Mobile: Stack content vertically. The color differentiation between columns should still be visible, but ensure readability on smaller screens.
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox or Grid
    
    Use media queries for mobile
    
    Mobile-first responsive logic
    
    Shopify Dawn compatible
    
    No JavaScript
    
    The final result must look exactly like the reference, with only the second column having a different background color (dark blue or similar).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-comparison-table__container-{{ ai_gen_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-comparison-table__title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 40px;
    color: {{ block.settings.title_color }};
  }

  .ai-comparison-table__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-comparison-table__column-{{ ai_gen_id }} {
    border-radius: {{ block.settings.border_radius }}px;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
  }

  .ai-comparison-table__column--left-{{ ai_gen_id }} {
    background-color: {{ block.settings.left_bg_color }};
  }

  .ai-comparison-table__column--right-{{ ai_gen_id }} {
    background-color: {{ block.settings.right_bg_color }};
  }

  .ai-comparison-table__column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: 700;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-comparison-table__column--left-{{ ai_gen_id }} .ai-comparison-table__column-title-{{ ai_gen_id }} {
    color: {{ block.settings.left_text_color }};
  }

  .ai-comparison-table__column--right-{{ ai_gen_id }} .ai-comparison-table__column-title-{{ ai_gen_id }} {
    color: {{ block.settings.right_text_color }};
  }

  .ai-comparison-table__items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-comparison-table__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.item_size }}px;
    line-height: 1.5;
  }

  .ai-comparison-table__column--left-{{ ai_gen_id }} .ai-comparison-table__item-{{ ai_gen_id }} {
    color: {{ block.settings.left_text_color }};
  }

  .ai-comparison-table__column--right-{{ ai_gen_id }} .ai-comparison-table__item-{{ ai_gen_id }} {
    color: {{ block.settings.right_text_color }};
  }

  .ai-comparison-table__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    font-size: {{ block.settings.icon_size }}px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-comparison-table__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }

    .ai-comparison-table__column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_title_size | times: 0.9 }}px;
    }

    .ai-comparison-table__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table__container-{{ ai_gen_id }}">
    <h2 class="ai-comparison-table__title-{{ ai_gen_id }}">🔴 WHY CHOOSE PANSTELLAR?</h2>

    <div class="ai-comparison-table__grid-{{ ai_gen_id }}">
      <div class="ai-comparison-table__column-{{ ai_gen_id }} ai-comparison-table__column--left-{{ ai_gen_id }}">
        <h3 class="ai-comparison-table__column-title-{{ ai_gen_id }}">Most Brands</h3>
        <div class="ai-comparison-table__items-{{ ai_gen_id }}">
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">❌</span>
            <span>Weak doses</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">❌</span>
            <span>1 or 2 ingredients</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">❌</span>
            <span>Made in China</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">❌</span>
            <span>No testing</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">❌</span>
            <span>Hidden formulas</span>
          </div>
        </div>
      </div>

      <div class="ai-comparison-table__column-{{ ai_gen_id }} ai-comparison-table__column--right-{{ ai_gen_id }}">
        <h3 class="ai-comparison-table__column-title-{{ ai_gen_id }}">Panstellar</h3>
        <div class="ai-comparison-table__items-{{ ai_gen_id }}">
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">✅</span>
            <span>High potency (3610mg)</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">✅</span>
            <span>Triple combo</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">✅</span>
            <span>USA Made</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">✅</span>
            <span>Every batch tested</span>
          </div>
          <div class="ai-comparison-table__item-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }}">✅</span>
            <span>Full transparency</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Background color",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "color",
      "id": "right_bg_color",
      "label": "Background color",
      "default": "#0e056e"
    },
    {
      "type": "color",
      "id": "right_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "column_title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Column title size",
      "default": 22
    },
    {
      "type": "range",
      "id": "item_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Item text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Comparison table"
    }
  ]
}
{% endschema %}
