<script>
  (function() {
    class ProductLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initImageGallery();
        this.initFrequencyOptions();
        this.initQuantityOptions();
        this.initShareButton();
      }

      initImageGallery() {
        const mainImage = this.querySelector('[data-main-image]');
        const thumbnails = this.querySelectorAll('.ai-product-thumbnail-{{ ai_gen_id }}');
        const dots = this.querySelectorAll('.ai-product-carousel-dot-{{ ai_gen_id }}');

        if (!mainImage || thumbnails.length === 0) return;

        thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            const index = parseInt(thumbnail.dataset.thumbnailIndex);
            const imageUrl = thumbnail.querySelector('img').src.replace('width=200', 'width=1000');

            mainImage.src = imageUrl;

            thumbnails.forEach((t) => t.classList.remove('active'));
            thumbnail.classList.add('active');

            dots.forEach((d) => d.classList.remove('active'));
            if (dots[index]) {
              dots[index].classList.add('active');
            }
          });
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.dataset.dotIndex);
            if (thumbnails[index]) {
              thumbnails[index].click();
            }
          });
        });
      }

      initFrequencyOptions() {
        const options = this.querySelectorAll('.ai-product-frequency-option-{{ ai_gen_id }}');

        options.forEach((option) => {
          option.addEventListener('click', () => {
            options.forEach((o) => o.classList.remove('selected'));
            option.classList.add('selected');
          });
        });
      }

      initQuantityOptions() {
        const options = this.querySelectorAll('.ai-product-quantity-option-{{ ai_gen_id }}');

        options.forEach((option) => {
          option.addEventListener('click', () => {
            options.forEach((o) => o.classList.remove('selected'));
            option.classList.add('selected');
          });
        });
      }

      initShareButton() {
        const shareButton = this.querySelector('[data-share-button]');

        if (!shareButton) return;

        shareButton.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({
                title: document.title,
                url: window.location.href
              });
            } catch (err) {
              console.log('Share cancelled');
            }
          } else {
            const url = window.location.href;
            navigator.clipboard.writeText(url);
            alert('Link copied to clipboard!');
          }
        });
      }
    }

    customElements.define('product-layout-{{ ai_gen_id }}', ProductLayout{{ ai_gen_id }});
  })();
</script>

