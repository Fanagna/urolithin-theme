{% doc %}
  @prompt
    Create a two-column product layout:
    
    LEFT COLUMN (Sticky Image Section)
    
    Main product image
    
    Thumbnail slider below
    
    Discount badge on image
    
    Zoom icon on image
    
    Carousel dots indicator
    
    Left column remains sticky while scrolling on desktop
    
    RIGHT COLUMN (Scrollable Content Section)
    
    The entire right column must be a vertically scrollable section inside its own container.
    
    This right panel contains:
    
    Review badge (3198 Verified Reviews)
    
    Star rating + “10,000+ Bottles Sold”
    
    Product title
    
    Share button
    
    Description
    
    Feature badges
    
    Benefit bullet points
    
    “Choose how often”
    
    “Select quantity”
    
    Pricing options
    
    Add to cart button
    
    Trust badges
    
    Reviews section
    
    Lab results section
    
    🔹 SCROLL BEHAVIOR (Critical Requirement)
    
    The right column scrolls independently
    
    The left image column remains sticky
    
    No layout shift
    
    Smooth vertical scrolling
    
    Scrollbar only visible on the right section
    
    Page body should not scroll while inside the right panel (desktop behavior)
    
    🔹 RESPONSIVE RULES
    Desktop
    
    Two-column layout
    
    Left side sticky
    
    Right side scrollable panel with overflow-y: auto
    
    Full height viewport layout
    
    Tablet
    
    Adjust proportions but maintain two-column structure if space allows
    
    Mobile
    
    Single column layout
    
    Normal page scroll
    
    Sticky and internal scroll disabled
    
    Maintain exact styling and spacing
    
    🔹 TECHNICAL REQUIREMENTS
    
    Use CSS Grid or Flexbox
    
    Use position: sticky for left column
    
    Use height: 100vh on layout wrapper (desktop)
    
    Use overflow-y: auto on right column
    
    No external libraries
    
    Dawn theme compatible
    
    Clean semantic HTML
    
    Lightweight CSS
    
    No redesign
    
    🔹 DESIGN RULES
    
    Keep exact red CTA button
    
    Keep exact highlight pricing box
    
    Keep exact badge styling
    
    Keep exact typography scale
    
    Keep exact spacing
    
    No animations added except natural hover states
    
    No color changes
    
    No structural changes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-layout-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .ai-product-layout-wrapper-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: {{ block.settings.left_column_width }}% {{ 100 | minus: block.settings.left_column_width }}%;
      gap: {{ block.settings.column_gap }}px;
      height: 100vh;
      overflow: hidden;
    }

    .ai-product-left-column-{{ ai_gen_id }} {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding: {{ block.settings.column_padding }}px;
    }

    .ai-product-right-column-{{ ai_gen_id }} {
      height: 100vh;
      overflow-y: auto;
      overflow-x: hidden;
      padding: {{ block.settings.column_padding }}px;
      scrollbar-width: thin;
      scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
    }

    .ai-product-right-column-{{ ai_gen_id }}::-webkit-scrollbar {
      width: 8px;
    }

    .ai-product-right-column-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: transparent;
    }

    .ai-product-right-column-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background-color: {{ block.settings.scrollbar_color }};
      border-radius: 4px;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-product-layout-wrapper-{{ ai_gen_id }} {
      display: block;
    }

    .ai-product-left-column-{{ ai_gen_id }},
    .ai-product-right-column-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }
  }

  .ai-product-image-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: 20px;
  }

  .ai-product-main-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f9f9f9;
  }

  .ai-product-main-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-discount-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-weight: 700;
    font-size: 14px;
    z-index: 2;
  }

  .ai-product-zoom-icon-{{ ai_gen_id }} {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-product-zoom-icon-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-product-zoom-icon-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: #121212;
  }

  .ai-product-thumbnails-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ai-product-thumbnails-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-thumbnail-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: {{ block.settings.thumbnail_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .ai-product-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.thumbnail_active_border }};
  }

  .ai-product-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .ai-product-carousel-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #d1d1d1;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .ai-product-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-product-review-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: {{ block.settings.review_badge_bg }};
    color: {{ block.settings.review_badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .ai-product-star-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-product-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-product-stars-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
    fill: {{ block.settings.star_color }};
  }

  .ai-product-bottles-sold-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666;
    font-weight: 500;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-product-share-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1px solid #d1d1d1;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    color: #121212;
    margin-bottom: 24px;
    transition: border-color 0.3s ease;
  }

  .ai-product-share-button-{{ ai_gen_id }}:hover {
    border-color: #121212;
  }

  .ai-product-share-button-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  .ai-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin-bottom: 24px;
  }

  .ai-product-feature-badges-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-product-feature-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: {{ block.settings.feature_badge_bg }};
    color: {{ block.settings.feature_badge_text }};
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
  }

  .ai-product-feature-badge-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  .ai-product-benefits-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-product-benefit-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ai-product-benefit-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
  }

  .ai-product-benefit-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.benefit_icon_color }};
  }

  .ai-product-benefit-text-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.5;
    color: #121212;
  }

  .ai-product-frequency-section-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-product-section-label-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: #121212;
    margin-bottom: 12px;
    display: block;
  }

  .ai-product-frequency-options-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-product-frequency-option-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px;
    border: 2px solid #d1d1d1;
    border-radius: 8px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .ai-product-frequency-option-{{ ai_gen_id }}:hover {
    border-color: #121212;
  }

  .ai-product-frequency-option-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.selected_option_border }};
    background-color: {{ block.settings.selected_option_bg }};
  }

  .ai-product-quantity-section-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-product-quantity-options-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 12px;
  }

  .ai-product-quantity-option-{{ ai_gen_id }} {
    padding: 16px;
    border: 2px solid #d1d1d1;
    border-radius: 8px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .ai-product-quantity-option-{{ ai_gen_id }}:hover {
    border-color: #121212;
  }

  .ai-product-quantity-option-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.selected_option_border }};
    background-color: {{ block.settings.selected_option_bg }};
  }

  .ai-product-quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .ai-product-quantity-price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
  }

  .ai-product-pricing-highlight-{{ ai_gen_id }} {
    background-color: {{ block.settings.pricing_highlight_bg }};
    border: 2px solid {{ block.settings.pricing_highlight_border }};
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .ai-product-pricing-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .ai-product-pricing-label-{{ ai_gen_id }} {
    font-size: 15px;
    color: #121212;
  }

  .ai-product-pricing-value-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: #121212;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    border: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 24px;
    transition: background-color 0.3s ease;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg }};
  }

  .ai-product-trust-badges-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-around;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 32px;
  }

  .ai-product-trust-badge-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .ai-product-trust-badge-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
  }

  .ai-product-trust-badge-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.trust_badge_icon_color }};
  }

  .ai-product-trust-badge-text-{{ ai_gen_id }} {
    font-size: 12px;
    color: #666;
    font-weight: 500;
  }

  .ai-product-reviews-section-{{ ai_gen_id }},
  .ai-product-lab-results-section-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-product-section-title-{{ ai_gen_id }} {
    font-size: 22px;
    font-weight: 700;
    color: #121212;
    margin-bottom: 16px;
  }

  .ai-product-section-content-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.6;
    color: #666;
  }
{% endstyle %}

<product-layout-{{ ai_gen_id }} class="ai-product-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-layout-wrapper-{{ ai_gen_id }}">
    <div class="ai-product-left-column-{{ ai_gen_id }}">
      <div class="ai-product-image-section-{{ ai_gen_id }}">
        <div class="ai-product-main-image-wrapper-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="ai-product-main-image-{{ ai_gen_id }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="eager"
              data-main-image
            >
          {% else %}
            <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.show_discount_badge %}
            <div class="ai-product-discount-badge-{{ ai_gen_id }}">
              {{ block.settings.discount_text }}
            </div>
          {% endif %}

          {% if block.settings.show_zoom_icon %}
            <div class="ai-product-zoom-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
              </svg>
            </div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="ai-product-thumbnails-{{ ai_gen_id }}">
            {% for image in product.images limit: 5 %}
              <div class="ai-product-thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-thumbnail-index="{{ forloop.index0 }}">
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </div>
            {% endfor %}
          </div>

          {% if block.settings.show_carousel_dots %}
            <div class="ai-product-carousel-dots-{{ ai_gen_id }}">
              {% for image in product.images limit: 5 %}
                <div class="ai-product-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-dot-index="{{ forloop.index0 }}"></div>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="ai-product-right-column-{{ ai_gen_id }}">
      {% if block.settings.show_review_badge %}
        <div class="ai-product-review-badge-{{ ai_gen_id }}">
          ✓ {{ block.settings.review_badge_label }}
        </div>
      {% endif %}

      <div class="ai-product-star-rating-{{ ai_gen_id }}">
        <div class="ai-product-stars-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="ai-product-bottles-sold-{{ ai_gen_id }}">{{ block.settings.bottles_sold_text }}</span>
      </div>

      <h1 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h1>

      {% if block.settings.show_share_button %}
        <button class="ai-product-share-button-{{ ai_gen_id }}" data-share-button>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
          </svg>
          Share
        </button>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.show_feature_badges %}
        <div class="ai-product-feature-badges-{{ ai_gen_id }}">
          {% if block.settings.feature_1 != blank %}
            <div class="ai-product-feature-badge-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {{ block.settings.feature_1 }}
            </div>
          {% endif %}
          {% if block.settings.feature_2 != blank %}
            <div class="ai-product-feature-badge-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {{ block.settings.feature_2 }}
            </div>
          {% endif %}
          {% if block.settings.feature_3 != blank %}
            <div class="ai-product-feature-badge-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {{ block.settings.feature_3 }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_benefits %}
        <div class="ai-product-benefits-{{ ai_gen_id }}">
          {% if block.settings.benefit_1 != blank %}
            <div class="ai-product-benefit-item-{{ ai_gen_id }}">
              <div class="ai-product-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <div class="ai-product-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_1 }}</div>
            </div>
          {% endif %}
          {% if block.settings.benefit_2 != blank %}
            <div class="ai-product-benefit-item-{{ ai_gen_id }}">
              <div class="ai-product-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <div class="ai-product-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_2 }}</div>
            </div>
          {% endif %}
          {% if block.settings.benefit_3 != blank %}
            <div class="ai-product-benefit-item-{{ ai_gen_id }}">
              <div class="ai-product-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <div class="ai-product-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_3 }}</div>
            </div>
          {% endif %}
        </div>
      {% endif %}

