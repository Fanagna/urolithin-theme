{% doc %}
  @prompt
    creer moi une section contenant un titre centré  au centre , une image en format carré à gauche (reglable); et à droite un tableau de 6lignes et de 2 colonnes (sans montrer les bordure des     colonnes)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-table-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-table-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-table-title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
  }

  .ai-image-table-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.image_width }}% 1fr;
    gap: {{ block.settings.content_gap }}px;
    align-items: start;
  }

  .ai-image-table-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-table-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-table-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-table-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-image-table-table-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-image-table-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
  }

  .ai-image-table-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    vertical-align: top;
  }

  .ai-image-table-table-{{ ai_gen_id }} td:first-child {
    font-weight: {{ block.settings.first_column_bold }};
    width: {{ block.settings.first_column_width }}%;
  }

  .ai-image-table-table-{{ ai_gen_id }} tr {
    border-bottom: {{ block.settings.row_separator_thickness }}px solid {{ block.settings.row_separator_color }};
  }

  .ai-image-table-table-{{ ai_gen_id }} tr:last-child {
    border-bottom: none;
  }

  @media screen and (max-width: 749px) {
    .ai-image-table-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-image-table-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-image-table-table-{{ ai_gen_id }} td {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
      padding: {{ block.settings.cell_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-table-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-table-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-image-table-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-image-table-content-{{ ai_gen_id }}">
      <div class="ai-image-table-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            class="ai-image-table-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-image-table-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-image-table-table-wrapper-{{ ai_gen_id }}">
        <table class="ai-image-table-table-{{ ai_gen_id }}">
          <tbody>
            {% if block.settings.row_1_col_1 != blank or block.settings.row_1_col_2 != blank %}
              <tr>
                <td>{{ block.settings.row_1_col_1 }}</td>
                <td>{{ block.settings.row_1_col_2 }}</td>
              </tr>
            {% endif %}

            {% if block.settings.row_2_col_1 != blank or block.settings.row_2_col_2 != blank %}
              <tr>
                <td>{{ block.settings.row_2_col_1 }}</td>
                <td>{{ block.settings.row_2_col_2 }}</td>
              </tr>
            {% endif %}

            {% if block.settings.row_3_col_1 != blank or block.settings.row_3_col_2 != blank %}
              <tr>
                <td>{{ block.settings.row_3_col_1 }}</td>
                <td>{{ block.settings.row_3_col_2 }}</td>
              </tr>
            {% endif %}

            {% if block.settings.row_4_col_1 != blank or block.settings.row_4_col_2 != blank %}
              <tr>
                <td>{{ block.settings.row_4_col_1 }}</td>
                <td>{{ block.settings.row_4_col_2 }}</td>
              </tr>
            {% endif %}

            {% if block.settings.row_5_col_1 != blank or block.settings.row_5_col_2 != blank %}
              <tr>
                <td>{{ block.settings.row_5_col_1 }}</td>
                <td>{{ block.settings.row_5_col_2 }}</td>
              </tr>
            {% endif %}

            {% if block.settings.row_6_col_1 != blank or block.settings.row_6_col_2 != blank %}
              <tr>
                <td>{{ block.settings.row_6_col_1 }}</td>
                <td>{{ block.settings.row_6_col_2 }}</td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with table",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product specifications"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing below title",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Image width",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Table row 1"
    },
    {
      "type": "text",
      "id": "row_1_col_1",
      "label": "Column 1"
    },
    {
      "type": "text",
      "id": "row_1_col_2",
      "label": "Column 2"
    },
    {
      "type": "header",
      "content": "Table row 2"
    },
    {
      "type": "text",
      "id": "row_2_col_1",
      "label": "Column 1"
    },
    {
      "type": "text",
      "id": "row_2_col_2",
      "label": "Column 2"
    },
    {
      "type": "header",
      "content": "Table row 3"
    },
    {
      "type": "text",
      "id": "row_3_col_1",
      "label": "Column 1"
    },
    {
      "type": "text",
      "id": "row_3_col_2",
      "label": "Column 2"
    },
    {
      "type": "header",
      "content": "Table row 4"
    },
    {
      "type": "text",
      "id": "row_4_col_1",
      "label": "Column 1"
    },
    {
      "type": "text",
      "id": "row_4_col_2",
      "label": "Column 2"
    },
    {
      "type": "header",
      "content": "Table row 5"
    },
    {
      "type": "text",
      "id": "row_5_col_1",
      "label": "Column 1"
    },
    {
      "type": "text",
      "id": "row_5_col_2",
      "label": "Column 2"
    },
    {
      "type": "header",
      "content": "Table row 6"
    },
    {
      "type": "text",
      "id": "row_6_col_1",
      "label": "Column 1"
    },
    {
      "type": "text",
      "id": "row_6_col_2",
      "label": "Column 2"
