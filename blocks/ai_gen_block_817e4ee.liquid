{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-clinical-science-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_desktop }}px 20px;
  }

  .ai-clinical-science-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-clinical-science-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size_desktop }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    text-align: center;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.title_margin }}px;
  }

  .ai-clinical-science-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 400;
    color: {{ block.settings.subtitle_color }};
    text-align: center;
    line-height: 1.6;
    margin: 0 0 {{ block.settings.content_gap }}px;
  }

  .ai-clinical-science-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.content_gap }}px;
    align-items: start;
  }

  .ai-clinical-science-image-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.image_block_bg }};
    border-radius: {{ block.settings.image_border_radius }}px;
    padding: {{ block.settings.image_padding }}px;
    overflow: hidden;
  }

  .ai-clinical-science-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
  }

  .ai-clinical-science-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-clinical-science-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-clinical-science-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-clinical-science-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-clinical-science-card-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-clinical-science-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .ai-clinical-science-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-clinical-science-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .ai-clinical-science-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    font-weight: 400;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-clinical-science-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_mobile }}px 16px;
    }

    .ai-clinical-science-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-clinical-science-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-clinical-science-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstyle %}

<clinical-science-{{ ai_gen_id }} class="ai-clinical-science-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-clinical-science-container-{{ ai_gen_id }}">
    <h2 class="ai-clinical-science-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    <p class="ai-clinical-science-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>

    <div class="ai-clinical-science-content-{{ ai_gen_id }}">
      <div class="ai-clinical-science-image-block-{{ ai_gen_id }}">
        <div class="ai-clinical-science-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="ai-clinical-science-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-clinical-science-cards-{{ ai_gen_id }}">
        <div class="ai-clinical-science-card-{{ ai_gen_id }}">
          <div class="ai-clinical-science-icon-{{ ai_gen_id }}" style="background-color: {{ block.settings.icon_1_color }};">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <h3 class="ai-clinical-science-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
          <p class="ai-clinical-science-card-description-{{ ai_gen_id }}">{{ block.settings.card_1_description }}</p>
        </div>

        <div class="ai-clinical-science-card-{{ ai_gen_id }}">
          <div class="ai-clinical-science-icon-{{ ai_gen_id }}" style="background-color: {{ block.settings.icon_2_color }};">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="ai-clinical-science-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
          <p class="ai-clinical-science-card-description-{{ ai_gen_id }}">{{ block.settings.card_2_description }}</p>
        </div>

        <div class="ai-clinical-science-card-{{ ai_gen_id }}">
          <div class="ai-clinical-science-icon-{{ ai_gen_id }}" style="background-color: {{ block.settings.icon_3_color }};">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path>
            </svg>
          </div>
          <h3 class="ai-clinical-science-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
          <p class="ai-clinical-science-card-description-{{ ai_gen_id }}">{{ block.settings.card_3_description }}</p>
        </div>

        <div class="ai-clinical-science-card-{{ ai_gen_id }}">
          <div class="ai-clinical-science-icon-{{ ai_gen_id }}" style="background-color: {{ block.settings.icon_4_color }};">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="ai-clinical-science-card-title-{{ ai_gen_id }}">{{ block.settings.card_4_title }}</h3>
          <p class="ai-clinical-science-card-description-{{ ai_gen_id }}">{{ block.settings.card_4_description }}</p>
        </div>
      </div>
    </div>
  </div>
</clinical-science-{{ ai_gen_id }}>

<script>
  (function() {
    class ClinicalScience{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('clinical-science-{{ ai_gen_id }}', ClinicalScience{{ ai_gen_id }});
  })();
</script>

