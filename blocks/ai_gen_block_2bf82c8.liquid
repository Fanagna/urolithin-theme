{% doc %}
  @prompt
    Create a clean two-column qualification section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, punctuation, emojis, icons, colors, spacing, or hierarchy.
    ⚠️ DO NOT rewrite, summarize, or optimize the copy.
    
    SECTION HEADER (centered)
    
    Title:
    🤔 IS THIS FOR YOU?
    
    LAYOUT
    
    Display two cards side by side on desktop.
    
    LEFT CARD (GREEN – POSITIVE)
    
    Card background:
    Light green (same shade as reference)
    
    Title:
    ✅ GREAT FIT IF YOU:
    
    Bullet list (keep exact wording and order):
    
    Deal with energy ups and downs
    
    Struggle with cravings
    
    Feel bloated or uncomfortable after meals
    
    Want to feel better without changing everything
    
    Value quality & transparency
    
    RIGHT CARD (RED – NOT A FIT)
    
    Card background:
    Light red / light pink (same shade as reference)
    
    Title:
    ❌ NOT FOR YOU IF:
    
    Bullet list (keep exact wording and order):
    
    You want instant results (this takes 2–3 weeks)
    
    You won’t take it daily
    
    You’re looking for a weight loss pill
    
    This works. But you need to be consistent.
    
    DESIGN & STYLE RULES
    
    Clean, premium supplement-brand aesthetic
    
    Rounded card corners
    
    Comfortable internal padding
    
    Text left-aligned inside cards
    
    Clear visual contrast between green and red cards
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: two cards side by side
    
    Tablet: two cards with reduced gap
    
    Mobile:
    
    Stack cards vertically
    
    Full-width cards
    
    Maintain background colors and spacing
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use Flexbox or CSS Grid
    
    Mobile-first responsive CSS
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting layout for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-qualification-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
  }

  .ai-qualification-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-qualification-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-qualification-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin: 0;
    color: #000000;
  }

  .ai-qualification-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .ai-qualification-card-{{ ai_gen_id }} {
    border-radius: 12px;
    padding: 40px 30px;
  }

  .ai-qualification-card-{{ ai_gen_id }}--green {
    background-color: #e8f5e9;
  }

  .ai-qualification-card-{{ ai_gen_id }}--red {
    background-color: #ffebee;
  }

  .ai-qualification-card-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 20px 0;
    color: #000000;
  }

  .ai-qualification-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-qualification-list-{{ ai_gen_id }} li {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 12px;
    color: #333333;
    padding-left: 0;
  }

  .ai-qualification-list-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-qualification-footer-{{ ai_gen_id }} {
    margin-top: 20px;
    font-size: 16px;
    font-weight: 600;
    color: #000000;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-qualification-cards-{{ ai_gen_id }} {
      gap: 20px;
    }

    .ai-qualification-card-{{ ai_gen_id }} {
      padding: 30px 25px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-qualification-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-qualification-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-qualification-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-qualification-card-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-qualification-card-title-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-qualification-list-{{ ai_gen_id }} li {
      font-size: 15px;
    }

    .ai-qualification-footer-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }
{% endstyle %}

<div class="ai-qualification-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-qualification-container-{{ ai_gen_id }}">
    <div class="ai-qualification-header-{{ ai_gen_id }}">
      <h2 class="ai-qualification-title-{{ ai_gen_id }}">🤔 IS THIS FOR YOU?</h2>
    </div>

    <div class="ai-qualification-cards-{{ ai_gen_id }}">
      <div class="ai-qualification-card-{{ ai_gen_id }} ai-qualification-card-{{ ai_gen_id }}--green">
        <h3 class="ai-qualification-card-title-{{ ai_gen_id }}">✅ GREAT FIT IF YOU:</h3>
        <ul class="ai-qualification-list-{{ ai_gen_id }}">
          <li>Deal with energy ups and downs</li>
          <li>Struggle with cravings</li>
          <li>Feel bloated or uncomfortable after meals</li>
          <li>Want to feel better without changing everything</li>
          <li>Value quality & transparency</li>
        </ul>
      </div>

      <div class="ai-qualification-card-{{ ai_gen_id }} ai-qualification-card-{{ ai_gen_id }}--red">
        <h3 class="ai-qualification-card-title-{{ ai_gen_id }}">❌ NOT FOR YOU IF:</h3>
        <ul class="ai-qualification-list-{{ ai_gen_id }}">
          <li>You want instant results (this takes 2–3 weeks)</li>
          <li>You won't take it daily</li>
          <li>You're looking for a weight loss pill</li>
        </ul>
        <div class="ai-qualification-footer-{{ ai_gen_id }}">This works. But you need to be consistent.</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Is this for you",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Is this for you"
    }
  ],
  "tag": null
}
{% endschema %}
