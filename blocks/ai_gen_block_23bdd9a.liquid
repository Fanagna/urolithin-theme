{% doc %}
  @prompt
    Create a two-column layout for the "ANTI-AGING STACK" section, identical to the reference.
    
    ⚠️ DO NOT change any text, wording, punctuation, icons, colors, images, or layout style.
    ⚠️ Only modify the mobile layout to stack content vertically.
    
    CONTENT (must remain exactly the same)
    
    Title (uppercase):
    ⚡ THE ANTI-AGING STACK THAT ACTUALLY WORKS
    
    Subtitle:
    Think of your cells like batteries. This protocol recharges them using 3 proven ingredients backed by 200+ scientific studies.
    
    LEFT COLUMN (BOTTLE 1: NAD+ COMPLEX)
    
    Image placeholder:
    [BOTTLE 1 IMAGE]
    NAD+ COMPLEX
    
    Text:
    What it does: Recharges your cells for sustained energy.
    
    List items:
    
    NAD+ boosters
    
    Resveratrol ("red wine molecule")
    
    CoQ10 (heart health)
    
    Footer:
    180 capsules · 3 month supply
    
    RIGHT COLUMN (BOTTLE 2: NMN + RESVERATROL)
    
    Image placeholder:
    [BOTTLE 2 IMAGE]
    NMN + RESVERATROL
    
    Text:
    What it does: Activates your longevity genes.
    
    List items:
    
    NMN (anti-aging)
    
    Extra Resveratrol
    
    Quercetin (recovery)
    
    Footer:
    180 capsules · 3 month supply
    
    RESULT SECTION (centered)
    
    Title:
    💪 THE RESULT
    
    Bullet points:
    
    ✅ More energy & Sharper mind
    
    ✅ Faster recovery & Better sleep
    
    ✅ Healthier aging
    
    Footer text:
    Real results take time. But they’re worth it.
    
    DESIGN & STYLE RULES
    
    Clean, minimal, premium supplement-brand aesthetic
    
    Text aligned with icons as shown in the reference
    
    Consistent padding and spacing between sections
    
    Horizontal line or space between products and results
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: two columns (products side by side)
    
    Tablet: two columns with reduced spacing
    
    Mobile:
    
    Stack content vertically (image first, then text)
    
    Ensure icons and text remain aligned
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox or Grid
    
    Mobile-first responsive layout
    
    Shopify Dawn compatible
    
    No JavaScript
    
    The final result must look identical to the reference on desktop, with the only change being the mobile stacking behavior.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-antiaging-stack-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-antiaging-stack__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-antiaging-stack__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    letter-spacing: 0.5px;
  }

  .ai-antiaging-stack__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    text-align: center;
    margin: 0 0 40px;
    color: {{ block.settings.text_color }};
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-antiaging-stack__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 40px;
  }

  .ai-antiaging-stack__product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-antiaging-stack__product-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: 300px;
    margin-bottom: 16px;
  }

  .ai-antiaging-stack__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-antiaging-stack__product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-antiaging-stack__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-antiaging-stack__product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-antiaging-stack__product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-antiaging-stack__product-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    text-align: left;
    width: 100%;
    max-width: 300px;
  }

  .ai-antiaging-stack__product-list-{{ ai_gen_id }} li {
    font-size: {{ block.settings.body_text_size }}px;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .ai-antiaging-stack__product-list-{{ ai_gen_id }} li::before {
    content: "{{ block.settings.list_icon }}";
    flex-shrink: 0;
  }

  .ai-antiaging-stack__product-footer-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-antiaging-stack__divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: 40px 0;
    opacity: 0.2;
  }

  .ai-antiaging-stack__result-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-antiaging-stack__result-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_title_size }}px;
    font-weight: 700;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-antiaging-stack__result-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: inline-block;
    text-align: left;
  }

  .ai-antiaging-stack__result-list-{{ ai_gen_id }} li {
    font-size: {{ block.settings.body_text_size }}px;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-antiaging-stack__result-list-{{ ai_gen_id }} li::before {
    content: "{{ block.settings.result_icon }}";
    flex-shrink: 0;
  }

  .ai-antiaging-stack__result-footer-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.text_color }};
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-antiaging-stack__products-{{ ai_gen_id }} {
      gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-antiaging-stack-{{ ai_gen_id }} {
      padding: 32px 16px;
    }

    .ai-antiaging-stack__products-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-antiaging-stack__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-antiaging-stack__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
      margin-bottom: 32px;
    }
  }
{% endstyle %}

<div class="ai-antiaging-stack-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-antiaging-stack__container-{{ ai_gen_id }}">
    <h2 class="ai-antiaging-stack__title-{{ ai_gen_id }}">
      ⚡ THE ANTI-AGING STACK THAT ACTUALLY WORKS
    </h2>
    
    <p class="ai-antiaging-stack__subtitle-{{ ai_gen_id }}">
      Think of your cells like batteries. This protocol recharges them using 3 proven ingredients backed by 200+ scientific studies.
    </p>

    <div class="ai-antiaging-stack__products-{{ ai_gen_id }}">
      <div class="ai-antiaging-stack__product-{{ ai_gen_id }}">
        <div class="ai-antiaging-stack__product-image-{{ ai_gen_id }}">
          {% if block.settings.product_1_image %}
            <img
              src="{{ block.settings.product_1_image | image_url: width: 600 }}"
              alt="{{ block.settings.product_1_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_1_image.width }}"
              height="{{ block.settings.product_1_image.height }}"
            >
          {% else %}
            <div class="ai-antiaging-stack__product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        <h3 class="ai-antiaging-stack__product-name-{{ ai_gen_id }}">
          NAD+ COMPLEX
        </h3>
        
        <p class="ai-antiaging-stack__product-description-{{ ai_gen_id }}">
          What it does: Recharges your cells for sustained energy.
        </p>
        
        <ul class="ai-antiaging-stack__product-list-{{ ai_gen_id }}">
          <li>NAD+ boosters</li>
          <li>Resveratrol ("red wine molecule")</li>
          <li>CoQ10 (heart health)</li>
        </ul>
        
        <p class="ai-antiaging-stack__product-footer-{{ ai_gen_id }}">
          180 capsules · 3 month supply
        </p>
      </div>

      <div class="ai-antiaging-stack__product-{{ ai_gen_id }}">
        <div class="ai-antiaging-stack__product-image-{{ ai_gen_id }}">
          {% if block.settings.product_2_image %}
            <img
              src="{{ block.settings.product_2_image | image_url: width: 600 }}"
              alt="{{ block.settings.product_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_2_image.width }}"
              height="{{ block.settings.product_2_image.height }}"
            >
          {% else %}
            <div class="ai-antiaging-stack__product-placeholder-{{ ai_gen_id }}">
              {{ 'product-2' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        <h3 class="ai-antiaging-stack__product-name-{{ ai_gen_id }}">
          NMN + RESVERATROL
        </h3>
        
        <p class="ai-antiaging-stack__product-description-{{ ai_gen_id }}">
          What it does: Activates your longevity genes.
        </p>
        
        <ul class="ai-antiaging-stack__product-list-{{ ai_gen_id }}">
          <li>NMN (anti-aging)</li>
          <li>Extra Resveratrol</li>
          <li>Quercetin (recovery)</li>
        </ul>
        
        <p class="ai-antiaging-stack__product-footer-{{ ai_gen_id }}">
          180 capsules · 3 month supply
        </p>
      </div>
    </div>

    <div class="ai-antiaging-stack__divider-{{ ai_gen_id }}"></div>

    <div class="ai-antiaging-stack__result-{{ ai_gen_id }}">
      <h3 class="ai-antiaging-stack__result-title-{{ ai_gen_id }}">
        💪 THE RESULT
      </h3>
      
      <ul class="ai-antiaging-stack__result-list-{{ ai_gen_id }}">
        <li>More energy & Sharper mind</li>
        <li>Faster recovery & Better sleep</li>
        <li>Healthier aging</li>
      </ul>
      
      <p class="ai-antiaging-stack__result-footer-{{ ai_gen_id }}">
        Real results take time. But they're worth it.
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anti-aging stack",
  "settings": [
    {
      "type": "header",
      "content": "Product images"
    },
    {
      "type": "image_picker",
      "id": "product_1_image",
      "label": "Product 1 image (NAD+ Complex)"
    },
    {
      "type": "image_picker",
      "id": "product_2_image",
      "label": "Product 2 image (NMN + Resveratrol)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 18
    },
    {
      "type": "range",
      "id": "product_name_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Product name size",
      "default": 20
    },
    {
      "type": "range",
      "id": "result_title_size",
      "min": 18,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Result title size",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "footer_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Footer text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "text",
      "id": "list_icon",
      "label": "Product list icon",
      "default": "•"
    },
    {
      "type": "text",
      "id": "result_icon",
      "label": "Result list icon",
      "default": "✅"
    }
  ],
  "presets": [
    {
      "name": "Anti-aging stack"
    }
  ]
}
{% endschema %}
