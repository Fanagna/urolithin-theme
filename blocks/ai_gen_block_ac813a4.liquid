{% doc %}
  @prompt
    Create a premium product option section exactly matching the provided visual, structure, colors, and content. Do not rewrite or paraphrase any text.
    
    Design & visual requirements:
    
    Clean, minimal, premium layout
    
    White / very light background
    
    Centered section with generous spacing
    
    Rounded card with subtle shadow
    
    Modern, science-driven aesthetic
    
    Desktop-first, fully responsive on mobile
    
    Top section (centered):
    
    Icon: light bulb
    
    Title (exact text): NEW TO NAD+?
    
    Subtitle (exact text): Not ready for the full stack yet?
    
    Main card (single option):
    
    Small badge at top-left of card: STARTER OPTION
    
    Price displayed top-right: $59.99
    
    Card title (exact text):
    Try NAD+ Complex
    
    Subtitle under title (exact text):
    30-day supply
    
    Bullet points (exact wording, with blue check icons):
    
    500mg clinical dose
    
    Full 30-day refund guarantee
    
    Upgrade to bundle anytime
    
    Primary button (centered inside card):
    
    Button text: Try NAD+ First
    
    Rounded outline or solid button style
    
    No hardcoded URL (link configurable later)
    
    Footer note under the card (small, subtle, centered):
    Most customers upgrade to the bundle by week 3
    
    Additional constraints:
    
    Do NOT change wording
    
    Do NOT add pricing explanations or claims
    
    Do NOT add testimonials or guarantees beyond what is listed
    
    Keep tone calm, factual, and premium
    
    Visual style must match a high-end longevity / biohacking brand
    
    Goal:
    Provide a low-commitment entry option for new customers while maintaining trust, clarity, and premium brand positioning.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-nad-starter-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-nad-starter-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-nad-starter-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-nad-starter-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    margin: 0 auto 16px;
    color: {{ block.settings.icon_color }};
  }

  .ai-nad-starter-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-nad-starter-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-nad-starter-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-nad-starter-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 32px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-nad-starter-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 6px 12px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .ai-nad-starter-price-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-nad-starter-card-content-{{ ai_gen_id }} {
    margin-top: 40px;
  }

  .ai-nad-starter-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-nad-starter-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0 0 24px;
  }

  .ai-nad-starter-features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }

  .ai-nad-starter-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: {{ block.settings.feature_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-nad-starter-feature-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-nad-starter-check-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: {{ block.settings.check_color }};
  }

  .ai-nad-starter-check-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-nad-starter-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-nad-starter-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-nad-starter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-nad-starter-footer-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 24px;
    font-size: {{ block.settings.footer_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-nad-starter-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-nad-starter-card-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-nad-starter-badge-{{ ai_gen_id }} {
      position: static;
      display: inline-block;
      margin-bottom: 12px;
    }

    .ai-nad-starter-price-{{ ai_gen_id }} {
      position: static;
      display: block;
      text-align: center;
      margin-bottom: 20px;
    }

    .ai-nad-starter-card-content-{{ ai_gen_id }} {
      margin-top: 0;
    }

    .ai-nad-starter-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-nad-starter-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-nad-starter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-nad-starter-container-{{ ai_gen_id }}">
    <div class="ai-nad-starter-header-{{ ai_gen_id }}">
      <div class="ai-nad-starter-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18h6"></path>
          <path d="M10 22h4"></path>
          <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
        </svg>
      </div>
      <h2 class="ai-nad-starter-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      <p class="ai-nad-starter-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
    </div>

    <div class="ai-nad-starter-card-{{ ai_gen_id }}">
      <div class="ai-nad-starter-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</div>
      <div class="ai-nad-starter-price-{{ ai_gen_id }}">{{ block.settings.price }}</div>

      <div class="ai-nad-starter-card-content-{{ ai_gen_id }}">
        <h3 class="ai-nad-starter-card-title-{{ ai_gen_id }}">{{ block.settings.card_title }}</h3>
        <p class="ai-nad-starter-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_subtitle }}</p>

        <ul class="ai-nad-starter-features-{{ ai_gen_id }}">
          {% if block.settings.feature_1 != blank %}
            <li class="ai-nad-starter-feature-{{ ai_gen_id }}">
              <div class="ai-nad-starter-check-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{{ block.settings.feature_1 }}</span>
            </li>
          {% endif %}
          {% if block.settings.feature_2 != blank %}
            <li class="ai-nad-starter-feature-{{ ai_gen_id }}">
              <div class="ai-nad-starter-check-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{{ block.settings.feature_2 }}</span>
            </li>
          {% endif %}
          {% if block.settings.feature_3 != blank %}
            <li class="ai-nad-starter-feature-{{ ai_gen_id }}">
              <div class="ai-nad-starter-check-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{{ block.settings.feature_3 }}</span>
            </li>
          {% endif %}
        </ul>

        <div class="ai-nad-starter-button-wrapper-{{ ai_gen_id }}">
          <a href="{{ block.settings.button_link }}" class="ai-nad-starter-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        </div>
      </div>
    </div>

    {% if block.settings.footer_text != blank %}
      <p class="ai-nad-starter-footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
    {% endif %}
  </div>
</div>

