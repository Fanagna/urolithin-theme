  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Brand names"
    },
    {
      "type": "text",
      "id": "brand_1",
      "label": "Brand 1",
      "default": "Premium Wellness"
    },
    {
      "type": "text",
      "id": "brand_2",
      "label": "Brand 2",
      "default": "Natural Health"
    },
    {
      "type": "text",
      "id": "brand_3",
      "label": "Brand 3",
      "default": "Pure Supplements"
    },
    {
      "type": "text",
      "id": "brand_4",
      "label": "Brand 4",
      "default": "Vitality Labs"
    },
