{% doc %}
  @prompt
    bandeau deroulant de noms de marques
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-brand-marquee-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.spacing }}px;
    animation: ai-brand-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-brand-marquee-{{ ai_gen_id }}:hover .ai-brand-marquee-track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-brand-marquee-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    white-space: nowrap;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-style: {{ block.settings.font_family.style }};
    font-weight: {{ block.settings.font_family.weight }};
  }

  @keyframes ai-brand-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brand-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<brand-marquee-{{ ai_gen_id }} class="ai-brand-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-marquee-track-{{ ai_gen_id }}">
    {% liquid
      assign brands = ''
      if block.settings.brand_1 != blank
        assign brands = brands | append: block.settings.brand_1
      endif
      if block.settings.brand_2 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_2
      endif
      if block.settings.brand_3 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_3
      endif
      if block.settings.brand_4 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_4
      endif
      if block.settings.brand_5 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_5
      endif
      if block.settings.brand_6 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_6
      endif
      if block.settings.brand_7 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_7
      endif
      if block.settings.brand_8 != blank
        if brands != blank
          assign brands = brands | append: '|'
        endif
        assign brands = brands | append: block.settings.brand_8
      endif

      assign brand_array = brands | split: '|'
      assign brand_count = brand_array.size
    %}

    {% if brand_count > 0 %}
      {% for i in (1..2) %}
        {% for brand in brand_array %}
          <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
            {{ brand }}
          </div>
        {% endfor %}
      {% endfor %}
    {% else %}
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 1
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 2
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 3
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 4
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 5
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 6
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 1
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 2
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 3
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 4
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 5
      </div>
      <div class="ai-brand-marquee-item-{{ ai_gen_id }}">
        Brand 6
      </div>
    {% endif %}
  </div>
</brand-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-brand-marquee-track-{{ ai_gen_id }}');
        this.adjustSpeed();
      }

      adjustSpeed() {
        if (!this.track) return;
        
        const trackWidth = this.track.scrollWidth / 2;
        const speed = {{ block.settings.scroll_speed }};
        
        this.track.style.animationDuration = speed + 's';
      }
    }

    customElements.define('brand-marquee-{{ ai_gen_id }}', BrandMarquee{{ ai_gen_id }});
  })();
</script>

