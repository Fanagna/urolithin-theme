{% doc %}
  @prompt
    Create a custom Shopify section based on the reference visual provided. The section must exactly match the layout, text, icons, and overall style shown in the image.
    
    ⚠️ Do not change or rewrite any text.
    ⚠️ Maintain the exact text, punctuation, and formatting.
    
    The section should contain:
    
    1. Section Structure
    
    Full-width section with a clean and modern look
    
    Background: white
    
    Centered content
    
    Max content width: 1100–1200px
    
    Padding: 64px top and bottom (desktop), 40px top/bottom (mobile)
    
    2. Left Side (Image Block)
    
    Square image block (aspect ratio 1:1)
    
    Image should be responsive and resize properly on mobile.
    
    Image should be contained within a rounded square frame (border-radius 12–16px)
    
    Padding inside image block: 16px
    
    Text should not overlap the image.
    
    3. Right Side (Text Block)
    
    Title:
    
    Text: “Transition to Wellness”
    
    Font size: 24–30px
    
    Font weight: bold
    
    Text color: dark blue (similar to #003366)
    
    Alignment: left
    
    Subtitle (below title):
    
    Text: “What if the answer lies in your gut microbiome?”
    
    Font size: 16–18px
    
    Font weight: normal
    
    Text color: blue (similar to #0055cc)
    
    Alignment: left
    
    Body text below subtitle:
    
    Text: “Science has revealed that your gut bacteria control far more than just digestion. They influence your weight, your mood, and your clarity of mind.”
    
    Font size: 14–16px
    
    Line height: 1.5–1.6
    
    Text color: dark gray (similar to #333333)
    
    Alignment: left
    
    4. Section Layout
    
    Left side (image) and right side (text) should be split into a 2-column layout on desktop.
    
    On mobile, switch to 1-column layout, with image on top and text below
    
    Column gap: 32px
    
    Image block should be flexible in size on mobile (no overflow).
    
    5. Output Requirements
    
    Generate Liquid + HTML + CSS code within a single Shopify section file
    
    Use clean, well-commented, and readable code
    
    Ensure the image scales properly on mobile (responsive)
    
    Make the text section mobile-first optimized
    
    Do not add animations or transition effects unless explicitly specified.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wellness-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top_desktop }}px 0 {{ block.settings.padding_bottom_desktop }}px;
  }

  .ai-wellness-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-wellness-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-wellness-image-block-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    padding: {{ block.settings.image_padding }}px;
    background-color: {{ block.settings.image_background }};
  }

  .ai-wellness-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-wellness-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-wellness-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-wellness-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-wellness-text-block-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-wellness-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
    text-align: left;
  }

  .ai-wellness-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 400;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.4;
    text-align: left;
  }

  .ai-wellness-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    font-weight: 400;
    color: {{ block.settings.body_color }};
    margin: 0;
    line-height: 1.6;
    text-align: left;
  }

  @media screen and (max-width: 749px) {
    .ai-wellness-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-wellness-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-wellness-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-wellness-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-wellness-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_size }}px * 0.95);
    }
  }
{% endstyle %}

<div class="ai-wellness-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-wellness-container-{{ ai_gen_id }}">
    <div class="ai-wellness-grid-{{ ai_gen_id }}">
      <div class="ai-wellness-image-block-{{ ai_gen_id }}">
        <div class="ai-wellness-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-wellness-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-wellness-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-wellness-text-block-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-wellness-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}

        {% if block.settings.subtitle != blank %}
          <p class="ai-wellness-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}

        {% if block.settings.body_text != blank %}
          <p class="ai-wellness-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

