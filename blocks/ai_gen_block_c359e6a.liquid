{% doc %}
  @prompt
    Role:
    Act as a senior Shopify theme developer and conversion-focused UX designer with strong experience in premium supplement product pages.
    
    Goal:
    Generate a clean, educational Dual-Action Protocol section that explains Step 1 of a supplement protocol, with a content card on the left and a purely visual image block on the right.
    
    Section Header
    Centered icon (lightning bolt or energy icon)
    Headline (editable):
    “THE DUAL-ACTION PROTOCOL
    Subheadline (editable, small text):
    “Most supplements address only one side of the problem. We address both.”
    Layout
    Two-column layout on desktop
    
    Stacked layout on mobile (content first, image second)
    
    White background
    
    Generous spacing, premium biotech aesthetic
    
    LEFT COLUMN — CONTENT CARD (FUNCTIONAL CONTENT)
    
    Create a rounded card with soft blue background.
    Card Structure (all text editable from section settings):
    
    Small label at top:
    “STEP 1 — FUEL”
    
    Main title:
    “NAD+ Complex (AM)”
    
    Highlighted dosage line (accent color):
    “2000mg per serving”
    
    Description text (neutral, non-medical):
    “Supports your body’s natural NAD+ production pathways for sustained cellular energy.”
    
    Bullet list with check icons:
    
    Clinically studied precursor
    
    Non-stimulating
    180 capsules (90 servings)
    Small credibility note at bottom (optional, editable):
    “200+ published studies”
    RIGHT COLUMN — IMAGE ONLY (IMPORTANT)
    The right column must be STRICTLY a visual image container
    NO product logic
    NO add-to-cart
    NO dynamic product data
    This block is decorative / educational only
    
    Image requirements:
    
    Image selectable from Shopify section settings
    Rounded container with dashed or subtle border
    Light gray background
    Centered image (scientific illustration / molecules / abstract biotech visual)
    Optional caption (editable):
    “Visual: Scientific rendering of NAD+ molecules fueling a cell”
    Design & Style
    Minimal, premium, science-driven
    No exaggerated claims
    No medical promises
    Typography clean and readable
    Consistent spacing between elements
    with mobil version 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-protocol-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-dual-protocol-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-dual-protocol-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-dual-protocol-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-dual-protocol-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-dual-protocol-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 0 0 {{ block.settings.headline_spacing }}px;
    color: {{ block.settings.headline_color }};
    text-transform: uppercase;
  }

  .ai-dual-protocol-subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    color: {{ block.settings.subheadline_color }};
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-dual-protocol-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-dual-protocol-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-dual-protocol-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin: 0 0 {{ block.settings.label_spacing }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-dual-protocol-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
  }

  .ai-dual-protocol-dosage-{{ ai_gen_id }} {
    font-size: {{ block.settings.dosage_size }}px;
    font-weight: 600;
    color: {{ block.settings.dosage_color }};
    margin: 0 0 {{ block.settings.dosage_spacing }}px;
  }

  .ai-dual-protocol-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px;
  }

  .ai-dual-protocol-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.list_spacing }}px;
  }

  .ai-dual-protocol-list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: {{ block.settings.list_item_size }}px;
    color: {{ block.settings.list_item_color }};
  }

  .ai-dual-protocol-check-icon-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: {{ block.settings.check_icon_color }};
  }

  .ai-dual-protocol-credibility-{{ ai_gen_id }} {
    font-size: {{ block.settings.credibility_size }}px;
    color: {{ block.settings.credibility_color }};
    font-style: italic;
    margin: 0;
  }

  .ai-dual-protocol-image-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.image_container_bg }};
    border-radius: {{ block.settings.image_border_radius }}px;
    border: {{ block.settings.image_border_width }}px {{ block.settings.image_border_style }} {{ block.settings.image_border_color }};
    padding: {{ block.settings.image_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .ai-dual-protocol-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-dual-protocol-image-{{ ai_gen_id }} {
    max-width: 100%;
    height: auto;
    border-radius: {{ block.settings.inner_image_radius }}px;
  }

  .ai-dual-protocol-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 400px;
  }

  .ai-dual-protocol-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    opacity: 0.3;
  }

  .ai-dual-protocol-caption-{{ ai_gen_id }} {
    font-size: {{ block.settings.caption_size }}px;
    color: {{ block.settings.caption_color }};
    text-align: center;
    margin-top: {{ block.settings.caption_spacing }}px;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-protocol-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-dual-protocol-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-dual-protocol-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-dual-protocol-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-dual-protocol-image-container-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<dual-action-protocol-{{ ai_gen_id }} class="ai-dual-protocol-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-protocol-container-{{ ai_gen_id }}">
    <div class="ai-dual-protocol-header-{{ ai_gen_id }}">
      {% if block.settings.show_icon %}
        <div class="ai-dual-protocol-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h2 class="ai-dual-protocol-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subheadline != blank %}
        <p class="ai-dual-protocol-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
      {% endif %}
    </div>

    <div class="ai-dual-protocol-content-{{ ai_gen_id }}">
      <div class="ai-dual-protocol-card-{{ ai_gen_id }}">
        {% if block.settings.step_label != blank %}
          <p class="ai-dual-protocol-label-{{ ai_gen_id }}">{{ block.settings.step_label }}</p>
        {% endif %}

        {% if block.settings.card_title != blank %}
          <h3 class="ai-dual-protocol-title-{{ ai_gen_id }}">{{ block.settings.card_title }}</h3>
        {% endif %}

        {% if block.settings.dosage != blank %}
          <p class="ai-dual-protocol-dosage-{{ ai_gen_id }}">{{ block.settings.dosage }}</p>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="ai-dual-protocol-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
        {% endif %}

        <ul class="ai-dual-protocol-list-{{ ai_gen_id }}">
          {% if block.settings.bullet_1 != blank %}
            <li class="ai-dual-protocol-list-item-{{ ai_gen_id }}">
              <svg class="ai-dual-protocol-check-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_1 }}</span>
            </li>
          {% endif %}

          {% if block.settings.bullet_2 != blank %}
            <li class="ai-dual-protocol-list-item-{{ ai_gen_id }}">
              <svg class="ai-dual-protocol-check-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_2 }}</span>
            </li>
          {% endif %}

          {% if block.settings.bullet_3 != blank %}
            <li class="ai-dual-protocol-list-item-{{ ai_gen_id }}">
              <svg class="ai-dual-protocol-check-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_3 }}</span>
            </li>
          {% endif %}
        </ul>

        {% if block.settings.credibility_note != blank %}
          <p class="ai-dual-protocol-credibility-{{ ai_gen_id }}">{{ block.settings.credibility_note }}</p>
        {% endif %}
      </div>

      <div class="ai-dual-protocol-image-container-{{ ai_gen_id }}">
        <div class="ai-dual-protocol-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.visual_image %}
            <img
              src="{{ block.settings.visual_image | image_url: width: 800 }}"
              alt="{{ block.settings.visual_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.visual_image.width }}"
              height="{{ block.settings.visual_image.height }}"
              class="ai-dual-protocol-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-protocol-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.image_caption != blank %}
          <p class="ai-dual-protocol-caption-{{ ai_gen_id }}">{{ block.settings.image_caption }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</dual-action-protocol-{{ ai_gen_id }}>

