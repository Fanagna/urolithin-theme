{% doc %}
  @prompt
    genere moi une section contenant un titre ,3blocs de card rectangulaire sur la largeur (les deux premiers blocs sont cote à cote  de gauche à doite et la troisieme bloc et juste en dessous et centrer au centre en fonction des deux premiers)
    chaque bloc est identique et contient chacun (titre, sous titre(orange), et des listes et une image à droite), le bordure du premier bloc contient un  text(Gold standart) et le dexieme(HIMALAYAN VITALITY)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-cards-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-feature-cards-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 40px;
  }

  .ai-feature-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.card_gap }}px;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .ai-feature-card-{{ ai_gen_id }}--centered {
    grid-column: 1 / -1;
    max-width: calc(50% - {{ block.settings.card_gap | divided_by: 2 }}px);
    margin: 0 auto;
  }

  .ai-feature-card-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-feature-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: -12px;
    left: 20px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-feature-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
  }

  .ai-feature-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-feature-card-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-feature-card-list-{{ ai_gen_id }} li {
    font-size: {{ block.settings.list_font_size }}px;
    color: {{ block.settings.list_text_color }};
    margin-bottom: 8px;
    padding-left: 20px;
    position: relative;
  }

  .ai-feature-card-list-{{ ai_gen_id }} li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: {{ block.settings.checkmark_color }};
    font-weight: bold;
  }

  .ai-feature-card-image-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-feature-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-feature-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-feature-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-feature-card-{{ ai_gen_id }}--centered {
      max-width: 100%;
    }

    .ai-feature-card-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }

    .ai-feature-card-list-{{ ai_gen_id }} li {
      text-align: left;
    }

    .ai-feature-card-image-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.image_width }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-cards-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-feature-cards-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    {% endif %}

    <div class="ai-feature-cards-grid-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_subtitle_key = 'card_' | append: i | append: '_subtitle'
          assign card_list_key = 'card_' | append: i | append: '_list'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_badge_key = 'card_' | append: i | append: '_badge'

          assign card_title = block.settings[card_title_key]
          assign card_subtitle = block.settings[card_subtitle_key]
          assign card_list = block.settings[card_list_key]
          assign card_image = block.settings[card_image_key]
          assign card_badge = block.settings[card_badge_key]
        %}

        <div class="ai-feature-card-{{ ai_gen_id }}">
          {% if card_badge != blank %}
            <div class="ai-feature-card-badge-{{ ai_gen_id }}">{{ card_badge }}</div>
          {% endif %}

          <div class="ai-feature-card-content-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-feature-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}

            {% if card_subtitle != blank %}
              <div class="ai-feature-card-subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</div>
            {% endif %}

            {% if card_list != blank %}
              {% assign list_items = card_list | split: '|' %}
              <ul class="ai-feature-card-list-{{ ai_gen_id }}">
                {% for item in list_items %}
                  <li>{{ item | strip }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          <div class="ai-feature-card-image-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 400 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_width }}"
                height="{{ block.settings.image_height }}"
              >
            {% else %}
              <div class="ai-feature-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% liquid
      assign card_title = block.settings.card_3_title
      assign card_subtitle = block.settings.card_3_subtitle
      assign card_list = block.settings.card_3_list
      assign card_image = block.settings.card_3_image
      assign card_badge = block.settings.card_3_badge
    %}

    <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}--centered">
      {% if card_badge != blank %}
        <div class="ai-feature-card-badge-{{ ai_gen_id }}">{{ card_badge }}</div>
      {% endif %}

      <div class="ai-feature-card-content-{{ ai_gen_id }}">
        {% if card_title != blank %}
          <h3 class="ai-feature-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
        {% endif %}

        {% if card_subtitle != blank %}
          <div class="ai-feature-card-subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</div>
        {% endif %}

        {% if card_list != blank %}
          {% assign list_items = card_list | split: '|' %}
          <ul class="ai-feature-card-list-{{ ai_gen_id }}">
            {% for item in list_items %}
              <li>{{ item | strip }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="ai-feature-card-image-{{ ai_gen_id }}">
        {% if card_image %}
          <img
            src="{{ card_image | image_url: width: 400 }}"
            alt="{{ card_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_width }}"
            height="{{ block.settings.image_height }}"
          >
        {% else %}
          <div class="ai-feature-card-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

