{% doc %}
  @prompt
    Create a centered educational header section identical to the reference visual.
    
    Do NOT change any wording, punctuation, capitalization, spacing, or hierarchy.
    
    The final result must visually match the reference exactly.
    
    🔹 CONTENT (Keep exactly as written)
    
    Main headline:
    
    Real BPC vs. Fake Blends: What YOU Need to Know!
    
    Subtext below the headline:
    
    The market is flooded with fake BPC products made from random blends and shortcuts. This video exposes what’s really inside those bottles and explains what separates real BPC from garbage formulas.
    
    🔹 DESIGN REQUIREMENTS
    
    Background: white
    
    Text color: black
    
    Headline:
    
    Large font size
    
    Bold
    
    Center aligned
    
    Maintain emphasis on “YOU” exactly as written
    
    Subtext:
    
    Smaller font size
    
    Regular weight
    
    Center aligned
    
    Clean, editorial layout
    
    No buttons
    
    No icons
    
    No additional elements
    
    No redesign
    
    🔹 LAYOUT
    
    Full-width section
    
    Content centered horizontally
    
    Moderate vertical spacing
    
    Clear hierarchy between headline and paragraph
    
    Balanced white space
    
    🔹 RESPONSIVE RULES (Very Important)
    
    Headline scales smoothly on mobile
    
    Text wraps naturally
    
    Maintain centered alignment on all screen sizes
    
    Preserve strong visual hierarchy
    
    🔹 TECHNICAL REQUIREMENTS
    
    Semantic HTML (section, h2, p)
    
    Clean CSS
    
    No JavaScript required
    
    Shopify Dawn theme compatible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-educational-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-educational-header__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-educational-header__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.spacing }}px 0;
    line-height: 1.2;
  }

  .ai-educational-header__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-educational-header-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-educational-header__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size_mobile }}px;
    }

    .ai-educational-header__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_mobile }}px;
    }
  }
{% endstyle %}

<section class="ai-educational-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-educational-header__container-{{ ai_gen_id }}">
    <h2 class="ai-educational-header__headline-{{ ai_gen_id }}">
      {{ block.settings.headline }}
    </h2>
    <p class="ai-educational-header__subtext-{{ ai_gen_id }}">
      {{ block.settings.subtext }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Educational header",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Real BPC vs. Fake Blends: What YOU Need to Know!"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "The market is flooded with fake BPC products made from random blends and shortcuts. This video exposes what's really inside those bottles and explains what separates real BPC from garbage formulas."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space between headline and subtext",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline size (desktop)",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "headline_size_mobile",
      "label": "Headline size (mobile)",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext size (desktop)",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subtext_size_mobile",
      "label": "Subtext size (mobile)",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Educational header"
    }
  ]
}
{% endschema %}