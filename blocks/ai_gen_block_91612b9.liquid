{% doc %}
  @prompt
    Create a centered, premium dark-mode trust metrics section that uses the exact same container width as the previous two sections.
    Important: The outer wrapper must reuse the same width rules (same max-width, same left/right padding, same centering) as the previous sections. Do NOT make it wider or narrower.
    
    Do not change the structure or wording. Keep the layout centered, with a dark subtle gradient background, rounded outer container, soft shadow, and thin border.
    
    Title (centered, do not edit):
    Trusted by Athletes & Biohackers
    
    Inside the same-width container, add a 3-column grid of metric cards (equal width), with the exact text and hierarchy:
    
    Card 1:
    10,000+
    Active users
    
    Card 2:
    4.8★
    Average rating
    
    Card 3:
    Third-party
    Lab tested
    
    Styling rules:
    
    Metric cards: rounded corners, thin border, subtle inner shadow
    
    Main metric text is large and bright blue
    
    Subtext smaller and muted
    
    Even spacing between cards
    
    Responsive: stack 1 column on mobile, 3 columns on desktop, without changing container width
    
    Do not add icons, buttons, extra copy, or animations. Keep everything consistent with the previous sections and match the width exactly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-metrics-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-trust-metrics-outer-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding_horizontal }}px;
  }

  .ai-trust-metrics-container-{{ ai_gen_id }} {
    background: {{ block.settings.background_gradient }};
    border-radius: {{ block.settings.container_border_radius }}px;
    border: {{ block.settings.container_border_thickness }}px solid {{ block.settings.container_border_color }};
    box-shadow: {{ block.settings.container_shadow_horizontal }}px {{ block.settings.container_shadow_vertical }}px {{ block.settings.container_shadow_blur }}px {{ block.settings.container_shadow_color }};
    padding: {{ block.settings.inner_padding_vertical }}px {{ block.settings.inner_padding_horizontal }}px;
  }

  .ai-trust-metrics-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
  }

  .ai-trust-metrics-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.card_gap }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-trust-metrics-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ai-trust-metrics-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: inset {{ block.settings.card_inner_shadow_horizontal }}px {{ block.settings.card_inner_shadow_vertical }}px {{ block.settings.card_inner_shadow_blur }}px {{ block.settings.card_inner_shadow_color }};
    padding: {{ block.settings.card_padding_vertical }}px {{ block.settings.card_padding_horizontal }}px;
    text-align: center;
  }

  .ai-trust-metrics-metric-{{ ai_gen_id }} {
    font-size: {{ block.settings.metric_font_size }}px;
    font-weight: {{ block.settings.metric_font_weight }};
    color: {{ block.settings.metric_color }};
    margin: 0 0 {{ block.settings.metric_margin_bottom }}px;
    line-height: 1.2;
  }

  .ai-trust-metrics-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    font-weight: {{ block.settings.subtext_font_weight }};
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.4;
  }
{% endstyle %}

<trust-metrics-{{ ai_gen_id }} class="ai-trust-metrics-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-metrics-outer-{{ ai_gen_id }}">
    <div class="ai-trust-metrics-container-{{ ai_gen_id }}">
      <h2 class="ai-trust-metrics-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      
      <div class="ai-trust-metrics-grid-{{ ai_gen_id }}">
        <div class="ai-trust-metrics-card-{{ ai_gen_id }}">
          <div class="ai-trust-metrics-metric-{{ ai_gen_id }}">{{ block.settings.metric_1 }}</div>
          <div class="ai-trust-metrics-subtext-{{ ai_gen_id }}">{{ block.settings.subtext_1 }}</div>
        </div>

        <div class="ai-trust-metrics-card-{{ ai_gen_id }}">
          <div class="ai-trust-metrics-metric-{{ ai_gen_id }}">{{ block.settings.metric_2 }}</div>
          <div class="ai-trust-metrics-subtext-{{ ai_gen_id }}">{{ block.settings.subtext_2 }}</div>
        </div>

        <div class="ai-trust-metrics-card-{{ ai_gen_id }}">
          <div class="ai-trust-metrics-metric-{{ ai_gen_id }}">{{ block.settings.metric_3 }}</div>
          <div class="ai-trust-metrics-subtext-{{ ai_gen_id }}">{{ block.settings.subtext_3 }}</div>
        </div>
      </div>
    </div>
  </div>
</trust-metrics-{{ ai_gen_id }}>

<script>
(function() {
  class TrustMetrics{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
    }
  }

  customElements.define('trust-metrics-{{ ai_gen_id }}', TrustMetrics{{ ai_gen_id }});
})();
</script>

