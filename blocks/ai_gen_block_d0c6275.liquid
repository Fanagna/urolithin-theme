{% doc %}
  @prompt
    Create a premium comparison section exactly matching the following structure, colors, and content. Do not change wording, layout, or meaning.
    
    Design & visual requirements:
    
    Full-width section
    
    Solid deep blue background (same tone across the entire section)
    
    Clean, modern, high-contrast design
    
    Minimalist, science-driven aesthetic
    
    White main title, colored icons, and clear visual separation
    
    Two-column layout (left = YES, right = NOT for you)
    
    Desktop-first, fully responsive on mobile
    
    Title (centered, exact text):
    🧠 IS THIS RIGHT FOR YOU?
    
    Left column (YES, if you want):
    
    Green check icon
    
    Title text: YES, if you want:
    
    Bullet points (exact wording):
    
    Energy without stimulants
    
    Long-term cellular health
    
    Science over hype
    
    Transparent, tested formulas
    
    Right column (NOT for you if):
    
    Red cross icon
    
    Title text: NOT for you if:
    
    Bullet points (exact wording):
    
    Seeking instant caffeine-like energy
    
    Looking for a pre-workout replacement
    
    Expecting a miracle overnight pill
    
    Footer note (centered, italic or subtle):
    This is cellular optimization, not a quick fix.
    
    Additional constraints:
    
    Do NOT rewrite or paraphrase any text
    
    Do NOT add new benefits or claims
    
    Do NOT add pricing, CTAs, or testimonials
    
    Keep icons simple (check / cross only)
    
    Tone must remain factual, calm, and authoritative
    
    Goal:
    Clearly qualify the audience and reinforce brand honesty and scientific positioning using a clean, premium visual layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-comparison-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-comparison-title-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-comparison-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    margin-bottom: {{ block.settings.footer_spacing }}px;
  }

  .ai-comparison-column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_background }};
    padding: {{ block.settings.column_padding }}px;
    border-radius: {{ block.settings.column_radius }}px;
  }

  .ai-comparison-column-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-comparison-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-comparison-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-comparison-column-title-{{ ai_gen_id }} {
    color: {{ block.settings.column_title_color }};
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-comparison-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.list_item_spacing }}px;
  }

  .ai-comparison-list-item-{{ ai_gen_id }} {
    color: {{ block.settings.list_text_color }};
    font-size: {{ block.settings.list_text_size }}px;
    line-height: 1.5;
    padding-left: 0;
  }

  .ai-comparison-footer-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.footer_color }};
    font-size: {{ block.settings.footer_size }}px;
    font-style: italic;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-comparison-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.title_spacing | times: 0.8 }}px;
    }

    .ai-comparison-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.7 }}px;
      margin-bottom: {{ block.settings.footer_spacing | times: 0.8 }}px;
    }

    .ai-comparison-column-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding | times: 0.8 }}px;
    }

    .ai-comparison-column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_title_size | times: 0.9 }}px;
    }

    .ai-comparison-list-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.list_text_size | times: 0.9 }}px;
    }

    .ai-comparison-footer-{{ ai_gen_id }} {
      font-size: {{ block.settings.footer_size | times: 0.9 }}px;
    }

    .ai-comparison-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-container-{{ ai_gen_id }}">
    <h2 class="ai-comparison-title-{{ ai_gen_id }}">
      {{ block.settings.main_title }}
    </h2>

    <div class="ai-comparison-columns-{{ ai_gen_id }}">
      <div class="ai-comparison-column-{{ ai_gen_id }}">
        <div class="ai-comparison-column-header-{{ ai_gen_id }}">
          <div class="ai-comparison-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.yes_icon_color }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="ai-comparison-column-title-{{ ai_gen_id }}">
            {{ block.settings.yes_title }}
          </h3>
        </div>
        <ul class="ai-comparison-list-{{ ai_gen_id }}">
          {% if block.settings.yes_item_1 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.yes_item_1 }}</li>
          {% endif %}
          {% if block.settings.yes_item_2 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.yes_item_2 }}</li>
          {% endif %}
          {% if block.settings.yes_item_3 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.yes_item_3 }}</li>
          {% endif %}
          {% if block.settings.yes_item_4 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.yes_item_4 }}</li>
          {% endif %}
        </ul>
      </div>

      <div class="ai-comparison-column-{{ ai_gen_id }}">
        <div class="ai-comparison-column-header-{{ ai_gen_id }}">
          <div class="ai-comparison-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.not_icon_color }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </div>
          <h3 class="ai-comparison-column-title-{{ ai_gen_id }}">
            {{ block.settings.not_title }}
          </h3>
        </div>
        <ul class="ai-comparison-list-{{ ai_gen_id }}">
          {% if block.settings.not_item_1 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.not_item_1 }}</li>
          {% endif %}
          {% if block.settings.not_item_2 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.not_item_2 }}</li>
          {% endif %}
          {% if block.settings.not_item_3 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.not_item_3 }}</li>
          {% endif %}
          {% if block.settings.not_item_4 != blank %}
            <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.not_item_4 }}</li>
          {% endif %}
        </ul>
      </div>
    </div>

    {% if block.settings.footer_text != blank %}
      <p class="ai-comparison-footer-{{ ai_gen_id }}">
        {{ block.settings.footer_text }}
      </p>
    {% endif %}
  </div>
</div>

