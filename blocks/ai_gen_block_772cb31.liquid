{% doc %}
  @prompt
    Create a full-width premium hero section identical to the reference visual.
    
    Do NOT change any wording, text hierarchy, colors, layout proportions, spacing, or visual tone.
    
    🔹 CONTENT (must remain exactly the same)
    
    Small badge at the top:
    “✦ EXCLUSIVE PROGRAM”
    
    Main headline (large, elegant serif font):
    “Panstellar VIP Membership”
    
    Subtext below headline:
    “Unlock 30% off every order, free shipping, and priority access to new releases. One membership — savings on everything, every time.”
    
    Pricing section:
    “$9.99 /month”
    
    Small disclaimer text below price:
    “3-month minimum commitment · Cancel anytime after”
    
    CTA Button text:
    “BECOME A VIP MEMBER →”
    
    🔹 DESIGN REQUIREMENTS
    
    Background: deep black with subtle gold gradient glow (premium aesthetic)
    
    Headline color: soft gold
    
    Subtext color: muted light grey
    
    Price: large white "$9.99" with smaller "/month"
    
    Badge:
    
    Rounded pill shape
    
    Thin gold border
    
    Gold text
    
    CTA button:
    
    Gold gradient background
    
    Black text
    
    Rounded corners
    
    Subtle hover glow (premium effect)
    
    No additional elements.
    No redesign.
    No extra animations beyond subtle hover.
    
    🔹 LAYOUT
    
    Fully centered content
    
    Generous vertical spacing
    
    Clean luxury composition
    
    Balanced typography scale
    
    🔹 RESPONSIVE RULES (very important)
    
    Headline scales smoothly on mobile
    
    Subtext wraps naturally
    
    Price remains visually dominant
    
    Button remains centered and full-width on small screens
    
    Preserve premium spacing on all devices
    
    🔹 TECHNICAL REQUIREMENTS
    
    Semantic HTML
    
    Clean, minimal CSS
    
    No JavaScript required
    
    Fully compatible with Shopify Dawn theme
    
    The final result must visually match the reference exactly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vip-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    background: linear-gradient(135deg, 
      {{ block.settings.background_color }} 0%, 
      {{ block.settings.background_color }} 40%, 
      rgba(184, 134, 11, 0.15) 70%, 
      {{ block.settings.background_color }} 100%);
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-vip-hero-container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-vip-hero-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 20px;
    border: 1px solid {{ block.settings.badge_border_color }};
    border-radius: 50px;
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-vip-hero-headline-{{ ai_gen_id }} {
    font-family: {{ block.settings.headline_font.family }}, {{ block.settings.headline_font.fallback_families }};
    font-weight: {{ block.settings.headline_font.weight }};
    font-style: {{ block.settings.headline_font.style }};
    font-size: {{ block.settings.headline_font_size }}px;
    line-height: 1.1;
    color: {{ block.settings.headline_color }};
    margin: 0;
    letter-spacing: -0.5px;
  }

  .ai-vip-hero-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.subtext_color }};
    max-width: 600px;
    margin: 0;
  }

  .ai-vip-hero-pricing-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: {{ block.settings.pricing_spacing }}px 0;
  }

  .ai-vip-hero-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .ai-vip-hero-price-period-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_period_font_size }}px;
    font-weight: 400;
    color: {{ block.settings.price_color }};
  }

  .ai-vip-hero-disclaimer-{{ ai_gen_id }} {
    font-size: {{ block.settings.disclaimer_font_size }}px;
    color: {{ block.settings.disclaimer_color }};
    line-height: 1.4;
  }

  .ai-vip-hero-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background: {{ block.settings.button_background }};
    background: linear-gradient(135deg, 
      {{ block.settings.button_background }} 0%, 
      {{ block.settings.button_background_end }} 100%);
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-vip-hero-cta-{{ ai_gen_id }}:hover {
    box-shadow: 0 0 30px rgba(184, 134, 11, 0.4);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-vip-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-vip-hero-container-{{ ai_gen_id }} {
      gap: {{ block.settings.content_spacing_mobile }}px;
    }

    .ai-vip-hero-badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_font_size_mobile }}px;
      padding: 6px 16px;
    }

    .ai-vip-hero-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size_mobile }}px;
    }

    .ai-vip-hero-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_font_size_mobile }}px;
    }

    .ai-vip-hero-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_font_size_mobile }}px;
    }

    .ai-vip-hero-price-period-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_period_font_size_mobile }}px;
    }

    .ai-vip-hero-disclaimer-{{ ai_gen_id }} {
      font-size: {{ block.settings.disclaimer_font_size_mobile }}px;
    }

    .ai-vip-hero-cta-{{ ai_gen_id }} {
      width: 100%;
      font-size: {{ block.settings.button_font_size_mobile }}px;
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
    }

    .ai-vip-hero-pricing-{{ ai_gen_id }} {
      margin: {{ block.settings.pricing_spacing_mobile }}px 0;
    }
  }
{% endstyle %}

<div class="ai-vip-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-vip-hero-container-{{ ai_gen_id }}">
    {% if block.settings.show_badge %}
      <div class="ai-vip-hero-badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    {% endif %}

    <h1 class="ai-vip-hero-headline-{{ ai_gen_id }}">
      {{ block.settings.headline }}
    </h1>

    <p class="ai-vip-hero-subtext-{{ ai_gen_id }}">
      {{ block.settings.subtext }}
    </p>

    <div class="ai-vip-hero-pricing-{{ ai_gen_id }}">
      <div class="ai-vip-hero-price-{{ ai_gen_id }}">
        <span>{{ block.settings.price_amount }}</span>
        <span class="ai-vip-hero-price-period-{{ ai_gen_id }}">{{ block.settings.price_period }}</span>
      </div>
      <p class="ai-vip-hero-disclaimer-{{ ai_gen_id }}">
        {{ block.settings.disclaimer_text }}
      </p>
    </div>

    <a href="{{ block.settings.cta_link }}" class="ai-vip-hero-cta-{{ ai_gen_id }}">
      {{ block.settings.cta_text }}
    </a>
  </div>
</div>

