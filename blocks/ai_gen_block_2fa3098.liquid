{% doc %}
  @prompt
    generate this     <!-- Timeline -->
        <section class="section">
            <div class="container">
                <h2 class="section-title">Simple Daily Protocol</h2>
                <div class="timeline">
                    <div class="timeline-row">
                        <div class="timeline-marker"><i class="fa-regular fa-sun"></i></div>
                        <div class="timeline-content">
                            <span class="time-tag">Morning (7-9 AM)</span>
                            <h4 class="mb-2">Take 1 Capsule BPC-157</h4>
                            <p class="text-muted">Take with or without food. The arginine salt form ensures high bioavailability regardless of meal timing.</p>
                        </div>
                    </div>
    
                    <div class="timeline-row">
                        <div class="timeline-marker"><i class="fa-solid fa-bolt"></i></div>
                        <div class="timeline-content">
                            <span class="time-tag">Pre-Workout</span>
                            <h4 class="mb-2">Drink 5g Creatine</h4>
                            <p class="text-muted">Mix 1 scoop with water or your pre-workout drink. Hydration is key for creatine efficacy.</p>
                        </div>
                    </div>
    
                    <div class="timeline-row">
                        <div class="timeline-marker"><i class="fa-regular fa-moon"></i></div>
                        <div class="timeline-content">
                            <span class="time-tag">Daily Consistency</span>
                            <h4 class="mb-2">Rest Days Included</h4>
                            <p class="text-muted">Take both supplements daily even if you aren't training. Recovery happens while you rest.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-timeline-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 700;
  }

  .ai-timeline-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.timeline_spacing }}px;
  }

  .ai-timeline-row-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.row_gap }}px;
    align-items: flex-start;
  }

  .ai-timeline-marker-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.marker_size }}px;
    height: {{ block.settings.marker_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.marker_bg_color }};
    color: {{ block.settings.marker_icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc({{ block.settings.marker_size }}px * 0.5);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    flex: 1;
    padding-top: 4px;
  }

  .ai-timeline-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 12px;
    background-color: {{ block.settings.tag_bg_color }};
    color: {{ block.settings.tag_text_color }};
    border-radius: {{ block.settings.tag_radius }}px;
    font-size: {{ block.settings.tag_font_size }}px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-timeline-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-timeline-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-timeline-marker-{{ ai_gen_id }} {
      width: calc({{ block.settings.marker_size }}px * 0.8);
      height: calc({{ block.settings.marker_size }}px * 0.8);
      font-size: calc({{ block.settings.marker_size }}px * 0.4);
    }

    .ai-timeline-row-{{ ai_gen_id }} {
      gap: {{ block.settings.row_gap | times: 0.7 }}px;
    }

    .ai-timeline-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.9);
    }

    .ai-timeline-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-timeline-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
