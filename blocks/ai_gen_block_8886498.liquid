{% doc %}
  @prompt
    une section qui affiche quelques produits en horizontale , en une seule ligne ... et je veux que ça soit reponsive
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-horizontal-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-horizontal-products__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-horizontal-products__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-horizontal-products__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-horizontal-products__scroll-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-horizontal-products__scroll-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .ai-horizontal-products__scroll-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-horizontal-products__product-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_width }}px;
    min-width: {{ block.settings.product_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-horizontal-products__product-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-horizontal-products__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-horizontal-products__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-horizontal-products__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-horizontal-products__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-horizontal-products__info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-horizontal-products__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .ai-horizontal-products__name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-horizontal-products__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-horizontal-products__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | minus: 2 }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    text-decoration: line-through;
    margin-left: 8px;
  }

  .ai-horizontal-products__link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-horizontal-products__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
  }

  .ai-horizontal-products__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-horizontal-products__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-horizontal-products__nav-button--prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-horizontal-products__nav-button--next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-horizontal-products__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-horizontal-products__product-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.product_width_mobile }}px;
      min-width: {{ block.settings.product_width_mobile }}px;
    }

    .ai-horizontal-products__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-horizontal-products__nav-button-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<horizontal-products-{{ ai_gen_id }}
  class="ai-horizontal-products-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-horizontal-products__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <div class="ai-horizontal-products__header-{{ ai_gen_id }}">
        <h2 class="ai-horizontal-products__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-horizontal-products__scroll-wrapper-{{ ai_gen_id }}">
        {% if block.settings.show_nav_buttons %}
          <button
            class="ai-horizontal-products__nav-button-{{ ai_gen_id }} ai-horizontal-products__nav-button--prev-{{ ai_gen_id }}"
            aria-label="Previous products"
            data-direction="prev"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        <div class="ai-horizontal-products__scroll-container-{{ ai_gen_id }}" data-scroll-container>
          {% for product in block.settings.collection.products limit: block.settings.products_limit %}
            <div class="ai-horizontal-products__product-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-horizontal-products__link-{{ ai_gen_id }}">
                <div class="ai-horizontal-products__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-horizontal-products__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-horizontal-products__placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-horizontal-products__info-{{ ai_gen_id }}">
                  {% if block.settings.show_vendor and product.vendor != blank %}
                    <div class="ai-horizontal-products__vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                  {% endif %}
                  <h3 class="ai-horizontal-products__name-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-horizontal-products__price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-horizontal-products__compare-price-{{ ai_gen_id }}">
                        {{ product.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>

        {% if block.settings.show_nav_buttons %}
          <button
            class="ai-horizontal-products__nav-button-{{ ai_gen_id }} ai-horizontal-products__nav-button--next-{{ ai_gen_id }}"
            aria-label="Next products"
            data-direction="next"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-horizontal-products__empty-state-{{ ai_gen_id }}">
        <p>Sélectionnez une collection pour afficher les produits</p>
      </div>
    {% endif %}
  </div>
</horizontal-products-{{ ai_gen_id }}>

<script>
  (function() {
    class HorizontalProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('[data-scroll-container]');
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');

        if (this.prevButton && this.nextButton) {
          this.setupNavigation();
        }
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
        
        this.scrollContainer.addEventListener('scroll', () => this.updateButtonStates());
        this.updateButtonStates();
      }

      scroll(direction) {
        const scrollAmount = this.scrollContainer.offsetWidth * 0.8;
        const currentScroll = this.scrollContainer.scrollLeft;
        
        if (direction === 'next') {
          this.scrollContainer.scrollLeft = currentScroll + scrollAmount;
        } else {
          this.scrollContainer.scrollLeft = currentScroll - scrollAmount;
        }
      }

      updateButtonStates() {
        const isAtStart = this.scrollContainer.scrollLeft <= 0;
        const isAtEnd = this.scrollContainer.scrollLeft + this.scrollContainer.offsetWidth >= this.scrollContainer.scrollWidth - 1;
        
        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('horizontal-products-{{ ai_gen_id }}', HorizontalProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Produits horizontaux",
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titre",
      "default": "Nos produits"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Nombre de produits",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le vendeur",
      "default": false
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Largeur du conteneur",
      "default": 1600
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espacement vertical",
      "default": 40
    },
    {
      "type": "range",
      "id": "product_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Largeur produit (desktop)",
      "default": 280
    },
    {
      "type": "range",
      "id": "product_width_mobile",
      "min": 150,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Largeur produit (mobile)",
      "default": 200
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Espacement entre produits",
      "default": 20
    },
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Alignement du titre",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Espacement sous le titre",
      "default": 30
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Carte produit"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Arrondi des cartes",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Espacement interne",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fond de carte",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Taille titre produit",
      "default": 16
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Taille du prix",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Couleur du prix",
      "default": "#5c1ada"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons",
      "label": "Afficher les boutons de navigation",
      "default": true
    },
    {
      "type": "color",
      "id": "nav_button_bg",
      "label": "Fond des boutons",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_hover_bg",
      "label": "Fond au survol",
      "default": "#5c1ada"
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Couleur des icônes",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Produits horizontaux"
    }
  ]
}
{% endschema %}
