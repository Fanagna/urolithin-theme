{% doc %}
  @prompt
    Create a custom Shopify section that replicates the following design, keeping the text and layout exactly the same:
    
    ⚠️ Do not modify or summarize the text.
    ⚠️ Keep the exact content, punctuation, and structure.
    
    The section should contain:
    
    1. Section Structure
    
    Full-width section
    
    Background: white
    
    Centered content
    
    Max content width: 1100px to 1200px
    
    Padding: 64px top/bottom for desktop, 40px top/bottom for mobile
    
    2. Title
    
    Text: “L. Reuteri & Gasseri: The strains your gut has been waiting for”
    
    Font size: 32px–36px (desktop), 24px–28px (mobile)
    
    Font weight: bold
    
    Text color: dark blue (similar to #003366)
    
    Text alignment: center
    
    Line height: 1.5
    
    Margin-bottom: 20px
    
    3. Subtitle / Additional Information
    
    Text: “No proprietary blends. No generic strains. Only clinically identified cultures:”
    
    Font size: 16px–18px
    
    Font weight: normal
    
    Text color: dark gray (similar to #333333)
    
    Text alignment: center
    
    Line height: 1.5
    
    Margin-bottom: 20px
    
    4. Cultures Text
    
    Text:
    “L. reuteri DSM 17648 • L. gasseri LG-36 • B. longum BB536”
    
    Font size: 14px–16px
    
    Font weight: normal
    
    Text color: blue (similar to #0055cc)
    
    Text alignment: center
    
    Line height: 1.6
    
    5. Section Layout
    
    Use a 1-column layout (centered)
    
    Use responsive typography, ensuring it scales well on both desktop and mobile
    
    6. Output Requirements
    
    Generate Liquid + HTML + CSS code for the section
    
    Ensure mobile-first optimization
    
    Clean, readable code with proper comments for maintainability
    
    Make sure the text is perfectly aligned, with no changes or spacing issues across devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reuteri-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top_mobile }}px 20px {{ block.settings.padding_bottom_mobile }}px;
  }

  .ai-reuteri-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-reuteri-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size_mobile }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    line-height: 1.5;
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
  }

  .ai-reuteri-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 400;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.5;
    margin: 0 0 {{ block.settings.subtitle_margin_bottom }}px;
  }

  .ai-reuteri-cultures-{{ ai_gen_id }} {
    font-size: {{ block.settings.cultures_size }}px;
    font-weight: 400;
    color: {{ block.settings.cultures_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-reuteri-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_desktop }}px 40px {{ block.settings.padding_bottom_desktop }}px;
    }

    .ai-reuteri-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-reuteri-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reuteri-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-reuteri-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <p class="ai-reuteri-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}

    {% if block.settings.cultures != blank %}
      <p class="ai-reuteri-cultures-{{ ai_gen_id }}">{{ block.settings.cultures }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
