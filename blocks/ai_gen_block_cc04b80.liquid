{% doc %}
  @prompt
    Améliorer le design de la section "Product Information" pour qu'elle soit plus belle et responsive : mise en page moderne avec une meilleure hiérarchie visuelle, typographie élégante, bouton d'achat bien mis en valeur, galerie d'images produit soignée, sections bien espacées, effets visuels subtils, et une expérience utilisateur fluide sur mobile et desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-info-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-info-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    padding: 40px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.container_radius }}px;
  }

  .ai-product-gallery-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-product-main-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
    background: #f5f5f5;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-main-image-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .ai-product-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-thumbnails-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 12px;
  }

  .ai-product-thumbnail-{{ ai_gen_id }} {
    aspect-ratio: 1;
    border-radius: {{ block.settings.thumbnail_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    background: #f5f5f5;
  }

  .ai-product-thumbnail-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.accent_color }};
    transform: scale(1.05);
  }

  .ai-product-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.accent_color }};
    box-shadow: 0 0 0 1px {{ block.settings.accent_color }};
  }

  .ai-product-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-product-vendor-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
    margin: 0;
  }

  .ai-product-price-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | times: 0.8 }}px;
    color: #999;
    text-decoration: line-through;
    font-weight: 400;
  }

  .ai-product-price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_color }};
  }

  .ai-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
  }

  .ai-product-variants-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-product-variant-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
  }

  .ai-product-variant-options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-product-variant-option-{{ ai_gen_id }} {
    padding: 10px 20px;
    border: 2px solid #e0e0e0;
    border-radius: {{ block.settings.variant_radius }}px;
    background: #fff;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-product-variant-option-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.accent_color }};
    transform: translateY(-2px);
  }

  .ai-product-variant-option-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.accent_color }};
    background: {{ block.settings.accent_color }};
    color: #fff;
  }

  .ai-product-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-product-quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 2px solid #e0e0e0;
    border-radius: {{ block.settings.button_radius }}px;
    overflow: hidden;
  }

  .ai-product-quantity-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background: #f5f5f5;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    transition: background 0.3s ease;
  }

  .ai-product-quantity-btn-{{ ai_gen_id }}:hover {
    background: #e0e0e0;
  }

  .ai-product-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-product-actions-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 32px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-product-buy-now-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 32px;
    background: transparent;
    color: {{ block.settings.button_color }};
    border: 2px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-product-buy-now-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    transform: translateY(-2px);
  }

  .ai-product-features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    padding: 24px;
    background: #f9f9f9;
    border-radius: {{ block.settings.feature_radius }}px;
    margin-top: 8px;
  }

  .ai-product-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-feature-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    color: {{ block.settings.accent_color }};
  }

  .ai-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }

  .ai-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-product-info-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 24px;
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.85 }}px;
    }

    .ai-product-features-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<product-info-{{ ai_gen_id }} class="ai-product-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-info-container-{{ ai_gen_id }}">
    <div class="ai-product-gallery-{{ ai_gen_id }}">
      <div class="ai-product-main-image-{{ ai_gen_id }}" data-main-image>
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            width="800"
            height="800"
            loading="lazy"
          >
        {% else %}
          <div class="ai-product-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="ai-product-thumbnails-{{ ai_gen_id }}">
          {% for image in product.images limit: 6 %}
            <div class="ai-product-thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-thumbnail data-image-url="{{ image | image_url: width: 800 }}">
              <img
                src="{{ image | image_url: width: 150 }}"
                alt="{{ image.alt | escape }}"
                width="150"
                height="150"
                loading="lazy"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="ai-product-details-{{ ai_gen_id }}">
      {% if block.settings.show_vendor and product.vendor != blank %}
        <div class="ai-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
      {% endif %}

      <h1 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h1>

      <div class="ai-product-price-{{ ai_gen_id }}">
        {% if product.compare_at_price > product.price %}
          <span class="ai-product-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
          <span class="ai-product-price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
        {% else %}
          <span>{{ product.price | money }}</span>
        {% endif %}
      </div>

      {% if block.settings.show_description and product.description != blank %}
        <div class="ai-product-description-{{ ai_gen_id }}">
          {{ product.description | truncate: 200 }}
        </div>
      {% endif %}

      {% form 'product', product %}
        <div class="ai-product-variants-{{ ai_gen_id }}">
          {% for option in product.options_with_values %}
            <div>
              <div class="ai-product-variant-label-{{ ai_gen_id }}">{{ option.name }}</div>
              <div class="ai-product-variant-options-{{ ai_gen_id }}">
                {% for value in option.values %}
                  <div class="ai-product-variant-option-{{ ai_gen_id }} {% if forloop.first %}selected{% endif %}" data-variant-option data-option-name="{{ option.name }}" data-option-value="{{ value }}">
                    {{ value }}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if block.settings.show_quantity %}
          <div class="ai-product-quantity-{{ ai_gen_id }}">
            <span class="ai-product-quantity-label-{{ ai_gen_id }}">Quantité</span>
            <div class="ai-product-quantity-selector-{{ ai_gen_id }}">
              <button type="button" class="ai-product-quantity-btn-{{ ai_gen_id }}" data-quantity-decrease>−</button>
              <input type="number" name="quantity" value="1" min="1" class="ai-product-quantity-input-{{ ai_gen_id }}" data-quantity-input>
              <button type="button" class="ai-product-quantity-btn-{{ ai_gen_id }}" data-quantity-increase>+</button>
            </div>
          </div>
        {% endif %}

        <div class="ai-product-actions-{{ ai_gen_id }}">
          <button type="submit" name="add" class="ai-product-add-to-cart-{{ ai_gen_id }}">
            {{ block.settings.add_to_cart_text }}
          </button>
          {% if block.settings.show_buy_now %}
            <button type="button" class="ai-product-buy-now-{{ ai_gen_id }}" data-buy-now>
              {{ block.settings.buy_now_text }}
            </button>
          {% endif %}
        </div>
      {% endform %}

      {% if block.settings.show_features %}
        <div class="ai-product-features-{{ ai_gen_id }}">
          <div class="ai-product-feature-{{ ai_gen_id }}">
            <svg class="ai-product-feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Livraison gratuite</span>
          </div>
          <div class="ai-product-feature-{{ ai_gen_id }}">
            <svg class="ai-product-feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            <span>Paiement sécurisé</span>
          </div>
          <div class="ai-product-feature-{{ ai_gen_id }}">
            <svg class="ai-product-feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span>Retours faciles</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</product-info-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductInfo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mainImage = this.querySelector('[data-main-image]');
        this.thumbnails = this.querySelectorAll('[data-thumbnail]');
        this.variantOptions = this.querySelectorAll('[data-variant-option]');
        this.quantityInput = this.querySelector('[data-quantity-input]');
        this.decreaseBtn = this.querySelector('[data-quantity-decrease]');
        this.increaseBtn = this.querySelector('[data-quantity-increase]');
        this.buyNowBtn = this.querySelector('[data-buy-now]');
      }

      connectedCallback() {
        this.setupThumbnails();
        this.setupVariants();
        this.setupQuantity();
        this.setupBuyNow();
      }

      setupThumbnails() {
        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            this.thumbnails.forEach(t => t.classList.remove('active'));
            thumbnail.classList.add('active');
            
            const imageUrl = thumbnail.dataset.imageUrl;
            const mainImg = this.mainImage.querySelector('img');
            if (mainImg) {
              mainImg.src = imageUrl;
            }
          });
        });
      }

      setupVariants() {
        this.variantOptions.forEach((option) => {
          option.addEventListener('click', () => {
            const optionName = option.dataset.optionName;
            this.querySelectorAll(`[data-option-name="${optionName}"]`).forEach(opt => {
              opt.classList.remove('selected');
            });
            option.classList.add('selected');
          });
        });
      }

      setupQuantity() {
        if (this.decreaseBtn) {
          this.decreaseBtn.addEventListener('click', () => {
            const currentValue = parseInt(this.quantityInput.value);
            if (currentValue > 1) {
              this.quantityInput.value = currentValue - 1;
            }
          });
        }

        if (this.increaseBtn) {
          this.increaseBtn.addEventListener('click', () => {
            const currentValue = parseInt(this.quantityInput.value);
            this.quantityInput.value = currentValue + 1;
          });
        }
      }

      setupBuyNow() {
        if (this.buyNowBtn) {
          this.buyNowBtn.addEventListener('click', () => {
            const form = this.querySelector('form');
            if (form) {
              const formData = new FormData(form);
              formData.append('return_to', '/checkout');
              
              fetch('/cart/add', {
                method: 'POST',
                body: formData
              })
              .then(response => response.json())
              .then(() => {
                window.location.href = '/checkout';
              });
            }
          });
        }
      }
    }

    customElements.define('product-info-{{ ai_gen_id }}', ProductInfo{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent",
      "default": "#5c1ada"
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le vendeur",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Afficher la description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Afficher le sélecteur de quantité",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Afficher le bouton acheter maintenant",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Afficher les caractéristiques",
      "default": true
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Taille du prix",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Taille de la description",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Couleur du prix en promotion",
      "default": "#c12d2d"
    },
    {
      "type": "header",
      "content": "Boutons"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Texte du bouton ajouter au panier",
      "default": "Ajouter au panier"
    },
    {
      "type": "text",
      "id": "buy_now_text",
      "label": "Texte du bouton acheter maintenant",
      "default": "Acheter maintenant"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Couleur du bouton",
      "default": "#5c1ada"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Couleur du bouton au survol",
      "default": "#4a0fb8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Couleur du texte du bouton",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Taille du texte du bouton",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Rayon des boutons",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_radius",
      "label": "Rayon du conteneur",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Rayon de l'image principale",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "Rayon des miniatures",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "variant_radius",
      "label": "Rayon des variantes",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "feature_radius",
      "label": "Rayon des caractéristiques",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
