{% doc %}
  @prompt
    Crée une section d’inscription premium pour une landing page de récupération sportive.
    
    🎨 Style & ambiance
    
    Dark mode, moderne, haut de gamme
    
    Fond noir / bleu nuit avec carte centrale arrondie
    
    Ombres douces, glow subtil vert/teal
    
    Typographie sans-serif, espacée, très lisible
    
    Design orienté conversion & confiance
    
    🧩 Structure
    1) Carte principale – Lead form
    
    Carte sombre, centrée, bords arrondis
    
    Titre en haut, centré :
    “Get Instant Access”
    
    Sous-titre :
    “Enter your email to download the guide + receive your 30% discount code”
    
    Champs du formulaire :
    
    Champ email (placeholder : you@example.com
    )
    
    Champ prénom (optionnel, placeholder : John)
    
    Checkbox avec texte :
    “Send me the free guide, discount code, and recovery tips. Unsubscribe anytime.”
    
    Bouton CTA principal :
    
    Large, vert/teal, coins arrondis
    
    Texte :
    “DOWNLOAD FREE GUIDE NOW”
    
    Effet hover léger + glow
    
    Micro-preuves sous le bouton (inline) :
    
    ✔ Instant download
    
    ✔ 100% free
    
    ✔ No spam
    
    2) Section preuve sociale (en dessous)
    
    Titre centré :
    “Trusted by Athletes & Biohackers”
    
    3 cartes statistiques alignées (desktop) :
    
    10,000+
    Active users
    
    4.8★
    Average rating
    
    Third-party
    Lab tested
    
    Cartes sombres, chiffres bleus/teal lumineux, texte secondaire discret.
    
    📱 Contraintes
    
    Responsive mobile / desktop
    
    Clair, rassurant, pas agressif
    
    Aucun health claim explicite
    
    Optimisé pour email capture
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recovery-signup-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-recovery-signup-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    margin: 0 auto;
  }

  .ai-recovery-signup-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 20px 60px {{ block.settings.shadow_color }};
    margin-bottom: 40px;
  }

  .ai-recovery-signup-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    text-align: center;
    margin: 0 0 12px;
    letter-spacing: 0.5px;
  }

  .ai-recovery-signup-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    text-align: center;
    margin: 0 0 32px;
    line-height: 1.5;
  }

  .ai-recovery-signup-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-recovery-signup-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 20px;
    background: {{ block.settings.input_background }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    color: {{ block.settings.input_text_color }};
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .ai-recovery-signup-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-recovery-signup-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
    box-shadow: 0 0 0 3px {{ block.settings.input_focus_glow }};
  }

  .ai-recovery-signup-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-recovery-signup-checkbox-{{ ai_gen_id }} {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ai-recovery-signup-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.checkbox_text_color }};
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-recovery-signup-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 32px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .ai-recovery-signup-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    box-shadow: 0 0 20px {{ block.settings.button_glow_color }};
    transform: translateY(-2px);
  }

  .ai-recovery-signup-trust-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .ai-recovery-signup-trust-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.trust_text_color }};
    font-size: 14px;
  }

  .ai-recovery-signup-trust-icon-{{ ai_gen_id }} {
    color: {{ block.settings.trust_icon_color }};
    font-size: 18px;
  }

  .ai-recovery-signup-social-proof-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-recovery-signup-social-title-{{ ai_gen_id }} {
    color: {{ block.settings.social_title_color }};
    font-size: {{ block.settings.social_title_size }}px;
    font-weight: 600;
    margin: 0 0 32px;
    letter-spacing: 0.5px;
  }

  .ai-recovery-signup-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
  }

  .ai-recovery-signup-stat-card-{{ ai_gen_id }} {
    background: {{ block.settings.stat_card_background }};
    border-radius: {{ block.settings.stat_card_border_radius }}px;
    padding: 32px 24px;
    box-shadow: 0 10px 30px {{ block.settings.stat_shadow_color }};
  }

  .ai-recovery-signup-stat-number-{{ ai_gen_id }} {
    color: {{ block.settings.stat_number_color }};
    font-size: {{ block.settings.stat_number_size }}px;
    font-weight: 700;
    margin: 0 0 8px;
    text-shadow: 0 0 20px {{ block.settings.stat_glow_color }};
  }

  .ai-recovery-signup-stat-label-{{ ai_gen_id }} {
    color: {{ block.settings.stat_label_color }};
    font-size: {{ block.settings.stat_label_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-recovery-signup-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    text-align: center;
    margin-top: 16px;
    font-size: 14px;
  }

  .ai-recovery-signup-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    text-align: center;
    margin-top: 16px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-recovery-signup-{{ ai_gen_id }} {
      padding: 40px 16px;
      min-height: auto;
    }

    .ai-recovery-signup-card-{{ ai_gen_id }} {
      padding: 32px 24px;
    }

    .ai-recovery-signup-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-recovery-signup-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-recovery-signup-trust-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-recovery-signup-stats-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-recovery-signup-stat-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_number_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-recovery-signup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-recovery-signup-container-{{ ai_gen_id }}">
    <div class="ai-recovery-signup-card-{{ ai_gen_id }}">
      <h2 class="ai-recovery-signup-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      <p class="ai-recovery-signup-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>

      {%- form 'contact' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,recovery-guide">
        
        <div class="ai-recovery-signup-form-{{ ai_gen_id }}">
          <input
            type="email"
            name="contact[email]"
            class="ai-recovery-signup-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            aria-required="true"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-recovery-signup-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-recovery-signup-success-{{ ai_gen_id }}"
            {% endif %}
            required
          >

          {% if block.settings.show_name_field %}
            <input
              type="text"
              name="contact[first_name]"
              class="ai-recovery-signup-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.name_placeholder }}"
              autocomplete="given-name"
            >
          {% endif %}

          <div class="ai-recovery-signup-checkbox-wrapper-{{ ai_gen_id }}">
            <input
              type="checkbox"
              id="ai-recovery-consent-{{ ai_gen_id }}"
              name="contact[accepts_marketing]"
              class="ai-recovery-signup-checkbox-{{ ai_gen_id }}"
              {% if block.settings.checkbox_required %}required{% endif %}
            >
            <label for="ai-recovery-consent-{{ ai_gen_id }}" class="ai-recovery-signup-checkbox-label-{{ ai_gen_id }}">
              {{ block.settings.checkbox_text }}
            </label>
          </div>

          <button type="submit" class="ai-recovery-signup-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>

          <div class="ai-recovery-signup-trust-{{ ai_gen_id }}">
            <div class="ai-recovery-signup-trust-item-{{ ai_gen_id }}">
              <span class="ai-recovery-signup-trust-icon-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.trust_item_1 }}</span>
            </div>
            <div class="ai-recovery-signup-trust-item-{{ ai_gen_id }}">
              <span class="ai-recovery-signup-trust-icon-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.trust_item_2 }}</span>
            </div>
            <div class="ai-recovery-signup-trust-item-{{ ai_gen_id }}">
              <span class="ai-recovery-signup-trust-icon-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.trust_item_3 }}</span>
            </div>
          </div>

          {%- if form.errors -%}
            <div id="ai-recovery-signup-error-{{ ai_gen_id }}" class="ai-recovery-signup-error-{{ ai_gen_id }}">
              <span>{{ form.errors.messages.email }}</span>
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div id="ai-recovery-signup-success-{{ ai_gen_id }}" class="ai-recovery-signup-success-{{ ai_gen_id }}">
              <span>{{ block.settings.success_message }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>

    <div class="ai-recovery-signup-social-proof-{{ ai_gen_id }}">
      <h3 class="ai-recovery-signup-social-title-{{ ai_gen_id }}">{{ block.settings.social_proof_title }}</h3>
      
      <div class="ai-recovery-signup-stats-{{ ai_gen_id }}">
        <div class="ai-recovery-signup-stat-card-{{ ai_gen_id }}">
          <div class="ai-recovery-signup-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_1_number }}</div>
          <div class="ai-recovery-signup-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
        </div>

        <div class="ai-recovery-signup-stat-card-{{ ai_gen_id }}">
          <div class="ai-recovery-signup-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_2_number }}</div>
          <div class="ai-recovery-signup-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
        </div>

        <div class="ai-recovery-signup-stat-card-{{ ai_gen_id }}">
          <div class="ai-recovery-signup-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_3_number }}</div>
          <div class="ai-recovery-signup-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

