{% doc %}
  @prompt
    Create a clean call-to-action section identical to the reference visual.
    
    Do NOT change any text, wording, colors, alignment, or hierarchy.
    
    🔹 CONTENT (must remain exactly the same)
    
    Headline (centered):
    “Need a specific batch COA?”
    
    Subtext below (centered, smaller font):
    “Every batch comes with its own Certificate of Analysis. Email us with your order number and we’ll send it within 24h.”
    
    Primary button (centered):
    contact@panstellar.shop
    
    🔹 DESIGN REQUIREMENTS
    
    Background: pure white
    
    Text color: dark green (same tone as reference)
    
    Button:
    
    Dark green background
    
    White text
    
    Rounded pill shape
    
    Subtle icon on the left (email icon)
    
    Minimal, premium, medical / scientific aesthetic
    
    No shadows, no gradients, no animations
    
    🔹 LAYOUT
    
    Full-width section
    
    Content perfectly centered horizontally
    
    Comfortable vertical padding (CTA spacing)
    
    Clear visual separation from other sections
    
    🔹 RESPONSIVE RULES (very important)
    
    Fully responsive on mobile, tablet, and desktop
    
    Headline scales down smoothly on small screens
    
    Text wraps naturally without breaking meaning
    
    Button remains centered and easily clickable on mobile
    
    🔹 TECHNICAL REQUIREMENTS
    
    Semantic HTML
    
    Clean, lightweight CSS
    
    No JavaScript required
    
    Shopify Dawn compatible
    
    The final result must visually match the reference exactly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coa-cta-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 60px 20px;
  }

  .ai-coa-cta-container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-coa-cta-heading-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 600;
    color: #1a5f3a;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-coa-cta-subtext-{{ ai_gen_id }} {
    font-size: 16px;
    color: #1a5f3a;
    margin: 0 0 32px 0;
    line-height: 1.5;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-coa-cta-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: #1a5f3a;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .ai-coa-cta-button-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-coa-cta-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-coa-cta-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-coa-cta-heading-{{ ai_gen_id }} {
      font-size: 24px;
      margin-bottom: 12px;
    }

    .ai-coa-cta-subtext-{{ ai_gen_id }} {
      font-size: 14px;
      margin-bottom: 24px;
    }

    .ai-coa-cta-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 15px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-coa-cta-heading-{{ ai_gen_id }} {
      font-size: 28px;
    }
  }
{% endstyle %}

<div class="ai-coa-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coa-cta-container-{{ ai_gen_id }}">
    <h2 class="ai-coa-cta-heading-{{ ai_gen_id }}">
      Need a specific batch COA?
    </h2>
    <p class="ai-coa-cta-subtext-{{ ai_gen_id }}">
      Every batch comes with its own Certificate of Analysis. Email us with your order number and we'll send it within 24h.
    </p>
    <a href="mailto:contact@panstellar.shop" class="ai-coa-cta-button-{{ ai_gen_id }}">
      <svg class="ai-coa-cta-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m2 7 10 6 10-6"></path>
      </svg>
      contact@panstellar.shop
    </a>
  </div>
</div>

{% schema %}
{
  "name": "COA request CTA",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "COA request CTA"
    }
  ]
}
{% endschema %}
