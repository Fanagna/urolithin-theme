{% doc %}
  @prompt
    Create a full-width trust bar section identical to the reference visual.
    
    Do NOT change any text, wording, icons meaning, order, spacing, or colors.
    
    CONTENT (must remain exactly the same, in this order):
    
    GMP Certified
    
    Third-Party Lab Tested
    
    COA Per Batch
    
    Made in USA
    
    Each item must include:
    
    A minimal, clean line-style icon
    
    Text placed to the right of the icon
    
    DESIGN REQUIREMENTS:
    
    Background: pure white
    
    Text color: dark green (same tone as reference)
    
    Icons: matching dark green, simple and professional
    
    Flat design, no shadows, no gradients
    
    Premium, scientific, pharmaceutical aesthetic
    
    LAYOUT:
    
    Full-width horizontal bar
    
    Items aligned on a single row on desktop
    
    Even spacing between items
    
    Vertically centered content
    
    RESPONSIVE RULES (very important):
    
    On mobile: items wrap cleanly into two rows if needed
    
    Icons and text remain aligned and readable
    
    No text truncation
    
    Maintain balanced spacing on all screen sizes
    
    TECHNICAL:
    
    Semantic HTML
    
    Lightweight CSS (flexbox)
    
    No JavaScript
    
    Compatible with Shopify Dawn theme
    
    The final result must visually match the reference exactly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 20px 0;
  }

  .ai-trust-bar-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-trust-bar-items-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .ai-trust-bar-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-trust-bar-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: #2d5016;
  }

  .ai-trust-bar-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-trust-bar-text-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 500;
    color: #2d5016;
    white-space: nowrap;
    line-height: 1.2;
  }

  @media screen and (max-width: 768px) {
    .ai-trust-bar-items-{{ ai_gen_id }} {
      gap: 20px;
    }

    .ai-trust-bar-item-{{ ai_gen_id }} {
      gap: 10px;
      flex-basis: calc(50% - 10px);
      justify-content: flex-start;
    }

    .ai-trust-bar-icon-{{ ai_gen_id }} {
      width: 28px;
      height: 28px;
    }

    .ai-trust-bar-text-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-trust-bar-{{ ai_gen_id }} {
      padding: 16px 0;
    }

    .ai-trust-bar-items-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-trust-bar-icon-{{ ai_gen_id }} {
      width: 24px;
      height: 24px;
    }

    .ai-trust-bar-text-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="ai-trust-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-bar-container-{{ ai_gen_id }}">
    <div class="ai-trust-bar-items-{{ ai_gen_id }}">
      <div class="ai-trust-bar-item-{{ ai_gen_id }}">
        <div class="ai-trust-bar-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="ai-trust-bar-text-{{ ai_gen_id }}">GMP Certified</span>
      </div>

      <div class="ai-trust-bar-item-{{ ai_gen_id }}">
        <div class="ai-trust-bar-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
          </svg>
        </div>
        <span class="ai-trust-bar-text-{{ ai_gen_id }}">Third-Party Lab Tested</span>
      </div>

      <div class="ai-trust-bar-item-{{ ai_gen_id }}">
        <div class="ai-trust-bar-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <span class="ai-trust-bar-text-{{ ai_gen_id }}">COA Per Batch</span>
      </div>

      <div class="ai-trust-bar-item-{{ ai_gen_id }}">
        <div class="ai-trust-bar-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/>
          </svg>
        </div>
        <span class="ai-trust-bar-text-{{ ai_gen_id }}">Made in USA</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "settings": [],
  "presets": [
    {
      "name": "Trust bar"
    }
  ]
}
{% endschema %}
