{% doc %}
  @prompt
    créer moi une section contenant un titre principal centrer au centre; puis juste en dessous deux bloc de card identique contenant dans 1/3 du card (Un bloc d image en format carré) et dans les 2/3( un titre, un sous titre en bleu et un paragraphe ); et sur les bordus haut des deux card se trouve des text avec bordure
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-cards-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-featured-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-featured-cards-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 700;
  }

  .ai-featured-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.cards_gap }}px;
  }

  .ai-featured-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .ai-featured-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-featured-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    border: {{ block.settings.badge_border_width }}px solid {{ block.settings.badge_border_color }};
    border-top: none;
    border-bottom-left-radius: {{ block.settings.badge_border_radius }}px;
    border-bottom-right-radius: {{ block.settings.badge_border_radius }}px;
    z-index: 2;
    white-space: nowrap;
  }

  .ai-featured-card-content-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    min-height: {{ block.settings.card_min_height }}px;
  }

  .ai-featured-card-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 33.333%;
    position: relative;
    overflow: hidden;
  }

  .ai-featured-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-card-text-{{ ai_gen_id }} {
    flex: 0 0 66.666%;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-featured-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_spacing }}px;
    font-weight: 700;
  }

  .ai-featured-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.card_subtitle_color }};
    margin: 0 0 {{ block.settings.card_subtitle_spacing }}px;
    font-weight: 600;
  }

  .ai-featured-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-featured-cards-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-featured-card-content-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-featured-card-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 auto;
      height: 200px;
    }

    .ai-featured-card-text-{{ ai_gen_id }} {
      flex: 1;
    }
  }
{% endstyle %}

<div class="ai-featured-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-cards-container-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-featured-cards-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}

    <div class="ai-featured-cards-grid-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_badge_key = 'card_' | append: i | append: '_badge'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_subtitle_key = 'card_' | append: i | append: '_subtitle'
          assign card_description_key = 'card_' | append: i | append: '_description'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_badge = block.settings[card_badge_key]
          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_subtitle = block.settings[card_subtitle_key]
          assign card_description = block.settings[card_description_key]
        %}

        {% if card_enabled %}
          <div class="ai-featured-card-{{ ai_gen_id }}">
            {% if card_badge != blank %}
              <div class="ai-featured-card-badge-{{ ai_gen_id }}">{{ card_badge }}</div>
            {% endif %}

            <div class="ai-featured-card-content-{{ ai_gen_id }}">
              <div class="ai-featured-card-image-wrapper-{{ ai_gen_id }}">
                {% if card_image %}
                  <img
                    src="{{ card_image | image_url: width: 600 }}"
                    alt="{{ card_image.alt | escape }}"
                    loading="lazy"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                    class="ai-featured-card-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-featured-card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-featured-card-text-{{ ai_gen_id }}">
                {% if card_title != blank %}
                  <h3 class="ai-featured-card-heading-{{ ai_gen_id }}">{{ card_title }}</h3>
                {% endif %}

                {% if card_subtitle != blank %}
                  <div class="ai-featured-card-subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</div>
                {% endif %}

                {% if card_description != blank %}
                  <div class="ai-featured-card-description-{{ ai_gen_id }}">{{ card_description }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

