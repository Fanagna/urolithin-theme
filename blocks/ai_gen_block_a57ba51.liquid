{% doc %}
  @prompt
    Role:
    Act as a senior Shopify theme developer and conversion-focused UX designer.
    
    Goal:
    Generate a clean, premium credibility bar / icon strip section similar to the provided reference image.
    
    Layout & Design:
    
    Full-width horizontal bar
    
    White background
    
    Thin top and bottom borders (very subtle light gray)
    
    Centered content
    
    Desktop: icons displayed in one horizontal row
    
    Mobile: icons wrap or stack cleanly without clutter
    
    Items (3 total):
    Each item contains:
    
    A minimal circular icon with soft background
    
    A short uppercase label
    
    Default items (editable):
    
    LAB TESTED
    
    Icon: laboratory / flask / test
    
    Icon background: soft blue
    
    DUAL ACTION
    
    Icon: lightning bolt / synergy / layers
    
    Icon background: soft purple
    
    90-DAY GUARANTEE
    
    Icon: shield / checkmark
    
    Icon background: soft green
    
    Typography:
    
    Small caps or uppercase
    
    Medium weight
    
    Neutral dark gray text
    
    Clean spacing between icon and label
    
    Customization (IMPORTANT):
    
    Each item text must be editable from the Shopify section settings
    
    Icons must be selectable (SVG or icon picker if supported)
    
    Colors editable from section settings
    
    Technical requirements:
    
    Shopify Online Store 2.0 compatible
    
    Implement as a reusable section
    
    Mobile-first & accessible
    
    No hardcoded text or colors
    
    Output:
    
    Generate the complete Shopify section code
    
    Minimal CSS
    
    Clean, professional, conversion-optimized
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-credibility-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    padding: {{ block.settings.padding_vertical }}px 20px;
  }

  .ai-credibility-bar__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-credibility-bar__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.icon_text_spacing }}px;
    flex: 0 1 auto;
  }

  .ai-credibility-bar__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-credibility-bar__icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
  }

  .ai-credibility-bar__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-align: center;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-credibility-bar__container-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing | times: 0.7 }}px;
    }

    .ai-credibility-bar__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-credibility-bar__icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size | times: 0.8 }}px * 0.5);
      height: calc({{ block.settings.icon_size | times: 0.8 }}px * 0.5);
    }

    .ai-credibility-bar__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-credibility-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-credibility-bar__container-{{ ai_gen_id }}">
    {% if block.settings.item_1_enabled %}
      <div class="ai-credibility-bar__item-{{ ai_gen_id }}">
        <div 
          class="ai-credibility-bar__icon-wrapper-{{ ai_gen_id }}"
          style="background-color: {{ block.settings.item_1_icon_bg }};"
        >
          <svg 
            class="ai-credibility-bar__icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="{{ block.settings.item_1_icon_color }}" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          >
            {% if block.settings.item_1_icon == 'flask' %}
              <path d="M9 3h6v7l5 8a2 2 0 0 1-2 3H6a2 2 0 0 1-2-3l5-8V3z"></path>
              <line x1="6" y1="15" x2="18" y2="15"></line>
            {% elsif block.settings.item_1_icon == 'shield' %}
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            {% elsif block.settings.item_1_icon == 'zap' %}
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            {% elsif block.settings.item_1_icon == 'award' %}
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            {% elsif block.settings.item_1_icon == 'check-circle' %}
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            {% else %}
              <path d="M9 3h6v7l5 8a2 2 0 0 1-2 3H6a2 2 0 0 1-2-3l5-8V3z"></path>
              <line x1="6" y1="15" x2="18" y2="15"></line>
            {% endif %}
          </svg>
        </div>
        <span class="ai-credibility-bar__label-{{ ai_gen_id }}">{{ block.settings.item_1_text }}</span>
      </div>
    {% endif %}

    {% if block.settings.item_2_enabled %}
      <div class="ai-credibility-bar__item-{{ ai_gen_id }}">
        <div 
          class="ai-credibility-bar__icon-wrapper-{{ ai_gen_id }}"
          style="background-color: {{ block.settings.item_2_icon_bg }};"
        >
          <svg 
            class="ai-credibility-bar__icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="{{ block.settings.item_2_icon_color }}" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          >
            {% if block.settings.item_2_icon == 'flask' %}
              <path d="M9 3h6v7l5 8a2 2 0 0 1-2 3H6a2 2 0 0 1-2-3l5-8V3z"></path>
              <line x1="6" y1="15" x2="18" y2="15"></line>
            {% elsif block.settings.item_2_icon == 'shield' %}
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            {% elsif block.settings.item_2_icon == 'zap' %}
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            {% elsif block.settings.item_2_icon == 'award' %}
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            {% elsif block.settings.item_2_icon == 'check-circle' %}
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            {% else %}
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            {% endif %}
          </svg>
        </div>
        <span class="ai-credibility-bar__label-{{ ai_gen_id }}">{{ block.settings.item_2_text }}</span>
      </div>
    {% endif %}

    {% if block.settings.item_3_enabled %}
      <div class="ai-credibility-bar__item-{{ ai_gen_id }}">
        <div 
          class="ai-credibility-bar__icon-wrapper-{{ ai_gen_id }}"
          style="background-color: {{ block.settings.item_3_icon_bg }};"
        >
          <svg 
            class="ai-credibility-bar__icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="{{ block.settings.item_3_icon_color }}" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          >
            {% if block.settings.item_3_icon == 'flask' %}
              <path d="M9 3h6v7l5 8a2 2 0 0 1-2 3H6a2 2 0 0 1-2-3l5-8V3z"></path>
              <line x1="6" y1="15" x2="18" y2="15"></line>
            {% elsif block.settings.item_3_icon == 'shield' %}
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            {% elsif block.settings.item_3_icon == 'zap' %}
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            {% elsif block.settings.item_3_icon == 'award' %}
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            {% elsif block.settings.item_3_icon == 'check-circle' %}
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            {% else %}
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            {% endif %}
          </svg>
        </div>
        <span class="ai-credibility-bar__label-{{ ai_gen_id }}">{{ block.settings.item_3_text }}</span>
      </div>
    {% endif %}
  </div>
</div>

