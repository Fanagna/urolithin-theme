{% doc %}
  @prompt
    créer moi une section qui contient un titre et un sous titre (Tout les contenus sont centrer au centre )
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-heading-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-heading-section__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.2;
  }

  .ai-heading-section__subtitle-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    font-weight: {{ block.settings.subtitle_weight }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-heading-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 16px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-heading-section__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
      margin-bottom: {{ block.settings.spacing | times: 0.7 }}px;
    }

    .ai-heading-section__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-heading-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-heading-section__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-heading-section__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h2>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <div class="ai-heading-section__subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Titre et sous-titre",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titre",
      "default": "Votre titre ici"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre",
      "default": 48
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Épaisseur du titre",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Sous-titre"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "<p>Votre sous-titre ici</p>"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Taille du sous-titre",
      "default": 18
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Couleur du sous-titre",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "subtitle_weight",
      "label": "Épaisseur du sous-titre",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Espacement entre titre et sous-titre",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement haut",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement bas",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Largeur du conteneur",
      "default": 800
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Titre et sous-titre"
    }
  ]
}
{% endschema %}
