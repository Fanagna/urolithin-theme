{% doc %}
  @prompt
    Create a testimonials section identical to the reference, with avatars added to each review.
    
    ⚠️ Do not change any text, wording, ratings, or layout.
    ⚠️ Only add avatars next to each user’s name.
    
    CONTENT (must remain exactly the same)
    
    Title:
    💬 WHAT OUR CUSTOMERS SAY
    
    Rating:
    ⭐⭐⭐⭐⭐ 4.9/5 Based on 2,847 reviews
    
    Customer 1:
    
    ⭐⭐⭐⭐⭐
    
    “I’m 48 and finally have the energy I had at 30. No more 3pm crashes.”
    — Michael R.
    Used for 5 months · ✔ VERIFIED BUYER
    
    Customer 2:
    
    ⭐⭐⭐⭐⭐
    
    “My workouts don’t destroy me anymore. I recover in half the time.”
    — Jennifer K.
    Used for 4 months · ✔ VERIFIED BUYER
    
    Customer 3:
    
    ⭐⭐⭐⭐⭐
    
    “Brain fog gone. Sleep is better. I feel 10 years younger.”
    — Robert T.
    Used for 6 months · ✔ VERIFIED BUYER
    
    DESIGN & STYLE RULES
    
    Clean, minimal, premium design, consistent with the brand’s aesthetic
    
    Avatar added next to each user’s name (circle shape, image aligned left of the name)
    
    Avatar size: around 40px by 40px
    
    Avatar image: placeholder or uploaded user image (e.g., upload the images of customers or create generic avatars like the one provided)
    
    Avatar border: A thin white or light grey border around the avatar to make it stand out against the background
    
    Align avatar and text properly (text to the right of the avatar)
    
    Ensure the avatar doesn't overlap text and has adequate padding
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: Avatar appears left of each testimonial text, in line with the name
    
    Mobile: Stack testimonials vertically, maintaining avatar alignment with text
    
    Avatar must still be visible and aligned with the text, but resized for smaller screens if needed
    
    Tablet: Same layout as desktop but with slightly reduced gap if necessary
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML to align avatars and text properly
    
    Use Flexbox or CSS Grid for layout
    
    Use media queries for mobile and tablet responsiveness
    
    Shopify Dawn theme compatible
    
    No JavaScript
    
    The final result must look exactly like the reference, with avatars added next to the user names.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonials-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
  }

  .ai-testimonials-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: {{ block.settings.rating_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-testimonials-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: 30px;
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.card_star_size }}px;
    margin-bottom: 16px;
  }

  .ai-testimonial-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid {{ block.settings.avatar_border_color }};
    overflow: hidden;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.avatar_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
    font-weight: 700;
    color: {{ block.settings.avatar_placeholder_text }};
  }

  .ai-testimonial-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-testimonial-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-testimonial-verified-{{ ai_gen_id }} {
    color: {{ block.settings.verified_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-testimonials-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-testimonials-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: 24px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<testimonials-section-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    <div class="ai-testimonials-header-{{ ai_gen_id }}">
      <h2 class="ai-testimonials-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      <div class="ai-testimonials-rating-{{ ai_gen_id }}">
        <span class="ai-testimonials-stars-{{ ai_gen_id }}">{{ block.settings.overall_stars }}</span>
        <span>{{ block.settings.overall_rating }}</span>
      </div>
    </div>

    <div class="ai-testimonials-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign stars_key = 'testimonial_' | append: i | append: '_stars'
          assign quote_key = 'testimonial_' | append: i | append: '_quote'
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign meta_key = 'testimonial_' | append: i | append: '_meta'
          assign avatar_key = 'testimonial_' | append: i | append: '_avatar'

          assign stars = block.settings[stars_key]
          assign quote = block.settings[quote_key]
          assign name = block.settings[name_key]
          assign meta = block.settings[meta_key]
          assign avatar = block.settings[avatar_key]
        %}

        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <div class="ai-testimonial-stars-{{ ai_gen_id }}">{{ stars }}</div>
          <p class="ai-testimonial-quote-{{ ai_gen_id }}">{{ quote }}</p>
          <div class="ai-testimonial-author-{{ ai_gen_id }}">
            <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
              {% if avatar %}
                <img
                  src="{{ avatar | image_url: width: 100 }}"
                  alt="{{ name }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-testimonial-avatar-placeholder-{{ ai_gen_id }}">
                  {{ name | slice: 0 }}
                </div>
              {% endif %}
            </div>
            <div class="ai-testimonial-info-{{ ai_gen_id }}">
              <p class="ai-testimonial-name-{{ ai_gen_id }}">{{ name }}</p>
              <p class="ai-testimonial-meta-{{ ai_gen_id }}">{{ meta }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</testimonials-section-{{ ai_gen_id }}>

