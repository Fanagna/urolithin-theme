{% doc %}
  @prompt
    Create a cart page header section with these specifications:
    
    CONTENT:
    - Large title: "Shopping Cart" — bold, 24px, font-weight 800
    - Below the title, a small green banner/pill that says: "✓ Your order qualifies for FREE shipping!" with a truck icon
    
    DESIGN FOR THE GREEN BANNER:
    - Background: light green (#e7f4ee)
    - Text color: dark green (#067d62)
    - Font-size: 13px, font-weight 600
    - Border-radius: 6px
    - Padding: 10px 14px
    - Display: flex with icon and text aligned center with 8px gap
    
    LAYOUT:
    - White card background with 8px border-radius
    - Padding: 20px 24px for the title area
    - The green banner has 14px margin on left and right
    
    RESPONSIVE:
    - On mobile (under 768px): title becomes 20px, padding 16px
    - Green banner: font-size 12px, margin 10px 16px
    - Everything stays left-aligned
    
    No JavaScript needed. HTML and CSS only.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-header-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    margin: 0 auto;
  }

  .ai-cart-header__title-area-{{ ai_gen_id }} {
    padding: 20px 24px;
  }

  .ai-cart-header__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 800;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
  }

  .ai-cart-header__banner-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: {{ block.settings.banner_background }};
    color: {{ block.settings.banner_text_color }};
    font-size: {{ block.settings.banner_font_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.banner_border_radius }}px;
    padding: 10px 14px;
    margin: 0 14px 14px 14px;
    width: fit-content;
  }

  .ai-cart-header__banner-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 767px) {
    .ai-cart-header__title-area-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-cart-header__title-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-cart-header__banner-{{ ai_gen_id }} {
      font-size: 12px;
      margin: 0 10px 16px 10px;
    }
  }
{% endstyle %}

<div class="ai-cart-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cart-header__title-area-{{ ai_gen_id }}">
    <h1 class="ai-cart-header__title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
  </div>
  
  {% if block.settings.show_banner %}
    <div class="ai-cart-header__banner-{{ ai_gen_id }}">
      <svg class="ai-cart-header__banner-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 3h15v13H1z"></path>
        <path d="M16 8h4l3 3v5h-7V8z"></path>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
      <span>{{ block.settings.banner_text }}</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart header",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shopping Cart"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Free shipping banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner",
      "default": true
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner text",
      "default": "✓ Your order qualifies for FREE shipping!"
    },
    {
      "type": "range",
      "id": "banner_font_size",
      "label": "Banner font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "Banner background",
      "default": "#e7f4ee"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Banner text color",
      "default": "#067d62"
    },
    {
      "type": "range",
      "id": "banner_border_radius",
      "label": "Banner border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Cart header"
    }
  ]
}
{% endschema %}
