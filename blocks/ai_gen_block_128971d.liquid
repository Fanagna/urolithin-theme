{% doc %}
  @prompt
    Create a two-column product selection section identical to the reference.
    
    ⚠️ Do not change any text, wording, prices, icons, or design elements.
    ⚠️ Only adjust the layout to be responsive.
    
    CONTENT (must remain exactly the same)
    
    Title (uppercase):
    💡 NOT SURE? START SMALL
    
    LEFT COLUMN (NAD+ COMPLEX)
    
    Image placeholder:
    [NAD+ BOTTLE]
    
    Product name:
    NAD+ Complex
    
    Price:
    $39.99
    
    Button text:
    START WITH NAD+
    
    RIGHT COLUMN (NMN STACK)
    
    Image placeholder:
    [NMN BOTTLE]
    
    Product name:
    NMN Stack
    
    Price:
    $34.99
    
    Button text:
    START WITH NMN
    
    BELOW BUTTON (footer)
    
    Text:
    Try risk-free – Upgrade to bundle later & save
    
    DESIGN AND STYLE RULES
    
    Clean, premium, high-conversion product selection design
    
    Equal column widths for both products
    
    Price displayed in bold under each product
    
    Call to action buttons centered and clearly labeled
    
    Consistent padding around text and buttons
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: Two products side by side with equal spacing between them
    
    Tablet: Same layout with reduced gap between columns
    
    Mobile: Stack content vertically
    
    Image first, followed by product name, price, and button below
    
    Ensure readability and easy button tap targets on small screens
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox or Grid
    
    Mobile-first responsive layout
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript required
    
    The final result must look exactly like the reference, with two columns on desktop and stacked content on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-selection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-selection-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-product-selection-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 40px;
    color: {{ block.settings.title_color }};
    letter-spacing: 0.5px;
  }

  .ai-product-selection-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    margin-bottom: 24px;
  }

  .ai-product-selection-column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_background }};
    border: {{ block.settings.column_border_width }}px solid {{ block.settings.column_border_color }};
    border-radius: {{ block.settings.column_border_radius }}px;
    padding: {{ block.settings.column_padding }}px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-product-selection-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    margin-bottom: 20px;
  }

  .ai-product-selection-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-selection-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-product-selection-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-selection-product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 600;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-selection-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    margin: 0 0 20px;
    color: {{ block.settings.price_color }};
  }

  .ai-product-selection-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: {{ block.settings.button_max_width }}px;
  }

  .ai-product-selection-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-product-selection-footer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.footer_text_color }};
    margin-top: 24px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-selection-{{ ai_gen_id }} {
      padding: 30px 16px;
    }

    .ai-product-selection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }

    .ai-product-selection-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-product-selection-column-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding | times: 0.8 }}px;
    }

    .ai-product-selection-product-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_name_size | times: 0.9 }}px;
    }

    .ai-product-selection-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.9 }}px;
    }

    .ai-product-selection-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }

    .ai-product-selection-footer-{{ ai_gen_id }} {
      font-size: {{ block.settings.footer_text_size | times: 0.9 }}px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-product-selection-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.column_gap | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-selection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-selection-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-product-selection-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-product-selection-grid-{{ ai_gen_id }}">
      <div class="ai-product-selection-column-{{ ai_gen_id }}">
        <div class="ai-product-selection-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.product_1_image %}
            <img
              src="{{ block.settings.product_1_image | image_url: width: 600 }}"
              alt="{{ block.settings.product_1_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_1_image.width }}"
              height="{{ block.settings.product_1_image.height }}"
              class="ai-product-selection-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-selection-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.product_1_name != blank %}
          <h3 class="ai-product-selection-product-name-{{ ai_gen_id }}">{{ block.settings.product_1_name }}</h3>
        {% endif %}

        {% if block.settings.product_1_price != blank %}
          <p class="ai-product-selection-price-{{ ai_gen_id }}">{{ block.settings.product_1_price }}</p>
        {% endif %}

        {% if block.settings.product_1_button_text != blank %}
          <a
            href="{{ block.settings.product_1_button_link }}"
            class="ai-product-selection-button-{{ ai_gen_id }}"
          >
            {{ block.settings.product_1_button_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-product-selection-column-{{ ai_gen_id }}">
        <div class="ai-product-selection-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.product_2_image %}
            <img
              src="{{ block.settings.product_2_image | image_url: width: 600 }}"
              alt="{{ block.settings.product_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_2_image.width }}"
              height="{{ block.settings.product_2_image.height }}"
              class="ai-product-selection-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-selection-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.product_2_name != blank %}
          <h3 class="ai-product-selection-product-name-{{ ai_gen_id }}">{{ block.settings.product_2_name }}</h3>
        {% endif %}

        {% if block.settings.product_2_price != blank %}
          <p class="ai-product-selection-price-{{ ai_gen_id }}">{{ block.settings.product_2_price }}</p>
        {% endif %}

        {% if block.settings.product_2_button_text != blank %}
          <a
            href="{{ block.settings.product_2_button_link }}"
            class="ai-product-selection-button-{{ ai_gen_id }}"
          >
            {{ block.settings.product_2_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if block.settings.footer_text != blank %}
      <p class="ai-product-selection-footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
    {% endif %}
  </div>
</div>

