    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_stock_status",
      "label": "Show stock status",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show badges",
      "info": "Displays bestseller and savings badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_save_for_later",
      "label": "Show save for later",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "container_bg_color",
      "label": "Container background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "item_bg_color",
      "label": "Item background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#ededed"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#007185"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#c45500"
    },
    {
      "type": "color",
      "id": "variant_text_color",
      "label": "Variant text",
      "default": "#565959"
    },
    {
      "type": "color",
      "id": "stock_color",
      "label": "Stock status",
      "default": "#067d62"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare at price",
      "default": "#767676"
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border",
      "default": "#d5d9d9"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Badge colors"
    },
    {
      "type": "color",
      "id": "bestseller_bg_color",
      "label": "Bestseller background",
      "default": "#fef3cd"
    },
    {
      "type": "color",
      "id": "bestseller_text_color",
      "label": "Bestseller text",
      "default": "#92690c"
    },
    {
      "type": "color",
      "id": "save_bg_color",
      "label": "Save background",
      "default": "#fce4e4"
    },
    {
      "type": "color",
      "id": "save_text_color",
      "label": "Save text",
      "default": "#b12704"
