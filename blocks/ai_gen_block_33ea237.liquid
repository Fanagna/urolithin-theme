{% doc %}
  @prompt
    Create a clean, centered informational banner section identical to the reference.
    
    ⚠️ Do NOT change any text, wording, punctuation, emojis, font sizes, colors, spacing, or hierarchy.
    ⚠️ Do NOT rewrite or optimize the copy.
    
    CONTENT (must remain exactly the same)
    
    Title (uppercase, centered):
    💪 WHAT PEOPLE NOTICE
    
    Main line (centered, single line on desktop):
    Energy that lasts • Fewer cravings • Comfortable digestion • Feel more like yourself
    
    Subtext (smaller, centered):
    Real results take time. Most notice a difference in 2–3 weeks.
    
    DESIGN & STYLE RULES
    
    White background
    
    Clean, minimal, premium supplement-brand look
    
    Center-aligned text
    
    Clear vertical spacing between title, main line, and subtext
    
    Same font family and color tones as the reference
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: all content centered, main line displayed on one row
    
    Tablet: same layout with reduced spacing
    
    Mobile:
    
    Text wraps naturally onto multiple lines
    
    All content remains centered
    
    No horizontal scrolling or overflow
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use Flexbox for alignment
    
    Mobile-first responsive CSS
    
    Compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting text wrapping for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-info-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-info-banner-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-info-banner-main-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_size }}px;
    font-weight: {{ block.settings.main_weight }};
    color: {{ block.settings.main_color }};
    text-align: center;
    margin: 0;
    line-height: 1.5;
  }

  .ai-info-banner-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    font-weight: {{ block.settings.subtext_weight }};
    color: {{ block.settings.subtext_color }};
    text-align: center;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-info-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-info-banner-container-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing_mobile }}px;
    }

    .ai-info-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-info-banner-main-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_size_mobile }}px;
    }

    .ai-info-banner-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_mobile }}px;
    }
  }
{% endstyle %}

<info-banner-{{ ai_gen_id }} class="ai-info-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-info-banner-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-info-banner-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.main_text != blank %}
      <p class="ai-info-banner-main-{{ ai_gen_id }}">{{ block.settings.main_text }}</p>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="ai-info-banner-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}
  </div>
</info-banner-{{ ai_gen_id }}>

