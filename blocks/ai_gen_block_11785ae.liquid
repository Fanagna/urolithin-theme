{% doc %}
  @prompt
    Create a centered, premium dark-mode section titled “What’s Inside the Guide”.
    
    The section must be perfectly centered horizontally on the page, with a modern, minimal, high-end SaaS / biohacker aesthetic.
    
    Structure and content must remain 100% identical, with no changes to wording, order, icons, or hierarchy.
    
    Layout details:
    
    Dark background with subtle gradient
    
    Rounded container with soft shadow
    
    Clean typography, high contrast
    
    Green check icons aligned on the left of each bullet
    
    Clear visual separation between list items
    
    The main card is centered on the page
    
    Content to display (do not edit):
    
    What’s Inside the Guide
    
    The Ultimate Recovery Guide
    15-page PDF · Research-backed protocols · Instant download
    
    ✔ Why injuries won’t heal — The 3 mistakes that keep you stuck
    ✔ The BPC-157 protocol — Oral vs injectable, dosing, what to expect
    ✔ Week-by-week tracking — How to measure progress objectively
    ✔ Recovery stack — Which supplements actually work (and which don’t)
    ✔ Nutrition timing — When to eat for optimal tissue repair
    ✔ Sleep optimization — The recovery phase most people ignore
    ✔ Case studies — Real examples of chronic injury recovery
    
    At the bottom, add a highlighted bonus box with a green accent:
    
    🎁 BONUS INSIDE
    Exclusive 30% discount code for Panstellar BPC-157 capsules (no injections required)
    
    Do not add extra elements, animations, or additional text.
    Keep everything centered, clean, premium, and conversion-focused.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-guide-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-guide-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    background: {{ block.settings.card_background }};
    background-image: {{ block.settings.card_gradient }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-guide-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-guide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    line-height: 1.2;
  }

  .ai-guide-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: {{ block.settings.subtitle_weight }};
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-guide-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.list_bottom_margin }}px;
  }

  .ai-guide-list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.item_gap }}px;
    padding: {{ block.settings.item_padding }}px 0;
    border-bottom: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
  }

  .ai-guide-list-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-guide-check-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-top: 2px;
  }

  .ai-guide-item-text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.item_text_size }}px;
    color: {{ block.settings.item_text_color }};
    line-height: 1.6;
  }

  .ai-guide-bonus-{{ ai_gen_id }} {
    background: {{ block.settings.bonus_background }};
    border: {{ block.settings.bonus_border_width }}px solid {{ block.settings.bonus_border_color }};
    border-radius: {{ block.settings.bonus_border_radius }}px;
    padding: {{ block.settings.bonus_padding }}px;
    text-align: center;
  }

  .ai-guide-bonus-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.bonus_text_size }}px;
    font-weight: {{ block.settings.bonus_text_weight }};
    color: {{ block.settings.bonus_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-guide-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-guide-container-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }

    .ai-guide-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }

    .ai-guide-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }

    .ai-guide-item-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_text_size | times: 0.9 }}px;
    }

    .ai-guide-bonus-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.bonus_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-guide-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
