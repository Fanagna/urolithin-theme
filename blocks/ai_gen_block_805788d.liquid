{% doc %}
  @prompt
    Create a premium Shopify product carousel section inspired by high-end biohacking supplement brands.
    
    Design style:
    - Dark background (black / deep charcoal)
    - Soft shadows and smooth transitions
    - Modern, minimal UI with high-end feel
    
    Features:
    - Horizontal scroll carousel with snap scrolling
    - Left/right arrow buttons with smooth animation
    - Product cards:
      - Image
      - Title
      - Price
      - Hover effect: zoom + dark overlay + "View Product" button
    - Slight card elevation on hover
    - Rounded corners and subtle glow
    
    Responsive:
    - Desktop: 4 products visible
    - Tablet: 2 products
    - Mobile: 1 product (swipe enabled)
    
    Technical:
    - Shopify Liquid loop through products
    - Use CSS scroll-snap for smooth UX
    - Hide scrollbar
    - No external libraries
    - Clean optimized code
    - Include section schema
    
    Make it visually premium, smooth, and conversion-focused.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    position: relative;
  }

  .ai-premium-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-premium-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-premium-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .ai-premium-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-premium-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-premium-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0 30px;
  }

  .ai-premium-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-premium-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.products_per_row_desktop }} - 1) * {{ block.settings.card_gap }}px) / {{ block.settings.products_per_row_desktop }});
    scroll-snap-align: start;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    position: relative;
  }

  .ai-premium-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, {{ block.settings.card_hover_shadow_opacity }});
  }

  .ai-premium-carousel__card-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-premium-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_background }};
  }

  .ai-premium-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-premium-carousel__card-{{ ai_gen_id }}:hover .ai-premium-carousel__image-{{ ai_gen_id }} {
    transform: scale(1.1);
  }

  .ai-premium-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-premium-carousel__card-{{ ai_gen_id }}:hover .ai-premium-carousel__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-premium-carousel__view-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    padding: 12px 28px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-premium-carousel__view-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: scale(1.05);
  }

  .ai-premium-carousel__info-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-premium-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-premium-carousel__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-premium-carousel__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .ai-premium-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-premium-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-premium-carousel__nav-button-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%) scale(1);
  }

  .ai-premium-carousel__nav-button--prev-{{ ai_gen_id }} {
    left: -25px;
  }

  .ai-premium-carousel__nav-button--next-{{ ai_gen_id }} {
    right: -25px;
  }

  .ai-premium-carousel__nav-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-premium-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.heading_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.products_per_row_tablet }} - 1) * {{ block.settings.card_gap }}px) / {{ block.settings.products_per_row_tablet }});
    }

    .ai-premium-carousel__nav-button--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-premium-carousel__nav-button--next-{{ ai_gen_id }} {
      right: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 40px);
      margin: 0 20px;
    }

    .ai-premium-carousel__track-{{ ai_gen_id }} {
      gap: 0;
      padding: 10px 0 30px;
    }

    .ai-premium-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-premium-carousel__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-premium-carousel__nav-button-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-premium-carousel__nav-button-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

<premium-product-carousel-{{ ai_gen_id }} class="ai-premium-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-premium-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-premium-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-premium-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-premium-carousel__wrapper-{{ ai_gen_id }}">
        <button
          class="ai-premium-carousel__nav-button-{{ ai_gen_id }} ai-premium-carousel__nav-button--prev-{{ ai_gen_id }}"
          aria-label="Previous products"
          data-direction="prev"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="ai-premium-carousel__track-{{ ai_gen_id }}" data-carousel-track>
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            <div class="ai-premium-carousel__card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-premium-carousel__card-link-{{ ai_gen_id }}">
                <div class="ai-premium-carousel__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-premium-carousel__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-premium-carousel__image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                  <div class="ai-premium-carousel__overlay-{{ ai_gen_id }}">
                    <span class="ai-premium-carousel__view-button-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
                  </div>
                </div>
                <div class="ai-premium-carousel__info-{{ ai_gen_id }}">
                  <h3 class="ai-premium-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-premium-carousel__price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>

        <button
          class="ai-premium-carousel__nav-button-{{ ai_gen_id }} ai-premium-carousel__nav-button--next-{{ ai_gen_id }}"
          aria-label="Next products"
          data-direction="next"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-premium-carousel__empty-state-{{ ai_gen_id }}">
        <p>Select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</premium-product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.prevButton = null;
        this.nextButton = null;
        this.scrollAmount = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');

        if (!this.track || !this.prevButton || !this.nextButton) return;

        this.setupEventListeners();
        this.updateButtonStates();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
        this.track.addEventListener('scroll', () => this.updateButtonStates());

        let isDown = false;
        let startX;
        let scrollLeft;

        this.track.addEventListener('mousedown', (e) => {
          isDown = true;
          this.track.style.cursor = 'grabbing';
          startX = e.pageX - this.track.offsetLeft;
          scrollLeft = this.track.scrollLeft;
        });

        this.track.addEventListener('mouseleave', () => {
          isDown = false;
          this.track.style.cursor = 'grab';
        });

        this.track.addEventListener('mouseup', () => {
          isDown = false;
          this.track.style.cursor = 'grab';
        });

        this.track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.track.offsetLeft;
          const walk = (x - startX) * 2;
          this.track.scrollLeft = scrollLeft - walk;
        });
      }

      scroll(direction) {
        const cardWidth = this.track.querySelector('.ai-premium-carousel__card-{{ ai_gen_id }}').offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const scrollDistance = cardWidth + gap;

        if (direction === 'next') {
          this.track.scrollBy({ left: scrollDistance, behavior: 'smooth' });
        } else {
          this.track.scrollBy({ left: -scrollDistance, behavior: 'smooth' });
        }
      }

      updateButtonStates() {
        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('premium-product-carousel-{{ ai_gen_id }}', PremiumProductCarousel{{ ai_gen_id }});
  })();
</script>

