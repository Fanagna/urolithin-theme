{% doc %}
  @prompt
    Create a two-column layout for the “IS THIS FOR YOU?” section, identical to the reference.
    
    ⚠️ Do NOT change any text, wording, punctuation, or colors.
    ⚠️ Only modify the background color of the two columns.
    
    CONTENT (must remain exactly the same)
    
    Title (uppercase):
    🤔 IS THIS FOR YOU?
    
    LEFT COLUMN (GREEN – POSITIVE)
    
    Column background:
    Light green (same shade as reference)
    
    Title:
    ✅ PERFECT IF YOU:
    
    Text (bullet list):
    
    Feel older than you are
    
    Want real energy (not from caffeine)
    
    Care about healthy aging
    
    Value quality & science
    
    Are committed to results
    
    RIGHT COLUMN (RED – NEGATIVE)
    
    Column background:
    Light red / light pink (same shade as reference)
    
    Title:
    ❌ NOT FOR YOU IF:
    
    Text (bullet list):
    
    You want instant results
    
    You’re looking for a magic pill
    
    You won’t take it daily
    
    Footer line (italic):
    This works. But it takes consistency.
    
    DESIGN AND STYLE RULES
    
    Clean, minimal, premium supplement-brand aesthetic
    
    Equal row height and spacing for both columns
    
    Title bold and slightly larger than the body text
    
    Bullet points aligned with check icons or text
    
    Vertical separation between the two columns
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: Two columns side by side, with a color difference between columns
    
    Tablet: Same layout with reduced gap between columns
    
    Mobile: Stack content vertically
    
    Keep color differentiation visible in stacked view
    
    Text remains readable and properly spaced
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox or Grid
    
    Use media queries for mobile
    
    Mobile-first responsive layout
    
    Shopify Dawn compatible
    
    No JavaScript
    
    The final result must look exactly like the reference, with color differentiation between the two columns, and all text aligned and centered as shown.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-is-this-for-you-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
  }

  .ai-is-this-for-you__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-is-this-for-you__title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 40px 0;
    color: {{ block.settings.title_color }};
  }

  .ai-is-this-for-you__columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .ai-is-this-for-you__column-{{ ai_gen_id }} {
    padding: 40px 30px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-is-this-for-you__column--positive-{{ ai_gen_id }} {
    background-color: {{ block.settings.positive_bg_color }};
  }

  .ai-is-this-for-you__column--negative-{{ ai_gen_id }} {
    background-color: {{ block.settings.negative_bg_color }};
  }

  .ai-is-this-for-you__column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 24px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-is-this-for-you__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-is-this-for-you__list-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-is-this-for-you__footer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.footer_size }}px;
    font-style: italic;
    margin-top: 40px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-is-this-for-you-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-is-this-for-you__columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-is-this-for-you__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }

    .ai-is-this-for-you__column-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-is-this-for-you__column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_title_size | times: 0.9 }}px;
    }

    .ai-is-this-for-you__footer-{{ ai_gen_id }} {
      margin-top: 30px;
    }
  }
{% endstyle %}

<ai-is-this-for-you-{{ ai_gen_id }} class="ai-is-this-for-you-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-is-this-for-you__container-{{ ai_gen_id }}">
    <h2 class="ai-is-this-for-you__title-{{ ai_gen_id }}">
      🤔 IS THIS FOR YOU?
    </h2>

    <div class="ai-is-this-for-you__columns-{{ ai_gen_id }}">
      <div class="ai-is-this-for-you__column-{{ ai_gen_id }} ai-is-this-for-you__column--positive-{{ ai_gen_id }}">
        <h3 class="ai-is-this-for-you__column-title-{{ ai_gen_id }}">
          ✅ PERFECT IF YOU:
        </h3>
        <ul class="ai-is-this-for-you__list-{{ ai_gen_id }}">
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">Feel older than you are</li>
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">Want real energy (not from caffeine)</li>
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">Care about healthy aging</li>
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">Value quality & science</li>
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">Are committed to results</li>
        </ul>
      </div>

      <div class="ai-is-this-for-you__column-{{ ai_gen_id }} ai-is-this-for-you__column--negative-{{ ai_gen_id }}">
        <h3 class="ai-is-this-for-you__column-title-{{ ai_gen_id }}">
          ❌ NOT FOR YOU IF:
        </h3>
        <ul class="ai-is-this-for-you__list-{{ ai_gen_id }}">
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">You want instant results</li>
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">You're looking for a magic pill</li>
          <li class="ai-is-this-for-you__list-item-{{ ai_gen_id }}">You won't take it daily</li>
        </ul>
      </div>
    </div>

    <p class="ai-is-this-for-you__footer-{{ ai_gen_id }}">
      This works. But it takes consistency.
    </p>
  </div>
</ai-is-this-for-you-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Is this for you",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "positive_bg_color",
      "label": "Positive column background",
      "default": "#d4edda"
    },
    {
      "type": "color",
      "id": "negative_bg_color",
      "label": "Negative column background",
      "default": "#f8d7da"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Column title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "footer_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Footer size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Column border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Is this for you"
    }
  ]
}
{% endschema %}
