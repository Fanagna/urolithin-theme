{% doc %}
  @prompt
    genere moi une section contenant un titre  un  tableau de 3 lignes et 4colonnes; la 3eme ligne de tous les colonnes ont une background color  different des autres, et ensuite une bloc d image en format carré juste à coté du tableau
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-image-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-table-image-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-table-image-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-table-image-content-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.content_gap }}px;
    align-items: flex-start;
  }

  .ai-table-wrapper-{{ ai_gen_id }} {
    flex: 1;
    overflow-x: auto;
  }

  .ai-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    border: {{ block.settings.table_border_width }}px solid {{ block.settings.table_border_color }};
    border-radius: {{ block.settings.table_border_radius }}px;
    overflow: hidden;
  }

  .ai-table-{{ ai_gen_id }} th,
  .ai-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.cell_alignment }};
    border: {{ block.settings.cell_border_width }}px solid {{ block.settings.cell_border_color }};
  }

  .ai-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
    font-size: {{ block.settings.header_font_size }}px;
  }

  .ai-table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.cell_bg_color }};
    color: {{ block.settings.cell_text_color }};
    font-size: {{ block.settings.cell_font_size }}px;
  }

  .ai-table-{{ ai_gen_id }} tr:nth-child(3) td {
    background-color: {{ block.settings.row_3_bg_color }};
    color: {{ block.settings.row_3_text_color }};
    font-weight: 500;
  }

  .ai-table-image-block-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
  }

  .ai-table-image-block-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-table-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-table-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-table-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    padding: 0 10px;
  }

  @media screen and (max-width: 749px) {
    .ai-table-image-content-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-table-image-block-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.image_size }}px;
      height: auto;
      aspect-ratio: 1;
    }

    .ai-table-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-table-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-table-image-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-table-image-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-table-image-content-{{ ai_gen_id }}">
      <div class="ai-table-wrapper-{{ ai_gen_id }}">
        <table class="ai-table-{{ ai_gen_id }}">
          <thead>
            <tr>
              <th>{{ block.settings.header_col_1 }}</th>
              <th>{{ block.settings.header_col_2 }}</th>
              <th>{{ block.settings.header_col_3 }}</th>
              <th>{{ block.settings.header_col_4 }}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{{ block.settings.row_1_col_1 }}</td>
              <td>{{ block.settings.row_1_col_2 }}</td>
              <td>{{ block.settings.row_1_col_3 }}</td>
              <td>{{ block.settings.row_1_col_4 }}</td>
            </tr>
            <tr>
              <td>{{ block.settings.row_2_col_1 }}</td>
              <td>{{ block.settings.row_2_col_2 }}</td>
              <td>{{ block.settings.row_2_col_3 }}</td>
              <td>{{ block.settings.row_2_col_4 }}</td>
            </tr>
            <tr>
              <td>{{ block.settings.row_3_col_1 }}</td>
              <td>{{ block.settings.row_3_col_2 }}</td>
              <td>{{ block.settings.row_3_col_3 }}</td>
              <td>{{ block.settings.row_3_col_4 }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="ai-table-image-block-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-table-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-table-empty-state-{{ ai_gen_id }}">
              Add an image
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

