{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-cards-container-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-bundle-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ block.settings.min_card_width }}px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    max-width: 100%;
  }

  .ai-bundle-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .ai-bundle-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-bundle-card-{{ ai_gen_id }}.ai-bonus-card-{{ ai_gen_id }} {
    background: {{ block.settings.bonus_card_background }};
    border-color: {{ block.settings.bonus_card_border_color }};
  }

  .ai-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: {{ block.settings.icon_color }};
    font-size: {{ block.settings.icon_size | times: 0.5 }}px;
  }

  .ai-bonus-card-{{ ai_gen_id }} .ai-card-icon-{{ ai_gen_id }} {
    background: {{ block.settings.bonus_icon_background }};
    color: {{ block.settings.bonus_icon_color }};
  }

  .ai-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.title_color }};
  }

  .ai-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    margin: 8px 0 16px;
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  .ai-spec-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-spec-item-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: {{ block.settings.spec_padding }}px 0;
    border-bottom: 1px solid {{ block.settings.spec_border_color }};
    font-size: {{ block.settings.spec_size }}px;
  }

  .ai-spec-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-spec-label-{{ ai_gen_id }} {
    color: {{ block.settings.spec_label_color }};
    font-weight: 500;
  }

  .ai-spec-val-{{ ai_gen_id }} {
    color: {{ block.settings.spec_value_color }};
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-bundle-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-bundle-cards-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-cards-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign card_enabled_key = 'card_' | append: i | append: '_enabled'
        assign card_icon_key = 'card_' | append: i | append: '_icon'
        assign card_title_key = 'card_' | append: i | append: '_title'
        assign card_description_key = 'card_' | append: i | append: '_description'
        assign card_is_bonus_key = 'card_' | append: i | append: '_is_bonus'
        assign card_link_key = 'card_' | append: i | append: '_link'
        assign spec_1_label_key = 'card_' | append: i | append: '_spec_1_label'
        assign spec_1_value_key = 'card_' | append: i | append: '_spec_1_value'
        assign spec_2_label_key = 'card_' | append: i | append: '_spec_2_label'
        assign spec_2_value_key = 'card_' | append: i | append: '_spec_2_value'
        assign spec_3_label_key = 'card_' | append: i | append: '_spec_3_label'
        assign spec_3_value_key = 'card_' | append: i | append: '_spec_3_value'

        assign card_enabled = block.settings[card_enabled_key]
        assign card_icon = block.settings[card_icon_key]
        assign card_title = block.settings[card_title_key]
        assign card_description = block.settings[card_description_key]
        assign card_is_bonus = block.settings[card_is_bonus_key]
        assign card_link = block.settings[card_link_key]
        assign spec_1_label = block.settings[spec_1_label_key]
        assign spec_1_value = block.settings[spec_1_value_key]
        assign spec_2_label = block.settings[spec_2_label_key]
        assign spec_2_value = block.settings[spec_2_value_key]
        assign spec_3_label = block.settings[spec_3_label_key]
        assign spec_3_value = block.settings[spec_3_value_key]
      %}

      {% if card_enabled %}
        <a 
          href="{{ card_link }}" 
          class="ai-bundle-card-{{ ai_gen_id }} {% if card_is_bonus %}ai-bonus-card-{{ ai_gen_id }}{% endif %}"
          {% if card_link == blank %}aria-disabled="true" style="pointer-events: none;"{% endif %}
        >
          <div class="ai-card-icon-{{ ai_gen_id }}">
            {{ card_icon }}
          </div>
          
          {% if card_title != blank %}
            <h3 class="ai-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
          
          {% if card_description != blank %}
            <div class="ai-card-description-{{ ai_gen_id }}">{{ card_description }}</div>
          {% endif %}
          
          <ul class="ai-spec-list-{{ ai_gen_id }}">
            {% if spec_1_label != blank and spec_1_value != blank %}
              <li class="ai-spec-item-{{ ai_gen_id }}">
                <span class="ai-spec-label-{{ ai_gen_id }}">{{ spec_1_label }}</span>
                <span class="ai-spec-val-{{ ai_gen_id }}">{{ spec_1_value }}</span>
              </li>
            {% endif %}
            
            {% if spec_2_label != blank and spec_2_value != blank %}
              <li class="ai-spec-item-{{ ai_gen_id }}">
                <span class="ai-spec-label-{{ ai_gen_id }}">{{ spec_2_label }}</span>
                <span class="ai-spec-val-{{ ai_gen_id }}">{{ spec_2_value }}</span>
              </li>
            {% endif %}
            
            {% if spec_3_label != blank and spec_3_value != blank %}
              <li class="ai-spec-item-{{ ai_gen_id }}">
                <span class="ai-spec-label-{{ ai_gen_id }}">{{ spec_3_label }}</span>
                <span class="ai-spec-val-{{ ai_gen_id }}">{{ spec_3_value }}</span>
              </li>
            {% endif %}
          </ul>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

