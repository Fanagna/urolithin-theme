{% doc %}
  @prompt
    Create a premium guarantee section exactly matching the provided visual, layout, colors, and content. Do not rewrite, paraphrase, or add any text.
    
    Design & visual requirements:
    
    Full-width section
    
    Dark navy / deep blue background with subtle gradient
    
    Rounded large container/card centered on the page
    
    Soft inner glow or border radius for a premium feel
    
    Minimalist, trustworthy, science-driven aesthetic
    
    Desktop-first, fully responsive on mobile
    
    Top icon:
    
    Shield icon centered at the top of the card
    
    Clean, modern, security-style icon
    
    Main title (centered, exact text, uppercase):
    THE "EMPTY BOTTLE" GUARANTEE
    
    Body text (centered, exact wording, line by line):
    
    Use the entire supply for 90 days.
    
    Track your energy, clarity, and recovery.
    
    Not satisfied? Send us the empty bottles.
    
    Full refund. Zero questions. Zero hassle.
    
    Final note (small, subtle, centered, exact text):
    We're that confident in the science.
    
    Typography & emphasis rules:
    
    White primary text
    
    Key guarantee lines in brighter or accent blue
    
    Calm, authoritative tone
    
    No emojis (except the shield icon)
    
    Additional constraints:
    
    Do NOT change any wording
    
    Do NOT add conditions, fine print, or CTAs
    
    Do NOT add pricing or testimonials
    
    Keep spacing generous and balanced
    
    Visual style must match a premium longevity / biohacking brand
    
    Goal:
    Remove all perceived risk and reinforce trust through a bold, transparent, and confidence-driven guarantee section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-guarantee-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    background: linear-gradient(135deg, {{ block.settings.background_color }} 0%, {{ block.settings.gradient_end_color }} 100%);
    padding: {{ block.settings.section_padding_desktop }}px 20px;
  }

  .ai-guarantee-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding_desktop }}px;
    box-shadow: 0 0 {{ block.settings.glow_intensity }}px {{ block.settings.glow_color }};
    text-align: center;
  }

  .ai-guarantee-icon-{{ ai_gen_id }} {
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-guarantee-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-guarantee-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .ai-guarantee-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: {{ block.settings.body_line_height }};
    margin: 0 0 {{ block.settings.body_spacing }}px;
  }

  .ai-guarantee-body-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.line_spacing }}px;
  }

  .ai-guarantee-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-guarantee-highlight-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_color }};
    font-weight: {{ block.settings.highlight_weight }};
  }

  .ai-guarantee-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.note_size }}px;
    color: {{ block.settings.note_color }};
    margin: 0;
    opacity: {{ block.settings.note_opacity }};
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-guarantee-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 16px;
    }

    .ai-guarantee-container-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }

    .ai-guarantee-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-guarantee-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-guarantee-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }

    .ai-guarantee-note-{{ ai_gen_id }} {
      font-size: {{ block.settings.note_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-guarantee-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-guarantee-container-{{ ai_gen_id }}">
    <div class="ai-guarantee-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
    </div>

    <h2 class="ai-guarantee-title-{{ ai_gen_id }}">
      THE "EMPTY BOTTLE" GUARANTEE
    </h2>

    <div class="ai-guarantee-body-{{ ai_gen_id }}">
      <p>Use the entire supply for 90 days.</p>
      <p>Track your <span class="ai-guarantee-highlight-{{ ai_gen_id }}">energy, clarity, and recovery</span>.</p>
      <p>Not satisfied? Send us the empty bottles.</p>
      <p><span class="ai-guarantee-highlight-{{ ai_gen_id }}">Full refund. Zero questions. Zero hassle.</span></p>
    </div>

    <p class="ai-guarantee-note-{{ ai_gen_id }}">
      We're that confident in the science.
    </p>
  </div>
</div>

