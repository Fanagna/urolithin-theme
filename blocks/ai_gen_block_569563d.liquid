{% doc %}
  @prompt
    une section FAQ  de 3 questions avec un design de noel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-christmas-faq-{{ ai_gen_id }} {
    padding: 60px 20px;
    background: {{ block.settings.background_gradient }};
    position: relative;
    overflow: hidden;
  }

  .ai-christmas-faq-container-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ai-christmas-faq-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-christmas-faq-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 700;
  }

  .ai-christmas-faq-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-christmas-faq-snowflake-{{ ai_gen_id }} {
    position: absolute;
    color: {{ block.settings.snowflake_color }};
    opacity: 0.3;
    pointer-events: none;
    font-size: 30px;
  }

  .ai-christmas-faq-snowflake-{{ ai_gen_id }}:nth-child(1) {
    top: 10%;
    left: 5%;
    font-size: 40px;
  }

  .ai-christmas-faq-snowflake-{{ ai_gen_id }}:nth-child(2) {
    top: 20%;
    right: 8%;
    font-size: 25px;
  }

  .ai-christmas-faq-snowflake-{{ ai_gen_id }}:nth-child(3) {
    bottom: 15%;
    left: 10%;
    font-size: 35px;
  }

  .ai-christmas-faq-snowflake-{{ ai_gen_id }}:nth-child(4) {
    bottom: 25%;
    right: 5%;
    font-size: 30px;
  }

  .ai-christmas-faq-item-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    margin-bottom: 20px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: 2px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-christmas-faq-item-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-christmas-faq-question-{{ ai_gen_id }} {
    width: 100%;
    padding: 25px 30px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: {{ block.settings.question_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_color }};
    transition: color 0.3s ease;
  }

  .ai-christmas-faq-question-{{ ai_gen_id }}:hover {
    color: {{ block.settings.question_hover_color }};
  }

  .ai-christmas-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-christmas-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: {{ block.settings.icon_color }};
    transition: transform 0.3s ease;
  }

  .ai-christmas-faq-item-{{ ai_gen_id }}.active .ai-christmas-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-christmas-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
  }

  .ai-christmas-faq-item-{{ ai_gen_id }}.active .ai-christmas-faq-answer-{{ ai_gen_id }} {
    max-height: 500px;
    padding: 0 30px 25px;
  }

  .ai-christmas-faq-answer-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-christmas-faq-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-christmas-faq-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-christmas-faq-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }

    .ai-christmas-faq-question-{{ ai_gen_id }} {
      padding: 20px;
      font-size: calc({{ block.settings.question_size }}px * 0.9);
    }

    .ai-christmas-faq-item-{{ ai_gen_id }}.active .ai-christmas-faq-answer-{{ ai_gen_id }} {
      padding: 0 20px 20px;
    }

    .ai-christmas-faq-answer-content-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.answer_size }}px * 0.9);
    }

    .ai-christmas-faq-snowflake-{{ ai_gen_id }} {
      font-size: 20px;
    }
  }
{% endstyle %}

<christmas-faq-{{ ai_gen_id }} class="ai-christmas-faq-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-christmas-faq-snowflake-{{ ai_gen_id }}">❄</div>
  <div class="ai-christmas-faq-snowflake-{{ ai_gen_id }}">❅</div>
  <div class="ai-christmas-faq-snowflake-{{ ai_gen_id }}">❆</div>
  <div class="ai-christmas-faq-snowflake-{{ ai_gen_id }}">❄</div>

  <div class="ai-christmas-faq-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-christmas-faq-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-christmas-faq-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-christmas-faq-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-christmas-faq-list-{{ ai_gen_id }}">
      {% if block.settings.question_1 != blank %}
        <div class="ai-christmas-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button
            class="ai-christmas-faq-question-{{ ai_gen_id }}"
            aria-expanded="false"
            type="button"
          >
            <span class="ai-christmas-faq-question-text-{{ ai_gen_id }}">
              {{ block.settings.question_1 }}
            </span>
            <span class="ai-christmas-faq-icon-{{ ai_gen_id }}" aria-hidden="true">🎄</span>
          </button>
          <div class="ai-christmas-faq-answer-{{ ai_gen_id }}">
            <div class="ai-christmas-faq-answer-content-{{ ai_gen_id }}">
              {{ block.settings.answer_1 }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.question_2 != blank %}
        <div class="ai-christmas-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button
            class="ai-christmas-faq-question-{{ ai_gen_id }}"
            aria-expanded="false"
            type="button"
          >
            <span class="ai-christmas-faq-question-text-{{ ai_gen_id }}">
              {{ block.settings.question_2 }}
            </span>
            <span class="ai-christmas-faq-icon-{{ ai_gen_id }}" aria-hidden="true">🎁</span>
          </button>
          <div class="ai-christmas-faq-answer-{{ ai_gen_id }}">
            <div class="ai-christmas-faq-answer-content-{{ ai_gen_id }}">
              {{ block.settings.answer_2 }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.question_3 != blank %}
        <div class="ai-christmas-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button
            class="ai-christmas-faq-question-{{ ai_gen_id }}"
            aria-expanded="false"
            type="button"
          >
            <span class="ai-christmas-faq-question-text-{{ ai_gen_id }}">
              {{ block.settings.question_3 }}
            </span>
            <span class="ai-christmas-faq-icon-{{ ai_gen_id }}" aria-hidden="true">⭐</span>
          </button>
          <div class="ai-christmas-faq-answer-{{ ai_gen_id }}">
            <div class="ai-christmas-faq-answer-content-{{ ai_gen_id }}">
              {{ block.settings.answer_3 }}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</christmas-faq-{{ ai_gen_id }}>

<script>
  (function() {
    class ChristmasFaq{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.faqItems = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.faqItems.forEach((item) => {
          const button = item.querySelector('.ai-christmas-faq-question-{{ ai_gen_id }}');
          
          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            
            this.faqItems.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.classList.remove('active');
                const otherButton = otherItem.querySelector('.ai-christmas-faq-question-{{ ai_gen_id }}');
                otherButton.setAttribute('aria-expanded', 'false');
              }
            });
            
            if (isActive) {
              item.classList.remove('active');
              button.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('christmas-faq-{{ ai_gen_id }}', ChristmasFaq{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Christmas FAQ",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
