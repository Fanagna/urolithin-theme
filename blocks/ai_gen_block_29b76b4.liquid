{% doc %}
  @prompt
    carousle d images d avis ugc deroulant automatique rapidment, image uploadable , pas de textes, les images vides ne devraient pas s afficher dans le menu deroulant
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ugc-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-ugc-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    animation: ai-ugc-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-ugc-carousel-{{ ai_gen_id }}:hover .ai-ugc-carousel-track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-ugc-carousel-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-ugc-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-ugc-carousel-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_width | times: 0.7 }}px;
      height: {{ block.settings.image_height | times: 0.7 }}px;
    }
  }
{% endstyle %}

<ugc-carousel-{{ ai_gen_id }} class="ai-ugc-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ugc-carousel-track-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}
      {% if image %}
        <div class="ai-ugc-carousel-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ image | image_url: width: 600 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="600"
            height="600"
            class="ai-ugc-carousel-image-{{ ai_gen_id }}"
          >
        </div>
      {% endif %}
    {% endfor %}

    {% for i in (1..10) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}
      {% if image %}
        <div class="ai-ugc-carousel-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ image | image_url: width: 600 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="600"
            height="600"
            class="ai-ugc-carousel-image-{{ ai_gen_id }}"
          >
        </div>
      {% endif %}
    {% endfor %}
  </div>
</ugc-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class UgcCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-ugc-carousel-track-{{ ai_gen_id }}');
        this.updateAnimation();
      }

      updateAnimation() {
        const images = this.track.querySelectorAll('.ai-ugc-carousel-image-wrapper-{{ ai_gen_id }}');
        const imageCount = images.length / 2;
        
        if (imageCount === 0) return;

        const imageWidth = {{ block.settings.image_width }};
        const gap = {{ block.settings.image_gap }};
        const isMobile = window.innerWidth <= 749;
        const actualWidth = isMobile ? imageWidth * 0.7 : imageWidth;
        const totalDistance = (actualWidth + gap) * imageCount;

        const style = document.createElement('style');
        style.textContent = `
          @keyframes ai-ugc-scroll-{{ ai_gen_id }} {
            0% {
              transform: translateX(0);
            }
            100% {
              transform: translateX(-${totalDistance}px);
            }
          }
        `;
        
        const existingStyle = this.querySelector('style');
        if (existingStyle) {
          existingStyle.remove();
        }
        this.appendChild(style);
      }
    }

    customElements.define('ugc-carousel-{{ ai_gen_id }}', UgcCarousel{{ ai_gen_id }});
  })();
</script>

