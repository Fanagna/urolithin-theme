{% doc %}
  @prompt
    Create a full-width hero banner identical to the reference visual.
    
    Do NOT change any wording, text alignment, color tones, spacing, or layout proportions.
    
    🔹 CONTENT (must remain exactly the same)
    
    Main headline (centered):
    
    Highest Quality BPC
    
    Subheadline below:
    
    Heal. Recover. Perform
    
    🔹 DESIGN REQUIREMENTS
    
    Full-width background image featuring a blue molecular/scientific structure
    
    Background slightly darkened for text contrast
    
    Main headline color: bright red
    
    Subheadline color: white
    
    Both texts centered horizontally and vertically
    
    Clean, modern, medical/scientific aesthetic
    
    No buttons
    
    No extra elements
    
    No added overlays beyond subtle dark gradient for readability
    
    🔹 LAYOUT
    
    Full viewport width
    
    Medium hero height (not full-screen)
    
    Text perfectly centered
    
    Balanced spacing between headline and subheadline
    
    🔹 RESPONSIVE RULES (very important)
    
    Headline scales smoothly on mobile
    
    Text remains centered on all devices
    
    Background image remains properly cropped without distortion
    
    Maintain strong contrast on small screens
    
    🔹 TECHNICAL REQUIREMENTS
    
    Semantic HTML
    
    Use CSS background-image (cover, center)
    
    Clean minimal CSS
    
    No JavaScript required
    
    Shopify Dawn theme compatible
    
    The final result must visually match the reference exactly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url('{{ block.settings.background_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .ai-hero-banner-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 1;
  }

  .ai-hero-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px;
    max-width: 1200px;
    width: 100%;
  }

  .ai-hero-banner__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .ai-hero-banner__subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    font-weight: 400;
    color: {{ block.settings.subheadline_color }};
    margin: 0;
    line-height: 1.4;
    letter-spacing: 0.05em;
  }

  .ai-hero-banner-placeholder-{{ ai_gen_id }} {
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #60a5fa 100%);
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 800px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-hero-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #333;
    text-align: center;
    pointer-events: none;
    z-index: 3;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.hero_height | times: 0.7 }}px;
    }

    .ai-hero-banner__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.6 }}px;
    }

    .ai-hero-banner__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.7 }}px;
    }

    .ai-hero-banner__content-{{ ai_gen_id }} {
      padding: 30px 16px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-hero-banner__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-hero-banner__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image == blank %}
    <div class="ai-hero-banner-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
    </div>
    <div class="ai-hero-banner-empty-state-{{ ai_gen_id }}">
      Next, add a background image
    </div>
  {% endif %}

  <div class="ai-hero-banner__content-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h1 class="ai-hero-banner__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h1>
    {% endif %}

    {% if block.settings.subheadline != blank %}
      <p class="ai-hero-banner__subheadline-{{ ai_gen_id }}">
        {{ block.settings.subheadline }}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "BPC hero banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Main headline",
      "default": "Highest Quality BPC"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Heal. Recover. Perform"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 0.8,
      "step": 0.1,
      "label": "Overlay darkness",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Hero height",
      "default": 500
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Headline size",
      "default": 70
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#e91d1d"
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "min": 14,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Subheadline size",
      "default": 24
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Subheadline color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing between texts",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "BPC hero banner"
    }
  ]
}
{% endschema %}
