{% doc %}
  @prompt
    generer moi une section contenant un titre  et 6 blocs de card (3 en haut et 3 en bas )  ; les posssedent un titre et une paragraphe
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-card-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-card-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-card-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-card-grid-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease;
  }

  .ai-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-card-title-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
  }

  .ai-card-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_text_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    .ai-card-grid-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-card-grid-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-card-grid-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-card-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-card-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-card-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-card-grid-cards-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_text_key = 'card_' | append: i | append: '_text'
          assign card_title = block.settings[card_title_key]
          assign card_text = block.settings[card_text_key]
        %}

        <div class="ai-card-{{ ai_gen_id }}">
          {% if card_title != blank %}
            <h3 class="ai-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
          {% if card_text != blank %}
            <div class="ai-card-text-{{ ai_gen_id }}">{{ card_text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

