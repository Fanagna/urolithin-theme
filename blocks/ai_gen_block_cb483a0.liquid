{% doc %}
  @prompt
    Create a "Subscribe & Save" upsell banner to display below the cart items:
    
    CONTENT:
    - Left: circular green icon (38px, background #0d6e4f, white sync/refresh icon inside)
    - Center text:
      - Bold line: "Subscribe & Save 15% on every order" (13px, bold, color #0a5a40)
      - Subtitle: "Auto-ship every 30, 60, or 90 days · Cancel anytime · Save $11.25 today" (11px, color #565959)
    - Right: checkbox input (20px x 20px, accent-color #0d6e4f)
    
    DESIGN:
    - Background: light green (#e7f4ee)
    - Border: 1.5px dashed #0d6e4f
    - Border-radius: 8px
    - Padding: 14px 16px
    - Margin: 0 24px 16px 24px (inside the cart card)
    - Display: flex, align-items center, gap 12px
    - Cursor: pointer on the whole row
    - On hover: background darkens slightly to #d4f0e2
    
    THE ENTIRE ROW should be a <label> wrapping the checkbox so clicking anywhere toggles it.
    
    RESPONSIVE (under 768px):
    - Margin: 0 16px 12px 16px
    - Icon shrinks to 32px
    - Padding: 10px 12px
    - Text sizes stay the same but the row can wrap if needed
    
    HTML and CSS only. No JavaScript needed (the label/checkbox handles interaction natively).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-subscribe-save-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-subscribe-save-label-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_thickness }}px dashed {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    margin: 0 {{ block.settings.margin_horizontal }}px {{ block.settings.margin_bottom }}px {{ block.settings.margin_horizontal }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ai-subscribe-save-label-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
  }

  .ai-subscribe-save-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-subscribe-save-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    color: {{ block.settings.icon_color }};
  }

  .ai-subscribe-save-content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-subscribe-save-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-subscribe-save-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-subscribe-save-checkbox-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.checkbox_size }}px;
    height: {{ block.settings.checkbox_size }}px;
    accent-color: {{ block.settings.checkbox_accent_color }};
    cursor: pointer;
  }

  @media screen and (max-width: 767px) {
    .ai-subscribe-save-label-{{ ai_gen_id }} {
      margin: 0 {{ block.settings.mobile_margin_horizontal }}px {{ block.settings.mobile_margin_bottom }}px {{ block.settings.mobile_margin_horizontal }}px;
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-subscribe-save-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-subscribe-save-icon-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.mobile_icon_size }}px * 0.5);
      height: calc({{ block.settings.mobile_icon_size }}px * 0.5);
    }
  }
{% endstyle %}

<div class="ai-subscribe-save-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <label class="ai-subscribe-save-label-{{ ai_gen_id }}">
    <div class="ai-subscribe-save-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="23 4 23 10 17 10"></polyline>
        <polyline points="1 20 1 14 7 14"></polyline>
        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
      </svg>
    </div>
    <div class="ai-subscribe-save-content-{{ ai_gen_id }}">
      <div class="ai-subscribe-save-title-{{ ai_gen_id }}">{{ block.settings.title }}</div>
      <div class="ai-subscribe-save-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
    </div>
    <input type="checkbox" class="ai-subscribe-save-checkbox-{{ ai_gen_id }}" name="subscribe_save" aria-label="{{ block.settings.checkbox_label }}">
  </label>
</div>

