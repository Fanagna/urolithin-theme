{% doc %}
  @prompt
    Create a centered, premium dark-mode opt-in form section that visually matches the previous section and has the exact same container width (same max-width, padding, and alignment) as the previous “What’s Inside the Guide” card.
    
    This form must be fully connected to Omnisend newsletter signup using Shopify’s native Omnisend integration (email capture + first name).
    
    Requirements for Omnisend integration:
    
    Email field must be required and mapped to Omnisend email subscriber list
    
    First name field must be optional and mapped to Omnisend first name property
    
    Checkbox must be a consent checkbox compatible with Omnisend
    
    On submit, the contact is added to the Omnisend newsletter list
    
    Form must be valid and functional for email marketing automation
    
    Do not change the structure, spacing, or wording. Keep the section centered in the middle of the page, with a rounded container, subtle gradient background, soft shadow, and high-contrast typography.
    
    Form layout rules:
    
    Same outer card width as the previous section (match max-width exactly)
    
    Title centered at top
    
    Subtitle centered below title
    
    Labels left-aligned above inputs
    
    Two stacked input fields
    
    Checkbox row below the inputs
    
    Large full-width green CTA button
    
    Small feature row at the bottom (3 items)
    
    Content to display (do not edit):
    
    Get Instant Access
    
    Enter your email to download the guide + receive your 30% discount code
    
    Label: Email address
    Placeholder: you@example.com
    
    Label: First name (optional)
    Placeholder: John
    
    Checkbox text:
    Send me the free guide, discount code, and recovery tips. Unsubscribe anytime.
    
    Button text (all caps):
    DOWNLOAD FREE GUIDE NOW
    
    Bottom row (3 items, small text):
    Instant download · 100% free · No spam
    
    Do not add extra fields, links, or additional copy.
    Keep everything centered, premium, conversion-focused, and visually consistent with the previous section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-omnisend-optin-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-omnisend-optin-container-{{ ai_gen_id }} {
    max-width: 700px;
    margin: 0 auto;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-radius: 16px;
    padding: 48px 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .ai-omnisend-optin-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-omnisend-optin-subtitle-{{ ai_gen_id }} {
    font-size: 16px;
    color: #b8b8d1;
    text-align: center;
    margin: 0 0 32px 0;
    line-height: 1.5;
  }

  .ai-omnisend-optin-field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-omnisend-optin-label-{{ ai_gen_id }} {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 8px;
    text-align: left;
  }

  .ai-omnisend-optin-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 16px;
    font-size: 16px;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .ai-omnisend-optin-input-{{ ai_gen_id }}::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .ai-omnisend-optin-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: #5c1ada;
    background-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 0 3px rgba(92, 26, 218, 0.2);
  }

  .ai-omnisend-optin-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-omnisend-optin-checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-top: 2px;
    cursor: pointer;
    accent-color: #5c1ada;
  }

  .ai-omnisend-optin-checkbox-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: #b8b8d1;
    line-height: 1.5;
    text-align: left;
  }

  .ai-omnisend-optin-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 32px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #ffffff;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .ai-omnisend-optin-button-{{ ai_gen_id }}:hover {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
  }

  .ai-omnisend-optin-features-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .ai-omnisend-optin-feature-{{ ai_gen_id }} {
    font-size: 12px;
    color: #8b8ba7;
    text-align: center;
  }

  .ai-omnisend-optin-success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 8px;
    color: #10b981;
    font-size: 14px;
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-omnisend-optin-error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    color: #ef4444;
    font-size: 14px;
    text-align: center;
    margin-bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-omnisend-optin-container-{{ ai_gen_id }} {
      padding: 32px 24px;
    }

    .ai-omnisend-optin-title-{{ ai_gen_id }} {
      font-size: 26px;
    }

    .ai-omnisend-optin-subtitle-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-omnisend-optin-features-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-omnisend-optin-feature-{{ ai_gen_id }} {
      font-size: 11px;
    }
  }
{% endstyle %}

<omnisend-optin-form-{{ ai_gen_id }}
  class="ai-omnisend-optin-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-omnisend-optin-container-{{ ai_gen_id }}">
    {%- form 'customer', id: 'omnisend-newsletter-form', class: 'omnisend-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      {%- if form.posted_successfully? -%}
        <div class="ai-omnisend-optin-success-{{ ai_gen_id }}">
          Thanks for subscribing! Check your email for the free guide and discount code.
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="ai-omnisend-optin-error-{{ ai_gen_id }}">
          {%- for field in form.errors -%}
            {{ form.errors.messages[field] }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <h2 class="ai-omnisend-optin-title-{{ ai_gen_id }}">
        Get Instant Access
      </h2>

      <p class="ai-omnisend-optin-subtitle-{{ ai_gen_id }}">
        Enter your email to download the guide + receive your 30% discount code
      </p>

      <div class="ai-omnisend-optin-field-{{ ai_gen_id }}">
        <label for="omnisend-email-{{ ai_gen_id }}" class="ai-omnisend-optin-label-{{ ai_gen_id }}">
          Email address
        </label>
        <input
          type="email"
          id="omnisend-email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-omnisend-optin-input-{{ ai_gen_id }}"
          placeholder="you@example.com"
          required
          autocomplete="email"
          aria-required="true"
          {% if form.errors %}
            aria-invalid="true"
          {% endif %}
        >
      </div>

      <div class="ai-omnisend-optin-field-{{ ai_gen_id }}">
        <label for="omnisend-firstname-{{ ai_gen_id }}" class="ai-omnisend-optin-label-{{ ai_gen_id }}">
          First name (optional)
        </label>
        <input
          type="text"
          id="omnisend-firstname-{{ ai_gen_id }}"
          name="contact[first_name]"
          class="ai-omnisend-optin-input-{{ ai_gen_id }}"
          placeholder="John"
          autocomplete="given-name"
        >
      </div>

      <div class="ai-omnisend-optin-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="omnisend-consent-{{ ai_gen_id }}"
          name="contact[accepts_marketing]"
          class="ai-omnisend-optin-checkbox-{{ ai_gen_id }}"
          value="true"
          required
          aria-required="true"
        >
        <label for="omnisend-consent-{{ ai_gen_id }}" class="ai-omnisend-optin-checkbox-label-{{ ai_gen_id }}">
          Send me the free guide, discount code, and recovery tips. Unsubscribe anytime.
        </label>
      </div>

      <button type="submit" class="ai-omnisend-optin-button-{{ ai_gen_id }}">
        DOWNLOAD FREE GUIDE NOW
      </button>

      <div class="ai-omnisend-optin-features-{{ ai_gen_id }}">
        <span class="ai-omnisend-optin-feature-{{ ai_gen_id }}">Instant download</span>
        <span class="ai-omnisend-optin-feature-{{ ai_gen_id }}">100% free</span>
        <span class="ai-omnisend-optin-feature-{{ ai_gen_id }}">No spam</span>
      </div>
    {%- endform -%}
  </div>
</omnisend-optin-form-{{ ai_gen_id }}>

<script>
  (function() {
    class OmnisendOptinForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const checkbox = this.querySelector('.ai-omnisend-optin-checkbox-{{ ai_gen_id }}');
        if (!checkbox.checked) {
          event.preventDefault();
          alert('Please accept the consent checkbox to continue.');
          return false;
        }
      }
    }

    customElements.define('omnisend-optin-form-{{ ai_gen_id }}', OmnisendOptinForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Omnisend opt-in form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Omnisend integration"
    },
    {
      "type": "paragraph",
      "content": "This form integrates with Shopify's native customer form and Omnisend. Ensure Omnisend is installed and configured in your store to capture subscribers."
    }
  ],
  "presets": [
    {
      "name": "Omnisend opt-in form"
    }
  ]
}
{% endschema %}
