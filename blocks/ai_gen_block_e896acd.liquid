{% doc %}
  @prompt
    genere moi une section contenant                                                                                                                                                                          une image (en format carré à droite) et un titre , des bouton 3 boutons avec des lien vers le produit) et noublie pas tous les parametrage des reglage
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-feature-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-feature-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-product-feature-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-product-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-feature-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-product-feature-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
  }

  .ai-product-feature-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-product-feature-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_width }}px;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
  }

  .ai-product-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-feature-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-feature-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-product-feature-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-product-feature-container-{{ ai_gen_id }} {
      flex-direction: column-reverse;
      gap: 24px;
    }

    .ai-product-feature-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      max-width: 400px;
      height: auto;
      aspect-ratio: 1;
    }

    .ai-product-feature-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }

  @media screen and (min-width: 750px) {
    .ai-product-feature-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }
{% endstyle %}

<product-feature-{{ ai_gen_id }}
  class="ai-product-feature-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-feature-container-{{ ai_gen_id }}">
    <div class="ai-product-feature-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-product-feature-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      <div class="ai-product-feature-buttons-{{ ai_gen_id }}">
        {% if block.settings.product_1 != blank %}
          <a
            href="{{ block.settings.product_1.url }}"
            class="ai-product-feature-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_1_text }}
          </a>
        {% endif %}

        {% if block.settings.product_2 != blank %}
          <a
            href="{{ block.settings.product_2.url }}"
            class="ai-product-feature-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_2_text }}
          </a>
        {% endif %}

        {% if block.settings.product_3 != blank %}
          <a
            href="{{ block.settings.product_3.url }}"
            class="ai-product-feature-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_3_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-product-feature-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-product-feature-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-product-feature-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-product-feature-empty-state-{{ ai_gen_id }}">
            Ajoutez une image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</product-feature-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeature{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-feature-{{ ai_gen_id }}', ProductFeature{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
