    },
    {
      "type": "header",
      "content": "Produit 2"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Produit"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Texte du bouton",
      "default": "Voir le produit 2"
    },
    {
      "type": "header",
      "content": "Produit 3"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Produit"
    },
    {
      "type": "text",
      "id": "button_3_text",
      "label": "Texte du bouton",
      "default": "Voir le produit 3"
    },
    {
      "type": "header",
      "content": "Style des boutons"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Couleur de fond",
      "default": "#5c1ada"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Couleur de fond au survol",
      "default": "#b600ff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Couleur du texte au survol",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Taille de police",
