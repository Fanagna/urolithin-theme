{% doc %}
  @prompt
    creer moi une section contenant un titre (avec text size) et un Slogan ; tous les contenu du text est centrer au centre
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-header-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-header-section__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.2;
  }

  .ai-header-section__slogan-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.slogan_color }};
    font-size: {{ block.settings.slogan_size }}px;
    font-weight: {{ block.settings.slogan_weight }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-header-section__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-header-section__slogan-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.slogan_size }}px * 0.9);
    }
  }
{% endstyle %}

<header-section-{{ ai_gen_id }} class="ai-header-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-section__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-header-section__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h2>
    {% endif %}

    {% if block.settings.slogan != blank %}
      <p class="ai-header-section__slogan-{{ ai_gen_id }}">
        {{ block.settings.slogan }}
      </p>
    {% endif %}
  </div>
</header-section-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('header-section-{{ ai_gen_id }}', HeaderSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Titre et slogan",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Votre titre ici"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre",
      "default": 40
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Poids du titre",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#121212"
    },
    {
      "type": "textarea",
      "id": "slogan",
      "label": "Slogan",
      "default": "Votre slogan inspirant ici"
    },
    {
      "type": "range",
      "id": "slogan_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Taille du slogan",
      "default": 18
    },
    {
      "type": "select",
      "id": "slogan_weight",
      "label": "Poids du slogan",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "slogan_color",
      "label": "Couleur du slogan",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Espacement entre titre et slogan",
      "default": 16
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 400,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Largeur du conteneur",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement haut",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement bas",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Titre et slogan"
    }
  ]
}
{% endschema %}
