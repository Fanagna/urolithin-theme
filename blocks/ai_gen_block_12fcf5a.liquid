{% doc %}
  @prompt
    Role:
    Act as a senior Shopify theme developer and conversion-focused UX designer with strong knowledge of scientific education UX.
    
    Goal:
    Generate a clean, educational explanatory section answering the question “Why does energy decline after 35?” in a neutral, science-based, non-medical way.
    
    Section Structure:
    
    Centered headline
    
    Short italic subheadline
    
    Two informational cards displayed side-by-side on desktop
    
    Cards stacked vertically on mobile
    
    Subtle callout message below the cards
    
    Headline (editable):
    “WHY DOES ENERGY DECLINE AFTER 35?”
    
    Subheadline (editable, italic):
    “It’s cellular biology, not just ‘getting old.’”
    
    Info Cards (2 total):
    Each card must include:
    
    A small numbered square badge (1, 2)
    
    A bold title
    
    Short explanatory text
    
    Rounded corners
    
    Soft shadow
    
    Default Card Content (editable from section settings):
    Card 1
    Title: “NAD+ LEVELS DROP”
    Text: “Your cellular energy currency declines approximately every 20 years, reducing ATP production and resilience.”
    
    Card 2
    Title: “OLD MITOCHONDRIA PILE UP”
    Text: “Damaged mitochondria slow recovery, increase fatigue, and reduce metabolic efficiency.”
    
    Callout Box (below cards):
    
    Soft red / warning background
    
    Small icon (coffee / alert / info)
    
    Text (editable):
    “Coffee doesn’t fix cellular dysfunction.”
    
    Footer Text (small, centered):
    “→ Science offers a solution”
    
    Design & Style:
    
    White background
    
    Neutral dark text
    
    Minimal biotech / longevity aesthetic
    
    Generous spacing
    
    No aggressive marketing language
    
    Customization:
    
    All text editable via section settings
    
    Colors adjustable via section settings
    
    Icons optional/selectable
    
    Technical Requirements:
    
    Shopify Online Store 2.0 compatible
    
    Implement as a reusable section
    
    Mobile-first, accessible
    
    Minimal CSS
    
    No hardcoded claims, no medical promises
    
    Output:
    
    Generate the complete Shopify section code
    
    Clean, professional, educational tone
    
    Ready to insert between product sections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-energy-decline-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-energy-decline-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-energy-decline-headline-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .ai-energy-decline-subheadline-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.subheadline_size }}px;
    font-style: italic;
    color: {{ block.settings.subheadline_color }};
    margin: 0 0 40px;
    line-height: 1.4;
  }

  .ai-energy-decline-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 32px;
  }

  @media screen and (min-width: 750px) {
    .ai-energy-decline-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .ai-energy-decline-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    position: relative;
  }

  .ai-energy-decline-badge-{{ ai_gen_id }} {
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    border-radius: {{ block.settings.badge_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .ai-energy-decline-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .ai-energy-decline-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-energy-decline-callout-{{ ai_gen_id }} {
    background-color: {{ block.settings.callout_background }};
    border-radius: {{ block.settings.callout_border_radius }}px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-energy-decline-callout-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: {{ block.settings.callout_icon_color }};
  }

  .ai-energy-decline-callout-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-energy-decline-callout-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.callout_text_size }}px;
    color: {{ block.settings.callout_text_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-energy-decline-footer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.footer_text_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-energy-decline-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }

    .ai-energy-decline-subheadline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheadline_size }}px * 0.9);
      margin-bottom: 32px;
    }
  }
{% endstyle %}

<energy-decline-{{ ai_gen_id }} class="ai-energy-decline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-energy-decline-container-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-energy-decline-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
    {% endif %}

    {% if block.settings.subheadline != blank %}
      <p class="ai-energy-decline-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
    {% endif %}

    <div class="ai-energy-decline-cards-{{ ai_gen_id }}">
      <div class="ai-energy-decline-card-{{ ai_gen_id }}">
        <div class="ai-energy-decline-badge-{{ ai_gen_id }}">1</div>
        {% if block.settings.card_1_title != blank %}
          <h3 class="ai-energy-decline-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
        {% endif %}
        {% if block.settings.card_1_text != blank %}
          <p class="ai-energy-decline-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</p>
        {% endif %}
      </div>

      <div class="ai-energy-decline-card-{{ ai_gen_id }}">
        <div class="ai-energy-decline-badge-{{ ai_gen_id }}">2</div>
        {% if block.settings.card_2_title != blank %}
          <h3 class="ai-energy-decline-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
        {% endif %}
        {% if block.settings.card_2_text != blank %}
          <p class="ai-energy-decline-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</p>
        {% endif %}
      </div>
    </div>

    {% if block.settings.callout_text != blank %}
      <div class="ai-energy-decline-callout-{{ ai_gen_id }}">
        {% if block.settings.show_callout_icon %}
          <div class="ai-energy-decline-callout-icon-{{ ai_gen_id }}">
            {% if block.settings.callout_icon == 'alert' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            {% elsif block.settings.callout_icon == 'info' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
                <line x1="6" y1="1" x2="6" y2="4"></line>
                <line x1="10" y1="1" x2="10" y2="4"></line>
                <line x1="14" y1="1" x2="14" y2="4"></line>
              </svg>
            {% endif %}
          </div>
        {% endif %}
        <p class="ai-energy-decline-callout-text-{{ ai_gen_id }}">{{ block.settings.callout_text }}</p>
      </div>
    {% endif %}

    {% if block.settings.footer_text != blank %}
      <p class="ai-energy-decline-footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
    {% endif %}
  </div>
</energy-decline-{{ ai_gen_id }}>

<script>
  (function() {
    class EnergyDecline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('energy-decline-{{ ai_gen_id }}', EnergyDecline{{ ai_gen_id }});
  })();
</script>

