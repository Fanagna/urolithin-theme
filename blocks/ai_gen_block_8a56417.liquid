{% doc %}
  @prompt
    Create a full-width horizontal feature bar identical to the reference.
    
    Do NOT change any colors, text, wording, icons, spacing, or layout style.
    
    Content (must stay exactly the same):
    
    Lab Tested
    
    500B CFU
    
    90 Days Supply
    
    Design requirements:
    
    Dark green background (same shade as reference)
    
    White text
    
    Small icons before each text (lab icon, lightning icon, shield icon)
    
    Clean, premium, minimal style
    
    Vertically and horizontally centered content
    
    Equal spacing between the three items
    
    Responsiveness (very important):
    
    On desktop: items displayed in a single horizontal row
    
    On tablet: maintain horizontal alignment with reduced spacing
    
    On mobile:
    
    Stack items vertically OR switch to 3-column compact layout
    
    Keep text readable and icons aligned
    
    No overflow or horizontal scrolling
    
    Technical constraints:
    
    Use semantic HTML and CSS (Flexbox)
    
    Mobile-first responsive design
    
    Compatible with Shopify Dawn theme
    
    No JavaScript required
    
    The result must look exactly like the reference visual, only adapting layout for smaller screens without changing appearance.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #1a4d2e;
    padding: 16px 20px;
  }

  .ai-feature-bar__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-feature-bar__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ai-feature-bar__icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-feature-bar__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #ffffff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-bar__container-{{ ai_gen_id }} {
      gap: 40px;
    }

    .ai-feature-bar__item-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-feature-bar__icon-{{ ai_gen_id }} {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-bar-{{ ai_gen_id }} {
      padding: 20px 16px;
    }

    .ai-feature-bar__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 16px;
    }

    .ai-feature-bar__item-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-feature-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-bar__container-{{ ai_gen_id }}">
    <div class="ai-feature-bar__item-{{ ai_gen_id }}">
      <div class="ai-feature-bar__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
        </svg>
      </div>
      <span>Lab Tested</span>
    </div>

    <div class="ai-feature-bar__item-{{ ai_gen_id }}">
      <div class="ai-feature-bar__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
        </svg>
      </div>
      <span>500B CFU</span>
    </div>

    <div class="ai-feature-bar__item-{{ ai_gen_id }}">
      <div class="ai-feature-bar__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <span>90 Days Supply</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Feature bar"
    }
  ]
}
{% endschema %}
