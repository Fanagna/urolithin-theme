{% doc %}
  @prompt
    Create an FAQ section exactly matching the provided visual, structure, colors, and content. Do not rewrite, paraphrase, or add any text.
    
    Design & visual requirements:
    
    Clean, modern FAQ / accordion layout
    
    Light background with soft contrast
    
    Rounded cards with subtle shadow
    
    Minimalist, premium, trust-focused design
    
    Desktop-first, fully responsive on mobile
    
    Accordion behavior (click to expand / collapse)
    
    Section title (centered, exact text):
    ❓ YOUR QUESTIONS ANSWERED
    
    FAQ items (accordion style, exact wording):
    
    Why bundle these two?
    
    Expanded answer text (exact content):
    
    NAD+ fuels cellular energy production. Urolithin A activates mitophagy—your cells' natural process to remove damaged mitochondria. Together they address both fuel supply AND engine quality. It's like putting premium gas in a well-maintained engine.
    
    What are the exact doses?
    
    Collapsed by default (content hidden)
    
    Is this safe? What testing do you do?
    
    Collapsed by default (content hidden)
    
    What's your guarantee?
    
    Collapsed by default (content hidden)
    
    Behavior rules:
    
    First question expanded by default
    
    Other questions collapsed
    
    Clear chevron / arrow indicator on the right
    
    Smooth open/close animation
    
    Additional constraints:
    
    Do NOT change any wording
    
    Do NOT invent answers for collapsed items
    
    Do NOT add testimonials, pricing, or CTAs
    
    Keep tone factual, calm, and professional
    
    Visual style must match a premium longevity / biohacking brand
    
    Goal:
    Reassure users and remove friction by answering common questions in a clean, trustworthy, and easy-to-scan FAQ format.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-faq-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 40px;
    color: {{ block.settings.title_color }};
  }

  .ai-faq-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    overflow: hidden;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: {{ block.settings.question_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_color }};
    transition: background-color 0.2s ease;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
    padding-right: 16px;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 500px;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    padding: 0 24px 20px;
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
    color: {{ block.settings.answer_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-faq-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
      margin-bottom: 30px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      padding: 16px 20px;
      font-size: calc({{ block.settings.question_size }}px * 0.9);
    }

    .ai-faq-answer-content-{{ ai_gen_id }} {
      padding: 0 20px 16px;
      font-size: calc({{ block.settings.answer_size }}px * 0.95);
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    <h2 class="ai-faq-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>

    <div class="ai-faq-list-{{ ai_gen_id }}">
      <div class="ai-faq-item-{{ ai_gen_id }} {% if block.settings.first_open %}active{% endif %}" data-faq-item>
        <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="{% if block.settings.first_open %}true{% else %}false{% endif %}">
          <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ block.settings.question_1 }}</span>
          <svg class="ai-faq-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="ai-faq-answer-{{ ai_gen_id }}">
          <div class="ai-faq-answer-content-{{ ai_gen_id }}">
            {{ block.settings.answer_1 }}
          </div>
        </div>
      </div>

      {% if block.settings.question_2 != blank %}
        <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
            <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ block.settings.question_2 }}</span>
            <svg class="ai-faq-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="ai-faq-answer-{{ ai_gen_id }}">
            <div class="ai-faq-answer-content-{{ ai_gen_id }}">
              {{ block.settings.answer_2 }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.question_3 != blank %}
        <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
            <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ block.settings.question_3 }}</span>
            <svg class="ai-faq-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="ai-faq-answer-{{ ai_gen_id }}">
            <div class="ai-faq-answer-content-{{ ai_gen_id }}">
              {{ block.settings.answer_3 }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.question_4 != blank %}
        <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
            <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ block.settings.question_4 }}</span>
            <svg class="ai-faq-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="ai-faq-answer-{{ ai_gen_id }}">
            <div class="ai-faq-answer-content-{{ ai_gen_id }}">
              {{ block.settings.answer_4 }}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
          
          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            
            if (isActive) {
              item.classList.remove('active');
              button.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

