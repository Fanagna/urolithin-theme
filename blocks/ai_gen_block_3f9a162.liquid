{% doc %}
  @prompt
    Create a two-column informational section identical to the reference.
    
    ⚠️ Do not change any text, wording, punctuation, images, or colors.
    ⚠️ Only modify the mobile layout to stack content vertically.
    
    CONTENT (must remain exactly the same)
    
    Title (uppercase, bold):
    ❓ WHY DO WE FEEL "OLD" AFTER 35?
    
    Subtitle:
    It’s not just in your head. Your cells literally run out of energy as you age.
    
    IMAGE (RIGHT COLUMN)
    
    Image placeholder:
    
    Light grey background
    
    Dashed border
    
    Icon: INSERT IMAGE HERE
    
    Image caption: Person looking tired OR Battery Low graphic
    
    TEXT (LEFT COLUMN)
    
    Title (uppercase, bold):
    📄 THE REALITY:
    
    Text:
    After 30, your natural energy production drops by HALF every 20 years.
    
    Bullet points (list items):
    
    Afternoon crashes
    
    Slower recovery
    
    Brain fog & Less motivation
    
    Looking older, faster
    
    Footer line (italic):
    ☕ Coffee is a band-aid. → Science offers a real solution.
    
    DESIGN AND STYLE RULES
    
    Clean, modern, premium supplement-brand aesthetic
    
    Left column: Text left-aligned
    
    Right column: Image with text description centered
    
    Consistent padding and spacing
    
    Vertical line separating the text and image
    
    MOBILE LAYOUT (IMPORTANT)
    
    On mobile screens:
    
    Text and image stack vertically
    
    Image should appear above text
    
    Maintain equal spacing between items
    
    Ensure text remains readable on all screen sizes
    
    No horizontal scrolling
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: Two columns side by side (image and text)
    
    Tablet: Two columns with reduced gap
    
    Mobile: Stack content vertically, image first, then text below
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox
    
    Use media queries for mobile
    
    Mobile-first responsive logic
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript required
    
    The final result must look exactly like the reference on desktop, with the only change being the mobile stacking behavior.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-info-section-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: stretch;
  }

  .ai-info-section-text-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.column_padding }}px;
    text-align: left;
  }

  .ai-info-section-divider-{{ ai_gen_id }} {
    width: 1px;
    background-color: {{ block.settings.divider_color }};
    flex-shrink: 0;
  }

  .ai-info-section-image-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.column_padding }}px;
    text-align: center;
  }

  .ai-info-section-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-info-section-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.content_spacing }}px 0;
    line-height: 1.5;
  }

  .ai-info-section-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-info-section-body-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.list_spacing }}px 0;
    line-height: 1.5;
  }

  .ai-info-section-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.content_spacing }}px 0;
  }

  .ai-info-section-list-{{ ai_gen_id }} li {
    font-size: {{ block.settings.list_item_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    line-height: 1.5;
  }

  .ai-info-section-footer-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_size }}px;
    font-style: italic;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-info-section-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_caption_spacing }}px;
  }

  .ai-info-section-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-info-section-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.placeholder_bg }};
    border: 2px dashed {{ block.settings.placeholder_border }};
    border-radius: 8px;
    padding: 60px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .ai-info-section-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.4;
  }

  .ai-info-section-placeholder-text-{{ ai_gen_id }} {
    margin-top: 16px;
    font-size: 14px;
    color: {{ block.settings.placeholder_text_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-info-section-image-caption-{{ ai_gen_id }} {
    font-size: {{ block.settings.caption_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-info-section-container-{{ ai_gen_id }} {
      flex-direction: column-reverse;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-info-section-divider-{{ ai_gen_id }} {
      display: none;
    }

    .ai-info-section-text-column-{{ ai_gen_id }},
    .ai-info-section-image-column-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-info-section-main-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.8 }}px;
    }

    .ai-info-section-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-info-section-section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.8 }}px;
    }

    .ai-info-section-body-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_text_size | times: 0.9 }}px;
    }

    .ai-info-section-list-{{ ai_gen_id }} li {
      font-size: {{ block.settings.list_item_size | times: 0.9 }}px;
    }

    .ai-info-section-footer-{{ ai_gen_id }} {
      font-size: {{ block.settings.footer_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-info-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-info-section-container-{{ ai_gen_id }}">
    <div class="ai-info-section-image-column-{{ ai_gen_id }}">
      <div class="ai-info-section-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-info-section-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-info-section-placeholder-text-{{ ai_gen_id }}">Insert Image Here</div>
          </div>
        {% endif %}
      </div>
      {% if block.settings.image_caption != blank %}
        <p class="ai-info-section-image-caption-{{ ai_gen_id }}">{{ block.settings.image_caption }}</p>
      {% endif %}
    </div>

    <div class="ai-info-section-divider-{{ ai_gen_id }}"></div>

    <div class="ai-info-section-text-column-{{ ai_gen_id }}">
      {% if block.settings.main_title != blank %}
        <h2 class="ai-info-section-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <p class="ai-info-section-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}

      {% if block.settings.section_title != blank %}
        <h3 class="ai-info-section-section-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h3>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <p class="ai-info-section-body-text-{{ ai_gen_id }}">{{ block.settings.body_text }}</p>
      {% endif %}

      <ul class="ai-info-section-list-{{ ai_gen_id }}">
        {% if block.settings.list_item_1 != blank %}
          <li>{{ block.settings.list_item_1 }}</li>
        {% endif %}
        {% if block.settings.list_item_2 != blank %}
          <li>{{ block.settings.list_item_2 }}</li>
        {% endif %}
        {% if block.settings.list_item_3 != blank %}
          <li>{{ block.settings.list_item_3 }}</li>
        {% endif %}
        {% if block.settings.list_item_4 != blank %}
          <li>{{ block.settings.list_item_4 }}</li>
        {% endif %}
      </ul>

      {% if block.settings.footer_text != blank %}
        <p class="ai-info-section-footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
      {% endif %}
    </div>
  </div>
</div>

