{% doc %}
  @prompt
    Create a full-width top feature bar section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, icons, colors, font sizes, spacing, or background.
    ⚠️ DO NOT modify the desktop or tablet design.
    
    CONTENT (must remain exactly the same)
    
    🧪 Lab Tested
    
    ⚡ Science Backed
    
    🛡️ Money-Back Guarantee
    
    DESIGN (DESKTOP & TABLET)
    
    Full-width horizontal bar
    
    Dark navy/blue background (same shade as reference)
    
    White text
    
    Icons displayed before each label
    
    Items aligned on a single horizontal row
    
    Even spacing between items
    
    Content vertically centered
    
    MOBILE LAYOUT (VERY IMPORTANT — REQUIRED FIX)
    
    On mobile screens only:
    
    Change layout to a linear vertical stack
    
    Display items one below the other
    
    Center-align each item horizontally
    
    Icon and text remain on the same line
    
    Equal vertical spacing between items
    
    No horizontal scrolling
    
    ⚠️ This mobile change must NOT affect desktop or tablet layouts.
    
    RESPONSIVE BEHAVIOR SUMMARY
    
    Desktop: horizontal row (unchanged)
    
    Tablet: horizontal row (unchanged)
    
    Mobile:
    
    Vertical, linear stacking
    
    Centered content
    
    Clean and readable
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Flexbox
    
    Use CSS media queries for mobile
    
    Mobile-first responsive logic
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must look exactly like the reference on desktop, with the only change being a linear vertical layout on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-feature-bar-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    max-width: 100%;
    padding: 0 20px;
  }

  .ai-feature-bar-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    white-space: nowrap;
  }

  .ai-feature-bar-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-bar-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_item_spacing }}px;
      padding: 0 20px;
    }

    .ai-feature-bar-item-{{ ai_gen_id }} {
      justify-content: center;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-feature-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-bar-container-{{ ai_gen_id }}">
    {% if block.settings.show_item_1 %}
      <div class="ai-feature-bar-item-{{ ai_gen_id }}">
        <span class="ai-feature-bar-icon-{{ ai_gen_id }}">{{ block.settings.item_1_icon }}</span>
        <span>{{ block.settings.item_1_text }}</span>
      </div>
    {% endif %}

    {% if block.settings.show_item_2 %}
      <div class="ai-feature-bar-item-{{ ai_gen_id }}">
        <span class="ai-feature-bar-icon-{{ ai_gen_id }}">{{ block.settings.item_2_icon }}</span>
        <span>{{ block.settings.item_2_text }}</span>
      </div>
    {% endif %}

    {% if block.settings.show_item_3 %}
      <div class="ai-feature-bar-item-{{ ai_gen_id }}">
        <span class="ai-feature-bar-icon-{{ ai_gen_id }}">{{ block.settings.item_3_icon }}</span>
        <span>{{ block.settings.item_3_text }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Feature bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Item spacing (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_item_spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Item spacing (mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#00143e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "checkbox",
      "id": "show_item_1",
      "label": "Show item 1",
      "default": true
    },
    {
      "type": "text",
      "id": "item_1_icon",
      "label": "Icon",
      "default": "🧪"
    },
    {
      "type": "text",
      "id": "item_1_text",
      "label": "Text",
      "default": "Lab Tested"
    },
    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "checkbox",
      "id": "show_item_2",
      "label": "Show item 2",
      "default": true
    },
    {
      "type": "text",
      "id": "item_2_icon",
      "label": "Icon",
      "default": "⚡"
    },
    {
      "type": "text",
      "id": "item_2_text",
      "label": "Text",
      "default": "Science Backed"
    },
    {
      "type": "header",
      "content": "Item 3"
    },
    {
      "type": "checkbox",
      "id": "show_item_3",
      "label": "Show item 3",
      "default": true
    },
    {
      "type": "text",
      "id": "item_3_icon",
      "label": "Icon",
      "default": "🛡️"
    },
    {
      "type": "text",
      "id": "item_3_text",
      "label": "Text",
      "default": "Money-Back Guarantee"
    }
  ],
  "presets": [
    {
      "name": "Feature bar"
    }
  ]
}
{% endschema %}
