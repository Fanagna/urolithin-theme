    },
    {
      "type": "text",
      "id": "item_2_icon",
      "label": "Icon",
      "default": "⚡"
    },
    {
      "type": "text",
      "id": "item_2_text",
      "label": "Text",
      "default": "500B CFU"
    },
    {
      "type": "header",
      "content": "Item 3"
