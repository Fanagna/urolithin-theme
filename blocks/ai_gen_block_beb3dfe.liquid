{% doc %}
  @prompt
    Crée une section Shopify avec texte défilant fixe en haut de la page (marquee), fond et couleur de texte personnalisables, arrêt au survol, responsive.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    z-index: 1000;
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-marquee-container-{{ ai_gen_id }}:hover .ai-marquee-content-{{ ai_gen_id }} {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: 0 {{ block.settings.item_spacing }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-marquee-separator-{{ ai_gen_id }} {
    display: inline-block;
    margin: 0 {{ block.settings.separator_spacing }}px;
    font-size: {{ block.settings.font_size }}px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
    }

    .ai-marquee-separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<marquee-banner-{{ ai_gen_id }} class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% if block.settings.text_1 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
        {% if block.settings.text_3 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_3 }}</span>
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
        {% if block.settings.text_4 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_4 }}</span>
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
        {% if block.settings.text_5 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_5 }}</span>
          {% if i == 1 or block.settings.text_1 != blank or block.settings.text_2 != blank or block.settings.text_3 != blank or block.settings.text_4 != blank %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</marquee-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustScrollSpeed();
      }

      adjustScrollSpeed() {
        const content = this.querySelector('.ai-marquee-content-{{ ai_gen_id }}');
        if (!content) return;

        const contentWidth = content.scrollWidth / 2;
        const speed = {{ block.settings.animation_speed }};
        const duration = (contentWidth / 100) * speed;

        content.style.animationDuration = duration + 's';
      }
    }

    customElements.define('marquee-banner-{{ ai_gen_id }}', MarqueeBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Texte défilant fixe",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Texte 1",
      "default": "Livraison gratuite sur toutes les commandes"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Texte 2",
      "default": "Retours sous 30 jours"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Texte 3",
      "default": "Support client 24/7"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Texte 4"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Texte 5"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Séparateur",
      "default": "★"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#5c1ada"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Taille de police",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Épaisseur de police",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Espacement vertical",
      "default": 12
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Vitesse d'animation",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause au survol",
      "default": true
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Espacement des éléments",
      "default": 20
    },
    {
      "type": "range",
      "id": "separator_spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Espacement du séparateur",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Texte défilant fixe"
    }
  ]
}
{% endschema %}
