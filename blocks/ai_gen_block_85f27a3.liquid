{% doc %}
  @prompt
    Create a full-width hero section identical to the reference visual.
    
    Do not change any text content, wording, hierarchy, or colors.
    
    CONTENT (must remain exactly the same):
    
    Small pill badge at the top: “THIRD-PARTY VERIFIED”
    
    Main headline (centered): “Certificates of Analysis”
    
    Subtext below the headline (centered, smaller size):
    “Every Panstellar product is independently tested. Browse our COAs below — full transparency, no exceptions.”
    
    DESIGN REQUIREMENTS:
    
    Background: deep green gradient exactly like the reference (dark green edges, slightly lighter center)
    
    Text color: white with proper contrast
    
    Badge: rounded pill shape, subtle border, minimal opacity
    
    Clean, premium, scientific aesthetic
    
    No icons, no images, no animations
    
    LAYOUT:
    
    Full-width section
    
    Centered content vertically and horizontally
    
    Generous vertical padding (hero-style spacing)
    
    RESPONSIVE RULES (very important):
    
    Fully responsive on mobile, tablet, and desktop
    
    Headline scales down smoothly on mobile (no line breaks that alter meaning)
    
    Subtext wraps cleanly and remains readable on small screens
    
    Padding adjusts for smaller viewports without crowding
    
    TECHNICAL:
    
    Use semantic HTML
    
    Clean, minimal CSS
    
    No JavaScript required
    
    Optimized for Shopify themes (Dawn-compatible)
    
    The final result must visually match the reference exactly, with no changes to colors, text, or structure.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coa-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #0d4d3d 0%, #1a6b54 50%, #0d4d3d 100%);
    padding: 120px 20px;
    text-align: center;
  }

  .ai-coa-hero-content-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .ai-coa-hero-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 20px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .ai-coa-hero-heading-{{ ai_gen_id }} {
    margin: 0;
    color: #ffffff;
    font-size: 56px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .ai-coa-hero-subtext-{{ ai_gen_id }} {
    margin: 0;
    color: #ffffff;
    font-size: 18px;
    line-height: 1.6;
    max-width: 650px;
    opacity: 0.95;
  }

  @media screen and (max-width: 989px) {
    .ai-coa-hero-{{ ai_gen_id }} {
      padding: 80px 20px;
    }

    .ai-coa-hero-heading-{{ ai_gen_id }} {
      font-size: 40px;
    }

    .ai-coa-hero-subtext-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-coa-hero-{{ ai_gen_id }} {
      padding: 60px 16px;
    }

    .ai-coa-hero-badge-{{ ai_gen_id }} {
      font-size: 11px;
      padding: 6px 16px;
    }

    .ai-coa-hero-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-coa-hero-subtext-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .ai-coa-hero-content-{{ ai_gen_id }} {
      gap: 20px;
    }
  }
{% endstyle %}

<div class="ai-coa-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coa-hero-content-{{ ai_gen_id }}">
    <span class="ai-coa-hero-badge-{{ ai_gen_id }}">THIRD-PARTY VERIFIED</span>
    <h1 class="ai-coa-hero-heading-{{ ai_gen_id }}">Certificates of Analysis</h1>
    <p class="ai-coa-hero-subtext-{{ ai_gen_id }}">
      Every Panstellar product is independently tested. Browse our COAs below — full transparency, no exceptions.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "COA hero",
  "settings": [],
  "presets": [
    {
      "name": "COA hero"
    }
  ]
}
{% endschema %}
