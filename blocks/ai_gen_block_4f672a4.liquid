{% doc %}
  @prompt
    genere moi une section contenant :                                                                                                                                                              une image (en format carré à gauche) et un titre , des bouton 9 bouttons avec des lien vers le produits) et noublie pas tous les parametrage des reglage surtout le background color de la section, 4 bouttons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: {{ block.settings.gap }}px;
    align-items: start;
  }

  .ai-product-grid-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-grid-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-grid-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-grid-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-grid-buttons-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-product-grid-button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    text-align: center;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    min-height: 50px;
  }

  .ai-product-grid-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-product-grid-button-empty-{{ ai_gen_id }} {
    background-color: #f9f9f9;
    color: #999;
    cursor: default;
    font-style: italic;
    font-size: 13px;
    border-color: #e0e0e0;
  }

  .ai-product-grid-button-empty-{{ ai_gen_id }}:hover {
    background-color: #f9f9f9;
    color: #999;
    border-color: #e0e0e0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | times: 0.75 }}px;
    }

    .ai-product-grid-buttons-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-product-grid-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-grid-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    <div class="ai-product-grid-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="800"
          height="800"
          class="ai-product-grid-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-product-grid-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-product-grid-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-product-grid-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      <div class="ai-product-grid-buttons-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign button_text_key = 'button_text_' | append: i
            assign product = block.settings[product_key]
            assign button_text = block.settings[button_text_key]
          %}

          {% if product != blank %}
            <a
              href="{{ product.url }}"
              class="ai-product-grid-button-{{ ai_gen_id }}"
            >
              {% if button_text != blank %}
                {{ button_text }}
              {% else %}
                {{ product.title }}
              {% endif %}
            </a>
          {% else %}
            <div class="ai-product-grid-button-{{ ai_gen_id }} ai-product-grid-button-empty-{{ ai_gen_id }}">
              Ajouter produit {{ i }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

