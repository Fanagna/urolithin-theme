{% doc %}
  @prompt
    Design a full-width FAQ section in dark mode titled “Frequently Asked Questions”.
    Use a pure black background (#000000) for the page.
    Add three large accordion cards stacked vertically and centered on the page, each about 80% of the page width, with dark grey (#111111) panels, subtle inner padding, and slightly rounded corners.
    Each question line is in bold white text, left-aligned, with a small blue ▲ icon aligned to the far right.
    When an accordion is opened, its outer border becomes a thin white outline to highlight it.
    Inside each open card, show the answer as normal-weight white text on the same dark grey background, left-aligned, with good line spacing.
    Use a clean modern sans-serif font.
    The three FAQs must be exactly:
    
    
    Question: “Can I take these at the same time?”
    Answer: “Yes, absolutely. There are no negative interactions. Taking them together in the morning is a great way to ensure consistency.”
    
    
    Question: “How fast does the repair work?”
    Answer: “Most users feel a reduction in joint discomfort within 14–21 days of BPC-157 use. Creatine saturation typically takes about 3–4 weeks to reach peak levels if not loading.”
    
    
    Question: “Is this safe for tested athletes?”
    Answer: “Yes. BPC-157 is currently not on the WADA prohibited list for out-of-competition use (check specific federation rules), and Creatine is universally allowed.”
    
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: #000000;
    padding: 60px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-faq-title-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: 36px;
    font-weight: 700;
    text-align: center;
    margin: 0 0 48px;
  }

  .ai-faq-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    width: 80%;
    background-color: #111111;
    border-radius: 12px;
    padding: 24px 28px;
    border: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.active {
    border-color: #ffffff;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    gap: 20px;
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
    text-align: left;
    flex: 1;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    color: #0048dc;
    font-size: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, margin-top 0.4s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 500px;
    margin-top: 20px;
  }

  .ai-faq-answer-text-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    margin: 0;
    text-align: left;
  }

  @media screen and (max-width: 768px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-faq-title-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 32px;
    }

    .ai-faq-item-{{ ai_gen_id }} {
      width: 100%;
      padding: 20px 20px;
    }

    .ai-faq-question-text-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-faq-answer-text-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    <h2 class="ai-faq-title-{{ ai_gen_id }}">Frequently Asked Questions</h2>
    
    <div class="ai-faq-list-{{ ai_gen_id }}">
      <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
        <div class="ai-faq-question-{{ ai_gen_id }}" role="button" aria-expanded="false" tabindex="0">
          <h3 class="ai-faq-question-text-{{ ai_gen_id }}">Can I take these at the same time?</h3>
          <span class="ai-faq-icon-{{ ai_gen_id }}" aria-hidden="true">▲</span>
        </div>
        <div class="ai-faq-answer-{{ ai_gen_id }}">
          <p class="ai-faq-answer-text-{{ ai_gen_id }}">Yes, absolutely. There are no negative interactions. Taking them together in the morning is a great way to ensure consistency.</p>
        </div>
      </div>

      <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
        <div class="ai-faq-question-{{ ai_gen_id }}" role="button" aria-expanded="false" tabindex="0">
          <h3 class="ai-faq-question-text-{{ ai_gen_id }}">How fast does the repair work?</h3>
          <span class="ai-faq-icon-{{ ai_gen_id }}" aria-hidden="true">▲</span>
        </div>
        <div class="ai-faq-answer-{{ ai_gen_id }}">
          <p class="ai-faq-answer-text-{{ ai_gen_id }}">Most users feel a reduction in joint discomfort within 14–21 days of BPC-157 use. Creatine saturation typically takes about 3–4 weeks to reach peak levels if not loading.</p>
        </div>
      </div>

      <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
        <div class="ai-faq-question-{{ ai_gen_id }}" role="button" aria-expanded="false" tabindex="0">
          <h3 class="ai-faq-question-text-{{ ai_gen_id }}">Is this safe for tested athletes?</h3>
          <span class="ai-faq-icon-{{ ai_gen_id }}" aria-hidden="true">▲</span>
        </div>
        <div class="ai-faq-answer-{{ ai_gen_id }}">
          <p class="ai-faq-answer-text-{{ ai_gen_id }}">Yes. BPC-157 is currently not on the WADA prohibited list for out-of-competition use (check specific federation rules), and Creatine is universally allowed.</p>
        </div>
      </div>
    </div>
  </div>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const question = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
          
          question.addEventListener('click', () => {
            this.toggleItem(item);
          });

          question.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.toggleItem(item);
            }
          });
        });
      }

      toggleItem(item) {
        const isActive = item.classList.contains('active');
        const question = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
        
        if (isActive) {
          item.classList.remove('active');
          question.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('active');
          question.setAttribute('aria-expanded', 'true');
        }
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "FAQ accordion"
    }
  ]
}
{% endschema %}
