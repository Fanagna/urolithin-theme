{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-strategic-faq-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top_desktop }}px 20px {{ block.settings.padding_bottom_desktop }}px;
  }

  .ai-strategic-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-strategic-faq-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size_desktop }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
  }

  .ai-strategic-faq-accordion-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-strategic-faq-item-{{ ai_gen_id }} {
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    background-color: {{ block.settings.item_background }};
    overflow: hidden;
    transition: background-color 0.3s ease;
  }

  .ai-strategic-faq-item-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.item_active_background }};
  }

  .ai-strategic-faq-question-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.question_padding }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: {{ block.settings.question_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_color }};
    transition: color 0.3s ease;
  }

  .ai-strategic-faq-item-{{ ai_gen_id }}.active .ai-strategic-faq-question-{{ ai_gen_id }} {
    color: {{ block.settings.question_active_color }};
    font-weight: 700;
  }

  .ai-strategic-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-strategic-faq-item-{{ ai_gen_id }}.active .ai-strategic-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-strategic-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }

  .ai-strategic-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-strategic-faq-item-{{ ai_gen_id }}.active .ai-strategic-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 500px;
  }

  .ai-strategic-faq-answer-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.question_padding }}px {{ block.settings.question_padding }}px;
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
    color: {{ block.settings.answer_color }};
  }

  .ai-strategic-faq-item-{{ ai_gen_id }}.active .ai-strategic-faq-answer-{{ ai_gen_id }} {
    color: {{ block.settings.answer_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-strategic-faq-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-strategic-faq-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-strategic-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size_mobile }}px;
    }

    .ai-strategic-faq-answer-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_size_mobile }}px;
    }
  }
{% endstyle %}

<strategic-faq-{{ ai_gen_id }} class="ai-strategic-faq-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
