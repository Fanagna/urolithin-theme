    <h2 class="ai-strategic-faq-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    
    <div class="ai-strategic-faq-accordion-{{ ai_gen_id }}">
      {% if block.settings.faq_1_enabled %}
        <div class="ai-strategic-faq-item-{{ ai_gen_id }}" data-faq-item>
