  </div>
</strategic-faq-{{ ai_gen_id }}>

<script>
  (function() {
    class StrategicFaq{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('.ai-strategic-faq-question-{{ ai_gen_id }}');
          
          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            
            this.items.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.classList.remove('active');
                const otherButton = otherItem.querySelector('.ai-strategic-faq-question-{{ ai_gen_id }}');
                otherButton.setAttribute('aria-expanded', 'false');
              }
            });
            
            if (isActive) {
              item.classList.remove('active');
              button.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('strategic-faq-{{ ai_gen_id }}', StrategicFaq{{ ai_gen_id }});
  })();
</script>

