{% doc %}
  @prompt
    Create a full-width dark green call-to-action section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, punctuation, emojis, icons, prices, colors, spacing, or hierarchy.
    ⚠️ DO NOT rewrite, summarize, or optimize the copy.
    
    SECTION BACKGROUND
    
    Full-width section
    
    Dark green background (same exact shade as reference)
    
    Content centered horizontally
    
    MAIN CONTENT (CENTERED – keep exactly as written)
    
    Title (uppercase):
    🚀 READY TO FEEL BETTER?
    
    BENEFITS LIST (two columns on desktop)
    
    Left column:
    
    ✓ Steady energy all day
    
    ✓ Comfortable digestion
    
    ✓ Easier to manage cravings
    
    Right column:
    
    ✓ 500 billion CFU
    
    ✓ Third-party tested
    
    ✓ 30-day guarantee
    
    White text
    
    Check icons in green/white as in reference
    
    PRICING CARD (centered)
    
    Create a centered pricing box with:
    
    Slightly lighter green background than section
    
    Rounded corners
    
    Subtle shadow
    
    Price:
    $56.99
    
    Primary button (white):
    Start Today
    
    Subscription line (smaller text):
    Or subscribe & save 15% – $48.44/month
    
    TRUST & BONUS LINE (below pricing)
    
    Bonus line:
    🎁 LIMITED BONUS: First 100 customers get free “Energy & Gut Guide” (PDF)
    
    Security line (small text):
    🔒 Secure checkout · 💳 All cards accepted
    
    DESIGN & STYLE RULES
    
    Clean, premium, high-conversion supplement-brand aesthetic
    
    All text centered
    
    Clear vertical spacing between sections
    
    Strong contrast between background and pricing card
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop:
    
    Benefits displayed in two columns
    
    Pricing card centered
    
    Tablet:
    
    Benefits may reduce spacing but remain readable
    
    Mobile:
    
    Benefits stack vertically
    
    Pricing card full width
    
    Button large and easy to tap
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use Flexbox or CSS Grid
    
    Mobile-first responsive CSS
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting layout for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cta-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-cta-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-cta-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 {{ block.settings.title_margin }}px;
    letter-spacing: 0.5px;
  }

  .ai-cta-benefits-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 40px;
    max-width: 800px;
    margin: 0 auto {{ block.settings.benefits_margin }}px;
    text-align: left;
  }

  .ai-cta-benefit-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    color: {{ block.settings.benefits_color }};
    font-size: {{ block.settings.benefits_size }}px;
    line-height: 1.5;
  }

  .ai-cta-benefit-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: {{ block.settings.check_icon_color }};
  }

  .ai-cta-pricing-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    padding: {{ block.settings.card_padding }}px;
    max-width: {{ block.settings.card_max_width }}px;
    margin: 0 auto {{ block.settings.card_margin }}px;
  }

  .ai-cta-price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.price_margin }}px;
  }

  .ai-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_radius }}px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: {{ block.settings.button_max_width }}px;
    margin-bottom: {{ block.settings.button_margin }}px;
  }

  .ai-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-cta-subscription-{{ ai_gen_id }} {
    color: {{ block.settings.subscription_color }};
    font-size: {{ block.settings.subscription_size }}px;
    line-height: 1.5;
  }

  .ai-cta-bonus-{{ ai_gen_id }} {
    color: {{ block.settings.bonus_color }};
    font-size: {{ block.settings.bonus_size }}px;
    margin-bottom: {{ block.settings.bonus_margin }}px;
    line-height: 1.6;
  }

  .ai-cta-security-{{ ai_gen_id }} {
    color: {{ block.settings.security_color }};
    font-size: {{ block.settings.security_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-cta-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-cta-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.title_margin | times: 0.8 }}px;
    }

    .ai-cta-benefits-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: {{ block.settings.benefits_margin | times: 0.8 }}px;
    }

    .ai-cta-benefit-{{ ai_gen_id }} {
      font-size: {{ block.settings.benefits_size | times: 0.9 }}px;
    }

    .ai-cta-pricing-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
      margin-bottom: {{ block.settings.card_margin | times: 0.8 }}px;
    }

    .ai-cta-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.85 }}px;
    }

    .ai-cta-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }

    .ai-cta-bonus-{{ ai_gen_id }} {
      font-size: {{ block.settings.bonus_size | times: 0.9 }}px;
    }

    .ai-cta-security-{{ ai_gen_id }} {
      font-size: {{ block.settings.security_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-cta-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cta-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-cta-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-cta-benefits-{{ ai_gen_id }}">
      {% if block.settings.benefit_1 != blank %}
        <div class="ai-cta-benefit-{{ ai_gen_id }}">
          <svg class="ai-cta-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{{ block.settings.benefit_1 }}</span>
        </div>
      {% endif %}

      {% if block.settings.benefit_2 != blank %}
        <div class="ai-cta-benefit-{{ ai_gen_id }}">
          <svg class="ai-cta-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{{ block.settings.benefit_2 }}</span>
        </div>
      {% endif %}

      {% if block.settings.benefit_3 != blank %}
        <div class="ai-cta-benefit-{{ ai_gen_id }}">
          <svg class="ai-cta-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{{ block.settings.benefit_3 }}</span>
        </div>
      {% endif %}

      {% if block.settings.benefit_4 != blank %}
        <div class="ai-cta-benefit-{{ ai_gen_id }}">
          <svg class="ai-cta-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{{ block.settings.benefit_4 }}</span>
        </div>
      {% endif %}

      {% if block.settings.benefit_5 != blank %}
        <div class="ai-cta-benefit-{{ ai_gen_id }}">
          <svg class="ai-cta-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{{ block.settings.benefit_5 }}</span>
        </div>
      {% endif %}

      {% if block.settings.benefit_6 != blank %}
        <div class="ai-cta-benefit-{{ ai_gen_id }}">
          <svg class="ai-cta-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{{ block.settings.benefit_6 }}</span>
        </div>
      {% endif %}
    </div>

    <div class="ai-cta-pricing-card-{{ ai_gen_id }}">
      {% if block.settings.price != blank %}
        <div class="ai-cta-price-{{ ai_gen_id }}">{{ block.settings.price }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-cta-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}

      {% if block.settings.subscription_text != blank %}
        <div class="ai-cta-subscription-{{ ai_gen_id }}">{{ block.settings.subscription_text }}</div>
      {% endif %}
    </div>

    {% if block.settings.bonus_text != blank %}
      <div class="ai-cta-bonus-{{ ai_gen_id }}">{{ block.settings.bonus_text }}</div>
    {% endif %}

    {% if block.settings.security_text != blank %}
      <div class="ai-cta-security-{{ ai_gen_id }}">{{ block.settings.security_text }}</div>
    {% endif %}
  </div>
</div>

