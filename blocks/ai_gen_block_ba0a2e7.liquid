{% doc %}
  @prompt
    Create a clean customer reviews section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, names, punctuation, star count, colors, spacing, or hierarchy.
    ⚠️ DO NOT rewrite, summarize, or optimize the reviews.
    
    SECTION HEADER (centered)
    
    Title:
    💬 WHAT CUSTOMERS SAY
    
    Rating line (centered, directly under title):
    ⭐⭐⭐⭐⭐ 4.9/5 Based on 2,847 reviews
    
    REVIEWS LAYOUT
    
    Display three review cards in a single row on desktop.
    
    REVIEW CARD 1
    
    Star rating:
    ⭐⭐⭐⭐⭐
    
    Review text:
    “No more afternoon crashes. I actually have energy to cook dinner now instead of ordering takeout.”
    
    Author:
    — Michael R.
    
    Meta line:
    Using 5 months · ✔ VERIFIED PURCHASE
    
    REVIEW CARD 2
    
    Star rating:
    ⭐⭐⭐⭐⭐
    
    Review text:
    “My stomach feels so much better. No more bloating after lunch. Wish I found this sooner.”
    
    Author:
    — Jennifer K.
    
    Meta line:
    Using 4 months · ✔ VERIFIED PURCHASE
    
    REVIEW CARD 3
    
    Star rating:
    ⭐⭐⭐⭐⭐
    
    Review text:
    “I don’t crave sugar like I used to. And I feel more steady all day. Game changer.”
    
    Author:
    — Sarah T.
    
    Meta line:
    Using 3 months · ✔ VERIFIED PURCHASE
    
    DESIGN & STYLE RULES
    
    White background
    
    Clean, premium, trustworthy supplement-brand aesthetic
    
    Cards with subtle background or light shadow
    
    Rounded corners
    
    Text left-aligned inside cards
    
    Consistent spacing and padding
    
    Yellow/gold stars exactly like the reference
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: 3 cards in one row
    
    Tablet: 2 cards per row, third wraps below
    
    Mobile:
    
    Stack cards vertically
    
    Full-width cards
    
    Maintain spacing and readability
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use Flexbox or CSS Grid
    
    Mobile-first responsive CSS
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting layout for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 60px 20px;
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 12px 0;
    color: #121212;
  }

  .ai-reviews-rating-line-{{ ai_gen_id }} {
    font-size: 16px;
    color: #121212;
    margin: 0;
  }

  .ai-reviews-stars-header-{{ ai_gen_id }} {
    color: #FFD700;
    letter-spacing: 2px;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: #f9f9f9;
    border-radius: 12px;
    padding: 28px 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .ai-review-stars-{{ ai_gen_id }} {
    color: #FFD700;
    font-size: 18px;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: #121212;
    margin: 0 0 16px 0;
  }

  .ai-review-author-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    color: #121212;
    margin: 0 0 8px 0;
  }

  .ai-review-meta-{{ ai_gen_id }} {
    font-size: 13px;
    color: #666666;
    margin: 0;
  }

  .ai-review-verified-{{ ai_gen_id }} {
    color: #00a651;
    font-weight: 600;
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-reviews-rating-line-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      padding: 24px 20px;
    }
  }
{% endstyle %}

<div class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    <div class="ai-reviews-header-{{ ai_gen_id }}">
      <h2 class="ai-reviews-title-{{ ai_gen_id }}">💬 WHAT CUSTOMERS SAY</h2>
      <p class="ai-reviews-rating-line-{{ ai_gen_id }}">
        <span class="ai-reviews-stars-header-{{ ai_gen_id }}">⭐⭐⭐⭐⭐</span> 4.9/5 Based on 2,847 reviews
      </p>
    </div>

    <div class="ai-reviews-grid-{{ ai_gen_id }}">
      <div class="ai-review-card-{{ ai_gen_id }}">
        <div class="ai-review-stars-{{ ai_gen_id }}">⭐⭐⭐⭐⭐</div>
        <p class="ai-review-text-{{ ai_gen_id }}">"No more afternoon crashes. I actually have energy to cook dinner now instead of ordering takeout."</p>
        <p class="ai-review-author-{{ ai_gen_id }}">— Michael R.</p>
        <p class="ai-review-meta-{{ ai_gen_id }}">Using 5 months · <span class="ai-review-verified-{{ ai_gen_id }}">✔ VERIFIED PURCHASE</span></p>
      </div>

      <div class="ai-review-card-{{ ai_gen_id }}">
        <div class="ai-review-stars-{{ ai_gen_id }}">⭐⭐⭐⭐⭐</div>
        <p class="ai-review-text-{{ ai_gen_id }}">"My stomach feels so much better. No more bloating after lunch. Wish I found this sooner."</p>
        <p class="ai-review-author-{{ ai_gen_id }}">— Jennifer K.</p>
        <p class="ai-review-meta-{{ ai_gen_id }}">Using 4 months · <span class="ai-review-verified-{{ ai_gen_id }}">✔ VERIFIED PURCHASE</span></p>
      </div>

      <div class="ai-review-card-{{ ai_gen_id }}">
        <div class="ai-review-stars-{{ ai_gen_id }}">⭐⭐⭐⭐⭐</div>
        <p class="ai-review-text-{{ ai_gen_id }}">"I don't crave sugar like I used to. And I feel more steady all day. Game changer."</p>
        <p class="ai-review-author-{{ ai_gen_id }}">— Sarah T.</p>
        <p class="ai-review-meta-{{ ai_gen_id }}">Using 3 months · <span class="ai-review-verified-{{ ai_gen_id }}">✔ VERIFIED PURCHASE</span></p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Customer reviews"
    }
  ]
}
{% endschema %}
