{% doc %}
  @prompt
    Create a “Science & Research” section identical to the reference visual.
    
    Do NOT change any wording, punctuation, capitalization, spacing, colors, layout proportions, or structure.
    
    The final result must visually match the reference exactly.
    
    🔹 TOP SECTION CONTENT (Static)
    
    Centered section title:
    
    Science & Research
    
    Paragraph below (keep text exactly as written):
    
    BPC is being actively researched for its potential role in tissue regeneration and repair. Emerging studies suggest it may help accelerate the body's natural recovery processes by stimulating fibroblast activity—key cells involved in forming new connective tissue. This can be especially beneficial for muscles, tendons, and ligaments, where quicker regeneration and reduced scarring are vital to effective healing. Though more research is underway, BPC continues to gain attention as a promising option in the realm of recovery and tissue support.
    
    🔹 ORANGE SECTION (MANDATORY SLIDER)
    
    The orange resource cards must be implemented as a horizontal slider / carousel.
    
    Requirements:
    
    Each orange card represents one slide
    
    Slides scroll horizontally
    
    Smooth sliding transition
    
    Navigation arrows on left and right
    
    Pagination dots below the slider (as shown)
    
    Active dot highlighted
    
    Slider must be touch/swipe enabled on mobile
    
    No page reload
    
    Infinite loop optional but smooth
    
    🔹 SLIDE CONTENT (Keep exactly as written)
    
    Each slide contains:
    
    Label:
    Resources:
    
    Study citation text (keep exactly as shown)
    
    Link:
    Link to Study →
    
    🔹 DESIGN REQUIREMENTS
    
    Background: light grey
    
    Title color: red
    
    Paragraph color: dark grey
    
    Slide cards:
    
    Bright orange background
    
    White text
    
    Rounded corners
    
    Generous padding
    
    No redesign
    
    No additional effects
    
    No color changes
    
    Maintain spacing exactly
    
    🔹 LAYOUT
    
    Desktop:
    
    Show 3 slides partially visible or 3 per view depending on spacing
    
    Horizontal sliding behavior
    
    Tablet:
    
    Show 2 per view
    
    Mobile:
    
    Show 1 per view
    
    Full swipe support
    
    🔹 RESPONSIVE RULES
    
    Title scales smoothly
    
    Paragraph wraps naturally
    
    Slider remains functional on all devices
    
    Arrows and dots remain aligned
    
    Maintain clean spacing
    
    🔹 TECHNICAL REQUIREMENTS
    
    Semantic HTML
    
    Use CSS + minimal JavaScript
    
    No heavy external libraries
    
    Shopify Dawn compatible
    
    Lightweight implementation
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-science-research-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
  }

  .ai-science-research-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-science-research-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 24px;
    font-weight: 700;
  }

  .ai-science-research-description-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0 auto 48px;
    max-width: 900px;
  }

  .ai-science-research-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 50px;
  }

  .ai-science-research-slider-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    transition: transform 0.4s ease;
    touch-action: pan-y;
  }

  .ai-science-research-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 14px);
    background-color: {{ block.settings.slide_bg_color }};
    border-radius: {{ block.settings.slide_border_radius }}px;
    padding: 30px;
    color: {{ block.settings.slide_text_color }};
    box-sizing: border-box;
  }

  .ai-science-research-slide-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .ai-science-research-slide-text-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 20px;
  }

  .ai-science-research-slide-link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.slide_text_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-bottom: 1px solid {{ block.settings.slide_text_color }};
    padding-bottom: 2px;
  }

  .ai-science-research-slide-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-science-research-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease;
  }

  .ai-science-research-arrow-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.7);
  }

  .ai-science-research-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-science-research-arrow-prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-science-research-arrow-next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-science-research-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .ai-science-research-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #ccc;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-science-research-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.slide_bg_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-science-research-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 10px);
    }

    .ai-science-research-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-science-research-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-science-research-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-science-research-slider-wrapper-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-science-research-arrow-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-science-research-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-science-research-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.85);
    }
  }
{% endstyle %}

<science-research-slider-{{ ai_gen_id }} class="ai-science-research-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-science-research-container-{{ ai_gen_id }}">
    <h2 class="ai-science-research-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    
    <div class="ai-science-research-description-{{ ai_gen_id }}">
      {{ block.settings.description }}
    </div>

    <div class="ai-science-research-slider-wrapper-{{ ai_gen_id }}">
      <button 
        class="ai-science-research-arrow-{{ ai_gen_id }} ai-science-research-arrow-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
        data-direction="prev"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-science-research-slider-{{ ai_gen_id }}" data-slider>
        {% for i in (1..6) %}
          {% liquid
            assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
            assign slide_text_key = 'slide_' | append: i | append: '_text'
            assign slide_link_key = 'slide_' | append: i | append: '_link'
            
            assign slide_enabled = block.settings[slide_enabled_key]
            assign slide_text = block.settings[slide_text_key]
            assign slide_link = block.settings[slide_link_key]
          %}

          {% if slide_enabled %}
            <div class="ai-science-research-slide-{{ ai_gen_id }}">
              <div class="ai-science-research-slide-label-{{ ai_gen_id }}">Resources:</div>
              <div class="ai-science-research-slide-text-{{ ai_gen_id }}">{{ slide_text }}</div>
              {% if slide_link != blank %}
                <a href="{{ slide_link }}" class="ai-science-research-slide-link-{{ ai_gen_id }}" target="_blank" rel="noopener">
                  Link to Study →
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button 
        class="ai-science-research-arrow-{{ ai_gen_id }} ai-science-research-arrow-next-{{ ai_gen_id }}"
        aria-label="Next slide"
        data-direction="next"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-science-research-dots-{{ ai_gen_id }}" data-dots></div>
  </div>
</science-research-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ScienceResearchSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = 3;
        this.touchStartX = 0;
        this.touchEndX = 0;
      }

      connectedCallback() {
        this.slider = this.querySelector('[data-slider]');
        this.slides = Array.from(this.slider.children);
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');
        this.dotsContainer = this.querySelector('[data-dots]');

        this.updateSlidesPerView();
        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
      }

      updateSlidesPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.slidesPerView = 1;
        } else if (width <= 989) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 3;
        }
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const totalDots = Math.max(0, this.slides.length - this.slidesPerView + 1);
        
        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-science-research-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
        this.updateDots();
      }

      updateDots() {
        const dots = this.dotsContainer.querySelectorAll('.ai-science-research-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      updateSlider() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = 20;
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.slider.style.transform = `translateX(${offset}px)`;

        const maxIndex = Math.max(0, this.slides.length - this.slidesPerView);
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
        
        this.updateDots();
      }

      goToSlide(index) {
        const maxIndex = Math.max(0, this.slides.length - this.slidesPerView);
        this.currentIndex = Math.max(0, Math.min(index, maxIndex));
        this.updateSlider();
      }

      next() {
        const maxIndex = Math.max(0, this.slides.length - this.slidesPerView);
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateSlider();
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
        }
      }

      handleTouchStart(e) {
        this.touchStartX = e.touches[0].clientX;
      }

      handleTouchMove(e) {
        this.touchEndX = e.touches[0].clientX;
      }

      handleTouchEnd() {
        const swipeThreshold = 50;
        const diff = this.touchStartX - this.touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.next();
          } else {
            this.prev();
          }
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        this.slider.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: true });
        this.slider.addEventListener('touchmove', (e) => this.handleTouchMove(e), { passive: true });
        this.slider.addEventListener('touchend', () => this.handleTouchEnd());

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.currentIndex = 0;
          this.createDots();
          this.updateSlider();
        });
      }
    }

    customElements.define('science-research-slider-{{ ai_gen_id }}', ScienceResearchSlider{{ ai_gen_id }});
  })();
</script>

