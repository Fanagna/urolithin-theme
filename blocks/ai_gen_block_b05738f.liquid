{% doc %}
  @prompt
    PROMPT SHOPIFY MAGIC (copier-coller tel quel)
    
    Create a centered, premium dark-mode feature list section that uses the exact same container width as all previous sections on the page.
    Important: The outer container must reuse the same width rules (same max-width, same horizontal padding, same centering) as the previous sections. Do NOT extend the section wider or narrower.
    
    Do not change the structure, wording, order, or hierarchy of the content. Keep the section vertically compact and visually consistent with the earlier cards.
    
    Layout & styling rules:
    
    Same outer card width and padding as previous sections
    
    Rounded container with subtle gradient background
    
    Soft shadow and thin border
    
    Each item displayed as a horizontal row with icon on the left and text on the right
    
    Consistent spacing between rows (not taller than previous sections)
    
    Clean, premium, biohacker/SaaS aesthetic
    
    Title (centered at top, do not edit):
    Why This Guide Is Different
    
    Feature items (do not edit text):
    
    Research-Backed
    No bro-science. Every recommendation is based on actual studies and athlete case reports.
    
    Actionable Protocols
    Not just theory. Step-by-step instructions you can implement today.
    
    Covers BPC-157 Capsules
    Learn about the oral alternative to injections — easier, more convenient, no needles.
    
    Includes 30% Discount
    Exclusive code for Panstellar products. Save on your first order of BPC-157 capsules.
    
    Do not add icons beyond simple left-aligned icons, no buttons, no animations, and no additional copy.
    Keep the section width identical to the previous sections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-list-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-feature-list-container-{{ ai_gen_id }} {
    background: {{ block.settings.background_gradient }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-feature-list-title-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-feature-list-items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-feature-list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-feature-list-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-feature-list-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ block.settings.icon_color }};
    stroke-width: 2;
  }

  .ai-feature-list-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-feature-list-item-title-{{ ai_gen_id }} {
    color: {{ block.settings.item_title_color }};
    font-size: {{ block.settings.item_title_size }}px;
    font-weight: 600;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .ai-feature-list-item-description-{{ ai_gen_id }} {
    color: {{ block.settings.item_description_color }};
    font-size: {{ block.settings.item_description_size }}px;
    margin: 0;
    line-height: 1.5;
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-list-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-feature-list-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.7 }}px;
    }

    .ai-feature-list-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-feature-list-item-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_title_size | times: 0.9 }}px;
    }

    .ai-feature-list-item-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-list-container-{{ ai_gen_id }}">
    <h2 class="ai-feature-list-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    
    <div class="ai-feature-list-items-{{ ai_gen_id }}">
      {% if block.settings.feature_1_title != blank %}
        <div class="ai-feature-list-item-{{ ai_gen_id }}">
          <div class="ai-feature-list-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="ai-feature-list-text-{{ ai_gen_id }}">
            <h3 class="ai-feature-list-item-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
            <p class="ai-feature-list-item-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description }}</p>
          </div>
        </div>
      {% endif %}

      {% if block.settings.feature_2_title != blank %}
        <div class="ai-feature-list-item-{{ ai_gen_id }}">
          <div class="ai-feature-list-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="ai-feature-list-text-{{ ai_gen_id }}">
            <h3 class="ai-feature-list-item-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
            <p class="ai-feature-list-item-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
          </div>
        </div>
      {% endif %}

      {% if block.settings.feature_3_title != blank %}
        <div class="ai-feature-list-item-{{ ai_gen_id }}">
          <div class="ai-feature-list-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="ai-feature-list-text-{{ ai_gen_id }}">
            <h3 class="ai-feature-list-item-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
            <p class="ai-feature-list-item-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
          </div>
        </div>
      {% endif %}

      {% if block.settings.feature_4_title != blank %}
        <div class="ai-feature-list-item-{{ ai_gen_id }}">
          <div class="ai-feature-list-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="ai-feature-list-text-{{ ai_gen_id }}">
            <h3 class="ai-feature-list-item-title-{{ ai_gen_id }}">{{ block.settings.feature_4_title }}</h3>
            <p class="ai-feature-list-item-description-{{ ai_gen_id }}">{{ block.settings.feature_4_description }}</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

