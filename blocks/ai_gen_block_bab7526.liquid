{% doc %}
  @prompt
    Create a two-column informational section identical to the reference layout.
    
    Do NOT change any text, wording, punctuation, emojis, colors, font weight, or hierarchy.
    
    LEFT COLUMN (text content – must remain exactly the same):
    
    Title:
    SOUND FAMILIAR?
    
    Subtitle:
    You eat well, but your gut and energy take a hit from modern life.
    
    Section title:
    HERE'S WHAT HAPPENS:
    
    Bullet list (keep red dots):
    
    Energy crashes (hello, 3pm slump)
    
    Cravings you can't control
    
    Bloating after meals
    
    Feeling “off” all day
    
    Never quite satisfied
    
    Footer line:
    ☕ Coffee is just a band-aid. → There's a better way.
    
    RIGHT COLUMN (image placeholder):
    
    Light grey background
    
    Dashed border
    
    Rounded corners
    
    Centered icon + text: “INSERT IMAGE HERE”
    
    Acts as an image container (no actual image required)
    
    Design & layout requirements:
    
    Clean, modern, editorial layout
    
    Left-aligned text
    
    Comfortable spacing between sections
    
    Professional, premium supplement-brand look
    
    Responsiveness (very important):
    
    Desktop: two-column layout (text left, image right)
    
    Tablet: maintain two columns with reduced gap
    
    Mobile:
    
    Stack columns vertically
    
    Text block first, image block below
    
    Image placeholder becomes full width
    
    No overflow, no horizontal scroll
    
    Technical constraints:
    
    Use semantic HTML
    
    Use CSS Flexbox or CSS Grid
    
    Mobile-first responsive design
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting layout for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-info-section__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .ai-info-section__text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-info-section__title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: {{ block.settings.title_color }};
    text-align: left;
  }

  .ai-info-section__subtitle-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-info-section__section-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    margin: 16px 0 0 0;
    color: {{ block.settings.text_color }};
    text-align: left;
    letter-spacing: 0.5px;
  }

  .ai-info-section__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-info-section__list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-info-section__bullet-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.bullet_color }};
    flex-shrink: 0;
    margin-top: 8px;
  }

  .ai-info-section__footer-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    margin: 16px 0 0 0;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-info-section__image-column-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-info-section__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: {{ block.settings.placeholder_bg_color }};
    border: 2px dashed {{ block.settings.placeholder_border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px;
  }

  .ai-info-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 48px;
    height: 48px;
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-info-section__placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.placeholder_text_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-info-section__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-info-section__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-info-section__container-{{ ai_gen_id }} {
      gap: 32px;
    }

    .ai-info-section__title-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-info-section__subtitle-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-info-section-{{ ai_gen_id }} {
      padding: 32px 16px;
    }

    .ai-info-section__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-info-section__title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-info-section__subtitle-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-info-section__list-item-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .ai-info-section__footer-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .ai-info-section__image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 16 / 9;
      padding: 32px;
    }
  }
{% endstyle %}

<div class="ai-info-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-info-section__container-{{ ai_gen_id }}">
    <div class="ai-info-section__text-column-{{ ai_gen_id }}">
      <h2 class="ai-info-section__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      
      <p class="ai-info-section__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      
      <h3 class="ai-info-section__section-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h3>
      
      <ul class="ai-info-section__list-{{ ai_gen_id }}">
        {% if block.settings.list_item_1 != blank %}
          <li class="ai-info-section__list-item-{{ ai_gen_id }}">
            <span class="ai-info-section__bullet-{{ ai_gen_id }}"></span>
            <span>{{ block.settings.list_item_1 }}</span>
          </li>
        {% endif %}
        {% if block.settings.list_item_2 != blank %}
          <li class="ai-info-section__list-item-{{ ai_gen_id }}">
            <span class="ai-info-section__bullet-{{ ai_gen_id }}"></span>
            <span>{{ block.settings.list_item_2 }}</span>
          </li>
        {% endif %}
        {% if block.settings.list_item_3 != blank %}
          <li class="ai-info-section__list-item-{{ ai_gen_id }}">
            <span class="ai-info-section__bullet-{{ ai_gen_id }}"></span>
            <span>{{ block.settings.list_item_3 }}</span>
          </li>
        {% endif %}
        {% if block.settings.list_item_4 != blank %}
          <li class="ai-info-section__list-item-{{ ai_gen_id }}">
            <span class="ai-info-section__bullet-{{ ai_gen_id }}"></span>
            <span>{{ block.settings.list_item_4 }}</span>
          </li>
        {% endif %}
        {% if block.settings.list_item_5 != blank %}
          <li class="ai-info-section__list-item-{{ ai_gen_id }}">
            <span class="ai-info-section__bullet-{{ ai_gen_id }}"></span>
            <span>{{ block.settings.list_item_5 }}</span>
          </li>
        {% endif %}
      </ul>
      
      <p class="ai-info-section__footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
    </div>

    <div class="ai-info-section__image-column-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <div class="ai-info-section__image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        </div>
      {% else %}
        <div class="ai-info-section__image-placeholder-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="ai-info-section__placeholder-text-{{ ai_gen_id }}">INSERT IMAGE HERE</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two column info section",
  "settings": [
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SOUND FAMILIAR?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "You eat well, but your gut and energy take a hit from modern life."
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "HERE'S WHAT HAPPENS:"
    },
    {
      "type": "text",
      "id": "list_item_1",
      "label": "List item 1",
      "default": "Energy crashes (hello, 3pm slump)"
    },
    {
      "type": "text",
      "id": "list_item_2",
      "label": "List item 2",
      "default": "Cravings you can't control"
    },
    {
      "type": "text",
      "id": "list_item_3",
      "label": "List item 3",
      "default": "Bloating after meals"
    },
    {
      "type": "text",
      "id": "list_item_4",
      "label": "List item 4",
      "default": "Feeling \"off\" all day"
    },
    {
      "type": "text",
      "id": "list_item_5",
      "label": "List item 5",
      "default": "Never quite satisfied"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "☕ Coffee is just a band-aid. → There's a better way."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet color",
      "default": "#DC2626"
    },
    {
      "type": "color",
      "id": "placeholder_bg_color",
      "label": "Placeholder background",
      "default": "#F3F4F6"
    },
    {
      "type": "color",
      "id": "placeholder_border_color",
      "label": "Placeholder border",
      "default": "#D1D5DB"
    },
    {
      "type": "color",
      "id": "placeholder_icon_color",
      "label": "Placeholder icon",
      "default": "#9CA3AF"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Placeholder text",
      "default": "#6B7280"
    }
  ],
  "presets": [
    {
      "name": "Two column info section"
    }
  ]
}
{% endschema %}
