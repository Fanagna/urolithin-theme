{% doc %}
  @prompt
    Generate a clean, premium two-card ingredient section identical to the reference layout.
    
    ⚠️ Do NOT change any text, wording, punctuation, icons, emojis, font sizes, colors, spacing, or hierarchy.
    ⚠️ Do NOT rewrite, summarize, or optimize copy.
    
    SECTION HEADER (centered)
    
    Title:
    ⚡ THE DAILY STACK FOR ENERGY + GUT COMFORT
    
    Subtitle:
    Two ingredients that work together to support your natural energy and digestive wellness.
    
    LAYOUT
    
    Display two cards side by side on desktop.
    
    CARD 1 (LEFT)
    
    Image placeholder (top of card):
    
    Light grey background
    
    Dashed border
    
    Rounded corners
    
    Centered icon + text: INSERT IMAGE HERE
    
    Title:
    INGREDIENT 1: BERBERINE
    
    Text:
    What it does: Supports your body's natural energy production*
    
    Users report:
    
    Steadier energy
    
    Fewer cravings
    
    Better focus
    
    Badge (pill style, green):
    2000mg per serving
    
    CARD 2 (RIGHT)
    
    Image placeholder:
    Same size, style, and alignment as Card 1
    
    Title:
    INGREDIENT 2: AKKERMANSIA
    
    Text:
    What it does: Supports a healthy gut lining and balanced microbiome
    
    Users report:
    
    Less bloating
    
    Better digestion
    
    More comfortable after meals
    
    Badge (pill style, green):
    500 billion CFU
    
    DESIGN RULES
    
    White background
    
    Clean, modern, premium supplement-brand aesthetic
    
    Subtle card border or shadow
    
    Consistent padding and spacing inside cards
    
    Green accent color for ingredient titles and badges (same shade as reference)
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: two cards side by side
    
    Tablet: two cards with reduced spacing
    
    Mobile:
    
    Stack cards vertically
    
    Full-width cards
    
    Image placeholder scales proportionally
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use CSS Grid or Flexbox
    
    Mobile-first responsive CSS
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting layout for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredient-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
  }

  .ai-ingredient-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-ingredient-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-ingredient-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-ingredient-subtitle-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-ingredient-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .ai-ingredient-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-ingredient-image-placeholder-{{ ai_gen_id }} {
    background-color: {{ block.settings.placeholder_bg }};
    border: 2px dashed {{ block.settings.placeholder_border }};
    border-radius: {{ block.settings.placeholder_radius }}px;
    padding: 48px 24px;
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .ai-ingredient-image-placeholder-{{ ai_gen_id }} svg {
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-ingredient-placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.placeholder_text_color }};
    font-weight: 500;
  }

  .ai-ingredient-card-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: {{ block.settings.ingredient_title_color }};
    margin: 0 0 16px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-ingredient-card-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .ai-ingredient-card-text-{{ ai_gen_id }} strong {
    font-weight: 600;
  }

  .ai-ingredient-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 16px 0;
  }

  .ai-ingredient-list-{{ ai_gen_id }} li {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    padding-left: 24px;
    position: relative;
    margin-bottom: 8px;
  }

  .ai-ingredient-list-{{ ai_gen_id }} li:before {
    content: "•";
    position: absolute;
    left: 8px;
    color: {{ block.settings.ingredient_title_color }};
    font-weight: 700;
  }

  .ai-ingredient-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin-top: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-ingredient-cards-{{ ai_gen_id }} {
      gap: 24px;
    }

    .ai-ingredient-title-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-ingredient-subtitle-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ingredient-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-ingredient-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-ingredient-card-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-ingredient-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-ingredient-subtitle-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .ai-ingredient-image-placeholder-{{ ai_gen_id }} {
      min-height: 180px;
      padding: 36px 20px;
    }
  }
{% endstyle %}

<div class="ai-ingredient-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredient-container-{{ ai_gen_id }}">
    <div class="ai-ingredient-header-{{ ai_gen_id }}">
      <h2 class="ai-ingredient-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      <p class="ai-ingredient-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
    </div>

    <div class="ai-ingredient-cards-{{ ai_gen_id }}">
      <div class="ai-ingredient-card-{{ ai_gen_id }}">
        {% if block.settings.card_1_image %}
          <img
            src="{{ block.settings.card_1_image | image_url: width: 600 }}"
            alt="{{ block.settings.card_1_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.card_1_image.width }}"
            height="{{ block.settings.card_1_image.height }}"
            style="width: 100%; height: auto; border-radius: {{ block.settings.placeholder_radius }}px; margin-bottom: 24px;"
          >
        {% else %}
          <div class="ai-ingredient-image-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="ai-ingredient-placeholder-text-{{ ai_gen_id }}">INSERT IMAGE HERE</span>
          </div>
        {% endif %}

        <h3 class="ai-ingredient-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
        <div class="ai-ingredient-card-text-{{ ai_gen_id }}">
          <strong>What it does:</strong> {{ block.settings.card_1_description }}
        </div>
        <div class="ai-ingredient-card-text-{{ ai_gen_id }}">
          <strong>Users report:</strong>
        </div>
        <ul class="ai-ingredient-list-{{ ai_gen_id }}">
          <li>{{ block.settings.card_1_benefit_1 }}</li>
          <li>{{ block.settings.card_1_benefit_2 }}</li>
          <li>{{ block.settings.card_1_benefit_3 }}</li>
        </ul>
        <span class="ai-ingredient-badge-{{ ai_gen_id }}">{{ block.settings.card_1_badge }}</span>
      </div>

      <div class="ai-ingredient-card-{{ ai_gen_id }}">
        {% if block.settings.card_2_image %}
          <img
            src="{{ block.settings.card_2_image | image_url: width: 600 }}"
            alt="{{ block.settings.card_2_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.card_2_image.width }}"
            height="{{ block.settings.card_2_image.height }}"
            style="width: 100%; height: auto; border-radius: {{ block.settings.placeholder_radius }}px; margin-bottom: 24px;"
          >
        {% else %}
          <div class="ai-ingredient-image-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="ai-ingredient-placeholder-text-{{ ai_gen_id }}">INSERT IMAGE HERE</span>
          </div>
        {% endif %}

        <h3 class="ai-ingredient-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
        <div class="ai-ingredient-card-text-{{ ai_gen_id }}">
          <strong>What it does:</strong> {{ block.settings.card_2_description }}
        </div>
        <div class="ai-ingredient-card-text-{{ ai_gen_id }}">
          <strong>Users report:</strong>
        </div>
        <ul class="ai-ingredient-list-{{ ai_gen_id }}">
          <li>{{ block.settings.card_2_benefit_1 }}</li>
          <li>{{ block.settings.card_2_benefit_2 }}</li>
          <li>{{ block.settings.card_2_benefit_3 }}</li>
        </ul>
        <span class="ai-ingredient-badge-{{ ai_gen_id }}">{{ block.settings.card_2_badge }}</span>
      </div>
    </div>
  </div>
</div>

