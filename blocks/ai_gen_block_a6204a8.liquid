{% doc %}
  @prompt
    genere moi une section contenant un titre(entré au centre) 
    juste ne dessous 3  multicolonnes avec un titre et liste puis une ligne de séparation
    en desous du ligne se trouve le prix barré et le prix;
    un text en orange; un boutton add To cart et enfin des icons (cadena,garenty,truck) avec des text à coté. tous les contenant de cette section sont centré au centre
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-section-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pricing-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 40px;
  }

  .ai-pricing-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto 30px;
  }

  .ai-pricing-column-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-pricing-column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    color: {{ block.settings.column_title_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-pricing-column-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-pricing-column-list-{{ ai_gen_id }} li {
    font-size: {{ block.settings.list_item_size }}px;
    color: {{ block.settings.list_item_color }};
    margin-bottom: 8px;
  }

  .ai-pricing-separator-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1200px;
    height: 1px;
    background-color: {{ block.settings.separator_color }};
    margin: 30px auto;
  }

  .ai-pricing-content-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-pricing-prices-{{ ai_gen_id }} {
    margin-bottom: 15px;
  }

  .ai-pricing-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    margin-right: 10px;
  }

  .ai-pricing-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-pricing-highlight-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.highlight_text_size }}px;
    color: {{ block.settings.highlight_text_color }};
    margin-bottom: 20px;
    font-weight: 600;
  }

  .ai-pricing-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 15px 40px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    border: none;
    cursor: pointer;
    margin-bottom: 25px;
    transition: background-color 0.3s ease;
  }

  .ai-pricing-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-pricing-features-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .ai-pricing-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-pricing-feature-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-pricing-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-pricing-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-pricing-features-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
    }
  }
{% endstyle %}

<div class="ai-pricing-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_title != blank %}
    <h2 class="ai-pricing-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
  {% endif %}

  <div class="ai-pricing-columns-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign column_title_key = 'column_' | append: i | append: '_title'
        assign column_list_key = 'column_' | append: i | append: '_list'
        assign column_title = block.settings[column_title_key]
        assign column_list = block.settings[column_list_key]
      %}
      <div class="ai-pricing-column-{{ ai_gen_id }}">
        {% if column_title != blank %}
          <h3 class="ai-pricing-column-title-{{ ai_gen_id }}">{{ column_title }}</h3>
        {% endif %}
        {% if column_list != blank %}
          <ul class="ai-pricing-column-list-{{ ai_gen_id }}">
            {% assign list_items = column_list | split: ',' %}
            {% for item in list_items %}
              <li>{{ item | strip }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-pricing-separator-{{ ai_gen_id }}"></div>

  <div class="ai-pricing-content-{{ ai_gen_id }}">
    <div class="ai-pricing-prices-{{ ai_gen_id }}">
      {% if block.settings.compare_price != blank %}
        <span class="ai-pricing-compare-price-{{ ai_gen_id }}">{{ block.settings.compare_price }}</span>
      {% endif %}
      {% if block.settings.price != blank %}
        <span class="ai-pricing-price-{{ ai_gen_id }}">{{ block.settings.price }}</span>
      {% endif %}
    </div>

    {% if block.settings.highlight_text != blank %}
      <div class="ai-pricing-highlight-text-{{ ai_gen_id }}">{{ block.settings.highlight_text }}</div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <button class="ai-pricing-button-{{ ai_gen_id }}" type="button">
        {{ block.settings.button_text }}
      </button>
    {% endif %}

    <div class="ai-pricing-features-{{ ai_gen_id }}">
      <div class="ai-pricing-feature-{{ ai_gen_id }}">
        <svg class="ai-pricing-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="ai-pricing-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</span>
      </div>

      <div class="ai-pricing-feature-{{ ai_gen_id }}">
        <svg class="ai-pricing-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span class="ai-pricing-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</span>
      </div>

      <div class="ai-pricing-feature-{{ ai_gen_id }}">
        <svg class="ai-pricing-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <span class="ai-pricing-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</span>
      </div>
    </div>
  </div>
</div>

