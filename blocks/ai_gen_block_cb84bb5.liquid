{% doc %}
  @prompt
    Créer moi une section contenant un titre, une paragraphe, et un sous titre (sachant que tous les contenues de de cette section soient centré au centre)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-centered-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-centered-content__wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
  }

  .ai-centered-content__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 700;
  }

  .ai-centered-content__paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    color: {{ block.settings.paragraph_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-centered-content__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-centered-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 16px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-centered-content__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-centered-content__paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.paragraph_size | times: 0.9 }}px;
    }

    .ai-centered-content__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-centered-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-centered-content__wrapper-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-centered-content__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h2>
    {% endif %}

    {% if block.settings.paragraph != blank %}
      <div class="ai-centered-content__paragraph-{{ ai_gen_id }}">
        {{ block.settings.paragraph }}
      </div>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <h3 class="ai-centered-content__subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle }}
      </h3>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contenu centré",
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titre",
      "default": "Votre titre principal"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraphe",
      "default": "<p>Votre texte descriptif ici. Ajoutez autant de détails que nécessaire pour communiquer votre message.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Votre sous-titre"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Largeur du contenu",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Espacement inférieur",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Paragraphe"
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "label": "Taille",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Couleur",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Espacement inférieur",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Sous-titre"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Taille",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Couleur",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement supérieur",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement inférieur",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Contenu centré"
    }
  ]
}
{% endschema %}
