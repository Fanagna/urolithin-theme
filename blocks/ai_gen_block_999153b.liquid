{% doc %}
  @prompt
    Create a section exactly matching the provided visual, structure, colors, and content. Do not rewrite, paraphrase, or add anything.
    
    Design & visual requirements:
    
    Clean, modern, premium layout
    
    White/light background
    
    Minimalist, science-driven aesthetic
    
    Rounded cards with subtle shadows
    
    Soft accent colors (blue for morning, purple for evening, green for later timeline)
    
    Desktop-first, fully responsive on mobile
    
    Use simple, friendly icons (clipboard, sun, moon, clock)
    
    Top section title (centered, exact text):
    📋 HOW TO USE
    Subtitle (smaller, exact text):
    SIMPLE & SUSTAINABLE
    
    Usage layout (two columns):
    
    Left column — MORNING:
    
    Icon: morning / sun
    
    Title: MORNING
    
    Card content (exact text):
    
    NAD+ Complex
    
    → 2 capsules with food
    
    Right column — EVENING:
    
    Icon: evening / moon
    
    Title: EVENING
    
    Card content (exact text):
    
    Urolithin A
    
    → 2 capsules with food
    
    Divider line between sections
    
    Second section title (centered):
    ⏱️ TIMELINE
    
    Timeline layout (three cards, horizontal):
    
    Card 1 (blue accent):
    
    Week 1–2
    
    Subtle energy improvements
    
    Card 2 (purple accent):
    
    Week 3–4
    
    Noticeable sustained energy & mental clarity
    
    Card 3 (green accent):
    
    Week 8–12
    
    Full cellular optimization
    
    Footer note (centered, subtle, exact text):
    💡 Consistency > timing. Recommended cycle: 60–90 days.
    
    Additional constraints:
    
    Do NOT change any wording
    
    Do NOT add claims, CTAs, pricing, or testimonials
    
    Keep spacing, alignment, and hierarchy clean and balanced
    
    Visual style must match a premium longevity / biohacking brand
    
    Goal:
    Clearly explain daily usage and expected timeline in a simple, trustworthy, and visually calming way.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-usage-guide-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-usage-guide-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-usage-guide-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-usage-guide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
  }

  .ai-usage-guide-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 500;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .ai-usage-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 48px;
  }

  .ai-usage-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 32px 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    text-align: center;
  }

  .ai-usage-icon-{{ ai_gen_id }} {
    font-size: 40px;
    margin-bottom: 16px;
    display: block;
  }

  .ai-usage-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-usage-card-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-usage-card-content-{{ ai_gen_id }} p {
    margin: 0 0 8px 0;
  }

  .ai-usage-card-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-usage-divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: 48px 0;
    opacity: 0.2;
  }

  .ai-timeline-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeline_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    letter-spacing: 0.5px;
  }

  .ai-timeline-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .ai-timeline-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 24px 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    text-align: center;
    position: relative;
  }

  .ai-timeline-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: {{ block.settings.card_radius }}px {{ block.settings.card_radius }}px 0 0;
  }

  .ai-timeline-card-{{ ai_gen_id }}.ai-timeline-card-blue-{{ ai_gen_id }}::before {
    background-color: {{ block.settings.timeline_accent_1 }};
  }

  .ai-timeline-card-{{ ai_gen_id }}.ai-timeline-card-purple-{{ ai_gen_id }}::before {
    background-color: {{ block.settings.timeline_accent_2 }};
  }

  .ai-timeline-card-{{ ai_gen_id }}.ai-timeline-card-green-{{ ai_gen_id }}::before {
    background-color: {{ block.settings.timeline_accent_3 }};
  }

  .ai-timeline-period-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeline_period_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeline_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-usage-footer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.footer_size }}px;
    color: {{ block.settings.footer_color }};
    margin-top: 32px;
  }

  @media screen and (max-width: 749px) {
    .ai-usage-guide-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-usage-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }

    .ai-timeline-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-usage-card-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-usage-guide-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-timeline-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.timeline_title_size | times: 0.8 }}px;
    }

    .ai-usage-divider-{{ ai_gen_id }} {
      margin: 32px 0;
    }
  }
{% endstyle %}

<usage-guide-{{ ai_gen_id }} class="ai-usage-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-usage-guide-container-{{ ai_gen_id }}">
    <div class="ai-usage-guide-header-{{ ai_gen_id }}">
      <h2 class="ai-usage-guide-title-{{ ai_gen_id }}">📋 HOW TO USE</h2>
      <p class="ai-usage-guide-subtitle-{{ ai_gen_id }}">SIMPLE & SUSTAINABLE</p>
    </div>

    <div class="ai-usage-grid-{{ ai_gen_id }}">
      <div class="ai-usage-card-{{ ai_gen_id }}">
        <span class="ai-usage-icon-{{ ai_gen_id }}">☀️</span>
        <h3 class="ai-usage-card-title-{{ ai_gen_id }}">MORNING</h3>
        <div class="ai-usage-card-content-{{ ai_gen_id }}">
          <p>NAD+ Complex</p>
          <p>→ 2 capsules with food</p>
        </div>
      </div>

      <div class="ai-usage-card-{{ ai_gen_id }}">
        <span class="ai-usage-icon-{{ ai_gen_id }}">🌙</span>
        <h3 class="ai-usage-card-title-{{ ai_gen_id }}">EVENING</h3>
        <div class="ai-usage-card-content-{{ ai_gen_id }}">
          <p>Urolithin A</p>
          <p>→ 2 capsules with food</p>
        </div>
      </div>
    </div>

    <div class="ai-usage-divider-{{ ai_gen_id }}"></div>

    <div class="ai-timeline-header-{{ ai_gen_id }}">
      <h2 class="ai-timeline-title-{{ ai_gen_id }}">⏱️ TIMELINE</h2>
    </div>

    <div class="ai-timeline-grid-{{ ai_gen_id }}">
      <div class="ai-timeline-card-{{ ai_gen_id }} ai-timeline-card-blue-{{ ai_gen_id }}">
        <h4 class="ai-timeline-period-{{ ai_gen_id }}">Week 1–2</h4>
        <p class="ai-timeline-description-{{ ai_gen_id }}">Subtle energy improvements</p>
      </div>

      <div class="ai-timeline-card-{{ ai_gen_id }} ai-timeline-card-purple-{{ ai_gen_id }}">
        <h4 class="ai-timeline-period-{{ ai_gen_id }}">Week 3–4</h4>
        <p class="ai-timeline-description-{{ ai_gen_id }}">Noticeable sustained energy & mental clarity</p>
      </div>

      <div class="ai-timeline-card-{{ ai_gen_id }} ai-timeline-card-green-{{ ai_gen_id }}">
        <h4 class="ai-timeline-period-{{ ai_gen_id }}">Week 8–12</h4>
        <p class="ai-timeline-description-{{ ai_gen_id }}">Full cellular optimization</p>
      </div>
    </div>

    <div class="ai-usage-footer-{{ ai_gen_id }}">
      💡 Consistency > timing. Recommended cycle: 60–90 days.
    </div>
  </div>
</usage-guide-{{ ai_gen_id }}>

<script>
  (function() {
    class UsageGuide{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('usage-guide-{{ ai_gen_id }}', UsageGuide{{ ai_gen_id }});
  })();
</script>

