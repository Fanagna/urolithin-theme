{% doc %}
  @prompt
    genere moi une section contenant un titre centrer au centre et deux blocs de text identique cote à cote contenant  un titre, prix barré       ,prix et pourcentage sauvé (sur la meme  ligne à des liste de texte ( avec tous les parametres du section) et avec la deuxieme bloc ajoute juste sur la bordure d entete best value ; avec des boutton ADD TO CARD
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pricing-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-pricing-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-weight: 700;
  }

  .ai-pricing-blocks-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.blocks_gap }}px;
    margin-top: {{ block.settings.blocks_margin_top }}px;
  }

  .ai-pricing-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.block_background }};
    border: {{ block.settings.block_border_width }}px solid {{ block.settings.block_border_color }};
    border-radius: {{ block.settings.block_border_radius }}px;
    padding: {{ block.settings.block_padding }}px;
    position: relative;
  }

  .ai-pricing-block-{{ ai_gen_id }}.has-badge::before {
    content: '{{ block.settings.badge_text }}';
    position: absolute;
    top: -1px;
    right: {{ block.settings.badge_position }}px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.badge_border_radius }}px {{ block.settings.badge_border_radius }}px 0 0;
    border: {{ block.settings.block_border_width }}px solid {{ block.settings.block_border_color }};
    border-bottom: none;
  }

  .ai-pricing-block-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
  }

  .ai-pricing-block-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.block_title_size }}px;
    color: {{ block.settings.block_title_color }};
    margin: 0 0 {{ block.settings.block_title_margin }}px;
    font-weight: 600;
  }

  .ai-pricing-price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.price_gap }}px;
    flex-wrap: wrap;
  }

  .ai-pricing-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-pricing-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-pricing-savings-{{ ai_gen_id }} {
    font-size: {{ block.settings.savings_size }}px;
    color: {{ block.settings.savings_color }};
    background-color: {{ block.settings.savings_background }};
    padding: {{ block.settings.savings_padding_vertical }}px {{ block.settings.savings_padding_horizontal }}px;
    border-radius: {{ block.settings.savings_border_radius }}px;
    font-weight: 600;
  }

  .ai-pricing-features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.features_margin_bottom }}px;
  }

  .ai-pricing-feature-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_size }}px;
    color: {{ block.settings.feature_color }};
    padding: {{ block.settings.feature_padding }}px 0;
    border-bottom: 1px solid {{ block.settings.feature_divider_color }};
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-pricing-feature-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-pricing-feature-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .ai-pricing-button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: block;
    transition: background-color 0.3s ease;
  }

  .ai-pricing-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-pricing-blocks-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-pricing-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-pricing-block-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.block_title_size }}px * 0.9);
    }
  }
{% endstyle %}

