{% doc %}
  @prompt
    Create a CSS code block that makes the delete/trash icon permanently visible in the cart instead of only showing on hover. The icon should always be displayed next to cart items so customers can easily remove products.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-remove-visible-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-cart-remove-visible-{{ ai_gen_id }} cart-remove-button {
    opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }} !important;
    visibility: visible !important;
  }

  .ai-cart-remove-visible-{{ ai_gen_id }} .cart-item__remove {
    opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }} !important;
    visibility: visible !important;
  }

  .ai-cart-remove-visible-{{ ai_gen_id }} .cart-remove-button {
    opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }} !important;
    visibility: visible !important;
  }

  .ai-cart-remove-visible-{{ ai_gen_id }} [class*="remove"] button,
  .ai-cart-remove-visible-{{ ai_gen_id }} [class*="remove"] a {
    opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }} !important;
    visibility: visible !important;
  }

  {% if block.settings.apply_to_drawer %}
    cart-drawer .cart-item cart-remove-button,
    cart-drawer .cart-item .cart-item__remove,
    cart-drawer .cart-item .cart-remove-button,
    cart-drawer .cart-item [class*="remove"] button,
    cart-drawer .cart-item [class*="remove"] a {
      opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }} !important;
      visibility: visible !important;
    }
  {% endif %}

  {% if block.settings.apply_to_page %}
    .cart-items cart-remove-button,
    .cart-items .cart-item__remove,
    .cart-items .cart-remove-button,
    .cart-items [class*="remove"] button,
    .cart-items [class*="remove"] a {
      opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }} !important;
      visibility: visible !important;
    }
  {% endif %}

  {% if block.settings.custom_color_enabled %}
    .ai-cart-remove-visible-{{ ai_gen_id }} cart-remove-button svg,
    .ai-cart-remove-visible-{{ ai_gen_id }} .cart-item__remove svg,
    .ai-cart-remove-visible-{{ ai_gen_id }} .cart-remove-button svg,
    .ai-cart-remove-visible-{{ ai_gen_id }} [class*="remove"] svg {
      color: {{ block.settings.icon_color }} !important;
    }

    {% if block.settings.apply_to_drawer %}
      cart-drawer .cart-item cart-remove-button svg,
      cart-drawer .cart-item .cart-item__remove svg,
      cart-drawer .cart-item .cart-remove-button svg,
      cart-drawer .cart-item [class*="remove"] svg {
        color: {{ block.settings.icon_color }} !important;
      }
    {% endif %}

    {% if block.settings.apply_to_page %}
      .cart-items cart-remove-button svg,
      .cart-items .cart-item__remove svg,
      .cart-items .cart-remove-button svg,
      .cart-items [class*="remove"] svg {
        color: {{ block.settings.icon_color }} !important;
      }
    {% endif %}
  {% endif %}

  {% if block.settings.custom_size_enabled %}
    .ai-cart-remove-visible-{{ ai_gen_id }} cart-remove-button,
    .ai-cart-remove-visible-{{ ai_gen_id }} .cart-item__remove,
    .ai-cart-remove-visible-{{ ai_gen_id }} .cart-remove-button {
      width: {{ block.settings.icon_size }}px !important;
      height: {{ block.settings.icon_size }}px !important;
    }

    .ai-cart-remove-visible-{{ ai_gen_id }} cart-remove-button svg,
    .ai-cart-remove-visible-{{ ai_gen_id }} .cart-item__remove svg,
    .ai-cart-remove-visible-{{ ai_gen_id }} .cart-remove-button svg {
      width: {{ block.settings.icon_size }}px !important;
      height: {{ block.settings.icon_size }}px !important;
    }

    {% if block.settings.apply_to_drawer %}
      cart-drawer .cart-item cart-remove-button,
      cart-drawer .cart-item .cart-item__remove,
      cart-drawer .cart-item .cart-remove-button {
        width: {{ block.settings.icon_size }}px !important;
        height: {{ block.settings.icon_size }}px !important;
      }

      cart-drawer .cart-item cart-remove-button svg,
      cart-drawer .cart-item .cart-item__remove svg,
      cart-drawer .cart-item .cart-remove-button svg {
        width: {{ block.settings.icon_size }}px !important;
        height: {{ block.settings.icon_size }}px !important;
      }
    {% endif %}

    {% if block.settings.apply_to_page %}
      .cart-items cart-remove-button,
      .cart-items .cart-item__remove,
      .cart-items .cart-remove-button {
        width: {{ block.settings.icon_size }}px !important;
        height: {{ block.settings.icon_size }}px !important;
      }

      .cart-items cart-remove-button svg,
      .cart-items .cart-item__remove svg,
      .cart-items .cart-remove-button svg {
        width: {{ block.settings.icon_size }}px !important;
        height: {{ block.settings.icon_size }}px !important;
      }
    {% endif %}
  {% endif %}
{% endstyle %}

<div class="ai-cart-remove-visible-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_message %}
    <div style="padding: 12px; background-color: {{ block.settings.message_bg_color }}; color: {{ block.settings.message_text_color }}; border-radius: {{ block.settings.message_border_radius }}px; text-align: center; font-size: 14px; margin-bottom: 16px;">
      {{ block.settings.message_text }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart remove icon",
  "settings": [
    {
      "type": "header",
      "content": "Visibility settings"
    },
    {
      "type": "paragraph",
      "content": "This block makes the delete/trash icon permanently visible in the cart instead of only showing on hover."
    },
    {
      "type": "checkbox",
      "id": "apply_to_drawer",
      "label": "Apply to cart drawer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "apply_to_page",
      "label": "Apply to cart page",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Icon opacity",
      "default": 100
    },
    {
      "type": "header",
      "content": "Icon customization"
    },
    {
      "type": "checkbox",
      "id": "custom_color_enabled",
      "label": "Enable custom color",
      "default": false
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#121212"
    },
    {
      "type": "checkbox",
      "id": "custom_size_enabled",
      "label": "Enable custom size",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Optional message"
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "Show message",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "message_text",
      "label": "Message text",
      "default": "Click the trash icon to remove items from your cart"
    },
    {
      "type": "color",
      "id": "message_bg_color",
      "label": "Message background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "message_text_color",
      "label": "Message text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "message_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Message border radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Cart remove icon"
    }
  ]
}
{% endschema %}
