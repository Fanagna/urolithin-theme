{% doc %}
  @prompt
    Create a premium trust & credibility section for a supplement brand landing page.
    
    Black background with soft gradients, dark luxury UI.
    
    Centered headline in white text:
    “Quality You Can Verify”
    
    Below the headline, display four sleek rectangular cards aligned horizontally, with subtle shadows and rounded edges.
    
    Each card contains a minimalist icon, bold title, and short subtitle:
    
    Card 1:
    Icon: USA badge
    Title: MADE IN USA
    Subtitle: FDA Registered Facility
    
    Card 2:
    Icon: laboratory / microscope
    Title: LAB TESTED
    Subtitle: Purity Verified
    
    Card 3:
    Icon: capsule / certification symbol
    Title: GMP CERTIFIED
    Subtitle: Manufacturing Standards
    
    Card 4:
    Icon: shield / checkmark
    Title: GUARANTEED
    Subtitle: 60-Day Return Policy
    
    Design style:
    
    Modern biotech & high-end supplement brand
    
    Clean sans-serif typography
    
    White text with subtle blue or red accent icons
    
    High contrast, minimalist, trust-focused
    
    Shopify-ready section, optimized for product pages and conversion
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-section-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    background-image: {{ block.settings.background_gradient }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-trust-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-trust-heading-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    letter-spacing: -0.5px;
  }

  .ai-trust-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    margin: 0;
  }

  .ai-trust-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-trust-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: 8 }}px {{ block.settings.card_shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.5 }});
  }

  .ai-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 1.5;
  }

  .ai-trust-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-trust-card-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.card_subtitle_color }};
    font-size: {{ block.settings.card_subtitle_size }}px;
    margin: 0;
    line-height: 1.5;
    opacity: 0.9;
  }

  @media screen and (max-width: 989px) {
    .ai-trust-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 16px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-trust-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-trust-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-trust-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-trust-cards-{{ ai_gen_id }}">
      {% if block.settings.card_1_enabled %}
        <div class="ai-trust-card-{{ ai_gen_id }}">
          <div class="ai-trust-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <h3 class="ai-trust-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
          <p class="ai-trust-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_1_subtitle }}</p>
        </div>
      {% endif %}

      {% if block.settings.card_2_enabled %}
        <div class="ai-trust-card-{{ ai_gen_id }}">
          <div class="ai-trust-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2v4"/>
              <path d="M10 2v4"/>
              <path d="M14 2v4"/>
              <path d="M18 2v4"/>
              <rect width="16" height="16" x="4" y="4" rx="2"/>
              <path d="M9 14a3 3 0 1 0 6 0 3 3 0 1 0-6 0"/>
            </svg>
          </div>
          <h3 class="ai-trust-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
          <p class="ai-trust-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_2_subtitle }}</p>
        </div>
      {% endif %}

      {% if block.settings.card_3_enabled %}
        <div class="ai-trust-card-{{ ai_gen_id }}">
          <div class="ai-trust-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v2"/>
              <circle cx="16" cy="16" r="6"/>
              <path d="m18 13-2 2-2-2"/>
              <path d="M16 19v-6"/>
            </svg>
          </div>
          <h3 class="ai-trust-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
          <p class="ai-trust-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_3_subtitle }}</p>
        </div>
      {% endif %}

      {% if block.settings.card_4_enabled %}
        <div class="ai-trust-card-{{ ai_gen_id }}">
          <div class="ai-trust-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <h3 class="ai-trust-card-title-{{ ai_gen_id }}">{{ block.settings.card_4_title }}</h3>
          <p class="ai-trust-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_4_subtitle }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

