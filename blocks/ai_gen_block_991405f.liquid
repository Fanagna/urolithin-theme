{% doc %}
  @prompt
    Role:
    Act as a senior Shopify theme developer and conversion-focused UX designer with strong experience in premium supplement and longevity product pages.
    
    Goal:
    Generate a clean, educational Step 2 — Renew section that explains the second phase of a dual-action protocol, with a purely visual image block on the left and a content card on the right.
    
    Section Header (optional if chained after Step 1)
    
    This section visually continues the “Dual-Action Protocol”
    
    No need to repeat the main protocol title if already present above
    
    Layout
    
    Two-column layout on desktop
    
    Left column: image only
    
    Right column: content card
    
    Mobile: stacked layout (content first, image second)
    
    White background
    
    Generous spacing, premium longevity aesthetic
    
    LEFT COLUMN — IMAGE ONLY (IMPORTANT)
    
    The left column must be STRICTLY a visual image container
    
    NO product logic
    
    NO pricing
    
    NO add-to-cart
    
    NO dynamic product data
    
    This block is decorative and educational only
    
    Image requirements:
    
    Image selectable from Shopify section settings
    
    Rounded container with dashed or subtle border
    
    Light gray background
    
    Centered icon or illustration (mitochondria / recycling / renewal visual)
    
    Optional caption (editable):
    “Visual: Macro shot of mitochondrial renewal process”
    
    RIGHT COLUMN — CONTENT CARD (FUNCTIONAL CONTENT)
    
    Create a rounded card with a soft purple background.
    
    Card Structure (all text editable from section settings):
    
    Small label at top:
    “STEP 2 — RENEW”
    
    Main title:
    “Urolithin A (PM)”
    
    Highlighted dosage line (accent color):
    “2000mg clinical dose”
    
    Description text (neutral, science-based, non-medical):
    “Activates mitophagy—your cells’ natural process to recycle damaged mitochondria.”
    
    Bullet list with check icons:
    
    Optimized muscle & energy
    
    Cellular cleanup protocol
    
    180 capsules (90 servings)
    
    Small credibility note at bottom (optional, editable):
    “6 clinical trials”
    
    Design & Style
    
    Clean, minimal, science-driven
    
    Premium longevity / biotech aesthetic
    
    No exaggerated claims
    
    No medica
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-step-renew-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-step-renew-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-step-renew-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-step-renew-header-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.header_color }};
    margin: 0;
    letter-spacing: -0.02em;
  }

  .ai-step-renew-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-step-renew-image-column-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-step-renew-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.image_background }};
    border-radius: {{ block.settings.image_border_radius }}px;
    border: {{ block.settings.image_border_width }}px {{ block.settings.image_border_style }} {{ block.settings.image_border_color }};
    padding: {{ block.settings.image_padding }}px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-step-renew-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_inner_radius }}px;
  }

  .ai-step-renew-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_background }};
    border-radius: {{ block.settings.image_inner_radius }}px;
  }

  .ai-step-renew-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-step-renew-image-caption-{{ ai_gen_id }} {
    margin-top: 12px;
    font-size: 13px;
    color: {{ block.settings.caption_color }};
    text-align: center;
    font-style: italic;
  }

  .ai-step-renew-content-column-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-step-renew-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .ai-step-renew-label-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .ai-step-renew-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .ai-step-renew-dosage-{{ ai_gen_id }} {
    font-size: {{ block.settings.dosage_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.dosage_color }};
    margin-bottom: 16px;
  }

  .ai-step-renew-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin-bottom: 20px;
  }

  .ai-step-renew-benefits-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
  }

  .ai-step-renew-benefit-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: {{ block.settings.benefit_font_size }}px;
    color: {{ block.settings.benefit_color }};
  }

  .ai-step-renew-benefit-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: {{ block.settings.check_icon_color }};
  }

  .ai-step-renew-credibility-{{ ai_gen_id }} {
    font-size: {{ block.settings.credibility_font_size }}px;
    color: {{ block.settings.credibility_color }};
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .ai-step-renew-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-step-renew-content-column-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-step-renew-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }

    .ai-step-renew-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
    }

    .ai-step-renew-header-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<dual-action-step-{{ ai_gen_id }} class="ai-step-renew-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-step-renew-container-{{ ai_gen_id }}">
    {% if block.settings.show_header and block.settings.header_text != blank %}
      <div class="ai-step-renew-header-{{ ai_gen_id }}">
        <h2 class="ai-step-renew-header-title-{{ ai_gen_id }}">{{ block.settings.header_text }}</h2>
      </div>
    {% endif %}

    <div class="ai-step-renew-grid-{{ ai_gen_id }}">
      <div class="ai-step-renew-image-column-{{ ai_gen_id }}">
        <div class="ai-step-renew-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-step-renew-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-step-renew-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.image_caption != blank %}
          <div class="ai-step-renew-image-caption-{{ ai_gen_id }}">
            {{ block.settings.image_caption }}
          </div>
        {% endif %}
      </div>

      <div class="ai-step-renew-content-column-{{ ai_gen_id }}">
        <div class="ai-step-renew-card-{{ ai_gen_id }}">
          {% if block.settings.step_label != blank %}
            <div class="ai-step-renew-label-{{ ai_gen_id }}">{{ block.settings.step_label }}</div>
          {% endif %}

          {% if block.settings.product_title != blank %}
            <h3 class="ai-step-renew-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h3>
          {% endif %}

          {% if block.settings.dosage_text != blank %}
            <div class="ai-step-renew-dosage-{{ ai_gen_id }}">{{ block.settings.dosage_text }}</div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="ai-step-renew-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
          {% endif %}

          <ul class="ai-step-renew-benefits-{{ ai_gen_id }}">
            {% if block.settings.benefit_1 != blank %}
              <li class="ai-step-renew-benefit-{{ ai_gen_id }}">
                <svg class="ai-step-renew-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{{ block.settings.benefit_1 }}</span>
              </li>
            {% endif %}

            {% if block.settings.benefit_2 != blank %}
              <li class="ai-step-renew-benefit-{{ ai_gen_id }}">
                <svg class="ai-step-renew-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{{ block.settings.benefit_2 }}</span>
              </li>
            {% endif %}

            {% if block.settings.benefit_3 != blank %}
              <li class="ai-step-renew-benefit-{{ ai_gen_id }}">
                <svg class="ai-step-renew-benefit-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{{ block.settings.benefit_3 }}</span>
              </li>
            {% endif %}
          </ul>

          {% if block.settings.credibility_note != blank %}
            <div class="ai-step-renew-credibility-{{ ai_gen_id }}">{{ block.settings.credibility_note }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</dual-action-step-{{ ai_gen_id }}>

<script>
  (function() {
    class DualActionStep{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('dual-action-step-{{ ai_gen_id }}', DualActionStep{{ ai_gen_id }});
  })();
</script>

