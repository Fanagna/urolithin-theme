{% doc %}
  @prompt
    genere moi une section contenant un titre(centre) ; deux multicolonne identique contenant chacun un titre, un sous titre et des textes. le premier multicolonne possède une icon de bonbon juste à coté du titre et ce lui du deuxieme un comprimé
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-columns-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-dual-columns-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-dual-columns-main-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.main_title_size }}px;
    color: {{ block.settings.main_title_color }};
    margin: 0 0 {{ block.settings.spacing_below_title }}px;
    font-weight: 700;
  }

  .ai-dual-columns-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-dual-columns-column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_background }};
    padding: {{ block.settings.column_padding }}px;
    border-radius: {{ block.settings.column_border_radius }}px;
    border: {{ block.settings.column_border_thickness }}px solid {{ block.settings.column_border_color }};
  }

  .ai-dual-columns-column-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-dual-columns-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-dual-columns-column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    color: {{ block.settings.column_title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-dual-columns-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 12px;
    font-weight: 500;
  }

  .ai-dual-columns-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-columns-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }

    .ai-dual-columns-main-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.8 }}px;
    }

    .ai-dual-columns-column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-dual-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-columns-container-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-dual-columns-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}

    <div class="ai-dual-columns-grid-{{ ai_gen_id }}">
      <div class="ai-dual-columns-column-{{ ai_gen_id }}">
        <div class="ai-dual-columns-column-header-{{ ai_gen_id }}">
          <div class="ai-dual-columns-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="{{ block.settings.icon_color }}" width="100%" height="100%">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
              <circle cx="12" cy="8" r="1.5" fill="{{ block.settings.icon_color }}"/>
              <circle cx="8" cy="12" r="1.5" fill="{{ block.settings.icon_color }}"/>
              <circle cx="16" cy="12" r="1.5" fill="{{ block.settings.icon_color }}"/>
              <circle cx="12" cy="16" r="1.5" fill="{{ block.settings.icon_color }}"/>
            </svg>
          </div>
          {% if block.settings.column_1_title != blank %}
            <h3 class="ai-dual-columns-column-title-{{ ai_gen_id }}">{{ block.settings.column_1_title }}</h3>
          {% endif %}
        </div>

        {% if block.settings.column_1_subtitle != blank %}
          <div class="ai-dual-columns-subtitle-{{ ai_gen_id }}">{{ block.settings.column_1_subtitle }}</div>
        {% endif %}

        {% if block.settings.column_1_text != blank %}
          <div class="ai-dual-columns-text-{{ ai_gen_id }}">{{ block.settings.column_1_text }}</div>
        {% endif %}
      </div>

      <div class="ai-dual-columns-column-{{ ai_gen_id }}">
        <div class="ai-dual-columns-column-header-{{ ai_gen_id }}">
          <div class="ai-dual-columns-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="{{ block.settings.icon_color }}" width="100%" height="100%">
              <ellipse cx="12" cy="12" rx="8" ry="4" fill="{{ block.settings.icon_color }}" opacity="0.3"/>
              <ellipse cx="12" cy="12" rx="6" ry="3" fill="{{ block.settings.icon_color }}"/>
              <rect x="10.5" y="8" width="3" height="8" rx="1.5" fill="{{ block.settings.icon_color }}"/>
              <circle cx="12" cy="10" r="1" fill="white"/>
              <circle cx="12" cy="14" r="1" fill="white"/>
            </svg>
          </div>
          {% if block.settings.column_2_title != blank %}
            <h3 class="ai-dual-columns-column-title-{{ ai_gen_id }}">{{ block.settings.column_2_title }}</h3>
          {% endif %}
        </div>

        {% if block.settings.column_2_subtitle != blank %}
          <div class="ai-dual-columns-subtitle-{{ ai_gen_id }}">{{ block.settings.column_2_subtitle }}</div>
        {% endif %}

        {% if block.settings.column_2_text != blank %}
          <div class="ai-dual-columns-text-{{ ai_gen_id }}">{{ block.settings.column_2_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

