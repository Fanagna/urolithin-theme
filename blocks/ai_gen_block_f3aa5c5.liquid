{% doc %}
  @prompt
    Create a custom Shopify section that reproduces exactly the visual layout, copy, hierarchy, spacing, and tone shown in the reference image.
    
    ⚠️ Do not rewrite, summarize, optimize, or change any text.
    ⚠️ Do not change wording, punctuation, capitalization, or line breaks.
    ⚠️ Do not add or remove content.
    
    The section must contain:
    
    1. Section Structure
    
    Full-width section
    
    White background
    
    Centered content
    
    Maximum content width: 1100–1200px
    
    Vertical padding: 64px top / 64px bottom (desktop)
    
    Mobile padding: 40px top / 40px bottom
    
    2. Section Heading
    
    Centered headline
    
    Text (EXACT, unchanged):
    “Is your gut sabotaging your goals?”
    
    Font weight: semi-bold to bold
    
    Font size:
    
    Desktop: ~32–36px
    
    Mobile: ~24–26px
    
    Margin-bottom: 40px
    
    3. Three-Column Card Layout
    
    Grid of 3 cards on desktop
    
    Stack to 1 column on mobile
    
    Gap between cards: 24–32px
    
    Each card must include:
    
    Light background (very light gray / off-white)
    
    Soft rounded corners (border-radius ~12–16px)
    
    Subtle shadow (low opacity, soft blur)
    
    Padding: 24–28px
    
    Center-aligned content
    
    4. Icons
    
    Circular colored icon container at the top of each card
    
    Icon style: minimal, outline or filled, centered
    
    Icon colors:
    
    Card 1: red/pink tone
    
    Card 2: purple/violet tone
    
    Card 3: orange/yellow tone
    
    Icon container size: ~40–48px
    
    5. Card Text (DO NOT CHANGE ANY TEXT)
    
    Card 1 text:
    “You eat clean, you train hard,
    but your belly stays bloated
    and those stubborn pounds
    won’t budge.”
    
    Card 2 text:
    “You feel that constant brain fog
    slowing down your day, even
    after 8 hours of sleep.”
    
    Card 3 text:
    “Your mood fluctuates for no
    reason—irritability, mild anxiety
    —and you need a root-cause
    solution.”
    
    Font size: ~15–16px
    
    Line height: comfortable (1.5–1.6)
    
    Text color: dark gray (#333–#444)
    
    6. Section Settings (IMPORTANT)
    
    Make the section configurable with the following settings:
    
    Toggle: Show / hide section
    
    Color picker: background color (default white)
    
    Text alignment option (default: center)
    
    Padding controls (top/botto
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gut-sabotage-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top_desktop }}px 20px {{ block.settings.padding_bottom_desktop }}px;
  }

  .ai-gut-sabotage-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-gut-sabotage-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
  }

  .ai-gut-sabotage-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-gut-sabotage-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    text-align: center;
  }

  .ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto {{ block.settings.icon_margin_bottom }}px;
  }

  .ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }}.card-1 {
    background-color: {{ block.settings.icon_color_1 }};
  }

  .ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }}.card-2 {
    background-color: {{ block.settings.icon_color_2 }};
  }

  .ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }}.card-3 {
    background-color: {{ block.settings.icon_color_3 }};
  }

  .ai-gut-sabotage-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: #ffffff;
    fill: none;
  }

  .ai-gut-sabotage-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    line-height: {{ block.settings.card_text_line_height }};
    color: {{ block.settings.card_text_color }};
    margin: 0;
    white-space: pre-line;
  }

  @media screen and (max-width: 749px) {
    .ai-gut-sabotage-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 20px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-gut-sabotage-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-gut-sabotage-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% if block.settings.show_section %}
  <gut-sabotage-section-{{ ai_gen_id }} class="ai-gut-sabotage-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-gut-sabotage-container-{{ ai_gen_id }}">
      <h2 class="ai-gut-sabotage-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      
      <div class="ai-gut-sabotage-cards-{{ ai_gen_id }}">
        <div class="ai-gut-sabotage-card-{{ ai_gen_id }}">
          <div class="ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }} card-1">
            <svg class="ai-gut-sabotage-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <p class="ai-gut-sabotage-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</p>
        </div>

        <div class="ai-gut-sabotage-card-{{ ai_gen_id }}">
          <div class="ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }} card-2">
            <svg class="ai-gut-sabotage-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <p class="ai-gut-sabotage-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</p>
        </div>

        <div class="ai-gut-sabotage-card-{{ ai_gen_id }}">
          <div class="ai-gut-sabotage-icon-wrapper-{{ ai_gen_id }} card-3">
            <svg class="ai-gut-sabotage-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
              <line x1="9" y1="9" x2="9.01" y2="9"></line>
              <line x1="15" y1="9" x2="15.01" y2="9"></line>
            </svg>
          </div>
          <p class="ai-gut-sabotage-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</p>
        </div>
      </div>
    </div>
  </gut-sabotage-section-{{ ai_gen_id }}>
{% endif %}

<script>
  (function() {
    class GutSabotageSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('gut-sabotage-section-{{ ai_gen_id }}', GutSabotageSection{{ ai_gen_id }});
  })();
</script>

