{% doc %}
  @prompt
    Create a “Why Trust InnerThera?” section identical to the reference visual.
    
    Do NOT change any wording, capitalization, spacing, badge design, layout proportions, or colors.
    
    The final result must visually match the reference exactly.
    
    🔹 TOP CONTENT (Centered)
    
    Main heading:
    
    Why Trust InnerThera?
    
    Subtext below (keep exactly as written):
    
    All of our products are manufactured in a state-of-the-art FDA registered facility in the USA. Every product is third party tested for purity and potency.
    
    🔹 BADGE GRID (Three Equal Columns)
    
    Create a horizontal 3-column layout with equal spacing.
    
    Each column contains:
    
    A circular black badge icon (as shown)
    
    A short label underneath
    
    BADGE 1
    
    Circular black seal reading:
    3RD PARTY LAB TESTED
    
    Label below:
    Third Party Tested
    
    BADGE 2
    
    Circular black seal reading:
    PROUDLY MADE IN USA
    
    Label below:
    Proudly Made in the USA
    
    BADGE 3
    
    Circular black seal reading:
    FREE RETURNS
    
    Label below:
    Free Returns
    
    🔹 DESIGN REQUIREMENTS
    
    Background: light grey (as shown)
    
    Heading: black
    
    Subtext: dark grey
    
    Badge seals: black circular with white text
    
    Labels under badges: black
    
    Clean spacing between badges
    
    Slight rounded container background behind each badge (if visible in reference)
    
    No redesign
    
    No animations
    
    No additional elements
    
    🔹 LAYOUT
    
    Desktop:
    
    Three equal columns
    
    Centered alignment
    
    Balanced spacing
    
    Tablet:
    
    Maintain three columns if space allows
    
    Otherwise adjust proportionally
    
    Mobile:
    
    Stack vertically
    
    Maintain spacing
    
    Keep badge centered above text
    
    🔹 RESPONSIVE RULES
    
    Heading scales properly on mobile
    
    Subtext wraps cleanly
    
    Badges remain proportionate
    
    Maintain visual balance on all screen sizes
    
    🔹 TECHNICAL REQUIREMENTS
    
    Semantic HTML (section, div, h2, p)
    
    Use CSS Grid or Flexbox
    
    Lightweight CSS
    
    No JavaScript required
    
    Shopify Dawn compatible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-trust-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-trust-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-trust-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subtext_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-trust-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-trust-badges-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.badge_spacing }}px;
    margin-top: {{ block.settings.badges_top_spacing }}px;
  }

  .ai-trust-badge-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-trust-badge-seal-{{ ai_gen_id }} {
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.label_spacing }}px;
    border: {{ block.settings.badge_border_width }}px solid {{ block.settings.badge_border_color }};
  }

  .ai-trust-badge-seal-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 700;
    color: {{ block.settings.badge_text_color }};
    text-align: center;
    line-height: 1.2;
    padding: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-trust-badge-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-trust-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-trust-badges-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.badge_spacing | times: 1.5 }}px;
    }

    .ai-trust-badge-seal-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size | times: 0.8 }}px;
      height: {{ block.settings.badge_size | times: 0.8 }}px;
    }

    .ai-trust-badge-seal-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_text_size | times: 0.8 }}px;
    }

    .ai-trust-badge-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-trust-badge-seal-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size | times: 0.9 }}px;
      height: {{ block.settings.badge_size | times: 0.9 }}px;
    }

    .ai-trust-badge-seal-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-container-{{ ai_gen_id }}">
    <div class="ai-trust-header-{{ ai_gen_id }}">
      <h2 class="ai-trust-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <p class="ai-trust-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    </div>

    <div class="ai-trust-badges-{{ ai_gen_id }}">
      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge-seal-{{ ai_gen_id }}">
          <div class="ai-trust-badge-seal-text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</div>
        </div>
        <div class="ai-trust-badge-label-{{ ai_gen_id }}">{{ block.settings.badge_1_label }}</div>
      </div>

      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge-seal-{{ ai_gen_id }}">
          <div class="ai-trust-badge-seal-text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</div>
        </div>
        <div class="ai-trust-badge-label-{{ ai_gen_id }}">{{ block.settings.badge_2_label }}</div>
      </div>

      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge-seal-{{ ai_gen_id }}">
          <div class="ai-trust-badge-seal-text-{{ ai_gen_id }}">{{ block.settings.badge_3_text }}</div>
        </div>
        <div class="ai-trust-badge-label-{{ ai_gen_id }}">{{ block.settings.badge_3_label }}</div>
      </div>
    </div>
  </div>
</div>

