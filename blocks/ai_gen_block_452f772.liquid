{% doc %}
  @prompt
    Create a clean guarantee highlight section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, punctuation, emojis, icons, colors, spacing, or hierarchy.
    ⚠️ DO NOT rewrite, summarize, or optimize the copy.
    
    LAYOUT
    
    Create a centered rectangular container on the page.
    
    CONTAINER STYLE
    
    Light green background (same shade as reference)
    
    Thin green border
    
    Rounded corners
    
    Content centered horizontally
    
    Generous internal padding
    
    TOP ELEMENT (visual placeholder)
    
    Add an image placeholder at the top center with:
    
    Light grey background
    
    Dashed border
    
    Rounded corners
    
    Centered icon + text: INSERT IMAGE HERE
    
    Same size and proportions as the reference
    
    MAIN CONTENT (centered – keep exactly as written)
    
    Title:
    🛡️ 30-DAY GUARANTEE
    
    Description text:
    Try it for 3 months. Track how you feel. Not happy? Send back the empty bottle. Full refund. No questions.
    
    DESIGN & STYLE RULES
    
    White page background outside the container
    
    Clean, minimal, premium supplement-brand aesthetic
    
    Text centered
    
    Title slightly bolder than description
    
    Consistent vertical spacing between image, title, and text
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: centered container with fixed max-width
    
    Tablet: same layout with reduced padding
    
    Mobile:
    
    Container becomes full width with side padding
    
    Image placeholder scales down proportionally
    
    Text remains centered
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML
    
    Use Flexbox for centering
    
    Mobile-first responsive CSS
    
    Fully compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting size and spacing for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-guarantee-highlight-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
  }

  .ai-guarantee-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-guarantee-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    margin-bottom: {{ block.settings.spacing_image_to_title }}px;
  }

  .ai-guarantee-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-guarantee-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.placeholder_aspect_ratio }};
    background-color: {{ block.settings.placeholder_bg_color }};
    border: {{ block.settings.placeholder_border_thickness }}px dashed {{ block.settings.placeholder_border_color }};
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai-guarantee-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    color: {{ block.settings.placeholder_text_color }};
  }

  .ai-guarantee-placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.placeholder_text_color }};
    font-weight: 500;
  }

  .ai-guarantee-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.spacing_title_to_text }}px 0;
    line-height: 1.3;
  }

  .ai-guarantee-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    font-weight: {{ block.settings.description_font_weight }};
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
    max-width: {{ block.settings.description_max_width }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-guarantee-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.75 }}px;
    }

    .ai-guarantee-image-wrapper-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_max_width | times: 0.85 }}px;
    }

    .ai-guarantee-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-guarantee-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-guarantee-highlight-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-guarantee-container-{{ ai_gen_id }} {
      max-width: 100%;
      padding: {{ block.settings.container_padding | times: 0.6 }}px;
    }

    .ai-guarantee-image-wrapper-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_max_width | times: 0.7 }}px;
      margin-bottom: {{ block.settings.spacing_image_to_title | times: 0.8 }}px;
    }

    .ai-guarantee-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
      margin-bottom: {{ block.settings.spacing_title_to_text | times: 0.8 }}px;
    }

    .ai-guarantee-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-guarantee-highlight-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-guarantee-container-{{ ai_gen_id }}">
    <div class="ai-guarantee-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          class="ai-guarantee-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-guarantee-placeholder-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span class="ai-guarantee-placeholder-text-{{ ai_gen_id }}">INSERT IMAGE HERE</span>
        </div>
      {% endif %}
    </div>

    <h2 class="ai-guarantee-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    <p class="ai-guarantee-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
  </div>
</div>

