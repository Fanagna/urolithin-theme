{% doc %}
  @prompt
    creer moi une section qui classifie les produits par catégorie , en total il y a 6 catégoroies de produits, et lorsqu on clic sur un e catégories ça affiche tous les produits dedans ... je veux que cette section soit responsive 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-categories-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-categories-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-categories-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-product-categories-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-product-categories-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-product-categories-tabs-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 40px;
  }

  .ai-product-categories-tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.tab_bg_color }};
    color: {{ block.settings.tab_text_color }};
    border: 2px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 500;
  }

  .ai-product-categories-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg_color }};
    color: {{ block.settings.tab_hover_text_color }};
    border-color: {{ block.settings.tab_hover_border_color }};
  }

  .ai-product-categories-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-product-categories-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-categories-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-product-categories-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-categories-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-product-categories-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-categories-card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
  }

  .ai-product-categories-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-categories-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-categories-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-categories-card-info-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-product-categories-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-product-categories-card-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-categories-card-title-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-product-categories-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-product-categories-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-product-categories-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-product-categories-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-product-categories-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-categories-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-categories-tabs-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-product-categories-tab-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: calc({{ block.settings.tab_font_size }}px * 0.9);
    }

    .ai-product-categories-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-product-categories-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }
  }
{% endstyle %}

<product-categories-{{ ai_gen_id }} class="ai-product-categories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-categories-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-product-categories-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-product-categories-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-product-categories-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-categories-tabs-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign category_enabled_key = 'category_' | append: i | append: '_enabled'
          assign category_name_key = 'category_' | append: i | append: '_name'
          assign category_enabled = block.settings[category_enabled_key]
          assign category_name = block.settings[category_name_key]
        %}
        {% if category_enabled and category_name != blank %}
          <button
            class="ai-product-categories-tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-category="{{ i }}"
            aria-label="View {{ category_name }} products"
          >
            {{ category_name }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    {% for i in (1..6) %}
      {% liquid
        assign category_enabled_key = 'category_' | append: i | append: '_enabled'
        assign category_collection_key = 'category_' | append: i | append: '_collection'
        assign category_enabled = block.settings[category_enabled_key]
        assign category_collection = block.settings[category_collection_key]
      %}
      {% if category_enabled %}
        <div
          class="ai-product-categories-content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-category="{{ i }}"
        >
          {% if category_collection != blank and category_collection.products.size > 0 %}
            <div class="ai-product-categories-grid-{{ ai_gen_id }}">
              {% for product in category_collection.products limit: block.settings.products_per_category %}
                <div class="ai-product-categories-card-{{ ai_gen_id }}">
                  <div class="ai-product-categories-card-image-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-product-categories-card-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-product-categories-card-info-{{ ai_gen_id }}">
                    <h3 class="ai-product-categories-card-title-{{ ai_gen_id }}">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    <div class="ai-product-categories-card-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="ai-product-categories-empty-{{ ai_gen_id }}">
              No products available in this category. Please select a collection in the theme editor.
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</product-categories-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCategories{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-product-categories-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-product-categories-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const categoryId = tab.getAttribute('data-category');
            this.switchCategory(categoryId);
          });
        });
      }

      switchCategory(categoryId) {
        this.tabs.forEach((tab) => {
          if (tab.getAttribute('data-category') === categoryId) {
            tab.classList.add('active');
          } else {
            tab.classList.remove('active');
          }
        });

        this.contents.forEach((content) => {
          if (content.getAttribute('data-category') === categoryId) {
            content.classList.add('active');
          } else {
            content.classList.remove('active');
          }
        });
      }
    }

    customElements.define('product-categories-{{ ai_gen_id }}', ProductCategories{{ ai_gen_id }});
  })();
</script>

