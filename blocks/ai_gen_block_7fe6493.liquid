{% doc %}
  @prompt
    Create a clean comparison table section identical to the reference.
    
    ⚠️ DO NOT change any text, wording, punctuation, emojis, icons, colors, spacing, or hierarchy.
    ⚠️ DO NOT rewrite or optimize the copy.
    
    SECTION HEADER (centered)
    
    Title:
    🎯 WHY THIS STACK?
    
    TABLE STRUCTURE
    
    Create a two-column comparison table with:
    
    Left column header:
    TYPICAL PROBIOTIC
    
    Right column header:
    GUT & GLUCOSE STACK
    
    Header row background: light green, same shade as reference.
    
    ROW CONTENT (must stay exactly the same)
    
    Row 1
    
    ❌ Basic strains only
    
    ✅ Targeted Akkermansia + Berberine
    
    Row 2
    
    ❌ Low potency
    
    ✅ 500B CFU
    
    Row 3
    
    ❌ Just digestion support
    
    ✅ Gut + Energy support
    
    Row 4
    
    ❌ No testing
    
    ✅ Every batch tested
    
    DESIGN & STYLE RULES
    
    White background
    
    Clean, minimal, premium supplement-brand aesthetic
    
    Clear horizontal row separators
    
    Icons aligned with text
    
    Text left-aligned inside cells
    
    Consistent spacing and padding
    
    RESPONSIVENESS (MANDATORY)
    
    Desktop: full comparison table (2 columns)
    
    Tablet: same layout with reduced spacing
    
    Mobile:
    
    Stack rows vertically per comparison OR
    
    Convert to card-style comparison
    
    Maintain icons and text clarity
    
    No horizontal scrolling
    
    TECHNICAL CONSTRAINTS
    
    Use semantic HTML (table, thead, tbody)
    
    Or accessible div-based table layout
    
    Mobile-first responsive CSS
    
    Compatible with Shopify Dawn theme
    
    No JavaScript
    
    The final result must visually match the reference exactly, only adapting layout for smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-comparison-table-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-comparison-table-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
  }

  .ai-comparison-table-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-comparison-table-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
  }

  .ai-comparison-table-{{ ai_gen_id }} table {
    width: 100%;
    border-collapse: collapse;
    background-color: #ffffff;
    border-radius: {{ block.settings.table_border_radius }}px;
    overflow: hidden;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th {
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: {{ block.settings.header_font_weight }};
    padding: {{ block.settings.header_padding_vertical }}px {{ block.settings.header_padding_horizontal }}px;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr {
    border-bottom: {{ block.settings.row_border_thickness }}px solid {{ block.settings.row_border_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr:last-child {
    border-bottom: none;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td {
    padding: {{ block.settings.cell_padding_vertical }}px {{ block.settings.cell_padding_horizontal }}px;
    font-size: {{ block.settings.cell_font_size }}px;
    color: {{ block.settings.cell_text_color }};
    vertical-align: middle;
  }

  .ai-comparison-table-cell-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-comparison-table-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    font-size: {{ block.settings.icon_size }}px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.5 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-comparison-table-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-comparison-table-wrapper-{{ ai_gen_id }} {
      overflow-x: visible;
    }

    .ai-comparison-table-{{ ai_gen_id }} table {
      display: block;
    }

    .ai-comparison-table-{{ ai_gen_id }} thead {
      display: block;
    }

    .ai-comparison-table-{{ ai_gen_id }} thead tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody {
      display: block;
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-bottom: {{ block.settings.mobile_row_gap }}px;
      border-bottom: none;
      background-color: #ffffff;
      border-radius: {{ block.settings.table_border_radius }}px;
      overflow: hidden;
      border: 1px solid {{ block.settings.row_border_color }};
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody td {
      padding: {{ block.settings.cell_padding_vertical | times: 0.8 }}px {{ block.settings.cell_padding_horizontal | times: 0.7 }}px;
      font-size: {{ block.settings.cell_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody td:first-child {
      border-right: {{ block.settings.row_border_thickness }}px solid {{ block.settings.row_border_color }};
    }

    .ai-comparison-table-cell-content-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-comparison-table-icon-{{ ai_gen_id }} {
      font-size: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <div class="ai-comparison-table-header-{{ ai_gen_id }}">
        <h2 class="ai-comparison-table-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="ai-comparison-table-wrapper-{{ ai_gen_id }}">
      <table>
        <thead>
          <tr>
            <th>{{ block.settings.column_1_header }}</th>
            <th>{{ block.settings.column_2_header }}</th>
          </tr>
        </thead>
        <tbody>
          {% for i in (1..4) %}
            {% liquid
              assign col1_key = 'row_' | append: i | append: '_col1'
              assign col2_key = 'row_' | append: i | append: '_col2'
              assign col1_content = block.settings[col1_key]
              assign col2_content = block.settings[col2_key]
            %}
            {% if col1_content != blank or col2_content != blank %}
              <tr>
                <td>
                  <div class="ai-comparison-table-cell-content-{{ ai_gen_id }}">
                    <span class="ai-comparison-table-icon-{{ ai_gen_id }}">{{ block.settings.icon_negative }}</span>
                    <span>{{ col1_content }}</span>
                  </div>
                </td>
                <td>
                  <div class="ai-comparison-table-cell-content-{{ ai_gen_id }}">
                    <span class="ai-comparison-table-icon-{{ ai_gen_id }}">{{ block.settings.icon_positive }}</span>
                    <span>{{ col2_content }}</span>
                  </div>
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

