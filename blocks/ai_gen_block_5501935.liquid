{% doc %}
  @prompt
    creer moi une section marquee barre d annoncement avec position fixed avec tous les parametres de reglage mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-announcement-{{ ai_gen_id }} {
    position: fixed;
    {% if block.settings.position == 'top' %}
      top: 0;
    {% else %}
      bottom: 0;
    {% endif %}
    left: 0;
    right: 0;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    z-index: {{ block.settings.z_index }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-marquee-announcement-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    gap: {{ block.settings.spacing_between_items }}px;
  }

  .ai-marquee-announcement-wrapper-{{ ai_gen_id }}:hover {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  .ai-marquee-announcement-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing_between_items }}px;
    white-space: nowrap;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-marquee-announcement-separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-marquee-announcement-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing_between_items }}px;
  }

  .ai-marquee-announcement-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-announcement-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px 0;
    }

    .ai-marquee-announcement-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .ai-marquee-announcement-separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .ai-marquee-announcement-wrapper-{{ ai_gen_id }} {
      animation-duration: {{ block.settings.animation_speed_mobile }}s;
      gap: {{ block.settings.spacing_between_items_mobile }}px;
    }

    .ai-marquee-announcement-item-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing_between_items_mobile }}px;
    }

    .ai-marquee-announcement-link-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing_between_items_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-marquee-announcement-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-announcement-wrapper-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% if block.settings.announcement_text != blank %}
        <div class="ai-marquee-announcement-item-{{ ai_gen_id }}">
          {% if block.settings.announcement_link != blank %}
            <a href="{{ block.settings.announcement_link }}" class="ai-marquee-announcement-link-{{ ai_gen_id }}">
              {{ block.settings.announcement_text }}
            </a>
          {% else %}
            {{ block.settings.announcement_text }}
          {% endif %}
        </div>
        <span class="ai-marquee-announcement-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Barre d'annonce marquee",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "inline_richtext",
      "id": "announcement_text",
      "label": "Texte de l'annonce",
      "default": "Livraison gratuite sur toutes les commandes de plus de 50€"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Lien de l'annonce"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Séparateur",
      "default": "★"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Haut"
        },
        {
          "value": "bottom",
          "label": "Bas"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "z_index",
      "min": 100,
      "max": 1000,
      "step": 10,
      "label": "Z-index",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#5c1ada"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Couleur du texte au survol",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Couleur du séparateur",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Style desktop"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Taille de police",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Épaisseur de police",
      "options": [
        {
          "value": "300",
          "label": "Léger"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Espacement vertical",
      "default": 12
    },
    {
      "type": "range",
      "id": "spacing_between_items",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espacement entre les éléments",
      "default": 40
    },
    {
      "type": "header",
      "content": "Animation desktop"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Vitesse d'animation",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause au survol",
      "default": true
    },
    {
      "type": "header",
      "content": "Style mobile"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Taille de police",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Espacement vertical",
      "default": 10
    },
    {
      "type": "range",
      "id": "spacing_between_items_mobile",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Espacement entre les éléments",
      "default": 30
    },
    {
      "type": "header",
      "content": "Animation mobile"
    },
    {
      "type": "range",
      "id": "animation_speed_mobile",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Vitesse d'animation",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce marquee"
    }
  ]
}
{% endschema %}
